+    /// them; a run whose code makes no step leaves it to an ordinary step,
+    /// as `jit_burst` does. The steps made.
+    fn jit_chain(&mut self, budget: u64, mut made: u64) -> Result<u64, Fault> {{
+        loop {{
+            if made >= budget || self.tr_on || self.halted || self.in_reset {{
+                return Ok(made);
