// The PC's devices on the ISA bus (`isabus.machine`): the AT's two 8259
// interrupt controllers, the 8254 timer, the 8237 DMA controller with its
// page registers, a host data link on a DMA channel, the IBM CGA, and a
// debugging console port. Every one is an 8-bit device: the bus controller
// splits a word into byte cycles for them.

use isabus::{Space, BusSize, IsaBus, IrqLines};
use crtc::{Mc6845Frame, Mc6845Timing, Mc6845Address, Mc6845Cursor, Mc6845Outputs, EgaCrtcFrame, EgaCrtcTiming, EgaCrtcAddress, EgaCrtcCursor, EgaCrtcOutputs};

/// The 8259 programmable interrupt controller in fixed-priority,
/// edge-triggered mode: a rising edge on an IR line sets its request bit,
/// and INT is high while an unmasked request outranks every line in
/// service. Port 0 takes ICW1, OCW2 (EOI) and OCW3 (which register a read
/// returns); port 1 takes ICW2-4 during initialisation and the mask (OCW1)
/// after.
///
/// Cascading: the SP/EN pin, strapped on the board, says which chip is the
/// master. The master's INT goes to the processor; a slave drives its INT
/// onto the master's IR line given by its ICW3 (its ID). When the master
/// grants a line that ICW3 marks as having a slave, it names the slave on
/// CAS0-2 and declines the acknowledge, and the slave whose ID matches
/// answers with its vector.
component Pic8259 {
    ports {
        bus port: IsaBus::Controller;
        /// IR0-7.
        bus ir: IrqLines::Controller;
        /// As a slave: INT onto the master's IR line.
        bus cascade: IrqLines::Device;
        /// SP/EN: high for the master.
        in sp: bool;
        out int: bool;
        /// CAS0-2, driven by the master and read by the slaves.
        out cas_out: u3;
        in cas_in: u3;
    }
    model {
        state irr: u8 = 0;
        state isr: u8 = 0;
        state imr: u8 = 0xFF;
        state base: u8 = 0;
        /// The master's slave lines, or a slave's ID.
        state icw3: u8 = 0;
        /// The ICW expected next on port 1: 2, 3, 4, or 0 when initialised.
        state icw: u8 = 0;
        state icw4_needed: bool = false;
        state single: bool = true;
        state auto_eoi: bool = false;
        state read_isr: bool = false;
        state lines: u8 = 0;

        /// INT follows the request the controller would grant.
        fn update_int() {
            let req = PicGrant(irr, imr, isr) != 0;
            int = req;
            if !sp && !single {
                emit cascade.request(icw3[2:0]) = req;
            }
        }

        /// Grant the highest-priority request: requested to in service.
        /// Returns the line, or 7 when nothing is requested (spurious).
        fn grant() -> u3 {
            let g = PicGrant(irr, imr, isr);
            if g == 0 {
                return 7;
            }
            let line = (g - 1) as u3;
            let bit = (1 as u8) << line;
            irr = irr & ~bit;
            if !auto_eoi {
                isr = isr | bit;
            }
            update_int();
            return line;
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let v: u8 = if addr[0] == 1 { imr } else if read_isr { isr } else { irr };
            return (data: v as u16, wait: 1);
        }
        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let d = data as u8;
            if addr[0] == 0 {
                if d[4] == 1 {
                    // ICW1: start initialisation; the mask clears.
                    icw = 2;
                    icw4_needed = d[0] == 1;
                    single = d[1] == 1;
                    imr = 0;
                    isr = 0;
                    read_isr = false;
                    auto_eoi = false;
                } else if d[3] == 0 {
                    // OCW2: non-specific EOI ends the highest-priority
                    // line in service, specific EOI the line named.
                    let cmd = d[7:5];
                    if cmd == 1 {
                        isr = isr & ~(isr & (~isr + 1));
                    } else if cmd == 3 {
                        isr = isr & ~((1 as u8) << d[2:0]);
                    }
                } else if d[1] == 1 {
                    // OCW3: select the register port 0 reads.
                    read_isr = d[0] == 1;
                }
            } else if icw == 2 {
                base = d & 0xF8;
                icw = if !single { 3 } else if icw4_needed { 4 } else { 0 };
            } else if icw == 3 {
                icw3 = d;
                icw = if icw4_needed { 4 } else { 0 };
            } else if icw == 4 {
                auto_eoi = d[1] == 1;
                icw = 0;
            } else {
                imr = d;
            }
            update_int();
            return (wait: 1);
        }
        /// A rising edge requests; a request whose line falls before it is
        /// acknowledged is withdrawn (the 8259 needs IR held until INTA).
        on ir.request(line: u3, value: bool) {
            let bit = (1 as u8) << line;
            if value && (lines & bit) == 0 {
                irr = irr | bit;
            }
            if !value {
                irr = irr & ~bit;
            }
            lines = if value { lines | bit } else { lines & ~bit };
            update_int();
        }
        /// The acknowledge: the master grants, and either answers or names
        /// the slave on CAS and declines; a slave answers only when named.
        on port.inta() -> (vector: u8, wait: u8) {
            if sp || single {
                let line = grant();
                if !single && icw3[line] == 1 {
                    cas_out = line;
                    decline;
                }
                return (vector: base | line as u8, wait: 0);
            }
            if cas_in != icw3[2:0] {
                decline;
            }
            let line = grant();
            return (vector: base | line as u8, wait: 0);
        }
    }
}

/// The request the 8259 grants under fixed priority (IR0 highest): its
/// line plus one, or 0 when no unmasked request outranks the lines in
/// service.
unit PicGrant(irr: u8, imr: u8, isr: u8) -> u4 {
    for i in 0..8 {
        if isr[i] == 1 {
            return 0;
        }
        if irr[i] == 1 && imr[i] == 0 {
            return (i + 1) as u4;
        }
    }
    return 0;
}

/// One 8254 counter channel.
bundle PitChannel {
    count: u16,
    reload: u16,
    mode: u3,
    /// 1 low byte, 2 high byte, 3 low then high.
    access: u2,
    counting: bool,
    /// Access mode 3: the low byte of a new count has been written.
    low_written: bool,
    low_byte: u8,
    /// Access mode 3: the next read returns the high byte.
    read_high: bool,
    latched: bool,
    latch: u16,
    out: bool,
}

/// The 8254 programmable interval timer: three 16-bit down-counters on one
/// clock. Port 3 takes control words (channel, access mode, counting mode,
/// or a counter latch command); ports 0-2 read and write the counters in
/// the programmed access mode (low byte, high byte, or low then high).
/// Modes 0 (interrupt on terminal count), 2 (rate generator) and 3 (square
/// wave, counted like mode 2) count; the gated modes 1 and 5 wait. Channel
/// 0's output drives interrupt line 0. The model catches up in one step
/// per `tick`, raising one edge however many periods passed.
component Pit8254 {
    ports {
        bus port: IsaBus::Slave;
        /// OUT0 drives IRQ 0.
        bus irq: IrqLines::Device;
        /// The AT's system control port B (61h), the board's glue around
        /// the timer: bit 0 gates channel 2, 1 drives the speaker with its
        /// output, 2 and 3 enable parity and I/O channel checks; reading,
        /// bit 4 is the refresh request flip-flop, which channel 1's output
        /// toggles each period (15 us as the BIOS programs it), and bit 5
        /// is channel 2's output. It is kept with the timer whose outputs
        /// drive it, so that reading it sees them current (until components
        /// can be composed). Unbound on boards without it.
        bus portb: IsaBus::Slave;
    }
    model {
        state ch: [PitChannel; 3];
        /// Port B's low four bits, and the refresh flip-flop.
        state portb_bits: u8 = 0;
        state refresh: bool = false;
        /// Channel 2's GATE: open until port B says otherwise.
        state gate2: bool = true;

        on portb.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let v = (portb_bits & 15) | (if refresh { 0x10 } else { 0 }) | (if ch[2].out { 0x20 } else { 0 });
            return (data: v as u16, wait: 1);
        }
        on portb.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            portb_bits = (data as u8) & 15;
            gate2 = portb_bits[0] == 1;
            return (wait: 1);
        }

        /// Set a channel's OUT pin; channel 0's drives interrupt line 0.
        fn set_out(c: u2, level: bool) {
            ch[c].out = level;
            if c == 0 {
                emit irq.request(0) = level;
            }
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let c = addr[1:0];
            if c == 3 {
                return (data: 0xFF, wait: 1);
            }
            let v = if ch[c].latched { ch[c].latch } else { ch[c].count };
            let high = ch[c].access == 2 || (ch[c].access == 3 && ch[c].read_high);
            if ch[c].access == 3 {
                ch[c].read_high = !ch[c].read_high;
            }
            if ch[c].access != 3 || !ch[c].read_high {
                ch[c].latched = false;
            }
            let b: u8 = if high { (v >> 8) as u8 } else { v as u8 };
            return (data: b as u16, wait: 1);
        }
        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let d = data as u8;
            let c = addr[1:0];
            if c == 3 {
                let sel = d[7:6];
                if sel == 3 {
                    return (wait: 1);
                }
                if d[5:4] == 0 {
                    ch[sel].latch = ch[sel].count;
                    ch[sel].latched = true;
                    return (wait: 1);
                }
                ch[sel].access = d[5:4];
                ch[sel].mode = if d[3:2] == 3 { d[3:1] & 3 } else { d[3:1] };
                ch[sel].counting = false;
                ch[sel].low_written = false;
                ch[sel].read_high = false;
                ch[sel].latched = false;
                // OUT starts low in mode 0, high in the others.
                set_out(sel, ch[sel].mode != 0);
                return (wait: 1);
            }
            // A count is complete after one byte, or the second of two.
            let full = ch[c].access != 3 || ch[c].low_written;
            if ch[c].access == 1 {
                ch[c].reload = d as u16;
            } else if ch[c].access == 2 {
                ch[c].reload = (d as u16) << 8;
            } else if !ch[c].low_written {
                ch[c].low_byte = d;
                ch[c].low_written = true;
                if ch[c].mode == 0 {
                    ch[c].counting = false;
                }
            } else {
                ch[c].reload = concat(d, ch[c].low_byte);
                ch[c].low_written = false;
            }
            if full {
                ch[c].count = ch[c].reload;
                ch[c].counting = ch[c].mode == 0 || ch[c].mode == 2 || ch[c].mode == 3;
                if ch[c].mode == 0 {
                    set_out(c, false);
                }
            }
            return (wait: 1);
        }
        /// Returns the cycles until channel 0's OUT next changes: nothing
        /// else here is visible without a bus access, which catches the
        /// timer up first.
        on tick(n: u32) -> u32 {
            for c in 0..3 {
                if ch[c].counting && (c != 2 || gate2) {
                    let period: u32 = if ch[c].reload == 0 { 0x10000 } else { ch[c].reload as u32 };
                    let left: u32 = if ch[c].count == 0 { 0x10000 } else { ch[c].count as u32 };
                    if n < left {
                        ch[c].count = (left - n) as u16;
                    } else if ch[c].mode == 0 {
                        ch[c].count = ((left + 0x10000 - n % 0x10000) % 0x10000) as u16;
                        if !ch[c].out {
                            set_out(c, true);
                        }
                    } else {
                        ch[c].count = (period - (n - left) % period) as u16;
                        // OUT pulses low as the count reloads: one edge.
                        set_out(c, false);
                        set_out(c, true);
                        // Each of channel 1's pulses toggles the refresh
                        // flip-flop.
                        if c == 1 && ((n - left) / period) % 2 == 0 {
                            refresh = !refresh;
                        }
                    }
                }
            }
            if !ch[0].counting || (ch[0].mode == 0 && ch[0].out) {
                return 0xFFFFFFFF;
            }
            return if ch[0].count == 0 { 0x10000 } else { ch[0].count as u32 };
        }
    }
}

/// One 8237 channel.
bundle DmaChannel {
    base_addr: u16,
    base_count: u16,
    addr: u16,
    count: u16,
    /// bits 0-1 channel, 2-3 transfer (1 write to memory, 2 read from
    /// memory), 4 autoinitialise, 5 address decrement, 6-7 mode
    mode: u8,
    masked: bool,
    /// Terminal count reached since the status register was last read.
    tc: bool,
    /// The address bits above 16, from the page register.
    page: u8,
}

/// The 8237 DMA controller with the AT's page registers. Registers 0-7
/// are each channel's address and count (low then high byte, through the
/// flip-flop), 8 status (read; clears the TC bits) and command (write), 10
/// a single mask bit, 11 the mode, 12 clears the flip-flop, 13 is a master
/// clear, 14 clears every mask and 15 writes them all. The page registers
/// at 81-87 give each channel's address bits 16-23. A channel transfers
/// while it is unmasked and its device holds DREQ, single-cycle mode, about
/// one byte per four DMA clocks; at terminal count it masks itself unless
/// it autoinitialises.
component Dma8237 {
    ports {
        bus regs: IsaBus::Slave;
        bus pages: IsaBus::Slave;
        bus dma: IsaBus::Master;
        /// Strapped on the AT's second controller (channels 4-7, at C0h-DFh):
        /// its registers are at even addresses (A0 isn't connected). Its
        /// 16-bit transfers aren't modelled yet (the ISA bus here has the
        /// four 8-bit request lines): it is programmed but moves nothing.
        in word: bool;
    }
    model {
        state ch: [DmaChannel; 4];
        state command: u8 = 0;
        state flip: bool = false;
        /// The page registers no channel uses.
        state spare: [u8; 8];

        on reset { master_clear(); }

        fn master_clear() {
            for c in 0..4 {
                ch[c].masked = true;
                ch[c].tc = false;
            }
            command = 0;
            flip = false;
        }

        /// One fly-by transfer on channel `c`, then the address and count step.
        fn transfer(c: u2) {
            let a = concat(ch[c].page, ch[c].addr);
            let kind = ch[c].mode[3:2];
            // T/C with the block's last transfer.
            let tc = ch[c].count == 0;
            if kind == 1 {
                let b = dma.dack_read(channel: c, tc: tc).data;
                dma.write(space: Space::Mem, addr: a, size: BusSize::Byte, data: b as u16);
            } else if kind == 2 {
                let b = dma.read(space: Space::Mem, addr: a, size: BusSize::Byte).data as u8;
                dma.dack_write(channel: c, data: b, tc: tc);
            }
            ch[c].addr = if ch[c].mode[5] == 1 { ch[c].addr - 1 } else { ch[c].addr + 1 };
            // Terminal count is the count rolling over from 0 to FFFF.
            let last = ch[c].count == 0;
            ch[c].count = ch[c].count - 1;
            if last {
                ch[c].tc = true;
                if ch[c].mode[4] == 1 {
                    ch[c].addr = ch[c].base_addr;
                    ch[c].count = ch[c].base_count;
                } else {
                    ch[c].masked = true;
                }
            }
        }

        /// Returns four clocks (one transfer) while a channel is active,
        /// else never: a rising DREQ wakes the controller, through the
        /// handler below, and programming it is a bus access.
        on tick(n: u32) -> u32 {
            if word { return 0xFFFFFFFF; }
            if command[2] == 1 {
                return 0xFFFFFFFF;
            }
            let mut budget: u32 = n / 4;
            for c in 0..4 {
                while budget > 0 && !ch[c].masked && dma.dreq(c) {
                    transfer(c);
                    budget = budget - 1;
                }
            }
            for c in 0..4 {
                if !ch[c].masked && dma.dreq(c) {
                    return 4;
                }
            }
            return 0xFFFFFFFF;
        }

        /// A request edge: nothing to do but be woken.
        on dma.dreq(channel: u2, value: bool) { }

        on regs.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let r = if word { addr[4:1] } else { addr[3:0] };
            if r < 8 {
                let c = r[2:1];
                let v = if r[0] == 0 { ch[c].addr } else { ch[c].count };
                let b: u8 = if flip { (v >> 8) as u8 } else { v as u8 };
                flip = !flip;
                return (data: b as u16, wait: 1);
            }
            if r == 8 {
                let mut status: u8 = 0;
                for c in 0..4 {
                    if ch[c].tc {
                        status = status | ((1 as u8) << c);
                        ch[c].tc = false;
                    }
                    if dma.dreq(c) {
                        status = status | ((0x10 as u8) << c);
                    }
                }
                return (data: status as u16, wait: 1);
            }
            return (data: 0xFF, wait: 1);
        }

        on regs.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let d = data as u8;
            let r = if word { addr[4:1] } else { addr[3:0] };
            if r < 8 {
                let c = r[2:1];
                if r[0] == 0 {
                    let v = if flip { concat(d, ch[c].base_addr as u8) } else { (ch[c].base_addr & 0xFF00) | d as u16 };
                    ch[c].base_addr = v;
                    ch[c].addr = v;
                } else {
                    let v = if flip { concat(d, ch[c].base_count as u8) } else { (ch[c].base_count & 0xFF00) | d as u16 };
                    ch[c].base_count = v;
                    ch[c].count = v;
                }
                flip = !flip;
            } else if r == 8 {
                command = d;
            } else if r == 10 {
                ch[d[1:0]].masked = d[2] == 1;
            } else if r == 11 {
                ch[d[1:0]].mode = d;
            } else if r == 12 {
                flip = false;
            } else if r == 13 {
                master_clear();
            } else if r == 14 {
                for c in 0..4 {
                    ch[c].masked = false;
                }
            } else if r == 15 {
                for c in 0..4 {
                    ch[c].masked = d[c] == 1;
                }
            }
            return (wait: 1);
        }

        /// The AT page registers: 87 channel 0, 83 channel 1, 81 channel 2,
        /// 82 channel 3 (89-8F the same for the second controller's 4-7).
        /// They are a 74LS612's sixteen registers, and those no channel uses
        /// read back too (the BIOS tests them all).
        on pages.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let r = addr[2:0];
            spare[r] = data as u8;
            if r == 7 {
                ch[0].page = data as u8;
            } else if r == 3 {
                ch[1].page = data as u8;
            } else if r == 1 {
                ch[2].page = data as u8;
            } else if r == 2 {
                ch[3].page = data as u8;
            }
            return (wait: 1);
        }
        on pages.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let r = addr[2:0];
            let v: u8 = if r == 7 { ch[0].page } else if r == 3 { ch[1].page } else if r == 1 { ch[2].page } else if r == 2 { ch[3].page } else { spare[r] };
            return (data: v as u16, wait: 1);
        }
    }
}

/// A data link to the embedding program over DMA channel 1. Bytes the host
/// pushes are requested on DREQ 1 and written to memory by the DMA
/// controller; when the host expects bytes, the device requests them and
/// collects what the controller reads out of memory.
component HostLink {
    ports {
        bus port: IsaBus::Slave;
        /// IRQ 12, on the slave controller's IR4.
        bus irq: IrqLines::Device;
    }
    model {
        mem inbox: [u8; 256];
        state head: u8 = 0;
        state tail: u8 = 0;
        mem outbox: [u8; 256];
        state out_len: u8 = 0;
        state wanted: u8 = 0;

        fn update_dreq() {
            emit port.dreq(1) = head != tail || wanted != 0;
        }

        /// Host side: queue a byte for the guest.
        fn push(b: u8) {
            inbox[tail] = b;
            tail = tail + 1;
            update_dreq();
        }

        /// Host side: raise or drop the link's interrupt.
        fn interrupt(level: bool) {
            emit irq.request(4) = level;
        }

        /// Host side: ask for `n` bytes from the guest.
        fn expect(n: u8) {
            wanted = n;
            update_dreq();
        }

        on port.dack_read(channel: u2, tc: bool) -> (data: u8, wait: u8) {
            if channel != 1 || head == tail {
                decline;
            }
            let b = inbox[head];
            head = head + 1;
            update_dreq();
            return (data: b, wait: 0);
        }

        on port.dack_write(channel: u2, data: u8, tc: bool) -> (wait: u8) {
            if channel != 1 || wanted == 0 {
                decline;
            }
            outbox[out_len] = data;
            out_len = out_len + 1;
            wanted = wanted - 1;
            update_dreq();
            return (wait: 0);
        }
    }
}

/// The IBM Color Graphics Adapter: 16 KB of video RAM at B8000 (mirrored
/// to BFFFF), an MC6845 CRTC at 3D4/3D5 (its logic in `crtc.machine`; the
/// card keeps the registers and the timing they give), the mode control
/// register at 3D8,
/// colour select at 3D9 and status at 3DA. It counts its 14.318 MHz dot
/// clock; as the beam finishes each scanline of the display area it renders
/// that line into `frame`, 640 dots wide, one colour index (0-15, IRGB)
/// per dot, so low-resolution modes draw every pixel twice. The host reads
/// `frame`, `frame_width`, `frame_height` and the `frames` counter.
///
/// The glyphs come from the card's character ROM (`charrom`, the 8 KB
/// IBM 5788005 the MDA shares, which the host fills as it fills the boot
/// ROM; `fonts/README.md`): its 8x8 fonts at 1000 (thin) and 1800 (thick),
/// eight rows a character, the most significant bit leftmost. A jumper on
/// the card picks the thin one (`thin_font`, a strap on the board).
component Cga {
    ports {
        bus port: IsaBus::Slave;
        /// The font jumper: set for the thin font.
        in thin_font: bool;
    }
    model {
        mem vram: [u8; 0x4000];
        mem charrom: [u8; 8192];
        mem frame: [u8; 163840];
        state frame_width: u32 = 0;
        state frame_height: u32 = 0;
        /// Completed frames.
        state frames: u32 = 0;
        state crtc: [u8; 18];
        state index: u8 = 0;
        /// What the 6845's registers give, derived when one is written.
        state t: Mc6845Frame;
        /// 3D8: bit 0 80-column text, 1 graphics, 2 monochrome, 3 video
        /// enable, 4 640-dot graphics, 5 blink.
        state mode: u8 = 0;
        /// 3D9: bits 0-3 background (or 640-dot foreground), 4 intensity,
        /// 5 palette.
        state color: u8 = 0;
        /// The beam, in dots from the top left of the frame.
        state pos: u32 = 0;
        /// Snow, per character cell of the frame (line * 80 + column): the
        /// frame it fell in (plus one; 0 none) and the character and
        /// attribute the cell showed.
        mem snow_tag: [u16; 20480];
        mem snow_ch: [u8; 20480];
        mem snow_at: [u8; 20480];

        on reset { t = Mc6845Timing(crtc); }

        /// A memory cycle of the CPU's, at the beam's `pos`; its wait
        /// states, in clocks of the bus.
        ///
        /// The CGA's RAM is single-ported, and the card gives the CPU a
        /// slot in its own timing: one character clock (8 dots), then the
        /// next 16-dot boundary after it. The CPU then goes on at its next
        /// clock. On a 4.77 MHz PC that is 3 to 8 CPU cycles, 5.8 on
        /// average, in every mode and at any point in the frame
        /// (reenigne.org, "The CGA wait states"). On the AT the bus
        /// controller's own default wait states follow here rather than
        /// overlapping, as IOCHRDY's would.
        ///
        /// In 80-column text, where the display uses every memory cycle,
        /// the CPU's slot takes the fetch of the character in the next
        /// character clock: that cell shows the byte that was in memory
        /// as its character, and the byte on the bus (written or read) as
        /// its attribute. That is CGA snow, after MartyPC's model; outside
        /// the display area nothing shows.
        fn mem_cycle(a: u32, write: bool, data: u8) -> u8 {
            let slot = ((pos + 8) / 16 + 1) * 16;
            let ld = line_dots();
            if mode[0] == 1 && mode[1] == 0 && mode[3] == 1 && ld != 0 {
                let at = slot + 8;
                let line = at / ld;
                let col = (at % ld) / 8;
                if line < t.shown_lines && line < 256 && col < t.shown_chars && col < 80 {
                    let i = line * 80 + col;
                    snow_tag[i] = ((frames & 0x7FFF) + 1) as u16;
                    snow_ch[i] = vram[a];
                    snow_at[i] = if write { data } else { vram[a] };
                }
            }
            return port.clocks(slot - pos) as u8;
        }

        /// Dots per character: 8 in 80-column text, else 16.
        fn char_dots() -> u32 {
            return if mode[0] == 1 && mode[1] == 0 { 8 } else { 16 };
        }
        fn line_dots() -> u32 { return t.line_chars * char_dots(); }

        /// Draw scanline `line` of the display area into `frame`.
        fn render(line: u32) {
            let ra = line % t.row_lines;
            let row = line / t.row_lines;
            let cd = char_dots();
            let cols = t.shown_chars;
            let base = line * 640;
            for col in 0..80 {
                if (col as u32) < cols && (col as u32 + 1) * cd <= 640 {
                    let ma = Mc6845Address(t, row, col as u32);
                    let x0 = base + col as u32 * cd;
                    if mode[3] == 0 {
                        for d in 0..16 {
                            if (d as u32) < cd { frame[x0 + d as u32] = 0; }
                        }
                    } else if mode[1] == 1 {
                        // Graphics: even scanlines in the first 8 KB, odd in
                        // the second; two bytes per character.
                        let a = ((ma * 2) & 0x1FFF) | ((ra & 1) << 13);
                        let bits = concat(vram[a], vram[a + 1]);
                        for d in 0..16 {
                            let mut c: u8 = 0;
                            if mode[4] == 1 {
                                if bits[15 - d] == 1 { c = color & 15; }
                            } else {
                                let px = d / 2;
                                let v = (bits >> (14 - px * 2)) & 3;
                                c = if v == 0 { color & 15 } else { (v as u8) * 2 + color[5] as u8 + (color[4] as u8) * 8 };
                            }
                            frame[x0 + d as u32] = c;
                        }
                    } else {
                        // Text: a character and its attribute.
                        let a = (ma * 2) & 0x3FFF;
                        let mut ch = vram[a];
                        let mut attr = vram[a + 1];
                        let si = line * 80 + col as u32;
                        if line < 256 && snow_tag[si] == ((frames & 0x7FFF) + 1) as u16 {
                            ch = snow_ch[si];
                            attr = snow_at[si];
                        }
                        let bank: u32 = if thin_font { 0x1000 } else { 0x1800 };
                        let mut glyph = charrom[bank + ch as u32 * 8 + (ra & 7)];
                        let mut fg = attr & 15;
                        let bg = if mode[5] == 1 { (attr >> 4) & 7 } else { attr >> 4 };
                        if mode[5] == 1 && attr[7] == 1 && frames[4] == 1 {
                            fg = bg;
                        }
                        if Mc6845Cursor(t, ma, ra, frames) {
                            glyph = 0xFF;
                            fg = attr & 15;
                        }
                        for d in 0..16 {
                            if (d as u32) < cd {
                                let px = if cd == 16 { d / 2 } else { d };
                                frame[x0 + d as u32] = if glyph[7 - px[2:0]] == 1 { fg } else { bg };
                            }
                        }
                    }
                }
            }
            frame_width = if cols * cd < 640 { cols * cd } else { 640 };
        }

        /// Returns the dots left in the frame: a raster write or a status
        /// read is a bus access and catches the card up first, so drawing a
        /// frame's lines in one go at its end looks the same; the host
        /// calls `catch_up_all` before reading `frame` mid-frame.
        on tick(n: u32) -> u32 {
            let ld = line_dots();
            let total = ld * t.frame_lines;
            if total == 0 {
                return 0xFFFFFFFF;
            }
            let mut left = n;
            while left > 0 {
                let line = pos / ld;
                let end = (line + 1) * ld;
                if pos + left < end {
                    pos = pos + left;
                    left = 0;
                } else {
                    left = left - (end - pos);
                    if line < t.shown_lines && line < 256 {
                        render(line);
                    }
                    pos = end;
                    if pos >= total {
                        pos = 0;
                        frames = frames + 1;
                        frame_height = if t.shown_lines < 256 { t.shown_lines } else { 256 };
                    }
                }
            }
            return total - pos;
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            if space == Space::Mem {
                let a = addr[13:0];
                let w = mem_cycle(a as u32, false, 0);
                if size == BusSize::Word {
                    return (data: concat(vram[(a + 1) & 0x3FFF], vram[a]), wait: w);
                }
                return (data: vram[a] as u16, wait: w);
            }
            let r = addr[3:0];
            if r == 10 {
                // Status: bit 0 outside the display area (the 6845's
                // DISPEN low), bit 3 vertical sync.
                let ld = line_dots();
                let line = if ld == 0 { 0 } else { pos / ld };
                let h = if ld == 0 { 0 } else { pos % ld };
                let o = Mc6845Outputs(t, line, h / char_dots());
                let v: u8 = (if o.display { 0 } else { 1 }) | (if o.vsync { 8 } else { 0 });
                return (data: v as u16, wait: 1);
            }
            if r[2:0] == 5 || r[2:0] == 1 || r[2:0] == 3 || r[2:0] == 7 {
                if r < 8 {
                    let v: u8 = if index >= 12 && index < 18 { crtc[index] } else { 0 };
                    return (data: v as u16, wait: 1);
                }
            }
            return (data: 0xFF, wait: 1);
        }

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            if space == Space::Mem {
                let a = addr[13:0];
                let w = mem_cycle(a as u32, true, data as u8);
                vram[a] = data as u8;
                if size == BusSize::Word {
                    vram[(a + 1) & 0x3FFF] = (data >> 8) as u8;
                }
                return (wait: w);
            }
            let r = addr[3:0];
            let d = data as u8;
            if r < 8 {
                if r[0] == 0 {
                    index = d & 31;
                } else if index < 18 {
                    crtc[index] = d;
                    t = Mc6845Timing(crtc);
                }
            } else if r == 8 {
                mode = d;
            } else if r == 9 {
                color = d;
            }
            return (wait: 1);
        }
    }
}

/// Collects the bytes written to its port (like the Bochs port E9 hack).
component Console {
    ports { bus port: IsaBus::Slave; }
    model {
        mem text: [u8; 256];
        state len: u8 = 0;

        /// Host side: forget what has been printed.
        fn clear() {
            len = 0;
        }

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            text[len] = data as u8;
            len = len + 1;
            return (wait: 0);
        }
    }
}

/// The IBM Enhanced Graphics Adapter with 256 KB: four 64 KB bit planes
/// behind the sequencer, the graphics controller, the attribute controller
/// and a CRTC, at the ISA bus's memory window A0000-BFFFF and ports
/// 3B0-3DF.
///
/// The processor reaches the planes through the graphics controller's
/// window (its Miscellaneous register: A0000 for 128 or 64 KB, B0000 or
/// B8000 for 32 KB). A read loads all four planes' bytes into the latches
/// and returns one plane (read mode 0, the Read Map Select) or the colour
/// compare of the four (read mode 1). A write goes to the planes the
/// sequencer's Map Mask enables: in write mode 0 the byte, rotated, or the
/// Set/Reset colour for the planes Enable Set/Reset names; in write mode 1
/// the latches; in write mode 2 the byte's low four bits as a colour; then
/// combined with the latches (Function Select: replace, AND, OR, XOR) and
/// merged through the Bit Mask. In odd/even mode (the sequencer's Memory
/// Mode bit 2 clear) address bit 0 picks the even or odd plane and the
/// planes see the address with bit 0 clear.
///
/// The CRTC and Input Status 1 answer at 3D4, 3D5 and 3DA, or at 3B4, 3B5
/// and 3BA, as the Miscellaneous Output register's I/O address bit says
/// (set for colour); the other range is left to another card.
///
/// The display: the CRTC counts character clocks of 8 or 9 dots (the
/// sequencer's Clocking Mode), at 14.318 MHz or 16.257 MHz (the
/// Miscellaneous Output register's clock select), halved for 320-dot
/// modes. Each row of characters starts at the start address plus the
/// Offset register's stride; word mode doubles the address, and the
/// compatibility bits put the row scan counter into address bits 13 (CGA)
/// and 14. Text reads the character from plane 0, its attribute from plane
/// 1 and the glyph row from plane 2 (32 bytes a character); 16-colour
/// graphics takes a dot's colour from the four planes; the CGA's 4-colour
/// modes (the shift register's interleave) take two bits from planes 0 and
/// 1, and chain odd/even graphics one bit. A dot's colour goes through the
/// Color Plane Enable mask and the attribute palette to one of the EGA's 64
/// colours (bits 0-5: B, G, R, b, g, r), which is what `frame` holds, 720
/// dots wide. The host reads `frame`, `frame_width`, `frame_height` and the
/// `frames` counter.
///
/// The card carries its BIOS: a 16 KB option ROM (`bios`, which the host
/// fills) answering at C0000-C3FFF, which the system BIOS finds and calls,
/// and which then loads the fonts into plane 2 and sets modes for INT 10h.
/// The four configuration switches (`switches`, a strap) tell it the
/// monitor: Input Status 0 bit 4 reads the switch the Miscellaneous Output
/// register's clock select bits name (bit n of `switches` for clock select
/// n; a switch that is on reads 0).
component Ega {
    ports {
        clock dot14;
        clock dot16;
        bus port: IsaBus::Slave;
        /// The configuration switches, as read: bit n for clock select n.
        in switches: u4;
    }
    model {
        mem planes: [u8; 0x40000];
        mem bios: [u8; 0x4000];
        mem frame: [u8; 252000];
        state frame_width: u32 = 0;
        state frame_height: u32 = 0;
        /// Completed frames.
        state frames: u32 = 0;
        /// The beam, in dots from the top left of the frame.
        state pos: u32 = 0;
        state latch: [u8; 4];

        state misc: u8 = 0;
        state seq_index: u8 = 0;
        state seq: [u8; 5];
        state gc_index: u8 = 0;
        state gc: [u8; 9];
        state crtc_index: u8 = 0;
        state crtc: [u8; 25];
        /// What the CRTC's registers give, derived when one is written
        /// (its logic is in `crtc.machine`).
        state t: EgaCrtcFrame;
        /// The attribute controller: the flip-flop says whether the next
        /// write to 3C0 is an index (false) or data.
        state attr_flip: bool = false;
        state attr_index: u8 = 0;
        state attr: [u8; 20];

        // -- the processor's side --------------------------------------------------

        fn plane(p: u2, off: u32) -> u8 { return planes[((p as u32) << 16) | (off & 0xFFFF)]; }
        fn set_plane(p: u2, off: u32, v: u8) { planes[((p as u32) << 16) | (off & 0xFFFF)] = v; }

        /// The offset of `addr` in the processor's window, or 0x10000 when
        /// the window does not hold it.
        fn window(addr: u24) -> u32 {
            let a = addr as u32;
            let map = (gc[6] >> 2) & 3;
            if map == 0 { return if a >= 0xA0000 && a <= 0xBFFFF { a - 0xA0000 } else { 0x10000 }; }
            if map == 1 { return if a >= 0xA0000 && a <= 0xAFFFF { a - 0xA0000 } else { 0x10000 }; }
            if map == 2 { return if a >= 0xB0000 && a <= 0xB7FFF { a - 0xB0000 } else { 0x10000 }; }
            return if a >= 0xB8000 && a <= 0xBFFFF { a - 0xB8000 } else { 0x10000 };
        }

        fn odd_even() -> bool { return seq[4][2] == 0; }

        fn read_byte(addr: u24) -> u8 {
            let w = window(addr);
            if w > 0xFFFF || misc[1] == 0 { return 0xFF; }
            let off = if odd_even() { w & 0xFFFE } else { w };
            for p in 0..4 { latch[p] = plane(p as u2, off); }
            if gc[5][3] == 1 {
                // Read mode 1: a 1 where every plane that matters matches
                // the colour compare.
                let mut r: u8 = 0xFF;
                for p in 0..4 {
                    if gc[7][p] == 1 {
                        let want: u8 = if gc[2][p] == 1 { 0xFF } else { 0 };
                        r = r & ~(latch[p] ^ want);
                    }
                }
                return r;
            }
            let p = if odd_even() && gc[5][4] == 1 { (gc[4] & 2) | (w as u8 & 1) } else { gc[4] & 3 };
            return latch[p];
        }

        fn write_byte(addr: u24, data: u8) {
            let w = window(addr);
            if w > 0xFFFF || misc[1] == 0 { return; }
            let mut mask = seq[2] & 15;
            let mut off = w;
            if odd_even() {
                mask = mask & (if w[0] == 1 { 0x0A } else { 0x05 });
                off = w & 0xFFFE;
            }
            let rot = gc[3] & 7;
            let rotated = if rot == 0 { data } else { (data >> rot) | (data << (8 - rot)) };
            let mode = gc[5] & 3;
            let func = (gc[3] >> 3) & 3;
            for p in 0..4 {
                if mask[p] == 1 {
                    let mut v: u8 = if mode == 1 {
                        latch[p]
                    } else if mode == 2 {
                        if data[p] == 1 { 0xFF } else { 0 }
                    } else if gc[1][p] == 1 {
                        if gc[0][p] == 1 { 0xFF } else { 0 }
                    } else {
                        rotated
                    };
                    if mode != 1 {
                        if func == 1 { v = v & latch[p]; }
                        if func == 2 { v = v | latch[p]; }
                        if func == 3 { v = v ^ latch[p]; }
                        v = (v & gc[8]) | (latch[p] & ~gc[8]);
                    }
                    set_plane(p as u2, off, v);
                }
            }
        }

        // -- the display ---------------------------------------------------------------

        /// Dots per character clock: 8 or 9, doubled when the dot clock is
        /// halved.
        fn char_dots() -> u32 {
            let d: u32 = if seq[1][0] == 1 { 8 } else { 9 };
            return if seq[1][3] == 1 { d * 2 } else { d };
        }
        fn line_dots() -> u32 { return t.line_chars * char_dots(); }
        fn clock16() -> bool { return ((misc >> 2) & 3) == 1; }

        on reset { t = EgaCrtcTiming(crtc); }

        /// An attribute through the palette (and the plane enable mask).
        fn colour(c: u8) -> u8 { return attr[c & attr[18] & 15] & 0x3F; }

        /// Draw scanline `line` of the display area into `frame`.
        fn render(line: u32) {
            let ra = line % t.row_lines;
            let row = line / t.row_lines;
            let cols = t.shown_chars;
            let cd = char_dots();
            let half = seq[1][3] == 1;
            let base = line * 720;
            let graphics = attr[16][0] == 1;
            for col in 0..90 {
                let c = col as u32;
                if c < cols && (c + 1) * cd <= 720 {
                    let a = EgaCrtcAddress(t, row, c, ra);
                    let x0 = base + c * cd;
                    if !graphics {
                        let ch = plane(0, a);
                        let at = plane(1, a);
                        let font = ((seq[3] & 3) as u32) * 0x4000;
                        let mut glyph = plane(2, font + (ch as u32) * 32 + ra);
                        let mut fg = at & 15;
                        let mut bg = at >> 4;
                        if attr[16][3] == 1 {
                            bg = bg & 7;
                            if at[7] == 1 && frames[4] == 1 { fg = bg; }
                        }
                        if EgaCrtcCursor(t, row, c, ra, frames) {
                            glyph = 0xFF;
                            fg = at & 15;
                        }
                        for d in 0..18 {
                            let dd = d as u32;
                            if dd < cd {
                                let px = if half { dd / 2 } else { dd };
                                let on = if px < 8 {
                                    glyph[7 - (px as u3)] == 1
                                } else {
                                    attr[16][2] == 1 && ch >= 0xC0 && ch <= 0xDF && glyph[0] == 1
                                };
                                frame[x0 + dd] = colour(if on { fg } else { bg });
                            }
                        }
                    } else if gc[5][5] == 1 {
                        // The CGA's 4-colour modes: two bits a dot, the even
                        // byte (plane 0) then the odd one (plane 1).
                        let bytes = concat(plane(0, a), plane(1, a));
                        for d in 0..16 {
                            let dd = d as u32;
                            if dd < cd {
                                let px = if half { dd / 2 } else { dd };
                                let v = (bytes >> (14 - (px & 7) * 2)) & 3;
                                frame[x0 + dd] = colour(v as u8);
                            }
                        }
                    } else if gc[6][1] == 1 {
                        // Chain odd/even graphics: one bit a dot, the even
                        // byte then the odd one.
                        let bytes = concat(plane(0, a), plane(1, a));
                        for d in 0..16 {
                            let dd = d as u32;
                            if dd < cd {
                                let px = if half { dd / 2 } else { dd };
                                frame[x0 + dd] = colour(bytes[15 - (px & 15) as u4] as u8);
                            }
                        }
                    } else {
                        // 16 colours: a bit from each plane.
                        for d in 0..18 {
                            let dd = d as u32;
                            if dd < cd {
                                let px = (if half { dd / 2 } else { dd }) & 7;
                                let b = 7 - (px as u3);
                                let v = (plane(0, a)[b] as u8) | ((plane(1, a)[b] as u8) << 1) | ((plane(2, a)[b] as u8) << 2) | ((plane(3, a)[b] as u8) << 3);
                                frame[x0 + dd] = colour(v);
                            }
                        }
                    }
                }
            }
            frame_width = if cols * cd < 720 { cols * cd } else { 720 };
        }

        /// The beam moves `n` dots; returns the dots left in the frame.
        fn advance(n: u32) -> u32 {
            let ld = line_dots();
            let total = ld * t.frame_lines;
            if total == 0 || seq[0] & 3 != 3 {
                return 0xFFFFFFFF;
            }
            let mut left = n;
            while left > 0 {
                let line = pos / ld;
                let end = (line + 1) * ld;
                if pos + left < end {
                    pos = pos + left;
                    left = 0;
                } else {
                    left = left - (end - pos);
                    if line < t.shown_lines && line < 350 {
                        render(line);
                    }
                    pos = end;
                    if pos >= total {
                        pos = 0;
                        frames = frames + 1;
                        frame_height = if t.shown_lines < 350 { t.shown_lines } else { 350 };
                    }
                }
            }
            return total - pos;
        }

        /// Only the selected dot clock moves the beam. A register write is
        /// a bus access and catches the card up first.
        on tick @ dot14 (n: u32) -> u32 {
            if clock16() { return 0xFFFFFFFF; }
            return advance(n);
        }
        on tick @ dot16 (n: u32) -> u32 {
            if !clock16() { return 0xFFFFFFFF; }
            return advance(n);
        }

        // -- the bus -----------------------------------------------------------------------

        /// Whether the card answers I/O port `r`: 3C0-3CF always, and the
        /// 3Dx or the 3Bx range by the I/O address bit.
        fn io_selected(r: u12) -> bool {
            if r >= 0x3C0 && r <= 0x3CF { return true; }
            if r >= 0x3D0 && r <= 0x3DF { return misc[0] == 1; }
            if r >= 0x3B0 && r <= 0x3BF { return misc[0] == 0; }
            return false;
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            if space == Space::Mem && addr >= 0xC0000 && addr <= 0xC3FFF {
                let a = addr[13:0];
                if size == BusSize::Word {
                    return (data: concat(bios[(a + 1) & 0x3FFF], bios[a]), wait: 1);
                }
                return (data: bios[a] as u16, wait: 1);
            }
            if space == Space::Mem {
                let lo = read_byte(addr);
                if size == BusSize::Word {
                    return (data: concat(read_byte(addr + 1), lo), wait: 1);
                }
                return (data: lo as u16, wait: 1);
            }
            let r = addr[11:0];
            if !io_selected(r) { decline; }
            if r == 0x3C2 {
                // Input Status 0: bit 4 senses the configuration switch the
                // clock select bits name.
                let sw = switches[((misc >> 2) & 3) as u2];
                return (data: (sw as u16) << 4, wait: 1);
            }
            if r == 0x3DA || r == 0x3BA {
                // Input Status 1: bit 0 outside the display area, bit 3
                // vertical retrace, bits 4-5 the diagnostic readback of two
                // of the attribute controller's output bits (chosen by the
                // Color Plane Enable register's bits 4-5: P2 and P0, P5 and
                // P4, P3 and P1); the read resets the attribute flip-flop.
                // The dot under the beam is taken from the last frame drawn,
                // which is exact for a still picture.
                attr_flip = false;
                let ld = line_dots();
                let line = if ld == 0 { 0 } else { pos / ld };
                let h = if ld == 0 { 0 } else { pos % ld };
                let o = EgaCrtcOutputs(t, line, h / char_dots());
                let dot = if o.display && line < 350 && h < 720 { frame[line * 720 + h] } else { 0 };
                let mux = (attr[18] >> 4) & 3;
                let diag: u8 = if mux == 0 { dot[0] as u8 | ((dot[2] as u8) << 1) }
                    else if mux == 1 { dot[4] as u8 | ((dot[5] as u8) << 1) }
                    else if mux == 2 { dot[1] as u8 | ((dot[3] as u8) << 1) }
                    else { 0 };
                let v: u8 = (if o.display { 0 } else { 1 }) | (if o.retrace { 8 } else { 0 }) | (diag << 4);
                return (data: v as u16, wait: 1);
            }
            if (r & 0xF) == 5 && r != 0x3C5 && crtc_index >= 12 && crtc_index <= 15 {
                return (data: crtc[crtc_index] as u16, wait: 1);
            }
            return (data: 0xFF, wait: 1);
        }

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            if space == Space::Mem && addr >= 0xC0000 {
                return (wait: 1);
            }
            if space == Space::Mem {
                write_byte(addr, data as u8);
                if size == BusSize::Word { write_byte(addr + 1, (data >> 8) as u8); }
                return (wait: 1);
            }
            let r = addr[11:0];
            if !io_selected(r) { decline; }
            let d = data as u8;
            if r == 0x3C0 {
                if !attr_flip {
                    attr_index = d & 0x3F;
                } else if (attr_index & 31) < 20 {
                    attr[attr_index & 31] = d;
                }
                attr_flip = !attr_flip;
            } else if r == 0x3C2 {
                misc = d;
            } else if r == 0x3C4 {
                seq_index = d & 7;
            } else if r == 0x3C5 {
                if seq_index < 5 { seq[seq_index] = d; }
            } else if r == 0x3CE {
                gc_index = d & 15;
            } else if r == 0x3CF {
                if gc_index < 9 { gc[gc_index] = d; }
            } else if (r & 0xF) == 4 && r != 0x3C4 {
                crtc_index = d & 31;
            } else if (r & 0xF) == 5 && r != 0x3C5 {
                if crtc_index < 25 {
                    crtc[crtc_index] = d;
                    t = EgaCrtcTiming(crtc);
                }
            }
            return (wait: 1);
        }
    }
}

/// The Hercules Graphics Card: the MDA's monochrome text and a 720x348
/// graphics mode, with 64 KB of video RAM at B0000 in two 32 KB pages, an
/// MC6845 CRTC at 3B4/3B5 (mirrored on the even and odd ports from 3B0;
/// its logic in `crtc.machine`), the Display Mode Control register at 3B8,
/// status at 3BA and the configuration switch at 3BF, on a 16.257 MHz dot
/// clock.
///
/// The configuration switch guards the card's extensions: until bit 0 is
/// set the mode register's graphics bit cannot be set, and until bit 1 is
/// set its page bit cannot, and the second page (B8000-BFFFF) is not
/// answered at all, so a colour card can sit there (the two-monitor PC).
///
/// Text is the MDA's: 80x25 characters of 9x14 dots, the character in the
/// even byte and the attribute in the odd one. The glyphs come from the
/// card's character ROM (`charrom`, which the host fills as it fills the
/// boot ROM), in the MDA's layout (the IBM 5788005; `fonts/README.md`):
/// rows 0-7 of each character in the first 2 KB and rows 8-15 in the next,
/// eight bytes a character in each, the most significant bit leftmost. The
/// ninth dot repeats the eighth for the line-drawing characters C0-DF.
/// Attributes: bit 3 intensity, bit 7 blink (when the mode register
/// enables blinking; else an intense background), foreground 1 underlined
/// (on row 12), 70 reverse video, 00 and 77's background-only forms
/// invisible.
///
/// Graphics: each character clock is 16 dots from two bytes, one bit a dot;
/// a dot row is in one of four 8 KB banks by the 6845's row scan (the
/// card puts its low two bits into address bits 13-14), 90 bytes a row.
///
/// `frame` holds 720 dots a line, each 0 (dark), 1 (normal) or 2 (intense).
/// Status (3BA): bit 0 outside the display area, bit 7 low during vertical
/// sync.
component Hercules {
    ports { bus port: IsaBus::Slave; }
    model {
        mem vram: [u8; 0x10000];
        mem charrom: [u8; 8192];
        mem frame: [u8; 252000];
        state frame_width: u32 = 0;
        state frame_height: u32 = 0;
        /// Completed frames.
        state frames: u32 = 0;
        /// The beam, in dots from the top left of the frame.
        state pos: u32 = 0;
        state crtc: [u8; 18];
        state index: u8 = 0;
        /// What the 6845's registers give, derived when one is written.
        state t: Mc6845Frame;
        /// 3B8: bit 1 graphics, 3 video enable, 5 blink enable, 7 display
        /// the second page.
        state mode: u8 = 0;
        /// 3BF: bit 0 allows graphics, bit 1 allows (and maps) the second
        /// page.
        state config: u8 = 0;

        on reset { t = Mc6845Timing(crtc); }

        fn graphics() -> bool { return mode[1] == 1; }
        fn char_dots() -> u32 { return if graphics() { 16 } else { 9 }; }
        fn line_dots() -> u32 { return t.line_chars * char_dots(); }

        /// The offset of `addr` in video RAM, or 0x10000 when the card does
        /// not answer it.
        fn offset(addr: u24) -> u32 {
            let a = addr as u32;
            if a < 0xB0000 || a > 0xBFFFF { return 0x10000; }
            let o = a - 0xB0000;
            if o >= 0x8000 && config[1] == 0 { return 0x10000; }
            return o;
        }

        /// Draw scanline `line` of the display area into `frame`.
        fn render(line: u32) {
            let ra = line % t.row_lines;
            let row = line / t.row_lines;
            let cd = char_dots();
            let cols = t.shown_chars;
            let page: u32 = if mode[7] == 1 { 0x8000 } else { 0 };
            let base = line * 720;
            for col in 0..90 {
                let c = col as u32;
                if c < cols && (c + 1) * cd <= 720 {
                    let ma = Mc6845Address(t, row, c);
                    let x0 = base + c * cd;
                    if mode[3] == 0 {
                        for d in 0..16 {
                            if (d as u32) < cd { frame[x0 + d as u32] = 0; }
                        }
                    } else if graphics() {
                        let a = page | ((ra & 3) << 13) | ((ma * 2) & 0x1FFF);
                        let bits = concat(vram[a], vram[a + 1]);
                        for d in 0..16 {
                            frame[x0 + d as u32] = bits[15 - d] as u8;
                        }
                    } else {
                        let a = page | ((ma * 2) & 0x7FFF);
                        let ch = vram[a];
                        let at = vram[a + 1];
                        let mut glyph = if ra < 8 { charrom[(ch as u32) * 8 + ra] }
                            else if ra < 16 { charrom[0x800 + (ch as u32) * 8 + (ra - 8)] }
                            else { 0 };
                        let reverse = (at & 0x77) == 0x70;
                        let blinking = mode[5] == 1;
                        let mut fg: u8 = if reverse { 0 } else if at[3] == 1 { 2 } else { 1 };
                        let bg: u8 = if !reverse { 0 } else if at[7] == 1 && !blinking { 2 } else { 1 };
                        if (at & 0x77) == 0 { fg = bg; }
                        if (at & 7) == 1 && ra == 12 { glyph = 0xFF; }
                        if blinking && at[7] == 1 && frames[4] == 1 { fg = bg; }
                        if Mc6845Cursor(t, ma, ra, frames) {
                            glyph = 0xFF;
                            fg = if reverse { 0 } else { 1 };
                        }
                        let ninth = ch >= 0xC0 && ch <= 0xDF && glyph[0] == 1 || glyph == 0xFF && (at & 7) == 1 && ra == 12;
                        for d in 0..9 {
                            let on = if d < 8 { glyph[7 - (d as u3)] == 1 } else { ninth };
                            frame[x0 + d as u32] = if on { fg } else { bg };
                        }
                    }
                }
            }
            frame_width = if cols * cd < 720 { cols * cd } else { 720 };
        }

        /// Returns the dots left in the frame.
        on tick(n: u32) -> u32 {
            let ld = line_dots();
            let total = ld * t.frame_lines;
            if total == 0 {
                return 0xFFFFFFFF;
            }
            let mut left = n;
            while left > 0 {
                let line = pos / ld;
                let end = (line + 1) * ld;
                if pos + left < end {
                    pos = pos + left;
                    left = 0;
                } else {
                    left = left - (end - pos);
                    if line < t.shown_lines && line < 350 {
                        render(line);
                    }
                    pos = end;
                    if pos >= total {
                        pos = 0;
                        frames = frames + 1;
                        frame_height = if t.shown_lines < 350 { t.shown_lines } else { 350 };
                    }
                }
            }
            return total - pos;
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            if space == Space::Mem {
                let o = offset(addr);
                if o > 0xFFFF { decline; }
                if size == BusSize::Word {
                    return (data: concat(vram[(o + 1) & 0xFFFF], vram[o]), wait: 1);
                }
                return (data: vram[o] as u16, wait: 1);
            }
            let r = addr[11:0];
            if r == 0x3BA {
                let ld = line_dots();
                let line = if ld == 0 { 0 } else { pos / ld };
                let h = if ld == 0 { 0 } else { pos % ld };
                let o = Mc6845Outputs(t, line, h / char_dots());
                let v: u8 = (if o.display { 0 } else { 1 }) | (if o.vsync { 0 } else { 0x80 });
                return (data: v as u16, wait: 1);
            }
            if r >= 0x3B0 && r < 0x3B8 && r[0] == 1 && index >= 14 && index < 18 {
                return (data: crtc[index] as u16, wait: 1);
            }
            return (data: 0xFF, wait: 1);
        }

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            if space == Space::Mem {
                let o = offset(addr);
                if o > 0xFFFF { decline; }
                vram[o] = data as u8;
                if size == BusSize::Word { vram[(o + 1) & 0xFFFF] = (data >> 8) as u8; }
                return (wait: 1);
            }
            let r = addr[11:0];
            let d = data as u8;
            if r >= 0x3B0 && r < 0x3B8 {
                if r[0] == 0 {
                    index = d & 31;
                } else if index < 18 {
                    crtc[index] = d;
                    t = Mc6845Timing(crtc);
                }
            } else if r == 0x3B8 {
                let mut allowed: u8 = 0x7F;
                if config[0] == 0 { allowed = allowed & 0xFD; }
                mode = d & (if config[1] == 1 { allowed | 0x80 } else { allowed });
            } else if r == 0x3BF {
                config = d & 3;
            }
            return (wait: 1);
        }
    }
}

/// A diagnostic POST card at I/O port 80h: the BIOS writes a checkpoint
/// there before each test of its power-on self test. It keeps them in
/// order (the first 4096), and reads back the last.
component PostCard {
    ports { bus port: IsaBus::Slave; }
    model {
        mem codes: [u8; 4096];
        state count: u32 = 0;
        state last: u8 = 0;

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            last = data as u8;
            if count < 4096 { codes[count] = last; }
            count = count + 1;
            return (wait: 0);
        }
        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            return (data: last as u16, wait: 0);
        }
    }
}

/// Days in `month` (1-12) of the two-digit `year` (every fourth a leap
/// year, as the MC146818 counts).
unit DaysIn(month: u32, year: u32) -> u32 {
    if month == 2 { return if year % 4 == 0 { 29 } else { 28 }; }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30; }
    return 31;
}

/// The Motorola MC146818 real-time clock and its battery-backed memory, as
/// on the PC/AT: port 70h selects one of its 64 bytes (bit 7 masks NMI on
/// the AT, which isn't modelled), 71h reads or writes it. Bytes 0-9 are the
/// time of day (seconds, alarm seconds, minutes, alarm minutes, hours,
/// alarm hours, day of week, date, month, year), 10-13 the registers A-D,
/// and 14-63 the CMOS memory the BIOS keeps its configuration in (the
/// embedding program fills `cmos` as a battery would have kept it).
///
/// Register A: bit 7 update in progress (read-only), 6-4 the divider (010
/// for the 32.768 kHz crystal: running), 3-0 the periodic rate. B: 7 SET
/// (stops updates), 6 periodic, 5 alarm and 4 update interrupt enables, 2
/// binary (else BCD), 1 24-hour. C (read-only, cleared by reading): 7 IRQF,
/// 6 periodic, 5 alarm, 4 update flags. D: 7 the battery is good.
component Mc146818 {
    ports {
        bus port: IsaBus::Slave;
        /// IRQF drives IRQ 8.
        bus irq: IrqLines::Device;
    }
    model {
        mem cmos: [u8; 64];
        state index: u8 = 0;
        /// 32.768 kHz ticks into the current second.
        state div: u32 = 0;

        fn bcd() -> bool { return cmos[11][2] == 0; }
        fn from(v: u8) -> u32 {
            return if bcd() { ((v >> 4) as u32) * 10 + (v & 15) as u32 } else { v as u32 };
        }
        fn to(v: u32) -> u8 {
            return if bcd() { (((v / 10) << 4) | (v % 10)) as u8 } else { v as u8 };
        }
        fn running() -> bool { return (cmos[10] >> 4) & 7 == 2; }
        /// Ticks of the periodic interrupt, by register A's rate (0: none).
        fn period() -> u32 {
            let r = cmos[10] & 15;
            if r == 0 { return 0; }
            if r <= 2 { return 1 << ((r + 6) as u32); }
            return 1 << ((r - 1) as u32);
        }

        /// IRQ 8 follows IRQF: a flag whose interrupt is enabled.
        fn update_irq() {
            let f = cmos[12] & cmos[11] & 0x70;
            let irqf = f != 0;
            cmos[12] = if irqf { cmos[12] | 0x80 } else { cmos[12] & 0x7F };
            emit irq.request(0) = irqf;
        }

        /// The once-a-second update: the time advances by a second, and
        /// the alarm is checked.
        fn second() {
            let mut s = from(cmos[0]) + 1;
            let mut m = from(cmos[2]);
            let pm = cmos[11][1] == 0 && cmos[4][7] == 1;
            let mut h = from(cmos[4] & 0x7F);
            if cmos[11][1] == 0 {
                // 12-hour: 12 AM is 0.
                h = (if h == 12 { 0 } else { h }) + (if pm { 12 } else { 0 });
            }
            let mut wd = from(cmos[6]);
            let mut d = from(cmos[7]);
            let mut mo = from(cmos[8]);
            let mut y = from(cmos[9]);
            if s >= 60 { s = 0; m = m + 1; }
            if m >= 60 { m = 0; h = h + 1; }
            if h >= 24 {
                h = 0;
                wd = if wd >= 7 { 1 } else { wd + 1 };
                d = d + 1;
                if d > DaysIn(mo, y) {
                    d = 1;
                    mo = mo + 1;
                    if mo > 12 { mo = 1; y = (y + 1) % 100; }
                }
            }
            cmos[0] = to(s);
            cmos[2] = to(m);
            if cmos[11][1] == 1 {
                cmos[4] = to(h);
            } else {
                let h12 = if h % 12 == 0 { 12 } else { h % 12 };
                cmos[4] = to(h12) | (if h >= 12 { 0x80 } else { 0 });
            }
            cmos[6] = to(wd);
            cmos[7] = to(d);
            cmos[8] = to(mo);
            cmos[9] = to(y);
            cmos[12] = cmos[12] | 0x10;
            let alarm = (cmos[1] >= 0xC0 || cmos[1] == cmos[0])
                && (cmos[3] >= 0xC0 || cmos[3] == cmos[2])
                && (cmos[5] >= 0xC0 || cmos[5] == cmos[4]);
            if alarm { cmos[12] = cmos[12] | 0x20; }
        }

        on tick(n: u32) -> u32 {
            if !running() { return 0xFFFFFFFF; }
            let mut left = n;
            while left > 0 {
                let step = if left < 32768 - div { left } else { 32768 - div };
                let p = period();
                if p != 0 && (div + step) / p != div / p {
                    cmos[12] = cmos[12] | 0x40;
                }
                div = div + step;
                left = left - step;
                if div >= 32768 {
                    div = 0;
                    if cmos[11][7] == 0 { second(); }
                }
            }
            update_irq();
            // Woken for the next interrupt it would raise.
            let p = period();
            let mut due: u32 = 0xFFFFFFFF;
            if cmos[11][6] == 1 && p != 0 { due = p - div % p; }
            if cmos[11][5] == 1 || cmos[11][4] == 1 {
                let s = 32768 - div;
                if s < due { due = s; }
            }
            return due;
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            if addr[0] == 0 { return (data: 0xFF, wait: 1); }
            let i = index;
            if i == 10 {
                // Update in progress: 244 us before the update, and the
                // update's own 1984 us after it.
                let uip = running() && cmos[11][7] == 0 && (div >= 32768 - 8 || div < 65);
                return (data: ((cmos[10] & 0x7F) | (if uip { 0x80 } else { 0 })) as u16, wait: 1);
            }
            if i == 12 {
                let v = cmos[12];
                cmos[12] = 0;
                update_irq();
                return (data: v as u16, wait: 1);
            }
            if i == 13 { return (data: 0x80, wait: 1); }
            return (data: cmos[i] as u16, wait: 1);
        }

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let d = data as u8;
            if addr[0] == 0 {
                index = d & 0x3F;
                return (wait: 1);
            }
            let i = index;
            if i == 10 {
                cmos[10] = d & 0x7F;
                if !running() { div = 0; }
            } else if i == 11 {
                // SET stops the update and its interrupt.
                cmos[11] = if d[7] == 1 { d & 0xEF } else { d };
                update_irq();
            } else if i != 12 && i != 13 {
                cmos[i] = d;
            }
            return (wait: 1);
        }
    }
}

/// The PC/AT's keyboard controller, an Intel 8042 running IBM's firmware,
/// as its command set presents it, with the keyboard attached to it. Port
/// 60h is data (to the keyboard, or a command's operand), 64h status
/// (read) and commands (write).
///
/// Status: bit 0 the output buffer is full, 1 the input buffer (always
/// empty here: commands take effect at once), 2 the system flag (the
/// self-test passed, or the command byte's bit 2), 3 the last write was a
/// command, 4 the keylock is off. The command byte: bit 0 IRQ 1 on a full
/// output buffer, 2 the system flag, 4 the keyboard disabled, 6 scan code
/// translation. The output port: bit 0 the processor runs (0 holds it in
/// reset), 1 the A20 gate. The input port is the board's switches
/// (`switches`: bit 7 keylock off, 6 the display switch, 0 colour, 5 the
/// manufacturing jumper off, 4 512 KB on the board).
///
/// The keyboard answers the commands the BIOS sends it (reset: ACK and
/// the passed self-test, AAh; LEDs, typematic rate and the rest: ACK; ID:
/// ACK, ABh, 83h, which translation makes 41h). Its bytes come over the
/// serial line about a millisecond apart, so a byte read lets IRQ 1 fall
/// before the next arrives. Keys pressed by the host (`key`) arrive as
/// set-1 scan codes, as the 8042 delivers them translated. The
/// controller's own answers (its self-test's 55h) are at once.
component Kbc8042 {
    ports {
        bus port: IsaBus::Slave;
        /// A full output buffer, while enabled, drives IRQ 1.
        bus irq: IrqLines::Device;
        in switches: u8;
        /// The output port's A20 gate, and the processor's RESET (the
        /// output port's bit 0 inverted).
        out a20: bool;
        out cpu_reset: bool;
    }
    model {
        state status: u8 = 0x10;
        state command: u8 = 0;
        state outp: u8 = 0xCD;
        state obuf: u8 = 0;
        /// Bytes from the keyboard on their way, and clocks until the
        /// first is in.
        mem queue: [u8; 32];
        state qhead: u8 = 0;
        state qlen: u8 = 0;
        state kdelay: u32 = 0;
        /// A command waiting for its operand at 60h (0: none), and one the
        /// keyboard is waiting for.
        state pending: u8 = 0;
        state kbd_pending: u8 = 0;
        /// Clocks left of a reset pulse (FEh).
        state pulse: u32 = 0;

        on reset {
            status = 0x10;
            command = 0;
            outp = 0xCD;
            qlen = 0;
            pending = 0;
            kbd_pending = 0;
            a20 = false;
            cpu_reset = false;
            pulse = 0;
        }

        /// A pulse on the reset line lasts about 6 us; a keyboard byte
        /// takes about a millisecond (1000 clocks) to come in.
        on tick(n: u32) -> u32 {
            if pulse > 0 {
                pulse = if n >= pulse { 0 } else { pulse - n };
                if pulse == 0 { cpu_reset = outp[0] == 0; }
            }
            if qlen > 0 && status[0] == 0 {
                kdelay = if n >= kdelay { 0 } else { kdelay - n };
                if kdelay == 0 {
                    obuf = queue[qhead];
                    qhead = (qhead + 1) & 31;
                    qlen = qlen - 1;
                    status = status | 1;
                    irq_level();
                    kdelay = 1000;
                }
            }
            let mut due: u32 = 0xFFFFFFFF;
            if pulse > 0 { due = pulse; }
            if qlen > 0 && status[0] == 0 && kdelay < due { due = kdelay; }
            return due;
        }

        fn irq_level() {
            emit irq.request(1) = status[0] == 1 && command[0] == 1;
        }

        /// The controller's own answer, into the output buffer.
        fn put(b: u8) {
            obuf = b;
            status = status | 1;
            irq_level();
        }

        /// A byte from the keyboard, on its way.
        fn send(b: u8) {
            if qlen < 32 {
                if qlen == 0 { kdelay = 1000; }
                queue[(qhead + qlen) & 31] = b;
                qlen = qlen + 1;
            }
        }

        /// The host presses a key: a set-1 scan code.
        fn key(code: u8) {
            if command[4] == 0 { send(code); }
        }

        fn set_output(v: u8) {
            outp = v;
            a20 = v[1] == 1;
            cpu_reset = v[0] == 0;
        }

        /// A byte for the keyboard.
        fn keyboard(b: u8) {
            if kbd_pending != 0 {
                kbd_pending = 0;
                send(0xFA);
                return;
            }
            if b == 0xFF {
                send(0xFA);
                send(0xAA);
            } else if b == 0xEE {
                send(0xEE);
            } else if b == 0xF2 {
                send(0xFA);
                send(0xAB);
                send(if command[6] == 1 { 0x41 } else { 0x83 });
            } else if b == 0xED || b == 0xF3 {
                kbd_pending = b;
                send(0xFA);
            } else {
                send(0xFA);
            }
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            if addr[2] == 1 {
                return (data: status as u16, wait: 1);
            }
            let v = obuf;
            status = status & 0xFE;
            if qlen > 0 && kdelay == 0 { kdelay = 1000; }
            irq_level();
            return (data: v as u16, wait: 1);
        }

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let d = data as u8;
            if addr[2] == 0 {
                status = status & 0xF7;
                let p = pending;
                pending = 0;
                if p == 0x60 {
                    command = d;
                    status = (status & 0xFB) | (d & 4);
                    irq_level();
                } else if p == 0xD1 {
                    set_output(d);
                } else {
                    keyboard(d);
                }
                return (wait: 1);
            }
            status = status | 8;
            if d == 0x20 {
                put(command);
            } else if d == 0x60 || d == 0xD1 {
                pending = d;
            } else if d == 0xAA {
                status = status | 4;
                put(0x55);
            } else if d == 0xAB {
                put(0x00);
            } else if d == 0xAD {
                command = command | 0x10;
            } else if d == 0xAE {
                command = command & 0xEF;
            } else if d == 0xC0 {
                put(switches);
            } else if d == 0xD0 {
                put(outp);
            } else if d == 0xE0 {
                put(0x00);
            } else if d >= 0xF0 {
                // Pulse the output port's low bits that are 0 in the
                // command: FE pulses the processor's reset.
                if d[0] == 0 {
                    cpu_reset = true;
                    pulse = 7;
                }
            }
            return (wait: 1);
        }
    }
}

/// How many bytes a uPD765 command takes, by its first (invalid ones: 1).
unit Upd765CommandBytes(op: u8) -> u8 {
    let o = op & 0x1F;
    if o == 0x03 { return 3; }
    if o == 0x04 || o == 0x07 || o == 0x0A { return 2; }
    if o == 0x08 { return 1; }
    if o == 0x0D { return 6; }
    if o == 0x0F { return 3; }
    if o == 0x02 || o == 0x05 || o == 0x06 || o == 0x09 || o == 0x0C { return 9; }
    return 1;
}

/// The AT's diskette controller: an NEC uPD765 behind the fixed disk and
/// diskette adapter's glue, on DMA channel 2 and IRQ 6, with one drive (A)
/// and the disk in it.
///
/// 3F1h reads 50h: the adapter has no fixed-disk controller (the BIOS
/// looks there before testing one at 1F0h).
/// 3F2h, the digital output register: bits 0-1 select a drive, bit 2 low
/// holds the controller in reset, bit 3 enables its DMA request and
/// interrupt, bits 4-7 turn the motors on. 3F4h, the main status register:
/// bit 7 ready for a byte, 6 the byte goes to the processor, 4 a command
/// is in progress. 3F5h, the data register: a command's bytes in, its
/// result's out. 3F7h: read, bit 7 the disk-change line; written, the data
/// rate (0: 500, 1: 300, 2: 250 kbit/s).
///
/// The disk is `image` with its geometry (`cylinders`, `heads`, `sectors`
/// of 512 bytes a track) and the data rate its media is recorded at
/// (`rate`); `present` when there is one. The drive (an 80-track one) is
/// there with or without a disk: its head stops at track 82, and its
/// track-0 sensor reports where it really is (the BIOS finds 80-track
/// drives that way). Recalibrate gives up after 77 steps, as the 765 does.
/// Sector reads and writes go through DMA a byte at a time until the DMA
/// controller's terminal count, across sectors and (multi-track) heads; a
/// track read at the wrong rate, or a cylinder or sector not on it, fails
/// as the 765 reports it; with no disk a read never ends (no index
/// pulses), until the BIOS gives up and resets the controller. Seeks take
/// a millisecond a track (`on tick` at 1.19 MHz) and then interrupt.
component Fdc765 {
    ports {
        bus port: IsaBus::Slave;
        bus irq: IrqLines::Device;
    }
    model {
        mem image: [u8; 1474560];
        state present: bool = false;
        state cylinders: u32 = 80;
        state heads: u32 = 2;
        state sectors: u32 = 15;
        state rate: u8 = 0;
        state changed: bool = true;

        state dor: u8 = 0;
        state ccr: u8 = 0;
        /// 0 command, 1 execution, 2 result.
        state phase: u8 = 0;
        state cmd: [u8; 9];
        state cmd_n: u8 = 0;
        state res: [u8; 7];
        state res_n: u8 = 0;
        state res_i: u8 = 0;
        /// The controller's present cylinder number, where the head really
        /// is, and the seek under way (clocks left).
        state pcn: u8 = 0;
        state head_pos: u8 = 0;
        state target: u8 = 0;
        state seek_left: u32 = 0;
        /// Interrupts for Sense Interrupt Status: ST0 and PCN.
        state pend_st0: [u8; 4];
        state pend_pcn: [u8; 4];
        state pend_n: u8 = 0;
        /// A transfer: the sector, its byte, writing, the track's head.
        state xr: u8 = 0;
        state xh: u8 = 0;
        state xpos: u32 = 0;
        state xwrite: bool = false;
        state xformat: bool = false;
        state xrecal: bool = false;
        state fmt_bytes: u8 = 0;
        state fmt_left: u8 = 0;
        state fmt_id: [u8; 4];
        state fmt_fill: u8 = 0;

        fn reset_controller() {
            phase = 0;
            cmd_n = 0;
            res_n = 0;
            res_i = 0;
            seek_left = 0;
            pend_n = 0;
            dreq_level(false);
            // After a reset the controller reports a ready change for each
            // of its four drives.
            for d in 0..4 {
                pend_st0[d] = 0xC0 | d as u8;
                pend_pcn[d] = 0;
            }
            pend_n = 4;
            interrupt();
        }

        fn dreq_level(on: bool) {
            emit port.dreq(2) = on && dor[3] == 1;
        }
        fn interrupt() {
            emit irq.request(6) = dor[3] == 1;
        }
        fn quiet() {
            emit irq.request(6) = false;
        }


        /// The drive is selected with its motor on (there is only A).
        fn ready(d: u8) -> bool {
            return d == 0 && (dor & 3) == d && dor[4] == 1;
        }

        /// The cylinder recorded on the track under the head, if the disk
        /// can be read at the selected rate there: a 40-track disk in this
        /// 80-track drive is read double-stepped.
        fn track_cylinder() -> u32 {
            if !present || (ccr & 3) != rate { return 0xFFFF; }
            if cylinders <= 40 {
                return if head_pos % 2 == 0 { (head_pos / 2) as u32 } else { 0xFFFF };
            }
            return if (head_pos as u32) < cylinders { head_pos as u32 } else { 0xFFFF };
        }

        fn result(st0: u8, st1: u8, st2: u8) {
            res[0] = st0;
            res[1] = st1;
            res[2] = st2;
            res[3] = cmd[2];
            res[4] = xh;
            res[5] = xr;
            res[6] = cmd[5];
            res_n = 7;
            res_i = 0;
            phase = 2;
            dreq_level(false);
            interrupt();
        }

        fn st0_of(code: u8) -> u8 {
            return code | (xh << 2) | (cmd[1] & 3);
        }

        /// The offset of the sector with ID (`c`, head `h`, `r`, size `n`)
        /// if it is on the track under the head (else all ones).
        fn sector_offset(c: u8, h: u8, r: u8, n: u8) -> u32 {
            let t = track_cylinder();
            if t == 0xFFFF || t != c as u32 || (h as u32) >= heads
                || r == 0 || (r as u32) > sectors || n != 2 {
                return 0xFFFFFFFF;
            }
            return ((t * heads + h as u32) * sectors + (r as u32 - 1)) * 512;
        }
        /// The transfer's sector: `xr` on head `xh` of the cylinder in
        /// `cmd[2]`.
        fn sector_at() -> u32 { return sector_offset(cmd[2], xh, xr, cmd[5]); }

        /// Read or write data: the transfer starts, or fails at once.
        fn start_transfer(write: bool) {
            xh = (cmd[1] >> 2) & 1;
            xr = cmd[4];
            xpos = 0;
            xwrite = write;
            xformat = false;
            if !ready(cmd[1] & 3) {
                result(st0_of(0x48), 0, 0);
                return;
            }
            if !present {
                // No disk, no index pulses: the command never ends.
                phase = 1;
                return;
            }
            if track_cylinder() == 0xFFFF {
                result(st0_of(0x40), 0x01, 0);
                return;
            }
            if sector_at() == 0xFFFFFFFF {
                let st2: u8 = if track_cylinder() != cmd[2] as u32 { 0x10 } else { 0 };
                result(st0_of(0x40), 0x04, st2);
                return;
            }
            phase = 1;
            dreq_level(true);
        }

        /// The sector is done: on to the next, or the command ends
        /// (past the end of the track without a terminal count, an error).
        fn next_sector(tc: bool) {
            xpos = 0;
            let last = xr == cmd[6];
            if last {
                if (cmd[0] & 0x80) != 0 && xh == 0 && heads > 1 {
                    xh = 1;
                    xr = 1;
                } else {
                    xr = 1;
                    cmd[2] = cmd[2] + 1;
                    if !tc { result(st0_of(0x40), 0x80, 0); return; }
                }
            } else {
                xr = xr + 1;
            }
            if tc { result(st0_of(0), 0, 0); return; }
            if sector_at() == 0xFFFFFFFF { result(st0_of(0x40), 0x04, 0); }
        }

        fn execute() {
            let o = cmd[0] & 0x1F;
            let d = cmd[1] & 3;
            if o == 0x03 {
                phase = 0;
            } else if o == 0x04 {
                let st3: u8 = d | (cmd[1] & 4) | (if ready(d) { 0x20 } else { 0 })
                    | (if d == 0 && head_pos == 0 { 0x10 } else { 0 }) | (if d == 0 { 0x08 } else { 0 });
                res[0] = st3;
                res_n = 1;
                res_i = 0;
                phase = 2;
            } else if o == 0x07 || o == 0x0F {
                target = if o == 0x07 { 0 } else { cmd[2] };
                xh = (cmd[1] >> 2) & 1;
                xrecal = o == 0x07;
                let steps = if xrecal { if head_pos > 77 { 77 } else { head_pos } }
                    else if target > pcn { target - pcn } else { pcn - target };
                seek_left = 1 + (steps as u32) * 1193;
                phase = 0;
            } else if o == 0x08 {
                if pend_n == 0 {
                    res[0] = 0x80;
                    res_n = 1;
                } else {
                    res[0] = pend_st0[0];
                    res[1] = pend_pcn[0];
                    for i in 0..3 {
                        pend_st0[i] = pend_st0[i + 1];
                        pend_pcn[i] = pend_pcn[i + 1];
                    }
                    pend_n = pend_n - 1;
                    res_n = 2;
                }
                res_i = 0;
                phase = 2;
                quiet();
            } else if o == 0x0A {
                xh = (cmd[1] >> 2) & 1;
                xr = 1;
                let c = track_cylinder();
                if !ready(d) {
                    result(st0_of(0x48), 0, 0);
                } else if !present {
                    phase = 1;
                } else if c == 0xFFFF {
                    result(st0_of(0x40), 0x01, 0);
                } else {
                    cmd[2] = c as u8;
                    cmd[5] = 2;
                    result(st0_of(0), 0, 0);
                }
            } else if o == 0x06 || o == 0x0C {
                start_transfer(false);
            } else if o == 0x05 || o == 0x09 {
                start_transfer(true);
            } else if o == 0x0D {
                // Format: four ID bytes a sector come by DMA; the
                // sectors are filled with the given byte.
                xh = (cmd[1] >> 2) & 1;
                if !ready(d) {
                    result(st0_of(0x48), 0, 0);
                } else {
                    xformat = true;
                    fmt_left = cmd[3];
                    fmt_fill = cmd[5];
                    fmt_bytes = 0;
                    phase = 1;
                    dreq_level(true);
                }
            } else {
                res[0] = 0x80;
                res_n = 1;
                res_i = 0;
                phase = 2;
            }
        }

        on tick(n: u32) -> u32 {
            if seek_left == 0 { return 0xFFFFFFFF; }
            seek_left = if n >= seek_left { 0 } else { seek_left - n };
            if seek_left == 0 {
                let d = cmd[1] & 3;
                // Seek end; equipment check when a recalibrate didn't
                // reach track 0 (or there is no drive).
                let mut st0: u8 = 0x20 | (xh << 2) | d;
                if d == 0 {
                    if xrecal {
                        if head_pos > 77 { head_pos = head_pos - 77; st0 = st0 | 0x50; } else { head_pos = 0; }
                        pcn = 0;
                    } else {
                        let moved = (head_pos as i32) + (target as i32) - (pcn as i32);
                        head_pos = if moved < 0 { 0 } else if moved > 82 { 82 } else { moved as u8 };
                        pcn = target;
                    }
                    if present && target != 0xFF { changed = false; }
                } else if xrecal {
                    st0 = st0 | 0x50;
                }
                if pend_n < 4 {
                    pend_st0[pend_n] = st0;
                    pend_pcn[pend_n] = if d == 0 { pcn } else { target };
                    pend_n = pend_n + 1;
                }
                interrupt();
                return 0xFFFFFFFF;
            }
            return seek_left;
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let r = addr[2:0];
            if r == 4 {
                let busy = phase != 0 || cmd_n != 0;
                let v: u8 = if phase == 1 { 0x10 | 0x20 } else if phase == 2 { 0xD0 } else { 0x80 | (if busy { 0x10 } else { 0 }) };
                return (data: v as u16, wait: 1);
            }
            if r == 5 {
                if phase != 2 { return (data: 0xFF, wait: 1); }
                let v = res[res_i];
                if res_i == 0 { quiet(); }
                res_i = res_i + 1;
                if res_i >= res_n { phase = 0; }
                return (data: v as u16, wait: 1);
            }
            if r == 7 { return (data: (if changed { 0x80 } else { 0 }) | 0x7F, wait: 1); }
            // A diskette-only adapter: the BIOS reads 3F1h and, seeing 50h
            // in its top five bits, doesn't look for a fixed disk on it.
            if r == 1 { return (data: 0x50, wait: 1); }
            return (data: 0xFF, wait: 1);
        }

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let d = data as u8;
            let r = addr[2:0];
            if r == 2 {
                let was = dor;
                dor = d;
                if d[2] == 1 && was[2] == 0 { reset_controller(); }
                if d[2] == 0 { phase = 0; cmd_n = 0; quiet(); }
                return (wait: 1);
            }
            if r == 7 { ccr = d & 3; return (wait: 1); }
            if r == 5 && dor[2] == 1 && phase == 0 {
                cmd[cmd_n] = d;
                cmd_n = cmd_n + 1;
                if cmd_n >= Upd765CommandBytes(cmd[0]) {
                    cmd_n = 0;
                    execute();
                }
            }
            return (wait: 1);
        }

        on port.dack_read(channel: u2, tc: bool) -> (data: u8, wait: u8) {
            if channel != 2 || phase != 1 || xwrite || xformat { decline; }
            let b = image[sector_at() + xpos];
            xpos = xpos + 1;
            if tc || xpos == 512 { next_sector(tc); }
            return (data: b, wait: 0);
        }

        on port.dack_write(channel: u2, data: u8, tc: bool) -> (wait: u8) {
            if channel != 2 || phase != 1 || !(xwrite || xformat) { decline; }
            if xformat {
                fmt_id[fmt_bytes] = data;
                fmt_bytes = fmt_bytes + 1;
                if fmt_bytes == 4 {
                    fmt_bytes = 0;
                    xr = fmt_id[2];
                    let at = sector_offset(fmt_id[0], xh, fmt_id[2], fmt_id[3]);
                    if at != 0xFFFFFFFF {
                        for i in 0..512 { image[at + i as u32] = fmt_fill; }
                    }
                    fmt_left = fmt_left - 1;
                    if fmt_left == 0 || tc { result(st0_of(0), 0, 0); }
                }
                return (wait: 0);
            }
            image[sector_at() + xpos] = data;
            xpos = xpos + 1;
            if tc || xpos == 512 { next_sector(tc); }
            return (wait: 0);
        }
    }
}

/// The AT's fixed disk controller, the Western Digital WD1003 on IBM's
/// fixed disk and diskette adapter, with one drive and the disk image in
/// it; IRQ 14.
///
/// 1F0h is the data register, 16 bits wide (the only one: it answers
/// `cs16`); a sector is 256 words. 1F1h reads the error register (01h
/// after a reset or diagnostics: no error; 10h: no such sector; 04h:
/// aborted) and takes the write precompensation; 1F2h the sector count (0
/// means 256), 1F3h the sector, 1F4h-1F5h the cylinder, 1F6h drive and
/// head (bit 4 the drive, 3-0 the head). 1F7h reads the status (80h busy,
/// 40h ready, 10h seek complete, 08h data request, 01h error) and takes a
/// command: 1xh restore, 7xh seek, 2xh read and 3xh write sectors (a
/// request and an interrupt a sector), 4xh verify, 50h format a track,
/// 90h diagnostics, 91h set the drive's parameters. 3F6h: bit 2 resets
/// the controller, bit 1 masks its interrupt.
///
/// The disk is `image`, `cylinders` by `heads` by `sectors` (17 a track)
/// of 512 bytes, when `present`: by default the AT's type 2 drive, 615
/// cylinders and 4 heads (20 MB). A command is busy (80h) for a while
/// before it completes and interrupts (about 250 us, on a 1.19 MHz
/// clock): each sector read, and each sector written once the host has
/// filled the buffer; a write's first data request comes at once. Reading
/// the status or writing a command clears the interrupt.
component Wd1003 {
    ports {
        bus port: IsaBus::Slave;
        bus irq: IrqLines::Device;
    }
    model {
        mem image: [u8; 33554432];
        state present: bool = false;
        state cylinders: u32 = 615;
        state heads: u32 = 4;
        state sectors: u32 = 17;

        state error: u8 = 1;
        state count: u8 = 1;
        state sector: u8 = 1;
        state cyl: u16 = 0;
        state sdh: u8 = 0xA0;
        state status: u8 = 0x50;
        state control: u8 = 0;
        state intrq: bool = false;
        /// The sector in transfer, where in it, and whether the host is
        /// writing it (or formatting).
        mem buf: [u8; 512];
        state pos: u32 = 0;
        state writing: bool = false;
        state formatting: bool = false;
        state left: u32 = 0;
        /// What completes when the busy time is up (0 nothing, 1 a sector
        /// to read, 2 the buffer to write, 3 done: ready and interrupt, 4
        /// verify, 5 the format), and the clocks left.
        state pending: u8 = 0;
        state busy: u32 = 0;

        fn after(what: u8) {
            pending = what;
            busy = 300;
            status = 0x80;
        }

        on tick(n: u32) -> u32 {
            if pending == 0 { return 0xFFFFFFFF; }
            busy = if n >= busy { 0 } else { busy - n };
            if busy > 0 { return busy; }
            let what = pending;
            pending = 0;
            if what == 1 { load(); }
            else if what == 2 { written(); }
            else if what == 3 { status = 0x50; interrupt(); }
            else if what == 4 { verify(); }
            else if what == 5 { written(); }
            return 0xFFFFFFFF;
        }

        fn line() {
            emit irq.request(6) = intrq && control[1] == 0;
        }
        fn interrupt() {
            intrq = true;
            line();
        }
        fn here() -> bool { return present && sdh[4] == 0; }

        /// The offset of the sector addressed by the registers, or all
        /// ones when there is no such sector.
        fn offset() -> u32 {
            let h = (sdh & 15) as u32;
            if !here() || (cyl as u32) >= cylinders || h >= heads || sector == 0 || (sector as u32) > sectors {
                return 0xFFFFFFFF;
            }
            return (((cyl as u32) * heads + h) * sectors + (sector as u32 - 1)) * 512;
        }

        /// On to the next sector: the next number, head, cylinder.
        fn advance() {
            if (sector as u32) < sectors {
                sector = sector + 1;
            } else {
                sector = 1;
                let h = (sdh & 15) + 1;
                if (h as u32) < heads {
                    sdh = (sdh & 0xF0) | h;
                } else {
                    sdh = sdh & 0xF0;
                    cyl = cyl + 1;
                }
            }
            count = count - 1;
        }

        fn fail(code: u8) {
            error = code;
            status = 0x51;
            interrupt();
        }

        /// The next sector into the buffer for the host to read.
        fn load() {
            let o = offset();
            if o == 0xFFFFFFFF { fail(0x10); return; }
            for i in 0..512 { buf[i] = image[o + i as u32]; }
            pos = 0;
            status = 0x58;
            interrupt();
        }

        fn command(c: u8) {
            intrq = false;
            line();
            error = 0;
            writing = false;
            formatting = false;
            let op = c >> 4;
            if c == 0x90 {
                error = 1;
                after(3);
            } else if !here() {
                fail(0x04);
            } else if c == 0x91 {
                after(3);
            } else if op == 1 {
                cyl = 0;
                after(3);
            } else if op == 7 {
                if (cyl as u32) < cylinders { after(3); } else { fail(0x10); }
            } else if op == 2 {
                left = if count == 0 { 256 } else { count as u32 };
                after(1);
            } else if op == 3 {
                left = if count == 0 { 256 } else { count as u32 };
                if offset() == 0xFFFFFFFF { fail(0x10); return; }
                writing = true;
                pos = 0;
                status = 0x58;
            } else if op == 4 {
                after(4);
            } else if c == 0x50 {
                // The interleave table comes as a sector of data first.
                formatting = true;
                pos = 0;
                status = 0x58;
            } else {
                fail(0x04);
            }
        }

        /// Verify: every sector asked for is there.
        fn verify() {
            let n = if count == 0 { 256 } else { count as u32 };
            let mut bad = false;
            for i in 0..256 {
                if (i as u32) < n && !bad {
                    if offset() == 0xFFFFFFFF { bad = true; } else { advance(); }
                }
            }
            if bad { fail(0x10); } else { status = 0x50; interrupt(); }
        }

        /// The host has filled the buffer: it is written (or the track
        /// formatted).
        fn written() {
            if formatting {
                formatting = false;
                let h = (sdh & 15) as u32;
                if !here() || (cyl as u32) >= cylinders || h >= heads { fail(0x10); return; }
                let t = ((cyl as u32) * heads + h) * sectors * 512;
                for i in 0..8704 {
                    if (i as u32) < sectors * 512 { image[t + i as u32] = 0; }
                }
                status = 0x50;
                interrupt();
                return;
            }
            let o = offset();
            if o == 0xFFFFFFFF { writing = false; fail(0x10); return; }
            for i in 0..512 { image[o + i as u32] = buf[i]; }
            advance();
            left = left - 1;
            pos = 0;
            if left == 0 { writing = false; status = 0x50; } else { status = 0x58; }
            interrupt();
        }

        fn data_in() -> u8 {
            if status[3] == 0 || writing || formatting { return 0xFF; }
            let b = buf[pos];
            pos = pos + 1;
            if pos == 512 {
                advance();
                left = left - 1;
                if left == 0 { status = 0x50; } else { after(1); }
            }
            return b;
        }

        fn data_out(b: u8) {
            if status[3] == 0 || !(writing || formatting) { return; }
            buf[pos] = b;
            pos = pos + 1;
            if pos == 512 { after(if formatting { 5 } else { 2 }); }
        }

        on port.cs16(space: Space, addr: u24) -> (cs16_n: bool, wait: u8) {
            if space != Space::Io || addr != 0x1F0 { decline; }
            return (cs16_n: false, wait: 0);
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let r = addr[2:0];
            if addr[9] == 1 { return (data: 0xFF, wait: 1); }
            if r == 0 {
                let lo = data_in();
                if size == BusSize::Word {
                    let hi = data_in();
                    return (data: concat(hi, lo), wait: 0);
                }
                return (data: lo as u16, wait: 0);
            }
            if r == 7 {
                intrq = false;
                line();
                // An absent drive selected: not ready (the BIOS checks
                // that there is no second drive this way).
                return (data: (if here() { status } else { status & 0x81 }) as u16, wait: 1);
            }
            let v = if r == 1 { error } else if r == 2 { count } else if r == 3 { sector }
                else if r == 4 { cyl as u8 } else if r == 5 { (cyl >> 8) as u8 } else { sdh };
            return (data: v as u16, wait: 1);
        }

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let d = data as u8;
            let r = addr[2:0];
            if addr[9] == 1 {
                // 3F6h: reset on the falling edge of bit 2.
                let was = control;
                control = d;
                if was[2] == 1 && d[2] == 0 {
                    error = 1;
                    status = if present { 0x50 } else { 0 };
                    writing = false;
                    formatting = false;
                    intrq = false;
                    pending = 0;
                }
                line();
                return (wait: 1);
            }
            if r == 0 {
                data_out(d);
                if size == BusSize::Word { data_out((data >> 8) as u8); }
            } else if r == 2 { count = d; }
            else if r == 3 { sector = d; }
            else if r == 4 { cyl = (cyl & 0xFF00) | d as u16; }
            else if r == 5 { cyl = (cyl & 0x00FF) | ((d as u16) << 8); }
            else if r == 6 { sdh = d; }
            else if r == 7 { command(d); }
            return (wait: 1);
        }
    }
}
