// The Intel 80286 instruction set architecture, real mode.
//
// This file is the architectural level of the 286: what instructions mean.
// It is checked against the SingleStepTests 80286 hardware vectors (see
// `vectors` at the end): `machine vectors --isa I286 targets/i286/*.machine`.
//
// Coverage so far: the eight ALU operations in all six register/memory/
// immediate forms and the 80-83 immediate group, INC/DEC r16, MOV between
// registers, memory and immediates, the conditional jumps, JMP short/near,
// CALL/RET near, PUSH/POP r16, PUSHF/POPF, INT3/INT n/INTO/IRET, BOUND,
// the string instructions with REP/REPE/REPNE, shifts and rotates, the
// F6/F7 group (TEST, NOT, NEG, MUL, IMUL, DIV, IDIV), TEST, XCHG, CBW/CWD,
// LEA, segment-register moves, far transfers, the FE/FF groups, PUSHA/POPA,
// ENTER/LEAVE, LOOP/JCXZ, XLAT, LAHF/SAHF, the BCD adjusts, I/O, ESC, WAIT,
// the flag instructions, HLT, segment-override, LOCK and repeat prefixes,
// and real-mode interrupt delivery through the IVT. That is every real-mode
// opcode in the SingleStepTests corpus.
//
// Protected mode (entered with LMSW): descriptor tables and the descriptor
// cache, checked segment loads and accesses, privilege levels, call gates
// with the stack switch, interrupt, trap and task gates, task switches,
// IOPL, and the 0F instructions (LGDT, LIDT, SGDT, SIDT, LLDT, SLDT, LTR,
// STR, LMSW, SMSW, CLTS, LAR, LSL, VERR, VERW) and ARPL. Checked against
// the self-checking programs of `simulators/test/i286/protected`.

use alu::{AluOp, ArithFlags, Alu, AluFlags, Parity8};

/// A segment register: the selector and its descriptor cache (base, limit
/// and access rights). Real mode loads only the selector and the base
/// (`selector << 4`).
bundle Segment { selector: u16, base: u24, limit: u16, rights: u8 }

/// A descriptor-table register (GDTR, IDTR).
bundle TableReg { base: u24, limit: u16 }

/// A descriptor as read from a table. For a gate, `limit` is the target
/// offset, `base[15:0]` the target selector and `base[20:16]` the word
/// count. `rights`: P (7), DPL (6:5), S (4), type (3:0).
bundle Descriptor { base: u24, limit: u16, rights: u8 }

/// The execution unit's address work before an instruction's first memory
/// access through a ModRM (SPEC 11.2c), fitted to the SingleStepTests
/// traces: base+index with a displacement takes 4 clocks, any other
/// address 3; a register operand none.
unit EaWork(mode: u2, rm: u3) -> u32 {
    if mode == 3 {
        return 0;
    }
    return if mode != 0 && rm < 4 { 4 } else { 3 };
}

isa I286 {
    space mem: addr u24 -> u8, little_endian;
    space io:  addr u16 -> u8, little_endian;

    register AX: u16 { AL: u8 @ 0; AH: u8 @ 8; }
    register BX: u16 { BL: u8 @ 0; BH: u8 @ 8; }
    register CX: u16 { CL: u8 @ 0; CH: u8 @ 8; }
    register DX: u16 { DL: u8 @ 0; DH: u8 @ 8; }
    register SI: u16;
    register DI: u16;
    register BP: u16;
    register SP: u16;
    register IP: u16;
    /// Internal, not visible to software: set by an instruction after
    /// which the 286 does not take a maskable interrupt (STI from IF clear,
    /// MOV SS, POP SS), cleared at the next boundary.
    register INHIBIT: u1;
    register CS: Segment;
    register DS: Segment;
    register ES: Segment;
    register SS: Segment;
    register FLAGS: u16 {
        CF: u1 @ 0; PF: u1 @ 2; AF: u1 @ 4; ZF: u1 @ 6; SF: u1 @ 7;
        TF: u1 @ 8; IF: u1 @ 9; DF: u1 @ 10; OF: u1 @ 11;
        IOPL: u2 @ 12; NT: u1 @ 14;
        view arith: ArithFlags { cf: CF, pf: PF, af: AF, zf: ZF, sf: SF, of: OF }
    }

    /// The machine status word: protection enable (set by LMSW, cleared
    /// only by reset), monitor and emulate coprocessor, task switched.
    register MSW: u16 { PE: u1 @ 0; MP: u1 @ 1; EM: u1 @ 2; TS: u1 @ 3; }
    register GDTR: TableReg;
    register IDTR: TableReg;
    /// The local descriptor table and the task register: a selector and
    /// the cached descriptor, as for the segment registers.
    register LDTR: Segment;
    register TR: Segment;

    mode Mode : u1 { Real, Protected }

    /// Why memory is touched; protected mode checks rights by it.
    enum Access : u2 { Read, Write, Execute }

    /// A segment-override prefix in effect for the current instruction.
    enum SegOv : u3 { ES = 0, CS = 1, SS = 2, DS = 3, None = 4 }
    latch seg_override: SegOv = SegOv::None;
    /// Bytes of the current instruction fetched so far; the 286 raises #GP
    /// when an instruction (prefixes included) exceeds 10 bytes.
    latch fetched: u8 = 0;
    /// Where the current instruction (its first prefix) starts: a faulting
    /// instruction restarts here, and an unfinished REP iteration repeats
    /// from here.
    latch start_ip: u16 = IP;

    /// A repeat prefix: F2 (REPNE) or F3 (REP/REPE).
    enum Rep : u2 { None = 0, Ne = 1, E = 2 }
    latch rep: Rep = Rep::None;

    fault DE { vector: 0, class: Fault }
    fault BR { vector: 5, class: Fault }
    /// The divider faults with the flags its last internal step left, so a
    /// faulting DIV/IDIV pushes data-dependent flags the description does not
    /// model (the vector runner reports those as undefined-flag leaks).
    fault UD { vector: 6, class: Fault }
    /// A fault while delivering a fault.
    fault DoubleFault { vector: 8, class: Fault, pushes_error_code: true }
    fault InvalidTss(error: u16) { vector: 10, class: Fault, pushes_error_code: true }
    fault NP(error: u16) { vector: 11, class: Fault, pushes_error_code: true }
    fault StackFault(error: u16) { vector: 12, class: Fault, pushes_error_code: true }
    fault GP(error: u16) { vector: 13, class: Fault, pushes_error_code: true }

    // -- addressing ------------------------------------------------------------

    /// Real mode: base plus offset, 24 bits wide. The 286 does not wrap at
    /// 1 MB (A20 is a system-board fact). Every real-mode segment has limit
    /// 0xFFFF: an access that runs past it is #GP(0).
    ///
    /// Protected mode checks the cached descriptor: a null selector, a
    /// write to code or to read-only data, or a read of execute-only code
    /// is #GP(0), and so is an access outside the limit (for expand-down
    /// data, the offsets above it).
    fn translate(seg: Segment, off: u16, size: u8, access: Access) -> u24 {
        let last = (off as u32) + (size as u32) - 1;
        if MSW.PE == 1 {
            if !in_segment(seg, off, size, access) { raise GP(0); }
        } else if last > 0xFFFF {
            raise GP(0);
        }
        return seg.base + (off as u24);
    }

    /// Whether a protected-mode access to `seg` is allowed.
    fn in_segment(seg: Segment, off: u16, size: u8, access: Access) -> bool {
        let r = seg.rights;
        if r == 0 { return false; }
        let code = r[3] == 1;
        if access == Access::Write && (code || r[1] == 0) { return false; }
        if access == Access::Read && code && r[1] == 0 { return false; }
        let last = (off as u32) + (size as u32) - 1;
        if !code && r[2] == 1 {
            // Expand-down: the valid offsets are above the limit.
            return (off as u32) > (seg.limit as u32) && last <= 0xFFFF;
        }
        return last <= (seg.limit as u32);
    }

    /// A stack access: as `translate`, but #SS(0) in protected mode.
    fn translate_stack(off: u16, access: Access) -> u24 {
        if MSW.PE == 1 {
            if !in_segment(SS, off, 2, access) { raise StackFault(0); }
            return SS.base + (off as u24);
        }
        return translate(SS, off, 2, access);
    }

    /// A real-mode segment: the selector and `selector << 4`.
    fn load_segment(sel: u16) -> Segment {
        return Segment { selector: sel, base: (sel as u24) << 4, limit: 0xFFFF, rights: 0x93 };
    }

    /// Processor reset, after the registers clear: execution starts at
    /// F000:FFF0 with the code segment's cached base at FF0000, so the
    /// first fetch is from FFFFF0 at the top of the 16 MB space until the
    /// first far jump reloads CS. FLAGS reads 0002, the MSW FFF0; the IDT
    /// is the real-mode vector table at 0.
    fn reset() {
        CS = Segment { selector: 0xF000, base: 0xFF0000, limit: 0xFFFF, rights: 0x9B };
        DS = load_segment(0);
        ES = load_segment(0);
        SS = load_segment(0);
        IP = 0xFFF0;
        FLAGS = 0x0002;
        MSW = 0xFFF0;
        IDTR = TableReg { base: 0, limit: 0x03FF };
        GDTR = TableReg { base: 0, limit: 0xFFFF };
    }

    fn push16(v: u16) {
        SP = SP - 2;
        mem.write_u16(translate_stack(SP, Access::Write), v);
    }

    fn pop16() -> u16 {
        let v = mem.read_u16(translate_stack(SP, Access::Read));
        SP = SP + 2;
        return v;
    }

    /// FLAGS from a POPF or IRET. Real mode cannot set IOPL or NT; bits 1,
    /// 3 and 5 are fixed. In protected mode IOPL changes only at CPL 0 and
    /// IF only at CPL <= IOPL.
    fn load_flags(v: u16) {
        if MSW.PE == 0 {
            FLAGS = (v & 0x0FD5) | 0x0002;
            return;
        }
        let mut keep: u16 = 0;
        if cpl() != 0 { keep = keep | 0x3000; }
        if (cpl() as u3) > (FLAGS.IOPL as u3) { keep = keep | 0x0200; }
        FLAGS = (((v & 0x7FD5) & ~keep) | (FLAGS & keep)) | 0x0002;
    }

    // -- protection ------------------------------------------------------------

    /// The current privilege level: CS's RPL in protected mode.
    fn cpl() -> u2 {
        return if MSW.PE == 1 { CS.selector[1:0] } else { 0 };
    }

    fn dpl(r: u8) -> u2 { return r[6:5]; }
    fn is_code(r: u8) -> bool { return r[4] == 1 && r[3] == 1; }
    fn is_data(r: u8) -> bool { return r[4] == 1 && r[3] == 0; }
    fn is_conforming(r: u8) -> bool { return is_code(r) && r[2] == 1; }
    fn system_type(r: u8) -> u4 { return if r[4] == 0 { r[3:0] } else { 0 }; }

    /// The error code naming a selector.
    fn sel_error(sel: u16) -> u16 { return sel & 0xFFFC; }

    /// Where `sel`'s descriptor is: in the LDT when its TI bit is set, else
    /// in the GDT. False past the table's limit (or with no LDT).
    fn descriptor_at(sel: u16) -> bool {
        let index = (sel & 0xFFF8) as u32;
        if sel[2] == 1 {
            return LDTR.rights != 0 && index + 7 <= (LDTR.limit as u32);
        }
        return index + 7 <= (GDTR.limit as u32);
    }

    fn descriptor_address(sel: u16) -> u24 {
        let base = if sel[2] == 1 { LDTR.base } else { GDTR.base };
        return base + ((sel & 0xFFF8) as u24);
    }

    fn read_descriptor_at(a: u24) -> Descriptor {
        let w0 = mem.read_u16(a);
        let w1 = mem.read_u16(a + 2);
        let w2 = mem.read_u16(a + 4);
        return Descriptor { base: concat(w2[7:0], w1), limit: w0, rights: w2[15:8] as u8 };
    }

    /// The descriptor `sel` names; #GP(sel) when it is outside its table.
    fn descriptor(sel: u16) -> Descriptor {
        if !descriptor_at(sel) { raise GP(sel_error(sel)); }
        return read_descriptor_at(descriptor_address(sel));
    }

    /// Loading a segment descriptor marks it accessed.
    fn mark_accessed(sel: u16, r: u8) {
        if r[0] == 0 { mem.write_u8(descriptor_address(sel) + 5, r | 1); }
    }

    fn cached(sel: u16, d: Descriptor) -> Segment {
        return Segment { selector: sel, base: d.base, limit: d.limit, rights: d.rights | 1 };
    }

    /// DS or ES: a null selector loads a null segment (any access through
    /// it is #GP); otherwise data or readable code, at a privilege the
    /// selector and CPL may use (conforming code at any), and present.
    fn load_data_segment(sel: u16) -> Segment {
        if MSW.PE == 0 { return load_segment(sel); }
        if (sel & 0xFFFC) == 0 { return Segment { selector: sel, base: 0, limit: 0, rights: 0 }; }
        let d = descriptor(sel);
        let r = d.rights;
        if r[4] == 0 || (r[3] == 1 && r[1] == 0) { raise GP(sel_error(sel)); }
        if !is_conforming(r) && ((dpl(r) as u3) < (cpl() as u3) || (dpl(r) as u3) < (sel[1:0] as u3)) {
            raise GP(sel_error(sel));
        }
        if r[7] == 0 { raise NP(sel_error(sel)); }
        mark_accessed(sel, r);
        return cached(sel, d);
    }

    /// SS: a writable data segment at exactly CPL, present (#SS if not).
    fn load_stack_segment(sel: u16) -> Segment {
        if MSW.PE == 0 { return load_segment(sel); }
        if (sel & 0xFFFC) == 0 { raise GP(0); }
        let d = descriptor(sel);
        let r = d.rights;
        if sel[1:0] != cpl() || dpl(r) != cpl() || !is_data(r) || r[1] == 0 { raise GP(sel_error(sel)); }
        if r[7] == 0 { raise StackFault(sel_error(sel)); }
        mark_accessed(sel, r);
        return cached(sel, d);
    }

    /// A code segment for a transfer to it at privilege `level`; the
    /// caller has checked the privilege. Not present is #NP, and the
    /// target offset must be within the limit.
    fn code_segment(sel: u16, d: Descriptor, level: u2, off: u16) -> Segment {
        if d.rights[7] == 0 { raise NP(sel_error(sel)); }
        if (off as u32) > (d.limit as u32) { raise GP(0); }
        mark_accessed(sel, d.rights);
        return cached((sel & 0xFFFC) | (level as u16), d);
    }

    /// A transfer within a privilege level to `sel`'s code segment
    /// (conforming code at or above CPL keeps CPL).
    fn same_level_code(sel: u16, d: Descriptor, off: u16) -> Segment {
        let r = d.rights;
        if !is_code(r) { raise GP(sel_error(sel)); }
        if is_conforming(r) {
            if (dpl(r) as u3) > (cpl() as u3) { raise GP(sel_error(sel)); }
        } else if (sel[1:0] as u3) > (cpl() as u3) || dpl(r) != cpl() {
            raise GP(sel_error(sel));
        }
        return code_segment(sel, d, cpl(), off);
    }

    /// The far JMP: real mode loads CS; protected mode goes to a code
    /// segment, through a call gate (at the same level), or to a task.
    fn jump_far(sel: u16, off: u16) {
        if MSW.PE == 0 { CS = load_segment(sel); IP = off; return; }
        if (sel & 0xFFFC) == 0 { raise GP(0); }
        let d = descriptor(sel);
        if d.rights[4] == 1 { CS = same_level_code(sel, d, off); IP = off; return; }
        let t = system_type(d.rights);
        if t == 1 || t == 5 { enter_task(sel, d, 0); return; }
        if t != 4 { raise GP(sel_error(sel)); }
        // A call gate: a JMP through it stays at CPL.
        if (dpl(d.rights) as u3) < (cpl() as u3) || (dpl(d.rights) as u3) < (sel[1:0] as u3) { raise GP(sel_error(sel)); }
        if d.rights[7] == 0 { raise NP(sel_error(sel)); }
        let tsel = d.base[15:0];
        if (tsel & 0xFFFC) == 0 { raise GP(0); }
        let td = descriptor(tsel);
        if !is_code(td.rights) { raise GP(sel_error(tsel)); }
        if is_conforming(td.rights) {
            if (dpl(td.rights) as u3) > (cpl() as u3) { raise GP(sel_error(tsel)); }
        } else if dpl(td.rights) != cpl() {
            raise GP(sel_error(tsel));
        }
        CS = code_segment(tsel, td, cpl(), d.limit);
        IP = d.limit;
    }

    /// The far CALL: as the JMP, pushing the return CS:IP; a call gate to
    /// a more privileged nonconforming segment switches to that level's
    /// stack from the TSS and copies the gate's word count of parameters.
    fn call_far(sel: u16, off: u16) {
        if MSW.PE == 0 {
            push16(CS.selector);
            push16(IP);
            CS = load_segment(sel);
            IP = off;
            return;
        }
        if (sel & 0xFFFC) == 0 { raise GP(0); }
        let d = descriptor(sel);
        if d.rights[4] == 1 {
            let cs = same_level_code(sel, d, off);
            push16(CS.selector);
            push16(IP);
            CS = cs;
            IP = off;
            return;
        }
        let t = system_type(d.rights);
        if t == 1 || t == 5 { enter_task(sel, d, 1); return; }
        if t != 4 { raise GP(sel_error(sel)); }
        if (dpl(d.rights) as u3) < (cpl() as u3) || (dpl(d.rights) as u3) < (sel[1:0] as u3) { raise GP(sel_error(sel)); }
        if d.rights[7] == 0 { raise NP(sel_error(sel)); }
        let tsel = d.base[15:0];
        if (tsel & 0xFFFC) == 0 { raise GP(0); }
        let td = descriptor(tsel);
        if !is_code(td.rights) || (dpl(td.rights) as u3) > (cpl() as u3) { raise GP(sel_error(tsel)); }
        let level = dpl(td.rights);
        if !is_conforming(td.rights) && (level as u3) < (cpl() as u3) {
            // Inner level: the new stack, then the old SS:SP, the
            // parameters, and the return address.
            let count = (d.base[20:16]) as u16;
            let old_ss = SS.selector;
            let old_sp = SP;
            let old_base = SS.base;
            let cs = code_segment(tsel, td, level, d.limit);
            stack_for(level);
            push16(old_ss);
            push16(old_sp);
            for i in 0..31 {
                if (i as u16) < count {
                    let k = count - 1 - (i as u16);
                    push16(mem.read_u16(old_base + ((old_sp + k * 2) as u24)));
                }
            }
            push16(CS.selector);
            push16(IP);
            CS = cs;
            IP = d.limit;
            return;
        }
        let cs = code_segment(tsel, td, cpl(), d.limit);
        push16(CS.selector);
        push16(IP);
        CS = cs;
        IP = d.limit;
    }

    /// SS:SP for privilege `level` from the current TSS.
    fn stack_for(level: u2) {
        let at = TR.base + ((level as u24) * 4) + 2;
        let sp = mem.read_u16(at);
        let ss = mem.read_u16(at + 2);
        if (ss & 0xFFFC) == 0 || !descriptor_at(ss) { raise InvalidTss(sel_error(ss)); }
        let d = descriptor(ss);
        if ss[1:0] != level || dpl(d.rights) != level || !is_data(d.rights) || d.rights[1] == 0 { raise InvalidTss(sel_error(ss)); }
        if d.rights[7] == 0 { raise StackFault(sel_error(ss)); }
        mark_accessed(ss, d.rights);
        SS = cached(ss, d);
        SP = sp;
    }

    /// The far RET, releasing `n` more bytes of parameters. To an outer
    /// level it also pops the caller's SS:SP and releases them there, and
    /// nulls the data segments the outer level may not use.
    fn return_far(n: u16) {
        let ip = mem.read_u16(translate_stack(SP, Access::Read));
        let cs = mem.read_u16(translate_stack(SP + 2, Access::Read));
        if MSW.PE == 0 {
            SP = SP + 4 + n;
            IP = ip;
            CS = load_segment(cs);
            return;
        }
        if (cs & 0xFFFC) == 0 { raise GP(0); }
        let d = descriptor(cs);
        let rpl = cs[1:0];
        if !is_code(d.rights) || (rpl as u3) < (cpl() as u3) { raise GP(sel_error(cs)); }
        if is_conforming(d.rights) {
            if (dpl(d.rights) as u3) > (rpl as u3) { raise GP(sel_error(cs)); }
        } else if dpl(d.rights) != rpl {
            raise GP(sel_error(cs));
        }
        if rpl == cpl() {
            CS = code_segment(cs, d, rpl, ip);
            SP = SP + 4 + n;
            IP = ip;
            return;
        }
        let sp = mem.read_u16(translate_stack(SP + 4 + n, Access::Read));
        let ss = mem.read_u16(translate_stack(SP + 6 + n, Access::Read));
        CS = code_segment(cs, d, rpl, ip);
        IP = ip;
        SS = load_stack_segment(ss);
        SP = sp + n;
        leave_outward();
    }

    /// After a return to an outer level: DS and ES are nulled when the new
    /// CPL may not use them.
    fn leave_outward() {
        DS = outward(DS);
        ES = outward(ES);
    }

    fn outward(s: Segment) -> Segment {
        let r = s.rights;
        if r == 0 || is_conforming(r) { return s; }
        if (dpl(r) as u3) < (cpl() as u3) { return Segment { selector: 0, base: 0, limit: 0, rights: 0 }; }
        return s;
    }

    /// IRET: real mode pops IP, CS and FLAGS; protected mode returns from a
    /// nested task when NT is set, else as a far RET that also restores
    /// FLAGS.
    fn interrupt_return() {
        if MSW.PE == 1 && FLAGS.NT == 1 {
            let back = mem.read_u16(TR.base);
            if (back & 0xFFFC) == 0 || back[2] == 1 { raise InvalidTss(sel_error(back)); }
            let d = descriptor(back);
            if system_type(d.rights) != 3 { raise InvalidTss(sel_error(back)); }
            enter_task(back, d, 2);
            return;
        }
        let ip = mem.read_u16(translate_stack(SP, Access::Read));
        let cs = mem.read_u16(translate_stack(SP + 2, Access::Read));
        let fl = mem.read_u16(translate_stack(SP + 4, Access::Read));
        if MSW.PE == 0 {
            SP = SP + 6;
            IP = ip;
            CS = load_segment(cs);
            load_flags(fl);
            return;
        }
        if (cs & 0xFFFC) == 0 { raise GP(0); }
        let d = descriptor(cs);
        let rpl = cs[1:0];
        if !is_code(d.rights) || (rpl as u3) < (cpl() as u3) { raise GP(sel_error(cs)); }
        if is_conforming(d.rights) {
            if (dpl(d.rights) as u3) > (rpl as u3) { raise GP(sel_error(cs)); }
        } else if dpl(d.rights) != rpl {
            raise GP(sel_error(cs));
        }
        // FLAGS are restored under the old CPL's rules.
        load_flags(fl);
        if rpl == cpl() {
            CS = code_segment(cs, d, rpl, ip);
            SP = SP + 6;
            IP = ip;
            return;
        }
        let sp = mem.read_u16(translate_stack(SP + 6, Access::Read));
        let ss = mem.read_u16(translate_stack(SP + 8, Access::Read));
        CS = code_segment(cs, d, rpl, ip);
        IP = ip;
        SS = load_stack_segment(ss);
        SP = sp;
        leave_outward();
    }

    // -- interrupts and tasks ----------------------------------------------------

    /// The fault hook: delivery of a fault (`restart` puts IP back at the
    /// instruction), with its error code in protected mode. Real mode
    /// pushes none. Nothing else is undone: the 286 keeps registers an
    /// instruction changed before it faulted.
    fn deliver(vector: u8, restart: bool, has_error: bool, error: u16) {
        if restart { IP = start_ip; }
        interrupt(vector, false, has_error, error);
    }

    /// Delivering interrupt `vector`. Real mode: FLAGS, CS and IP through
    /// the vector table at IDTR's base. Protected mode: through the IDT's
    /// gate: an interrupt or trap gate to a code segment (to an inner
    /// level on that level's stack, with the old SS:SP pushed first) or a
    /// task gate. A software INT needs the gate's DPL at or above CPL.
    fn interrupt(vector: u8, soft: bool, has_error: bool, error: u16) {
        if MSW.PE == 0 {
            push16(FLAGS);
            push16(CS.selector);
            push16(IP);
            FLAGS.IF = 0;
            FLAGS.TF = 0;
            let entry = IDTR.base + (vector as u24) * 4;
            IP = mem.read_u16(entry);
            CS = load_segment(mem.read_u16(entry + 2));
            return;
        }
        let at = (vector as u16) * 8;
        let gate_error = at + 2;
        if (at as u32) + 7 > (IDTR.limit as u32) { raise GP(gate_error); }
        let g = read_descriptor_at(IDTR.base + (at as u24));
        let t = system_type(g.rights);
        if g.rights[4] == 1 || (t != 5 && t != 6 && t != 7) { raise GP(gate_error); }
        if soft && (dpl(g.rights) as u3) < (cpl() as u3) { raise GP(gate_error); }
        if g.rights[7] == 0 { raise NP(gate_error); }
        let tsel = g.base[15:0];
        if t == 5 {
            if (tsel & 0xFFFC) == 0 || tsel[2] == 1 { raise InvalidTss(sel_error(tsel)); }
            let td = descriptor(tsel);
            enter_task(tsel, td, 1);
            if has_error { push16(error); }
            return;
        }
        if (tsel & 0xFFFC) == 0 { raise GP(0); }
        let td = descriptor(tsel);
        if !is_code(td.rights) || (dpl(td.rights) as u3) > (cpl() as u3) { raise GP(sel_error(tsel)); }
        let level = if is_conforming(td.rights) { cpl() } else { dpl(td.rights) };
        let fl = FLAGS;
        let old_cs = CS.selector;
        let old_ip = IP;
        let cs = code_segment(tsel, td, level, g.limit);
        if (level as u3) < (cpl() as u3) {
            let old_ss = SS.selector;
            let old_sp = SP;
            stack_for(level);
            push16(old_ss);
            push16(old_sp);
        }
        push16(fl);
        push16(old_cs);
        push16(old_ip);
        if has_error { push16(error); }
        CS = cs;
        IP = g.limit;
        FLAGS.TF = 0;
        FLAGS.NT = 0;
        if t == 6 { FLAGS.IF = 0; }
    }

    /// A task switch to the TSS `sel` (descriptor `d`, or a task gate to
    /// one) by a JMP (0), a CALL or interrupt (1, nesting: the new task's
    /// back link names the old, and NT is set), or an IRET (2, back to a
    /// busy task). The old task's state is saved into its TSS; the new
    /// one's is loaded, its LDT and segments checked (#TS).
    fn enter_task(sel: u16, d: Descriptor, how: u2) {
        let mut tsel = sel;
        let mut td = d;
        if system_type(d.rights) == 5 {
            // A task gate: its DPL was checked like a call gate's.
            if (dpl(d.rights) as u3) < (cpl() as u3) || (dpl(d.rights) as u3) < (sel[1:0] as u3) { raise GP(sel_error(sel)); }
            if d.rights[7] == 0 { raise NP(sel_error(sel)); }
            tsel = d.base[15:0];
            if (tsel & 0xFFFC) == 0 || tsel[2] == 1 { raise GP(sel_error(tsel)); }
            td = descriptor(tsel);
        } else if how != 2 && ((dpl(d.rights) as u3) < (cpl() as u3) || (dpl(d.rights) as u3) < (sel[1:0] as u3)) {
            raise GP(sel_error(sel));
        }
        let want: u4 = if how == 2 { 3 } else { 1 };
        if system_type(td.rights) != want { raise GP(sel_error(tsel)); }
        if td.rights[7] == 0 { raise NP(sel_error(tsel)); }
        if (td.limit as u32) < 0x2B { raise InvalidTss(sel_error(tsel)); }
        // Save the outgoing task.
        let old = TR;
        let b = old.base;
        let mut fl = FLAGS;
        if how == 2 { fl = fl & 0xBFFF; }
        mem.write_u16(b + 14, IP);
        mem.write_u16(b + 16, fl);
        mem.write_u16(b + 18, AX);
        mem.write_u16(b + 20, CX);
        mem.write_u16(b + 22, DX);
        mem.write_u16(b + 24, BX);
        mem.write_u16(b + 26, SP);
        mem.write_u16(b + 28, BP);
        mem.write_u16(b + 30, SI);
        mem.write_u16(b + 32, DI);
        mem.write_u16(b + 34, ES.selector);
        mem.write_u16(b + 36, CS.selector);
        mem.write_u16(b + 38, SS.selector);
        mem.write_u16(b + 40, DS.selector);
        // A JMP or IRET leaves the old task; a CALL keeps it busy.
        if how != 1 && old.rights != 0 {
            mem.write_u8(descriptor_address(old.selector) + 5, (old.rights & 0xFD));
        }
        // The new task becomes busy.
        let nb = td.base;
        if how != 2 {
            mem.write_u8(descriptor_address(tsel) + 5, td.rights | 0x02);
        }
        if how == 1 { mem.write_u16(nb, old.selector); }
        TR = Segment { selector: tsel, base: nb, limit: td.limit, rights: td.rights | 0x02 };
        MSW.TS = 1;
        IP = mem.read_u16(nb + 14);
        let nfl = mem.read_u16(nb + 16);
        FLAGS = (nfl & 0x7FD5) | 0x0002;
        if how == 1 { FLAGS.NT = 1; }
        AX = mem.read_u16(nb + 18);
        CX = mem.read_u16(nb + 20);
        DX = mem.read_u16(nb + 22);
        BX = mem.read_u16(nb + 24);
        SP = mem.read_u16(nb + 26);
        BP = mem.read_u16(nb + 28);
        SI = mem.read_u16(nb + 30);
        DI = mem.read_u16(nb + 32);
        let es = mem.read_u16(nb + 34);
        let cs = mem.read_u16(nb + 36);
        let ss = mem.read_u16(nb + 38);
        let ds = mem.read_u16(nb + 40);
        let ldt = mem.read_u16(nb + 42);
        // The new task's LDT, then its segments, checked as #TS.
        LDTR = task_ldt(ldt);
        if (cs & 0xFFFC) == 0 || !descriptor_at(cs) { raise InvalidTss(sel_error(cs)); }
        let cd = descriptor(cs);
        if !is_code(cd.rights) { raise InvalidTss(sel_error(cs)); }
        if cd.rights[7] == 0 { raise NP(sel_error(cs)); }
        mark_accessed(cs, cd.rights);
        CS = cached(cs, cd);
        if (ss & 0xFFFC) == 0 || !descriptor_at(ss) { raise InvalidTss(sel_error(ss)); }
        let sd = descriptor(ss);
        if !is_data(sd.rights) || sd.rights[1] == 0 || dpl(sd.rights) != cs[1:0] { raise InvalidTss(sel_error(ss)); }
        if sd.rights[7] == 0 { raise StackFault(sel_error(ss)); }
        mark_accessed(ss, sd.rights);
        SS = cached(ss, sd);
        DS = task_data(ds);
        ES = task_data(es);
    }

    fn task_ldt(sel: u16) -> Segment {
        if (sel & 0xFFFC) == 0 { return Segment { selector: sel, base: 0, limit: 0, rights: 0 }; }
        if sel[2] == 1 || !(((sel & 0xFFF8) as u32) + 7 <= (GDTR.limit as u32)) { raise InvalidTss(sel_error(sel)); }
        let d = read_descriptor_at(GDTR.base + ((sel & 0xFFF8) as u24));
        if system_type(d.rights) != 2 { raise InvalidTss(sel_error(sel)); }
        if d.rights[7] == 0 { raise InvalidTss(sel_error(sel)); }
        return Segment { selector: sel, base: d.base, limit: d.limit, rights: d.rights };
    }

    fn task_data(sel: u16) -> Segment {
        if (sel & 0xFFFC) == 0 { return Segment { selector: sel, base: 0, limit: 0, rights: 0 }; }
        if !descriptor_at(sel) { raise InvalidTss(sel_error(sel)); }
        let d = descriptor(sel);
        let r = d.rights;
        if r[4] == 0 || (r[3] == 1 && r[1] == 0) { raise InvalidTss(sel_error(sel)); }
        if r[7] == 0 { raise NP(sel_error(sel)); }
        mark_accessed(sel, r);
        return cached(sel, d);
    }

    /// I/O and the interrupt flag at CPL <= IOPL only (protected mode).
    fn io_allowed() {
        if MSW.PE == 1 && (cpl() as u3) > (FLAGS.IOPL as u3) { raise GP(0); }
    }

    /// The system instructions: CPL 0 only.
    fn privileged() {
        if MSW.PE == 1 && cpl() != 0 { raise GP(0); }
    }

    /// The descriptor instructions exist only in protected mode.
    fn protected_only() {
        if MSW.PE == 0 { raise UD; }
    }

    fn code_address() -> u24 { return translate(CS, IP, 1, Access::Execute); }
    /// The bytes of code from IP to the end of CS (offset FFFF in real
    /// mode): the bus unit does not prefetch past them.
    fn code_room() -> u32 {
        let limit = if MSW.PE == 1 { CS.limit as u32 } else { 0xFFFF };
        return if (IP as u32) > limit { 0 } else { limit + 1 - (IP as u32) };
    }

    fn next_byte() -> u8 {
        if fetched == 10 { raise GP(0); }
        fetched = fetched + 1;
        let b = mem.read_u8(code_address());
        IP = IP + 1;
        return b;
    }

    istream { space mem; address code_address; next next_byte; undefined UD; fault deliver; boundary take_interrupt; limit code_room; }

    /// The INTR pin, and the two interrupt-acknowledge bus cycles that
    /// fetch the vector from the interrupt controller: the processor model
    /// supplies both.
    extern fn intr() -> bool;
    extern fn acknowledge() -> u8;

    /// At each instruction boundary: a maskable interrupt is taken when
    /// INTR is high and IF is set, except right after an instruction that
    /// inhibits it. Between iterations of a repeated string instruction IP
    /// is back at the prefix, so the interrupt returns there. Taking one
    /// ends HLT.
    fn take_interrupt() -> bool {
        if INHIBIT == 1 {
            INHIBIT = 0;
            return false;
        }
        if FLAGS.IF == 1 && intr() {
            let v = acknowledge();
            interrupt(v, false, false, 0);
            return true;
        }
        return false;
    }

    fn segment(s: SegOv) -> Segment {
        return match s { SegOv::ES => ES, SegOv::CS => CS, SegOv::SS => SS, _ => DS };
    }

    /// ModRM byte; `tail` is the displacement its addressing form carries.
    operand ModRM {
        size 1;
        fields { mod: u2 @ 6; reg: u3 @ 3; rm: u3 @ 0; }
        tail {
            if mod == 1 { Disp8 }
            else if mod == 2 || (mod == 0 && rm == 6) { Disp16 }
        }
    }
    operand Disp8  { size 1; fields { value: i8 @ 0; } }
    operand Disp16 { size 2; fields { value: i16 @ 0; } }
    operand Imm8   { size 1; fields { value: u8 @ 0; } }
    operand Imm16  { size 2; fields { value: u16 @ 0; } }
    /// A direct far pointer: offset, then segment.
    operand FarPtr { size 4; fields { off: u16 @ 0; seg: u16 @ 16; } }
    /// A direct memory offset (A0-A3).
    operand Moffs  { size 2; fields { off: u16 @ 0; } }

    /// Segment and offset of a ModRM memory form. BP-based forms default to
    /// SS, the others to DS; a segment-override prefix replaces either.
    fn effective_address(m: ModRM) -> (seg: Segment, off: u16) {
        let disp: u16 = match m.mod {
            0 => if m.rm == 6 { m.tail.Disp16.value as u16 } else { 0 },
            1 => m.tail.Disp8.value as u16,
            2 => m.tail.Disp16.value as u16,
            _ => unreachable("register form"),
        };
        let (base, seg) = match m.rm {
            0 => (BX + SI, DS), 1 => (BX + DI, DS), 2 => (BP + SI, SS), 3 => (BP + DI, SS),
            4 => (SI, DS),      5 => (DI, DS),      6 => if m.mod == 0 { (0, DS) } else { (BP, SS) },
            7 => (BX, DS),
        };
        let s = if seg_override == SegOv::None { seg } else { segment(seg_override) };
        return (s, base + disp);
    }

    fn ea(m: ModRM, size: u8, access: Access) -> u24 {
        let (s, o) = effective_address(m);
        return translate(s, o, size, access);
    }

    // -- operand kinds ------------------------------------------------------------

    operand_kind r8 : u8 {
        select(n: u3) => match n { 0 => AL, 1 => CL, 2 => DL, 3 => BL, 4 => AH, 5 => CH, 6 => DH, 7 => BH };
    }
    operand_kind r16 : u16 {
        select(n: u3) => match n { 0 => AX, 1 => CX, 2 => DX, 3 => BX, 4 => SP, 5 => BP, 6 => SI, 7 => DI };
    }
    operand_kind rm8 : u8 from m: ModRM {
        is_mem => m.mod != 3;
        ea => EaWork(m.mod, m.rm);
        read => if m.mod == 3 { r8.select(m.rm) } else { mem.read_u8(ea(m, 1, Access::Read)) };
        write(v: u8) => if m.mod == 3 { r8.select(m.rm) = v; } else { mem.write_u8(ea(m, 1, Access::Write), v); };
    }
    operand_kind rm16 : u16 from m: ModRM {
        is_mem => m.mod != 3;
        ea => EaWork(m.mod, m.rm);
        read => if m.mod == 3 { r16.select(m.rm) } else { mem.read_u16(ea(m, 2, Access::Read)) };
        write(v: u16) => if m.mod == 3 { r16.select(m.rm) = v; } else { mem.write_u16(ea(m, 2, Access::Write), v); };
    }
    operand_kind imm8  : u8  from i: Imm8  { read => i.value; }
    operand_kind imm16 : u16 from i: Imm16 { read => i.value; }
    /// An 8-bit immediate sign-extended to 16 bits (83 /x).
    operand_kind simm8 : u16 from i: Disp8 { read => i.value as u16; }
    operand_kind rel8  : u16 from d: Disp8 { read => d.value as u16; }
    operand_kind rel16 : u16 from d: Imm16 { read => d.value; }

    /// The two signed words of a BOUND limit pair, read as two word accesses
    /// (the hardware does not fault on a pair straddling the segment end).
    operand_kind bounds : (lo: i16, hi: i16) from m: ModRM {
        is_mem => m.mod != 3;
        ea => EaWork(m.mod, m.rm);
        read => {
            let (s, o) = effective_address(m);
            let lo = mem.read_u16(translate(s, o, 2, Access::Read)) as i16;
            let hi = mem.read_u16(translate(s, o + 2, 2, Access::Read)) as i16;
            (lo: lo, hi: hi)
        };
    }

    /// An ESC instruction's ModRM as it goes to the coprocessor: the byte,
    /// and for a memory form the operand's selector and offset.
    operand_kind esc_op : (modrm: u8, seg: u16, off: u16) from m: ModRM {
        is_mem => m.mod != 3;
        ea => EaWork(m.mod, m.rm);
        read => {
            let b = concat(m.mod, m.reg, m.rm);
            if m.mod == 3 {
                (modrm: b, seg: 0, off: 0)
            } else {
                // The operand is checked against its segment's limit (a
                // word at FFFF is #GP), though not read.
                let (s, o) = effective_address(m);
                let _ = translate(s, o, 2, Access::Read);
                (modrm: b, seg: s.selector, off: o)
            }
        };
    }

    /// The ModRM itself, for instructions that address a memory operand
    /// of their own shape (LGDT's 6-byte table pointer).
    operand_kind table_ref : ModRM from m: ModRM {
        is_mem => m.mod != 3;
        read => m;
    }

    /// The effective offset of a ModRM memory form (LEA).
    operand_kind mem_offset : u16 from m: ModRM {
        is_mem => m.mod != 3;
        ea => EaWork(m.mod, m.rm);
        read => effective_address(m).off;
    }

    operand_kind far_ptr : (off: u16, seg: u16) from p: FarPtr { read => (off: p.off, seg: p.seg); }
    /// A far pointer in memory (`m16:16`): two word reads, offset first.
    operand_kind far_mem : (off: u16, seg: u16) from m: ModRM {
        is_mem => m.mod != 3;
        ea => EaWork(m.mod, m.rm);
        read => {
            let (s, o) = effective_address(m);
            let off = mem.read_u16(translate(s, o, 2, Access::Read));
            let seg = mem.read_u16(translate(s, o + 2, 2, Access::Read));
            (off: off, seg: seg)
        };
    }
    operand_kind moffs8 : u8 from m: Moffs {
        read => mem.read_u8(translate(src_seg(), m.off, 1, Access::Read));
        write(v: u8) => mem.write_u8(translate(src_seg(), m.off, 1, Access::Write), v);
    }
    operand_kind moffs16 : u16 from m: Moffs {
        read => mem.read_u16(translate(src_seg(), m.off, 2, Access::Read));
        write(v: u16) => mem.write_u16(translate(src_seg(), m.off, 2, Access::Write), v);
    }
    /// The segment register number in ModRM `reg` (8C/8E); 4-7 are #UD.
    operand_kind sreg_n : u3 { value(n: u3) => n; }
    operand_kind bits3 : u3 { value(n: u3) => n; }

    operand_kind alu_op : AluOp { value(n: u3) => n as AluOp; }

    /// Shift and rotate operation, the ModRM `reg` field of C0/C1/D0-D3.
    /// 6 is undocumented and behaves as SHL.
    enum ShiftOp : u3 { Rol, Ror, Rcl, Rcr, Shl, Shr, Sal, Sar }
    operand_kind shift_op : ShiftOp { value(n: u3) => n as ShiftOp; }
    /// F2 is REPNE (z = 0), F3 is REP/REPE (z = 1).
    operand_kind rep_kind : Rep { value(n: u1) => ((n as u2) + 1) as Rep; }
    operand_kind cond : u4 { value(n: u4) => n; }
    operand_kind seg_ov : SegOv { value(n: u2) => (n as u3) as SegOv; }

    // -- shared semantics ----------------------------------------------------------

    fn alu_name(op: AluOp) -> str {
        return match op {
            AluOp::Add => "add", AluOp::Or => "or", AluOp::Adc => "adc", AluOp::Sbb => "sbb",
            AluOp::And => "and", AluOp::Sub => "sub", AluOp::Xor => "xor", AluOp::Cmp => "cmp",
        };
    }

    /// AF is undefined after the logical operations.
    fn is_logic(op: AluOp) -> bool {
        return op == AluOp::Or || op == AluOp::And || op == AluOp::Xor;
    }

    fn alu8(op: AluOp, a: u8, b: u8) -> u8 {
        let (r, raw) = Alu<8>(op, a, b, CF);
        FLAGS.arith = AluFlags<8>(op, a, b, raw);
        return r;
    }

    fn alu16(op: AluOp, a: u16, b: u16) -> u16 {
        let (r, raw) = Alu<16>(op, a, b, CF);
        FLAGS.arith = AluFlags<16>(op, a, b, raw);
        return r;
    }

    /// Jcc condition `c` (opcode bits 3..0): bit 0 negates.
    fn condition(c: u4) -> bool {
        let r = match c >> 1 {
            0 => OF == 1,
            1 => CF == 1,
            2 => ZF == 1,
            3 => CF == 1 || ZF == 1,
            4 => SF == 1,
            5 => PF == 1,
            6 => SF != OF,
            _ => SF != OF || ZF == 1,
        };
        return if c[0] == 1 { !r } else { r };
    }

    fn cond_name(c: u4) -> str {
        return match c {
            0 => "jo", 1 => "jno", 2 => "jb", 3 => "jae", 4 => "je", 5 => "jne", 6 => "jbe", 7 => "ja",
            8 => "js", 9 => "jns", 10 => "jp", 11 => "jnp", 12 => "jl", 13 => "jge", 14 => "jle", _ => "jg",
        };
    }

    // -- prefixes ---------------------------------------------------------------------

    prefix SegOverride {
        encoding { opcode "001ss110" { s: seg_ov } }
        operands (s: seg_ov);
        semantics { seg_override = s; }
    }

    /// LOCK has no architectural effect on a single processor.
    prefix Lock { encoding { opcode 0xF0; } }

    prefix Repeat {
        encoding { opcode "1111001z" { z: rep_kind } }
        operands (z: rep_kind);
        semantics { rep = z; }
    }

    // -- ALU ----------------------------------------------------------------------------

    instruction Alu_rm8_r8 {
        mnemonic alu_name(op);
        encoding { opcode "00ooo000" { o: alu_op }; ModRM { reg: r8 } }
        operands (op: alu_op, dst: rm8, src: r8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_logic(op)]; }
        semantics { let r = alu8(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_rm16_r16 {
        mnemonic alu_name(op);
        encoding { opcode "00ooo001" { o: alu_op }; ModRM { reg: r16 } }
        operands (op: alu_op, dst: rm16, src: r16);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_logic(op)]; }
        semantics { let r = alu16(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_r8_rm8 {
        mnemonic alu_name(op);
        encoding { opcode "00ooo010" { o: alu_op }; ModRM { reg: r8 } }
        operands (op: alu_op, dst: r8, src: rm8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_logic(op)]; }
        semantics { let r = alu8(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_r16_rm16 {
        mnemonic alu_name(op);
        encoding { opcode "00ooo011" { o: alu_op }; ModRM { reg: r16 } }
        operands (op: alu_op, dst: r16, src: rm16);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_logic(op)]; }
        semantics { let r = alu16(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_al_imm8 {
        mnemonic alu_name(op);
        encoding { opcode "00ooo100" { o: alu_op }; Imm8 }
        operands (op: alu_op, src: imm8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_logic(op)]; }
        semantics { let r = alu8(op, AL, src); if op != AluOp::Cmp { AL = r; } }
    }
    instruction Alu_ax_imm16 {
        mnemonic alu_name(op);
        encoding { opcode "00ooo101" { o: alu_op }; Imm16 }
        operands (op: alu_op, src: imm16);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_logic(op)]; }
        semantics { let r = alu16(op, AX, src); if op != AluOp::Cmp { AX = r; } }
    }

    /// 80 and 82 are the same instruction on the 286.
    instruction Alu_rm8_imm8 {
        mnemonic alu_name(op);
        encoding { opcode "100000-0"; ModRM { reg: alu_op } Imm8 }
        operands (op: alu_op, dst: rm8, src: imm8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_logic(op)]; }
        semantics { let r = alu8(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_rm16_imm16 {
        mnemonic alu_name(op);
        encoding { opcode 0x81; ModRM { reg: alu_op } Imm16 }
        operands (op: alu_op, dst: rm16, src: imm16);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_logic(op)]; }
        semantics { let r = alu16(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_rm16_simm8 {
        mnemonic alu_name(op);
        encoding { opcode 0x83; ModRM { reg: alu_op } Disp8 }
        operands (op: alu_op, dst: rm16, src: simm8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_logic(op)]; }
        semantics { let r = alu16(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }

    /// INC and DEC leave CF alone.
    instruction Inc_r16 {
        mnemonic "inc";
        encoding { opcode "01000rrr" { r: r16 } }
        operands (dst: r16);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        semantics { let c = CF; dst = alu16(AluOp::Add, dst, 1); FLAGS.CF = c; }
    }
    instruction Dec_r16 {
        mnemonic "dec";
        encoding { opcode "01001rrr" { r: r16 } }
        operands (dst: r16);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        semantics { let c = CF; dst = alu16(AluOp::Sub, dst, 1); FLAGS.CF = c; }
    }

    // -- MOV -------------------------------------------------------------------------------

    instruction Mov_rm8_r8 {
        mnemonic "mov";
        encoding { opcode 0x88; ModRM { reg: r8 } }
        operands (dst: rm8, src: r8);
        semantics { dst = src; }
    }
    instruction Mov_rm16_r16 {
        mnemonic "mov";
        encoding { opcode 0x89; ModRM { reg: r16 } }
        operands (dst: rm16, src: r16);
        semantics { dst = src; }
    }
    instruction Mov_r8_rm8 {
        mnemonic "mov";
        encoding { opcode 0x8A; ModRM { reg: r8 } }
        operands (dst: r8, src: rm8);
        semantics { dst = src; }
    }
    instruction Mov_r16_rm16 {
        mnemonic "mov";
        encoding { opcode 0x8B; ModRM { reg: r16 } }
        operands (dst: r16, src: rm16);
        semantics { dst = src; }
    }
    instruction Mov_r8_imm8 {
        mnemonic "mov";
        encoding { opcode "10110rrr" { r: r8 }; Imm8 }
        operands (dst: r8, src: imm8);
        semantics { dst = src; }
    }
    instruction Mov_r16_imm16 {
        mnemonic "mov";
        encoding { opcode "10111rrr" { r: r16 }; Imm16 }
        operands (dst: r16, src: imm16);
        semantics { dst = src; }
    }
    instruction Mov_rm8_imm8 {
        mnemonic "mov";
        encoding { opcode 0xC6; ModRM { reg: 0 } Imm8 }
        operands (dst: rm8, src: imm8);
        semantics { dst = src; }
    }
    instruction Mov_rm16_imm16 {
        mnemonic "mov";
        encoding { opcode 0xC7; ModRM { reg: 0 } Imm16 }
        operands (dst: rm16, src: imm16);
        semantics { dst = src; }
    }

    // -- stack ------------------------------------------------------------------------------

    /// The 286 pushes the value SP had before the push, even for `push sp`.
    instruction Push_r16 {
        mnemonic "push";
        encoding { opcode "01010rrr" { r: r16 } }
        operands (src: r16);
        semantics { push16(src); }
    }
    instruction Pop_r16 {
        mnemonic "pop";
        encoding { opcode "01011rrr" { r: r16 } }
        operands (dst: r16);
        semantics { dst = pop16(); }
    }
    instruction Pushf { mnemonic "pushf"; encoding { opcode 0x9C; } semantics { push16(FLAGS); } }
    instruction Popf {
        mnemonic "popf";
        encoding { opcode 0x9D; }
        flags { modifies: [OF, DF, IF, TF, SF, ZF, AF, PF, CF]; }
        semantics { load_flags(pop16()); }
    }

    // -- control flow ------------------------------------------------------------------------

    instruction Call_rel16 {
        mnemonic "call";
        encoding { opcode 0xE8; Imm16 }
        operands (rel: rel16);
        semantics { push16(IP); IP = IP + rel; }
    }
    instruction Ret {
        mnemonic "ret";
        encoding { opcode 0xC3; }
        semantics { IP = pop16(); }
    }
    instruction Ret_imm16 {
        mnemonic "ret";
        encoding { opcode 0xC2; Imm16 }
        operands (n: imm16);
        semantics { IP = pop16(); SP = SP + n; }
    }
    instruction Iret {
        mnemonic "iret";
        encoding { opcode 0xCF; }
        flags { modifies: [OF, DF, IF, TF, SF, ZF, AF, PF, CF]; }
        semantics { interrupt_return(); }
    }
    instruction Int3 { mnemonic "int3"; encoding { opcode 0xCC; } semantics { interrupt(3, true, false, 0); } }
    instruction Int_imm8 {
        mnemonic "int";
        encoding { opcode 0xCD; Imm8 }
        operands (n: imm8);
        semantics { interrupt(n, true, false, 0); }
    }
    instruction Into { mnemonic "into"; encoding { opcode 0xCE; } semantics { if OF == 1 { interrupt(4, true, false, 0); } } }
    /// `bound r16, m16&16`: #BR when the index is outside the signed pair;
    /// the register form is #UD.
    instruction Bound {
        mnemonic "bound";
        encoding { opcode 0x62; ModRM { reg: r16 } }
        operands (idx: r16, lim: bounds);
        semantics {
            if !lim.is_mem { raise UD; }
            let b = lim;
            let i = idx as i16;
            if i < b.lo || i > b.hi { raise BR; }
        }
    }

    instruction Jcc {
        mnemonic cond_name(c);
        encoding { opcode "0111cccc" { c: cond }; Disp8 }
        operands (c: cond, rel: rel8);
        semantics { if condition(c) { IP = IP + rel; } }
    }
    instruction Jmp_rel8 {
        mnemonic "jmp";
        encoding { opcode 0xEB; Disp8 }
        operands (rel: rel8);
        semantics { IP = IP + rel; }
    }
    instruction Jmp_rel16 {
        mnemonic "jmp";
        encoding { opcode 0xE9; Imm16 }
        operands (rel: rel16);
        semantics { IP = IP + rel; }
    }

    // -- shifts and rotates ---------------------------------------------------------------------
    //
    // The 286 masks the count to 5 bits; a zero count changes nothing. One
    // routine serves both widths, on a 32-bit working value.

    fn shift_name(op: ShiftOp) -> str {
        return match op {
            ShiftOp::Rol => "rol", ShiftOp::Ror => "ror", ShiftOp::Rcl => "rcl", ShiftOp::Rcr => "rcr",
            ShiftOp::Shl => "shl", ShiftOp::Shr => "shr", ShiftOp::Sal => "sal", ShiftOp::Sar => "sar",
        };
    }

    fn is_shift(op: ShiftOp) -> bool {
        return op == ShiftOp::Shl || op == ShiftOp::Sal || op == ShiftOp::Shr || op == ShiftOp::Sar;
    }

    /// `v` (the low `w` bits) shifted or rotated by `count`; sets the flags.
    fn shift(op: ShiftOp, v: u16, w: u8, count: u8) -> u16 {
        let n = (count & 0x1F) as u32;
        if n == 0 { return v; }
        let wd = w as u32;
        let mask = (1_u32 << wd) - 1;
        let x = (v as u32) & mask;
        let msb = wd - 1;
        let c = CF as u32;
        let sx = (((x << (32 - wd)) as i32) >> (32 - wd));
        let (r, cf): (u32, u32) = match op {
            ShiftOp::Rol => {
                let k = n % wd;
                let r = ((x << k) | (x >> (wd - k))) & mask;
                (r, r & 1)
            },
            ShiftOp::Ror => {
                let k = n % wd;
                let r = ((x >> k) | (x << (wd - k))) & mask;
                (r, (r >> msb) & 1)
            },
            ShiftOp::Rcl => {
                let k = n % (wd + 1);
                let y = x | (c << wd);
                let wide = (mask << 1) | 1;
                let r = ((y << k) | (y >> (wd + 1 - k))) & wide;
                (r & mask, (r >> wd) & 1)
            },
            ShiftOp::Rcr => {
                let k = n % (wd + 1);
                let y = x | (c << wd);
                let wide = (mask << 1) | 1;
                let r = ((y >> k) | (y << (wd + 1 - k))) & wide;
                (r & mask, (r >> wd) & 1)
            },
            ShiftOp::Shl | ShiftOp::Sal => {
                let t = (x as u64) << n;
                ((t as u32) & mask, ((t >> wd) & 1) as u32)
            },
            ShiftOp::Shr => ((x >> n) & mask, (x >> (n - 1)) & 1),
            ShiftOp::Sar => (((sx >> n) as u32) & mask, ((sx >> (n - 1)) as u32) & 1),
        };
        FLAGS.CF = cf as u1;
        let top = (r >> msb) & 1;
        let next = (r >> (msb - 1)) & 1;
        let of: u32 = match op {
            ShiftOp::Rol | ShiftOp::Rcl | ShiftOp::Shl | ShiftOp::Sal => top ^ cf,
            ShiftOp::Ror | ShiftOp::Rcr => top ^ next,
            ShiftOp::Shr => (x >> msb) & 1,
            ShiftOp::Sar => 0,
        };
        FLAGS.OF = of as u1;
        if is_shift(op) {
            FLAGS.SF = top as u1;
            FLAGS.ZF = (r == 0) as u1;
            FLAGS.PF = Parity8(r as u8);
        }
        return r as u16;
    }

    instruction Shift_rm8_1 {
        mnemonic shift_name(op);
        encoding { opcode 0xD0; ModRM { reg: shift_op } }
        operands (op: shift_op, dst: rm8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_shift(op)]; }
        semantics { dst = shift(op, dst as u16, 8, 1) as u8; }
    }
    instruction Shift_rm16_1 {
        mnemonic shift_name(op);
        encoding { opcode 0xD1; ModRM { reg: shift_op } }
        operands (op: shift_op, dst: rm16);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_shift(op)]; }
        semantics { dst = shift(op, dst, 16, 1); }
    }
    instruction Shift_rm8_cl {
        mnemonic shift_name(op);
        encoding { opcode 0xD2; ModRM { reg: shift_op } }
        operands (op: shift_op, dst: rm8);
        flags {
            modifies: [OF, SF, ZF, AF, PF, CF];
            undefined: [OF if (CL & 0x1F) != 1, AF if is_shift(op) && (CL & 0x1F) != 0, CF if is_shift(op) && (CL & 0x1F) > 8];
        }
        // A count of 0 (mod 32) reads the operand but writes nothing back.
        semantics { let v = shift(op, dst as u16, 8, CL) as u8; if (CL & 0x1F) != 0 { dst = v; } }
    }
    instruction Shift_rm16_cl {
        mnemonic shift_name(op);
        encoding { opcode 0xD3; ModRM { reg: shift_op } }
        operands (op: shift_op, dst: rm16);
        flags {
            modifies: [OF, SF, ZF, AF, PF, CF];
            undefined: [OF if (CL & 0x1F) != 1, AF if is_shift(op) && (CL & 0x1F) != 0, CF if is_shift(op) && (CL & 0x1F) > 16];
        }
        semantics { let v = shift(op, dst, 16, CL); if (CL & 0x1F) != 0 { dst = v; } }
    }
    instruction Shift_rm8_imm8 {
        mnemonic shift_name(op);
        encoding { opcode 0xC0; ModRM { reg: shift_op } Imm8 }
        operands (op: shift_op, dst: rm8, n: imm8);
        flags {
            modifies: [OF, SF, ZF, AF, PF, CF];
            undefined: [OF if (n & 0x1F) != 1, AF if is_shift(op) && (n & 0x1F) != 0, CF if is_shift(op) && (n & 0x1F) > 8];
        }
        semantics { let v = shift(op, dst as u16, 8, n) as u8; if (n & 0x1F) != 0 { dst = v; } }
    }
    instruction Shift_rm16_imm8 {
        mnemonic shift_name(op);
        encoding { opcode 0xC1; ModRM { reg: shift_op } Imm8 }
        operands (op: shift_op, dst: rm16, n: imm8);
        flags {
            modifies: [OF, SF, ZF, AF, PF, CF];
            undefined: [OF if (n & 0x1F) != 1, AF if is_shift(op) && (n & 0x1F) != 0, CF if is_shift(op) && (n & 0x1F) > 16];
        }
        semantics { let v = shift(op, dst, 16, n); if (n & 0x1F) != 0 { dst = v; } }
    }

    // -- TEST, NOT, NEG, MUL, DIV ---------------------------------------------------------------

    instruction Test_rm8_r8 {
        mnemonic "test";
        encoding { opcode 0x84; ModRM { reg: r8 } }
        operands (a: rm8, b: r8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu8(AluOp::And, a, b); }
    }
    instruction Test_rm16_r16 {
        mnemonic "test";
        encoding { opcode 0x85; ModRM { reg: r16 } }
        operands (a: rm16, b: r16);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu16(AluOp::And, a, b); }
    }
    instruction Test_al_imm8 {
        mnemonic "test";
        encoding { opcode 0xA8; Imm8 }
        operands (b: imm8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu8(AluOp::And, AL, b); }
    }
    instruction Test_ax_imm16 {
        mnemonic "test";
        encoding { opcode 0xA9; Imm16 }
        operands (b: imm16);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu16(AluOp::And, AX, b); }
    }
    instruction Test_rm8_imm8 {
        mnemonic "test";
        encoding { opcode 0xF6; ModRM { reg: 0 } Imm8 }
        operands (a: rm8, b: imm8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu8(AluOp::And, a, b); }
    }
    /// F6 /1 is an undocumented alias of F6 /0.
    instruction Test_rm8_imm8_alias {
        mnemonic "test";
        encoding { opcode 0xF6; ModRM { reg: 1 } Imm8 }
        operands (a: rm8, b: imm8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu8(AluOp::And, a, b); }
    }
    instruction Not_rm8 { mnemonic "not"; encoding { opcode 0xF6; ModRM { reg: 2 } } operands (dst: rm8); semantics { dst = ~dst; } }
    instruction Neg_rm8 {
        mnemonic "neg";
        encoding { opcode 0xF6; ModRM { reg: 3 } }
        operands (dst: rm8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        semantics { dst = alu8(AluOp::Sub, 0, dst); }
    }
    instruction Mul_rm8 {
        mnemonic "mul";
        encoding { opcode 0xF6; ModRM { reg: 4 } }
        operands (src: rm8);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics {
            AX = (AL as u16) * (src as u16);
            FLAGS.CF = (AH != 0) as u1;
            FLAGS.OF = (AH != 0) as u1;
        }
    }
    instruction Imul_rm8 {
        mnemonic "imul";
        encoding { opcode 0xF6; ModRM { reg: 5 } }
        operands (src: rm8);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics {
            let p = ((AL as i8) as i16) * ((src as i8) as i16);
            AX = p as u16;
            let wide = p != ((p as i8) as i16);
            FLAGS.CF = wide as u1;
            FLAGS.OF = wide as u1;
        }
    }
    instruction Div_rm8 {
        mnemonic "div";
        encoding { opcode 0xF6; ModRM { reg: 6 } }
        operands (src: rm8);
        flags { undefined: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            let d = src as u16;
            if d == 0 { raise DE; }
            let q = AX / d;
            if q > 0xFF { raise DE; }
            let r = AX % d;
            AL = q as u8;
            AH = r as u8;
        }
    }
    instruction Idiv_rm8 {
        mnemonic "idiv";
        encoding { opcode 0xF6; ModRM { reg: 7 } }
        operands (src: rm8);
        flags { undefined: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            let a = (AX as i16) as i32;
            let d = ((src as i8) as i16) as i32;
            if d == 0 { raise DE; }
            let q = a / d;
            if q > 127 || q < -128 { raise DE; }
            let r = a % d;
            AL = q as u8;
            AH = r as u8;
        }
    }
    instruction Test_rm16_imm16 {
        mnemonic "test";
        encoding { opcode 0xF7; ModRM { reg: 0 } Imm16 }
        operands (a: rm16, b: imm16);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu16(AluOp::And, a, b); }
    }
    /// F7 /1 is an undocumented alias of F7 /0.
    instruction Test_rm16_imm16_alias {
        mnemonic "test";
        encoding { opcode 0xF7; ModRM { reg: 1 } Imm16 }
        operands (a: rm16, b: imm16);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu16(AluOp::And, a, b); }
    }
    instruction Not_rm16 { mnemonic "not"; encoding { opcode 0xF7; ModRM { reg: 2 } } operands (dst: rm16); semantics { dst = ~dst; } }
    instruction Neg_rm16 {
        mnemonic "neg";
        encoding { opcode 0xF7; ModRM { reg: 3 } }
        operands (dst: rm16);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        semantics { dst = alu16(AluOp::Sub, 0, dst); }
    }
    instruction Mul_rm16 {
        mnemonic "mul";
        encoding { opcode 0xF7; ModRM { reg: 4 } }
        operands (src: rm16);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics {
            let p = (AX as u32) * (src as u32);
            AX = p as u16;
            DX = (p >> 16) as u16;
            FLAGS.CF = (DX != 0) as u1;
            FLAGS.OF = (DX != 0) as u1;
        }
    }
    instruction Imul_rm16 {
        mnemonic "imul";
        encoding { opcode 0xF7; ModRM { reg: 5 } }
        operands (src: rm16);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics {
            let p = ((AX as i16) as i32) * ((src as i16) as i32);
            AX = p as u16;
            DX = (p >> 16) as u16;
            let wide = p != ((p as i16) as i32);
            FLAGS.CF = wide as u1;
            FLAGS.OF = wide as u1;
        }
    }
    instruction Div_rm16 {
        mnemonic "div";
        encoding { opcode 0xF7; ModRM { reg: 6 } }
        operands (src: rm16);
        flags { undefined: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            let d = src as u32;
            if d == 0 { raise DE; }
            let n = ((DX as u32) << 16) | (AX as u32);
            let q = n / d;
            if q > 0xFFFF { raise DE; }
            let r = n % d;
            AX = q as u16;
            DX = r as u16;
        }
    }
    instruction Idiv_rm16 {
        mnemonic "idiv";
        encoding { opcode 0xF7; ModRM { reg: 7 } }
        operands (src: rm16);
        flags { undefined: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            let n = ((((DX as u32) << 16) | (AX as u32)) as i32) as i64;
            let d = ((src as i16) as i32) as i64;
            if d == 0 { raise DE; }
            let q = n / d;
            if q > 32767 || q < -32768 { raise DE; }
            let r = n % d;
            AX = q as u16;
            DX = r as u16;
        }
    }

    // -- XCHG, sign extension, LEA ----------------------------------------------------------------

    instruction Xchg_rm8_r8 {
        mnemonic "xchg";
        encoding { opcode 0x86; ModRM { reg: r8 } }
        operands (a: rm8, b: r8);
        semantics { let x = a; let y = b; a = y; b = x; }
    }
    instruction Xchg_rm16_r16 {
        mnemonic "xchg";
        encoding { opcode 0x87; ModRM { reg: r16 } }
        operands (a: rm16, b: r16);
        semantics { let x = a; let y = b; a = y; b = x; }
    }
    /// 90 is `xchg ax, ax`, which is NOP.
    instruction Xchg_ax_r16 {
        mnemonic "xchg";
        encoding { opcode "10010rrr" { r: r16 } }
        operands (b: r16);
        semantics { let x = AX; let y = b; AX = y; b = x; }
    }
    instruction Cbw { mnemonic "cbw"; encoding { opcode 0x98; } semantics { AX = (AL as i8) as u16; } }
    instruction Cwd { mnemonic "cwd"; encoding { opcode 0x99; } semantics { DX = if AX[15] == 1 { 0xFFFF } else { 0 }; } }
    /// The register form is #UD.
    instruction Lea {
        mnemonic "lea";
        encoding { opcode 0x8D; ModRM { reg: r16 } }
        operands (dst: r16, src: mem_offset);
        semantics { if !src.is_mem { raise UD; } dst = src; }
    }

    // -- segment registers --------------------------------------------------------------------

    fn read_sreg(n: u3) -> u16 {
        return match n { 0 => ES.selector, 1 => CS.selector, 2 => SS.selector, 3 => DS.selector, _ => { raise UD; } };
    }

    /// Loading CS this way is #UD; so are the nonexistent registers 4-7.
    fn write_sreg(n: u3, v: u16) {
        match n {
            0 => { ES = load_data_segment(v); }
            2 => { SS = load_stack_segment(v); INHIBIT = 1; }
            3 => { DS = load_data_segment(v); }
            _ => { raise UD; }
        }
    }

    instruction Mov_rm16_sreg {
        mnemonic "mov";
        encoding { opcode 0x8C; ModRM { reg: sreg_n } }
        operands (n: sreg_n, dst: rm16);
        semantics { let v = read_sreg(n); dst = v; }
    }
    instruction Mov_sreg_rm16 {
        mnemonic "mov";
        encoding { opcode 0x8E; ModRM { reg: sreg_n } }
        operands (n: sreg_n, src: rm16);
        semantics { if n == 1 || n > 3 { raise UD; } write_sreg(n, src); }
    }
    instruction Push_sreg {
        mnemonic "push";
        encoding { opcode "000ss110" { s: seg_ov } }
        operands (s: seg_ov);
        semantics { push16(segment(s).selector); }
    }
    /// POP ES, SS, DS: the register is loaded before SP moves. (0F is not
    /// POP CS on the 286: it escapes to two-byte opcodes.)
    fn pop_sreg(n: u3) {
        let v = mem.read_u16(translate_stack(SP, Access::Read));
        write_sreg(n, v);
        SP = SP + 2;
    }
    instruction Pop_es { mnemonic "pop"; encoding { opcode 0x07; } semantics { pop_sreg(0); } }
    instruction Pop_ss { mnemonic "pop"; encoding { opcode 0x17; } semantics { pop_sreg(2); } }
    instruction Pop_ds { mnemonic "pop"; encoding { opcode 0x1F; } semantics { pop_sreg(3); } }

    // -- protected mode: the system instructions -------------------------------------------------
    //
    // The 0F group: descriptor-table registers, the machine status word,
    // the LDT and task registers, and the descriptor queries; and ARPL.
    // LGDT, LIDT, LLDT, LTR, LMSW and CLTS are CPL 0 only; SLDT, STR, LLDT,
    // LTR, VERR, VERW, LAR, LSL and ARPL are #UD in real mode.

    /// SGDT/SIDT store the limit and the 24-bit base; the sixth byte reads
    /// FF on the 286.
    fn store_table(m: ModRM, t: TableReg) {
        let (s, o) = effective_address(m);
        mem.write_u16(translate(s, o, 2, Access::Write), t.limit);
        mem.write_u16(translate(s, o + 2, 2, Access::Write), t.base[15:0]);
        mem.write_u8(translate(s, o + 4, 1, Access::Write), t.base[23:16]);
        mem.write_u8(translate(s, o + 5, 1, Access::Write), 0xFF);
    }

    fn load_table(m: ModRM) -> TableReg {
        let (s, o) = effective_address(m);
        let limit = mem.read_u16(translate(s, o, 2, Access::Read));
        let lo = mem.read_u16(translate(s, o + 2, 2, Access::Read));
        let hi = mem.read_u8(translate(s, o + 4, 1, Access::Read));
        return TableReg { base: concat(hi, lo), limit: limit };
    }

    instruction Sgdt {
        mnemonic "sgdt";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 0 } }
        operands (m: table_ref);
        semantics { if !m.is_mem { raise UD; } store_table(m, GDTR); }
    }
    instruction Sidt {
        mnemonic "sidt";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 1 } }
        operands (m: table_ref);
        semantics { if !m.is_mem { raise UD; } store_table(m, IDTR); }
    }
    instruction Lgdt {
        mnemonic "lgdt";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 2 } }
        operands (m: table_ref);
        semantics { if !m.is_mem { raise UD; } privileged(); GDTR = load_table(m); }
    }
    instruction Lidt {
        mnemonic "lidt";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 3 } }
        operands (m: table_ref);
        semantics { if !m.is_mem { raise UD; } privileged(); IDTR = load_table(m); }
    }
    instruction Smsw {
        mnemonic "smsw";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 4 } }
        operands (dst: rm16);
        semantics { dst = MSW; }
    }
    /// LMSW sets the low four bits; once set, PE stays set until reset.
    instruction Lmsw {
        mnemonic "lmsw";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 6 } }
        operands (src: rm16);
        semantics {
            privileged();
            let v = src;
            MSW = (MSW & 0xFFF0) | (v & 0x000F) | (MSW & 0x0001);
            if MSW.PE == 1 { mode = Mode::Protected; }
        }
    }
    instruction Clts {
        mnemonic "clts";
        encoding { opcode [0x0F, 0x06]; }
        semantics { privileged(); MSW.TS = 0; }
    }

    instruction Sldt {
        mnemonic "sldt";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 0 } }
        operands (dst: rm16);
        semantics { protected_only(); dst = LDTR.selector; }
    }
    instruction Str {
        mnemonic "str";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 1 } }
        operands (dst: rm16);
        semantics { protected_only(); dst = TR.selector; }
    }
    /// LLDT: an LDT descriptor in the GDT, or null for no LDT.
    instruction Lldt {
        mnemonic "lldt";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 2 } }
        operands (src: rm16);
        semantics {
            protected_only();
            privileged();
            let sel = src;
            if (sel & 0xFFFC) == 0 {
                LDTR = Segment { selector: sel, base: 0, limit: 0, rights: 0 };
            } else {
                if sel[2] == 1 { raise GP(sel_error(sel)); }
                let d = descriptor(sel);
                if system_type(d.rights) != 2 { raise GP(sel_error(sel)); }
                if d.rights[7] == 0 { raise NP(sel_error(sel)); }
                LDTR = Segment { selector: sel, base: d.base, limit: d.limit, rights: d.rights };
            }
        }
    }
    /// LTR: an available TSS in the GDT, which becomes busy.
    instruction Ltr {
        mnemonic "ltr";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 3 } }
        operands (src: rm16);
        semantics {
            protected_only();
            privileged();
            let sel = src;
            if (sel & 0xFFFC) == 0 || sel[2] == 1 { raise GP(sel_error(sel)); }
            let d = descriptor(sel);
            if system_type(d.rights) != 1 { raise GP(sel_error(sel)); }
            if d.rights[7] == 0 { raise NP(sel_error(sel)); }
            mem.write_u8(descriptor_address(sel) + 5, d.rights | 0x02);
            TR = Segment { selector: sel, base: d.base, limit: d.limit, rights: d.rights | 0x02 };
        }
    }

    /// The descriptor queries' privilege rule: a segment the selector and
    /// CPL may see (conforming code always).
    fn visible(sel: u16, r: u8) -> bool {
        if is_conforming(r) { return true; }
        return (dpl(r) as u3) >= (cpl() as u3) && (dpl(r) as u3) >= (sel[1:0] as u3);
    }

    /// VERR/VERW: ZF says whether the segment can be read (written) at CPL.
    fn verify(sel: u16, write: bool) {
        FLAGS.ZF = 0;
        if (sel & 0xFFFC) == 0 || !descriptor_at(sel) { return; }
        let r = descriptor(sel).rights;
        if r[4] == 0 || !visible(sel, r) { return; }
        let ok = if write { is_data(r) && r[1] == 1 } else { is_data(r) || r[1] == 1 };
        if ok { FLAGS.ZF = 1; }
    }

    instruction Verr {
        mnemonic "verr";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 4 } }
        operands (src: rm16);
        flags { modifies: [ZF]; }
        semantics { protected_only(); verify(src, false); }
    }
    instruction Verw {
        mnemonic "verw";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 5 } }
        operands (src: rm16);
        flags { modifies: [ZF]; }
        semantics { protected_only(); verify(src, true); }
    }
    /// LAR: the access-rights byte, in the high byte, of a segment, TSS,
    /// LDT, call gate or task gate the selector may see.
    instruction Lar {
        mnemonic "lar";
        encoding { opcode [0x0F, 0x02]; ModRM { reg: r16 } }
        operands (dst: r16, src: rm16);
        flags { modifies: [ZF]; }
        semantics {
            protected_only();
            let sel = src;
            FLAGS.ZF = 0;
            if (sel & 0xFFFC) != 0 && descriptor_at(sel) {
                let r = descriptor(sel).rights;
                let t = system_type(r);
                if (r[4] == 1 || (t >= 1 && t <= 5)) && visible(sel, r) {
                    dst = (r as u16) << 8;
                    FLAGS.ZF = 1;
                }
            }
        }
    }
    /// LSL: the limit of a segment, TSS or LDT the selector may see.
    instruction Lsl {
        mnemonic "lsl";
        encoding { opcode [0x0F, 0x03]; ModRM { reg: r16 } }
        operands (dst: r16, src: rm16);
        flags { modifies: [ZF]; }
        semantics {
            protected_only();
            let sel = src;
            FLAGS.ZF = 0;
            if (sel & 0xFFFC) != 0 && descriptor_at(sel) {
                let d = descriptor(sel);
                let t = system_type(d.rights);
                if (d.rights[4] == 1 || (t >= 1 && t <= 3)) && visible(sel, d.rights) {
                    dst = d.limit;
                    FLAGS.ZF = 1;
                }
            }
        }
    }
    /// ARPL: raises the destination selector's RPL to the source's.
    instruction Arpl {
        mnemonic "arpl";
        encoding { opcode 0x63; ModRM { reg: r16 } }
        operands (dst: rm16, src: r16);
        flags { modifies: [ZF]; }
        semantics {
            protected_only();
            let d = dst;
            if (d[1:0] as u3) < (src[1:0] as u3) {
                dst = (d & 0xFFFC) | (src & 0x0003);
                FLAGS.ZF = 1;
            } else {
                FLAGS.ZF = 0;
            }
        }
    }

    // -- far transfers ------------------------------------------------------------------------

    instruction Call_far {
        mnemonic "call";
        encoding { opcode 0x9A; FarPtr }
        operands (target: far_ptr);
        semantics { let t = target; call_far(t.seg, t.off); }
    }
    instruction Jmp_far {
        mnemonic "jmp";
        encoding { opcode 0xEA; FarPtr }
        operands (target: far_ptr);
        semantics { let t = target; jump_far(t.seg, t.off); }
    }
    /// Reads both words before releasing the stack.
    instruction Retf {
        mnemonic "retf";
        encoding { opcode 0xCB; }
        semantics { return_far(0); }
    }
    instruction Retf_imm16 {
        mnemonic "retf";
        encoding { opcode 0xCA; Imm16 }
        operands (n: imm16);
        semantics { return_far(n); }
    }

    // -- FE/FF groups, 8F -----------------------------------------------------------------------

    instruction Inc_rm8 {
        mnemonic "inc";
        encoding { opcode 0xFE; ModRM { reg: 0 } }
        operands (dst: rm8);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        semantics { let c = CF; dst = alu8(AluOp::Add, dst, 1); FLAGS.CF = c; }
    }
    instruction Dec_rm8 {
        mnemonic "dec";
        encoding { opcode 0xFE; ModRM { reg: 1 } }
        operands (dst: rm8);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        semantics { let c = CF; dst = alu8(AluOp::Sub, dst, 1); FLAGS.CF = c; }
    }
    instruction Inc_rm16 {
        mnemonic "inc";
        encoding { opcode 0xFF; ModRM { reg: 0 } }
        operands (dst: rm16);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        semantics { let c = CF; dst = alu16(AluOp::Add, dst, 1); FLAGS.CF = c; }
    }
    instruction Dec_rm16 {
        mnemonic "dec";
        encoding { opcode 0xFF; ModRM { reg: 1 } }
        operands (dst: rm16);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        semantics { let c = CF; dst = alu16(AluOp::Sub, dst, 1); FLAGS.CF = c; }
    }
    instruction Call_rm16 {
        mnemonic "call";
        encoding { opcode 0xFF; ModRM { reg: 2 } }
        operands (target: rm16);
        semantics { let t = target; push16(IP); IP = t; }
    }
    instruction Call_far_mem {
        mnemonic "call";
        encoding { opcode 0xFF; ModRM { reg: 3 } }
        operands (target: far_mem);
        semantics {
            if !target.is_mem { raise UD; }
            let t = target;
            call_far(t.seg, t.off);
        }
    }
    instruction Jmp_rm16 {
        mnemonic "jmp";
        encoding { opcode 0xFF; ModRM { reg: 4 } }
        operands (target: rm16);
        semantics { IP = target; }
    }
    instruction Jmp_far_mem {
        mnemonic "jmp";
        encoding { opcode 0xFF; ModRM { reg: 5 } }
        operands (target: far_mem);
        semantics { if !target.is_mem { raise UD; } let t = target; jump_far(t.seg, t.off); }
    }
    instruction Push_rm16 {
        mnemonic "push";
        encoding { opcode 0xFF; ModRM { reg: 6 } }
        operands (src: rm16);
        semantics { let v = src; push16(v); }
    }
    instruction Pop_rm16 {
        mnemonic "pop";
        encoding { opcode 0x8F; ModRM { reg: 0 } }
        operands (dst: rm16);
        semantics { let v = mem.read_u16(translate(SS, SP, 2, Access::Read)); SP = SP + 2; dst = v; }
    }

    // -- more stack -------------------------------------------------------------------------------

    instruction Push_imm16 { mnemonic "push"; encoding { opcode 0x68; Imm16 } operands (v: imm16); semantics { push16(v); } }
    instruction Push_simm8 { mnemonic "push"; encoding { opcode 0x6A; Disp8 } operands (v: simm8); semantics { push16(v); } }
    /// Pushes the SP value from before the first push. The 286 works on an
    /// internal copy of SP: a fault leaves what was stored but not SP.
    instruction Pusha {
        mnemonic "pusha";
        encoding { opcode 0x60; }
        semantics {
            let sp = SP;
            mem.write_u16(translate(SS, sp - 2, 2, Access::Write), AX);
            mem.write_u16(translate(SS, sp - 4, 2, Access::Write), CX);
            mem.write_u16(translate(SS, sp - 6, 2, Access::Write), DX);
            mem.write_u16(translate(SS, sp - 8, 2, Access::Write), BX);
            mem.write_u16(translate(SS, sp - 10, 2, Access::Write), sp);
            mem.write_u16(translate(SS, sp - 12, 2, Access::Write), BP);
            mem.write_u16(translate(SS, sp - 14, 2, Access::Write), SI);
            mem.write_u16(translate(SS, sp - 16, 2, Access::Write), DI);
            SP = sp - 16;
        }
    }
    /// Reads all eight words before changing any register; the saved SP is
    /// skipped.
    instruction Popa {
        mnemonic "popa";
        encoding { opcode 0x61; }
        semantics {
            let di = mem.read_u16(translate(SS, SP, 2, Access::Read));
            let si = mem.read_u16(translate(SS, SP + 2, 2, Access::Read));
            let bp = mem.read_u16(translate(SS, SP + 4, 2, Access::Read));
            // The saved SP is read (a bus cycle) and discarded.
            let _sp = mem.read_u16(translate(SS, SP + 6, 2, Access::Read));
            let bx = mem.read_u16(translate(SS, SP + 8, 2, Access::Read));
            let dx = mem.read_u16(translate(SS, SP + 10, 2, Access::Read));
            let cx = mem.read_u16(translate(SS, SP + 12, 2, Access::Read));
            let ax = mem.read_u16(translate(SS, SP + 14, 2, Access::Read));
            DI = di; SI = si; BP = bp; BX = bx; DX = dx; CX = cx; AX = ax;
            SP = SP + 16;
        }
    }
    /// The nesting level is masked to 5 bits; level - 1 frame pointers are
    /// copied from the enclosing frame. The 286 works on internal copies of
    /// SP and BP and commits them at the end: a fault leaves the words
    /// already stored but neither pointer changed.
    instruction Enter {
        mnemonic "enter";
        encoding { opcode 0xC8; Imm16; Imm8 }
        operands (size: imm16, level: imm8);
        semantics {
            let lvl = level & 0x1F;
            let frame = SP - 2;
            mem.write_u16(translate(SS, frame, 2, Access::Write), BP);
            for i in 1..32 {
                if (i as u8) < lvl {
                    let off = 2 * (i as u16);
                    let v = mem.read_u16(translate(SS, BP - off, 2, Access::Read));
                    mem.write_u16(translate(SS, frame - off, 2, Access::Write), v);
                }
            }
            let depth = if lvl == 0 { 0_u16 } else { 2 * (lvl as u16) };
            if lvl > 0 { mem.write_u16(translate(SS, frame - depth, 2, Access::Write), frame); }
            BP = frame;
            SP = frame - depth - size;
        }
    }
    /// Reads the saved BP before releasing the frame.
    instruction Leave {
        mnemonic "leave";
        encoding { opcode 0xC9; }
        semantics { let v = mem.read_u16(translate(SS, BP, 2, Access::Read)); SP = BP + 2; BP = v; }
    }

    // -- miscellany -------------------------------------------------------------------------------

    instruction Imul_r16_rm16_imm16 {
        mnemonic "imul";
        encoding { opcode 0x69; ModRM { reg: r16 } Imm16 }
        operands (dst: r16, src: rm16, k: imm16);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics {
            let p = ((src as i16) as i32) * ((k as i16) as i32);
            dst = p as u16;
            let wide = p != ((p as i16) as i32);
            FLAGS.CF = wide as u1;
            FLAGS.OF = wide as u1;
        }
    }
    instruction Imul_r16_rm16_simm8 {
        mnemonic "imul";
        encoding { opcode 0x6B; ModRM { reg: r16 } Disp8 }
        operands (dst: r16, src: rm16, k: simm8);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics {
            let p = ((src as i16) as i32) * ((k as i16) as i32);
            dst = p as u16;
            let wide = p != ((p as i16) as i32);
            FLAGS.CF = wide as u1;
            FLAGS.OF = wide as u1;
        }
    }
    instruction Les {
        mnemonic "les";
        encoding { opcode 0xC4; ModRM { reg: r16 } }
        operands (dst: r16, src: far_mem);
        semantics { if !src.is_mem { raise UD; } let p = src; dst = p.off; ES = load_data_segment(p.seg); }
    }
    instruction Lds {
        mnemonic "lds";
        encoding { opcode 0xC5; ModRM { reg: r16 } }
        operands (dst: r16, src: far_mem);
        semantics { if !src.is_mem { raise UD; } let p = src; dst = p.off; DS = load_data_segment(p.seg); }
    }
    instruction Mov_al_moffs { mnemonic "mov"; encoding { opcode 0xA0; Moffs } operands (src: moffs8); semantics { AL = src; } }
    instruction Mov_ax_moffs { mnemonic "mov"; encoding { opcode 0xA1; Moffs } operands (src: moffs16); semantics { AX = src; } }
    instruction Mov_moffs_al { mnemonic "mov"; encoding { opcode 0xA2; Moffs } operands (dst: moffs8); semantics { dst = AL; } }
    instruction Mov_moffs_ax { mnemonic "mov"; encoding { opcode 0xA3; Moffs } operands (dst: moffs16); semantics { dst = AX; } }

    instruction Loopne {
        mnemonic "loopne";
        encoding { opcode 0xE0; Disp8 }
        operands (rel: rel8);
        semantics { CX = CX - 1; if CX != 0 && ZF == 0 { IP = IP + rel; } }
    }
    instruction Loope {
        mnemonic "loope";
        encoding { opcode 0xE1; Disp8 }
        operands (rel: rel8);
        semantics { CX = CX - 1; if CX != 0 && ZF == 1 { IP = IP + rel; } }
    }
    instruction Loop {
        mnemonic "loop";
        encoding { opcode 0xE2; Disp8 }
        operands (rel: rel8);
        semantics { CX = CX - 1; if CX != 0 { IP = IP + rel; } }
    }
    instruction Jcxz {
        mnemonic "jcxz";
        encoding { opcode 0xE3; Disp8 }
        operands (rel: rel8);
        semantics { if CX == 0 { IP = IP + rel; } }
    }

    instruction Xlat {
        mnemonic "xlat";
        encoding { opcode 0xD7; }
        semantics { AL = mem.read_u8(translate(src_seg(), BX + (AL as u16), 1, Access::Read)); }
    }
    instruction Lahf { mnemonic "lahf"; encoding { opcode 0x9F; } semantics { AH = FLAGS as u8; } }
    instruction Sahf {
        mnemonic "sahf";
        encoding { opcode 0x9E; }
        flags { modifies: [SF, ZF, AF, PF, CF]; }
        semantics { FLAGS = (FLAGS & 0xFF00) | ((AH as u16) & 0x00D5) | 0x0002; }
    }
    /// Undocumented: AL = CF ? FF : 00.
    instruction Salc { mnemonic "salc"; encoding { opcode 0xD6; } semantics { AL = if CF == 1 { 0xFF } else { 0x00 }; } }

    // -- BCD adjustment ------------------------------------------------------------------------------

    instruction Daa {
        mnemonic "daa";
        encoding { opcode 0x27; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF]; }
        semantics {
            let old_al = AL;
            let old_cf = CF;
            let lo = (AL & 0x0F) > 9 || AF == 1;
            let a1 = if lo { AL + 6 } else { AL };
            let hi = old_al > 0x99 || old_cf == 1;
            let a2 = if hi { a1 + 0x60 } else { a1 };
            AL = a2;
            FLAGS.AF = lo as u1;
            FLAGS.CF = hi as u1;
            FLAGS.SF = AL[7];
            FLAGS.ZF = (AL == 0) as u1;
            FLAGS.PF = Parity8(AL);
        }
    }
    instruction Das {
        mnemonic "das";
        encoding { opcode 0x2F; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF]; }
        semantics {
            let old_al = AL;
            let old_cf = CF;
            let lo = (AL & 0x0F) > 9 || AF == 1;
            let a1 = if lo { AL - 6 } else { AL };
            let hi = old_al > 0x99 || old_cf == 1;
            let a2 = if hi { a1 - 0x60 } else { a1 };
            AL = a2;
            FLAGS.AF = lo as u1;
            // The low adjustment's borrow sets CF too.
            FLAGS.CF = (hi || (lo && old_al < 6)) as u1;
            FLAGS.SF = AL[7];
            FLAGS.ZF = (AL == 0) as u1;
            FLAGS.PF = Parity8(AL);
        }
    }
    /// On the 286 the adjustment adds 0x106 to AX, so the carry out of AL
    /// reaches AH.
    instruction Aaa {
        mnemonic "aaa";
        encoding { opcode 0x37; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF, SF, ZF, PF]; }
        semantics {
            let adj = (AL & 0x0F) > 9 || AF == 1;
            if adj { AX = AX + 0x0106; }
            AL = AL & 0x0F;
            FLAGS.AF = adj as u1;
            FLAGS.CF = adj as u1;
        }
    }
    instruction Aas {
        mnemonic "aas";
        encoding { opcode 0x3F; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF, SF, ZF, PF]; }
        semantics {
            let adj = (AL & 0x0F) > 9 || AF == 1;
            if adj { AX = AX - 0x0106; }
            AL = AL & 0x0F;
            FLAGS.AF = adj as u1;
            FLAGS.CF = adj as u1;
        }
    }
    instruction Aam {
        mnemonic "aam";
        encoding { opcode 0xD4; Imm8 }
        operands (base: imm8);
        flags {
            modifies: [OF, SF, ZF, AF, PF, CF];
            undefined: [OF, AF, CF, SF if base == 0, ZF if base == 0, PF if base == 0];
        }
        semantics {
            if base == 0 {
                // The divider's leftover flags: SF and ZF clear, PF from AL in
                // most captures (the rest are reported as undefined-flag leaks).
                FLAGS.SF = 0; FLAGS.ZF = 0; FLAGS.CF = 0; FLAGS.AF = 0; FLAGS.OF = 0;
                FLAGS.PF = Parity8(AL);
                raise DE;
            }
            let a = AL;
            AH = a / base;
            AL = a % base;
            FLAGS.SF = AL[7];
            FLAGS.ZF = (AL == 0) as u1;
            FLAGS.PF = Parity8(AL);
        }
    }
    instruction Aad {
        mnemonic "aad";
        encoding { opcode 0xD5; Imm8 }
        operands (base: imm8);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF, AF, CF]; }
        semantics {
            AL = AL + AH * base;
            AH = 0;
            FLAGS.SF = AL[7];
            FLAGS.ZF = (AL == 0) as u1;
            FLAGS.PF = Parity8(AL);
        }
    }

    // -- I/O ------------------------------------------------------------------------------------------

    instruction In_al_imm8  { mnemonic "in";  encoding { opcode 0xE4; Imm8 } operands (p: imm8); semantics { io_allowed(); AL = io.read_u8(p as u16); } }
    instruction In_ax_imm8  { mnemonic "in";  encoding { opcode 0xE5; Imm8 } operands (p: imm8); semantics { io_allowed(); AX = io.read_u16(p as u16); } }
    instruction Out_imm8_al { mnemonic "out"; encoding { opcode 0xE6; Imm8 } operands (p: imm8); semantics { io_allowed(); io.write_u8(p as u16, AL); } }
    instruction Out_imm8_ax { mnemonic "out"; encoding { opcode 0xE7; Imm8 } operands (p: imm8); semantics { io_allowed(); io.write_u16(p as u16, AX); } }
    instruction In_al_dx  { mnemonic "in";  encoding { opcode 0xEC; } semantics { io_allowed(); AL = io.read_u8(DX); } }
    instruction In_ax_dx  { mnemonic "in";  encoding { opcode 0xED; } semantics { io_allowed(); AX = io.read_u16(DX); } }
    instruction Out_dx_al { mnemonic "out"; encoding { opcode 0xEE; } semantics { io_allowed(); io.write_u8(DX, AL); } }
    instruction Out_dx_ax { mnemonic "out"; encoding { opcode 0xEF; } semantics { io_allowed(); io.write_u16(DX, AX); } }
    instruction Insb {
        mnemonic "insb";
        encoding { opcode 0x6C; }
        semantics {
            io_allowed();
            if repeating() && CX == 0 { return; }
            let v = io.read_u8(DX);
            let d = DI; DI = DI + delta(1);
            if repeating() { CX = CX - 2; }
            mem.write_u8(translate(ES, d, 1, Access::Write), v);
            if repeating() { CX = CX + 1; if CX != 0 { IP = start_ip; } }
        }
    }
    instruction Insw {
        mnemonic "insw";
        encoding { opcode 0x6D; }
        semantics {
            io_allowed();
            if repeating() && CX == 0 { return; }
            let v = io.read_u16(DX);
            let d = DI; DI = DI + delta(2);
            if repeating() { CX = CX - 2; }
            mem.write_u16(translate(ES, d, 2, Access::Write), v);
            if repeating() { CX = CX + 1; if CX != 0 { IP = start_ip; } }
        }
    }
    instruction Outsb {
        mnemonic "outsb";
        encoding { opcode 0x6E; }
        semantics {
            io_allowed();
            if repeating() && CX == 0 { return; }
            let s = SI; SI = SI + delta(1);
            if repeating() { CX = CX - 1; }
            io.write_u8(DX, mem.read_u8(translate(src_seg(), s, 1, Access::Read)));
            if repeating() && CX != 0 { IP = start_ip; }
        }
    }
    instruction Outsw {
        mnemonic "outsw";
        encoding { opcode 0x6F; }
        semantics {
            io_allowed();
            if repeating() && CX == 0 { return; }
            let s = SI; SI = SI + delta(2);
            if repeating() { CX = CX - 1; }
            io.write_u16(DX, mem.read_u16(translate(src_seg(), s, 2, Access::Read)));
            if repeating() && CX != 0 { IP = start_ip; }
        }
    }

    /// Coprocessor escape: with no coprocessor and MSW clear, the 286
    /// consumes the ModRM (and displacement) and, for a memory form, reads
    /// the operand word (so it can fault) and discards it.
    /// With no coprocessor, the 286 still hands an ESC instruction to one
    /// over I/O (the SingleStepTests traces): the opcode and ModRM to port
    /// F8, then the instruction's IP and CS, and for a memory operand its
    /// offset and selector, to port FC. Memory is not read, but the
    /// operand's address is checked.
    instruction Esc {
        mnemonic "esc";
        encoding { opcode "11011eee" { e: bits3 }; ModRM }
        operands (e: bits3, m: esc_op);
        semantics {
            let o = m;
            io.write_u16(0xF8, concat(o.modrm, 0xD8_u8 | (e as u8)));
            io.write_u16(0xFC, start_ip);
            io.write_u16(0xFC, CS.selector);
            if m.is_mem {
                io.write_u16(0xFC, o.off);
                io.write_u16(0xFC, o.seg);
            }
        }
    }
    instruction Wait { mnemonic "wait"; encoding { opcode 0x9B; } }

    // -- strings -------------------------------------------------------------------------------
    //
    // One element per execution. Under a repeat prefix an iteration that is
    // not the last sets IP back to the prefix, so REP is interruptible and a
    // fault mid-REP pushes the prefix's address. The order of pointer
    // updates, CX decrements and accesses is the hardware's, as observed in
    // faulting vectors: an index register advances as its access is issued
    // (before the access can fault); CMPS reads ES:DI before DS:SI; CX is
    // counted with the source access, and when a store faults the 286 has
    // counted the store as well.

    fn delta(size: u16) -> u16 { return if DF == 1 { 0 - size } else { size }; }
    fn src_seg() -> Segment { return if seg_override == SegOv::None { DS } else { segment(seg_override) }; }
    fn repeating() -> bool { return rep != Rep::None; }
    /// Whether REPE/REPNE continue after a comparison.
    fn rep_continues() -> bool { return if rep == Rep::E { ZF == 1 } else { ZF == 0 }; }

    instruction Movsb {
        mnemonic "movsb";
        encoding { opcode 0xA4; }
        semantics {
            if repeating() && CX == 0 { return; }
            let s = SI; SI = SI + delta(1);
            if repeating() { CX = CX - 1; }
            let v = mem.read_u8(translate(src_seg(), s, 1, Access::Read));
            let d = DI; DI = DI + delta(1);
            if repeating() { CX = CX - 1; }
            mem.write_u8(translate(ES, d, 1, Access::Write), v);
            if repeating() { CX = CX + 1; if CX != 0 { IP = start_ip; } }
        }
    }
    instruction Movsw {
        mnemonic "movsw";
        encoding { opcode 0xA5; }
        semantics {
            if repeating() && CX == 0 { return; }
            let s = SI; SI = SI + delta(2);
            if repeating() { CX = CX - 1; }
            let v = mem.read_u16(translate(src_seg(), s, 2, Access::Read));
            let d = DI; DI = DI + delta(2);
            if repeating() { CX = CX - 1; }
            mem.write_u16(translate(ES, d, 2, Access::Write), v);
            if repeating() { CX = CX + 1; if CX != 0 { IP = start_ip; } }
        }
    }
    instruction Cmpsb {
        mnemonic "cmpsb";
        encoding { opcode 0xA6; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            if repeating() && CX == 0 { return; }
            let d = DI; DI = DI + delta(1);
            let b = mem.read_u8(translate(ES, d, 1, Access::Read));
            let s = SI; SI = SI + delta(1);
            if repeating() { CX = CX - 1; }
            let a = mem.read_u8(translate(src_seg(), s, 1, Access::Read));
            let _ = alu8(AluOp::Cmp, a, b);
            if repeating() && CX != 0 && rep_continues() { IP = start_ip; }
        }
    }
    instruction Cmpsw {
        mnemonic "cmpsw";
        encoding { opcode 0xA7; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            if repeating() && CX == 0 { return; }
            let d = DI; DI = DI + delta(2);
            let b = mem.read_u16(translate(ES, d, 2, Access::Read));
            let s = SI; SI = SI + delta(2);
            if repeating() { CX = CX - 1; }
            let a = mem.read_u16(translate(src_seg(), s, 2, Access::Read));
            let _ = alu16(AluOp::Cmp, a, b);
            if repeating() && CX != 0 && rep_continues() { IP = start_ip; }
        }
    }
    instruction Stosb {
        mnemonic "stosb";
        encoding { opcode 0xAA; }
        semantics {
            if repeating() && CX == 0 { return; }
            let d = DI; DI = DI + delta(1);
            if repeating() { CX = CX - 2; }
            mem.write_u8(translate(ES, d, 1, Access::Write), AL);
            if repeating() { CX = CX + 1; if CX != 0 { IP = start_ip; } }
        }
    }
    instruction Stosw {
        mnemonic "stosw";
        encoding { opcode 0xAB; }
        semantics {
            if repeating() && CX == 0 { return; }
            let d = DI; DI = DI + delta(2);
            if repeating() { CX = CX - 2; }
            mem.write_u16(translate(ES, d, 2, Access::Write), AX);
            if repeating() { CX = CX + 1; if CX != 0 { IP = start_ip; } }
        }
    }
    instruction Lodsb {
        mnemonic "lodsb";
        encoding { opcode 0xAC; }
        semantics {
            if repeating() && CX == 0 { return; }
            let s = SI; SI = SI + delta(1);
            if repeating() { CX = CX - 1; }
            AL = mem.read_u8(translate(src_seg(), s, 1, Access::Read));
            if repeating() && CX != 0 { IP = start_ip; }
        }
    }
    instruction Lodsw {
        mnemonic "lodsw";
        encoding { opcode 0xAD; }
        semantics {
            if repeating() && CX == 0 { return; }
            let s = SI; SI = SI + delta(2);
            if repeating() { CX = CX - 1; }
            AX = mem.read_u16(translate(src_seg(), s, 2, Access::Read));
            if repeating() && CX != 0 { IP = start_ip; }
        }
    }
    instruction Scasb {
        mnemonic "scasb";
        encoding { opcode 0xAE; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            if repeating() && CX == 0 { return; }
            let d = DI; DI = DI + delta(1);
            if repeating() { CX = CX - 1; }
            let b = mem.read_u8(translate(ES, d, 1, Access::Read));
            let _ = alu8(AluOp::Cmp, AL, b);
            if repeating() && CX != 0 && rep_continues() { IP = start_ip; }
        }
    }
    instruction Scasw {
        mnemonic "scasw";
        encoding { opcode 0xAF; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            if repeating() && CX == 0 { return; }
            let d = DI; DI = DI + delta(2);
            if repeating() { CX = CX - 1; }
            let b = mem.read_u16(translate(ES, d, 2, Access::Read));
            let _ = alu16(AluOp::Cmp, AX, b);
            if repeating() && CX != 0 && rep_continues() { IP = start_ip; }
        }
    }

    // -- flags and miscellany ---------------------------------------------------------------------

    instruction Hlt { mnemonic "hlt"; encoding { opcode 0xF4; } semantics { privileged(); halt; } }
    instruction Cmc { mnemonic "cmc"; encoding { opcode 0xF5; } flags { modifies: [CF]; } semantics { FLAGS.CF = ~CF; } }
    instruction Clc { mnemonic "clc"; encoding { opcode 0xF8; } flags { modifies: [CF]; } semantics { FLAGS.CF = 0; } }
    instruction Stc { mnemonic "stc"; encoding { opcode 0xF9; } flags { modifies: [CF]; } semantics { FLAGS.CF = 1; } }
    instruction Cli { mnemonic "cli"; encoding { opcode 0xFA; } flags { modifies: [IF]; } semantics { io_allowed(); FLAGS.IF = 0; } }
    instruction Sti { mnemonic "sti"; encoding { opcode 0xFB; } flags { modifies: [IF]; } semantics { io_allowed(); if FLAGS.IF == 0 { INHIBIT = 1; } FLAGS.IF = 1; } }
    instruction Cld { mnemonic "cld"; encoding { opcode 0xFC; } flags { modifies: [DF]; } semantics { FLAGS.DF = 0; } }
    instruction Std { mnemonic "std"; encoding { opcode 0xFD; } flags { modifies: [DF]; } semantics { FLAGS.DF = 1; } }
}

// -- tests ---------------------------------------------------------------------------------

test "sti from IF clear inhibits interrupts for one instruction" on I286 {
    given { FLAGS = 0x0002; }
    run bytes [0xFB];
    expect { FLAGS.IF == 1; INHIBIT == 1; }
}

test "mov ss inhibits interrupts for one instruction" on I286 {
    given { AX = 0x2000; }
    run bytes [0x8E, 0xD0];
    expect { SS.selector == 0x2000; INHIBIT == 1; }
}

test "add al, bl" on I286 {
    given { AL = 0x7F; BL = 0x01; }
    run instruction Alu_rm8_r8 { op: AluOp::Add, dst: AL, src: BL };
    expect { AL == 0x80; FLAGS.OF == 1; FLAGS.SF == 1; FLAGS.CF == 0; FLAGS.AF == 1; }
}

test "cmp does not write back" on I286 {
    given { AX = 0x0005; }
    run instruction Alu_ax_imm16 { op: AluOp::Cmp, src: 0x0007 };
    expect { AX == 0x0005; FLAGS.CF == 1; FLAGS.SF == 1; FLAGS.ZF == 0; }
}

test "segment override and memory destination" on I286 {
    given {
        ES = Segment { selector: 0x2000, base: 0x20000, limit: 0xFFFF, rights: 0x93 };
        DS = Segment { selector: 0x1000, base: 0x10000, limit: 0xFFFF, rights: 0x93 };
        BX = 0x0010; CL = 0x01; mem[0x20010] = 0xFF;
        CS = Segment { selector: 0, base: 0, limit: 0xFFFF, rights: 0x93 }; IP = 0x0100;
    }
    run bytes [0x26, 0x00, 0x0F];            // ES: add [bx], cl
    expect { mem[0x20010] == 0x00; mem[0x10010] == 0x00; FLAGS.CF == 1; FLAGS.ZF == 1; IP == 0x0103; }
}

test "jcc taken and not taken" on I286 {
    given { FLAGS.ZF = 1; CS = Segment { selector: 0, base: 0, limit: 0xFFFF, rights: 0x93 }; IP = 0x0100; }
    run bytes [0x74, 0x10];                  // je +0x10
    expect { IP == 0x0112; }
}

test "inc keeps the carry" on I286 {
    given { AX = 0xFFFF; FLAGS.CF = 1; }
    run instruction Inc_r16 { dst: AX };
    expect { AX == 0x0000; FLAGS.CF == 1; FLAGS.ZF == 1; FLAGS.AF == 1; }
}

test "int 3 vectors through the ivt" on I286 {
    given {
        CS = Segment { selector: 0x1000, base: 0x10000, limit: 0xFFFF, rights: 0x93 }; IP = 0x0200;
        SS = Segment { selector: 0x2000, base: 0x20000, limit: 0xFFFF, rights: 0x93 }; SP = 0x0100;
        FLAGS = 0x0246;
        mem[0x0C] = 0x34; mem[0x0D] = 0x12; mem[0x0E] = 0x00; mem[0x0F] = 0x30;   // ivt[3] = 3000:1234
    }
    run bytes [0xCC];
    expect {
        CS.selector == 0x3000; IP == 0x1234; SP == 0x00FA;
        mem[0x200FE] == 0x46; mem[0x200FF] == 0x02;    // flags
        mem[0x200FC] == 0x00; mem[0x200FD] == 0x10;    // cs
        mem[0x200FA] == 0x01; mem[0x200FB] == 0x02;    // ip after int3
        FLAGS.IF == 0;
    }
}

test "a fault delivers with the instruction's start ip" on I286 {
    given {
        CS = Segment { selector: 0, base: 0, limit: 0xFFFF, rights: 0x93 }; IP = 0x0100;
        SS = Segment { selector: 0x2000, base: 0x20000, limit: 0xFFFF, rights: 0x93 }; SP = 0x0100;
        DS = Segment { selector: 0, base: 0, limit: 0xFFFF, rights: 0x93 }; SI = 0xFFFF;
        mem[0x34] = 0x00; mem[0x35] = 0x40; mem[0x36] = 0x00; mem[0x37] = 0x50;   // ivt[13] = 5000:4000
    }
    run bytes [0x3E, 0x01, 0x04];        // ds: add [si], ax, wrapping the segment: #GP
    expect { CS.selector == 0x5000; IP == 0x4000; mem[0x200FA] == 0x00; mem[0x200FB] == 0x01; SP == 0x00FA; }
}

test "rep movsb copies cx bytes, one step per element" on I286 {
    given {
        CS = Segment { selector: 0, base: 0, limit: 0xFFFF, rights: 0x93 }; IP = 0x0100;
        DS = Segment { selector: 0x1000, base: 0x10000, limit: 0xFFFF, rights: 0x93 }; ES = Segment { selector: 0x2000, base: 0x20000, limit: 0xFFFF, rights: 0x93 };
        SI = 0x0000; DI = 0x0010; CX = 3;
        mem[0x10000] = 0x11; mem[0x10001] = 0x22; mem[0x10002] = 0x33;
        mem[0x0100] = 0xF3; mem[0x0101] = 0xA4;
    }
    run bytes [0xF3, 0xA4];
    expect { CX == 2; IP == 0x0100; mem[0x20010] == 0x11; mem[0x20011] == 0x00; }
}

test "push and pop round trip" on I286 {
    given { SS = Segment { selector: 0x2000, base: 0x20000, limit: 0xFFFF, rights: 0x93 }; SP = 0x0010; AX = 0xBEEF; }
    run instruction Push_r16 { src: AX };
    expect { SP == 0x000E; mem[0x2000E] == 0xEF; mem[0x2000F] == 0xBE; }
}

// -- hardware vectors ------------------------------------------------------------------------

/// SingleStepTests 80286, real mode: captured from a Harris 80C286, one
/// instruction plus HLT per vector.
vectors "../../../simulators/test/i286/SingleStepTests/v1_real_mode/*.MOO.gz" on I286 {
    format moo;
    memory mem;
    /// The capture rig has nothing on the I/O bus: reads float high.
    open io = 0xFF;
    /// Each trace starts at the jump to the instruction and ends at the
    /// injected HLT; one cycle of that belongs to no instruction (NOP
    /// measures 3 and INC r16 2, as Intel documents).
    harness_cycles 1;
    reg ax = AX;
    reg bx = BX;
    reg cx = CX;
    reg dx = DX;
    reg sp = SP;
    reg bp = BP;
    reg si = SI;
    reg di = DI;
    reg ip = IP;
    reg flags = FLAGS;
    reg cs { load => CS = Segment { selector: value, base: (value as u24) << 4, limit: 0xFFFF, rights: 0x93 }; read => CS.selector; }
    reg ds { load => DS = Segment { selector: value, base: (value as u24) << 4, limit: 0xFFFF, rights: 0x93 }; read => DS.selector; }
    reg es { load => ES = Segment { selector: value, base: (value as u24) << 4, limit: 0xFFFF, rights: 0x93 }; read => ES.selector; }
    reg ss { load => SS = Segment { selector: value, base: (value as u24) << 4, limit: 0xFFFF, rights: 0x93 }; read => SS.selector; }
}
