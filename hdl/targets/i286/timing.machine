// Execution cycles of each 80286 instruction beyond its bus transfers,
// measured from the SingleStepTests cycle traces.
//
// A trace starts at a jump (an empty queue) and ends at an injected HLT. Its
// cycles that are not part of a bus cycle, less the rig's one
// (`harness_cycles` in i286.machine), are the execution unit's own time;
// each entry is the most common such value for the instruction's form, or,
// where the time depends on data, an expression fitted to it (shift counts,
// REP iterations, taken branches, ENTER's level). Generated with
// `machine vectors --isa I286 --fit` and checked with `--timing`.
//
// The memory forms vary by a cycle or two around their entry: how operand
// transfers overlap the queue refilling after the jump, which this level
// does not model (tier 2, the prefetch queue, would).

use i286::{I286};

timing on I286 {
    Aaa => 3;
    Aad => 15;
    Aam => 17;
    Aas => 3;
    Alu_al_imm8 => 4;
    Alu_ax_imm16 => 3;
    Alu_r16_rm16 => if src.is_mem { 6 } else { 3 };
    Alu_r8_rm8 => if src.is_mem { 6 } else { 3 };
    Alu_rm16_imm16 => 4;
    Alu_rm16_r16 => if dst.is_mem { 4 } else { 3 };
    Alu_rm16_simm8 => 4;
    Alu_rm8_imm8 => 3;
    Alu_rm8_r8 => if dst.is_mem { 4 } else { 3 };
    Bound => 10;
    Call_far => 8;
    Call_far_mem => 6;
    Call_rel16 => 4;
    Call_rm16 => if target.is_mem { 4 } else { 3 };
    Cbw => 2;
    Clc => 2;
    Cld => 2;
    Cli => 3;
    Cmc => 2;
    Cmpsb => if !repeating() { 4 } else if restarted() { 5 } else if CX == 0 { 6 } else { 11 };
    Cmpsw => if !repeating() { 4 } else if restarted() { 5 } else if CX == 0 { 6 } else { 11 };
    Cwd => 2;
    Daa => 3;
    Das => 3;
    Dec_r16 => 2;
    Dec_rm16 => if dst.is_mem { 4 } else { 3 };
    Dec_rm8 => if dst.is_mem { 4 } else { 3 };
    Div_rm16 => if src.is_mem { 24 } else { 23 };
    Div_rm8 => if src.is_mem { 16 } else { 15 };
    Enter => if (level & 0x1F) == 0 { 9 } else if (level & 0x1F) == 1 { 10 } else { 12 };
    Esc => if m.is_mem { 19 } else { 10 };
    Hlt => 2;
    Idiv_rm16 => if src.is_mem { 27 } else { 26 };
    Idiv_rm8 => if src.is_mem { 19 } else { 18 };
    Imul_r16_rm16_imm16 => if src.is_mem { 23 } else { 22 };
    Imul_r16_rm16_simm8 => if src.is_mem { 23 } else { 22 };
    Imul_rm16 => if src.is_mem { 24 } else { 22 };
    Imul_rm8 => if src.is_mem { 16 } else { 14 };
    In_al_dx => 3;
    In_al_imm8 => 4;
    In_ax_dx => 3;
    In_ax_imm8 => 4;
    Inc_r16 => 2;
    Inc_rm16 => if dst.is_mem { 4 } else { 3 };
    Inc_rm8 => if dst.is_mem { 4 } else { 3 };
    Insb => if !repeating() { 3 } else if restarted() { 0 } else if CX == 0 { 8 } else { 7 };
    Insw => if !repeating() { 3 } else if restarted() { 0 } else if CX == 0 { 8 } else { 7 };
    Int3 => 11;
    Int_imm8 => 9;
    Into => if OF == 1 { 11 } else { 5 };
    Iret => 9;
    Jcc => if condition(c) { 4 } else { 5 };
    Jcxz => if CX == 0 { 5 } else { 6 };
    Jmp_far => 8;
    Jmp_far_mem => 7;
    Jmp_rel16 => 4;
    Jmp_rel8 => 4;
    Jmp_rm16 => if target.is_mem { 5 } else { 3 };
    Lahf => 2;
    Lds => 4;
    Lea => 4;
    Leave => 3;
    Les => 4;
    Lodsb => if !repeating() { 3 } else if restarted() { 2 } else if CX == 0 { 6 } else { 8 };
    Lodsw => if !repeating() { 3 } else if restarted() { 2 } else if CX == 0 { 6 } else { 8 };
    Loop => if CX != 1 { 5 } else { 6 };
    Loope => if CX != 1 && ZF == 1 { 5 } else { 6 };
    Loopne => if CX != 1 && ZF == 0 { 5 } else { 6 };
    Mov_al_moffs => 3;
    Mov_ax_moffs => 3;
    Mov_moffs_al => 1;
    Mov_moffs_ax => 1;
    Mov_r16_imm16 => 2;
    Mov_r16_rm16 => if src.is_mem { 4 } else { 3 };
    Mov_r8_imm8 => 3;
    Mov_r8_rm8 => if src.is_mem { 4 } else { 3 };
    Mov_rm16_imm16 => if dst.is_mem { 2 } else { 3 };
    Mov_rm16_r16 => if dst.is_mem { 2 } else { 3 };
    Mov_rm16_sreg => if dst.is_mem { 2 } else { 3 };
    Mov_rm8_imm8 => if dst.is_mem { 1 } else { 2 };
    Mov_rm8_r8 => if dst.is_mem { 2 } else { 3 };
    Mov_sreg_rm16 => if src.is_mem { 4 } else { 3 };
    Movsb => if !repeating() { 3 } else if restarted() { 0 } else if CX == 0 { 8 } else { 7 };
    Movsw => if !repeating() { 3 } else if restarted() { 0 } else if CX == 0 { 8 } else { 7 };
    Mul_rm16 => if src.is_mem { 24 } else { 22 };
    Mul_rm8 => if src.is_mem { 16 } else { 14 };
    Neg_rm16 => if dst.is_mem { 4 } else { 3 };
    Neg_rm8 => if dst.is_mem { 4 } else { 3 };
    Not_rm16 => if dst.is_mem { 4 } else { 3 };
    Not_rm8 => if dst.is_mem { 4 } else { 3 };
    Out_dx_al => 1;
    Out_dx_ax => 0;
    Out_imm8_al => 2;
    Out_imm8_ax => 1;
    Outsb => if !repeating() { 1 } else if restarted() { 0 } else if CX == 0 { 8 } else { 7 };
    Outsw => if !repeating() { 1 } else if restarted() { 0 } else if CX == 0 { 8 } else { 7 };
    Pop_r16 => 3;
    Pop_rm16 => 4;
    Pop_es => 3;
    Pop_ss => 3;
    Pop_ds => 3;
    Popa => 3;
    Popf => 4;
    Push_imm16 => 1;
    Push_r16 => 1;
    Push_rm16 => if src.is_mem { 4 } else { 2 };
    Push_simm8 => 3;
    Push_sreg => 1;
    Pusha => 1;
    Pushf => 1;
    Ret => 7;
    Ret_imm16 => 7;
    Retf => 8;
    Retf_imm16 => 8;
    Sahf => 2;
    Salc => if CF == 1 { 3 } else { 4 };
    Scasb => if !repeating() { 5 } else if restarted() { 6 } else if CX == 0 { 6 } else { 12 };
    Scasw => if !repeating() { 5 } else if restarted() { 6 } else if CX == 0 { 6 } else { 12 };
    Shift_rm16_1 => if dst.is_mem { 4 } else { 3 };
    Shift_rm16_cl => if dst.is_mem { 5 + (CL & 0x1F) as u32 } else { 6 + (CL & 0x1F) as u32 };
    Shift_rm16_imm8 => if dst.is_mem { 4 + (n & 0x1F) as u32 } else { 5 + (n & 0x1F) as u32 };
    Shift_rm8_1 => if dst.is_mem { 4 } else { 3 };
    Shift_rm8_cl => if dst.is_mem { 5 + (CL & 0x1F) as u32 } else { 6 + (CL & 0x1F) as u32 };
    Shift_rm8_imm8 => if dst.is_mem { 4 + (n & 0x1F) as u32 } else { 5 + (n & 0x1F) as u32 };
    Stc => 2;
    Std => 2;
    Sti => 2;
    Stosb => if !repeating() { 1 } else if restarted() { 1 } else if CX == 0 { 7 } else { 7 };
    /// An odd DI splits each word store into two bus cycles, which hide
    /// the iteration's execution cycle.
    Stosw => if !repeating() { if DI[0] == 1 { 0 } else { 1 } } else if restarted() { if DI[0] == 1 { 0 } else { 1 } } else if CX == 0 { 7 } else if DI[0] == 1 { 5 } else { 7 };
    Test_al_imm8 => 4;
    Test_ax_imm16 => 3;
    Test_rm16_imm16 => if a.is_mem { 5 } else { 4 };
    Test_rm16_imm16_alias => if a.is_mem { 5 } else { 4 };
    Test_rm16_r16 => if a.is_mem { 5 } else { 3 };
    Test_rm8_imm8 => if a.is_mem { 4 } else { 3 };
    Test_rm8_imm8_alias => if a.is_mem { 4 } else { 3 };
    Test_rm8_r8 => if a.is_mem { 5 } else { 3 };
    Wait => 7;
    Xchg_ax_r16 => 3;
    Xchg_rm16_r16 => if a.is_mem { 2 } else { 4 };
    Xchg_rm8_r8 => if a.is_mem { 2 } else { 4 };
    Xlat => 3;

    /// Delivering a fault, added to the instruction's entry (beyond the
    /// pushes and IVT reads, which are bus cycles): #DE after a divide that
    /// overflows (7 for DIV, 9 for IDIV, measured), #BR, #UD (an opcode
    /// that does not decode, or a form the semantics reject), and #GP for a
    /// word operand at offset FFFF.
    fault => match vector { 0 => 8, 5 => 5, 6 => 5, 13 => 20, _ => 9 };
    /// Taking an interrupt at a boundary: as INT n.
    interrupt => 9;
}
