   bx_bool
+floppy_drive_seek(drive, head, track)
+  Bit16u drive;
+  Bit16u head;
+  Bit16u track;
+{
+  Bit8u  val8;
+  Bit16u curr_cyl_offset;
+
+  //
+  // DS has been set to 0x40 before call
+  //
+  // A real 765 reads, writes and formats where its head is: it must be
+  // sought first (Bochs's own controller moves it to the cylinder asked
+  // for, so the BIOS did not).
+
+  curr_cyl_offset = drive ? 0x0095 : 0x0094;
+  if (read_byte_DS(curr_cyl_offset) == track)
+    return(1);
+
+  floppy_prepare_controller(drive);
+
+  // send Seek command (3 bytes) to controller
+  outb(PORT_FD_DATA, 0x0f);                // 0f: Seek
+  outb(PORT_FD_DATA, (head << 2) | drive); // HD DR1 DR2
+  outb(PORT_FD_DATA, track);
+
+  // turn on interrupts
+ASM_START
+  sti
+ASM_END
+
+  // wait on 40:3e bit 7 to become 1
+  do {
+    val8 = (read_byte_DS(0x003e) & 0x80);
+  } while ( val8 == 0 );
+
+  val8 = 0; // separate asm from while() loop
+  // turn off interrupts
+ASM_START
+  cli
+ASM_END
+
+  // set 40:3e bit 7 to 0
+  val8 = read_byte_DS(0x003e);
+  val8 &= 0x7f;
+  write_byte_DS(0x003e, val8);
+  write_byte_DS(curr_cyl_offset, track);
+
+  return(1);
+}
