// The 80286 ALU: units shared by the isa (derived interpreter) and, later,
// the execute unit's rtl.

/// ALU operation. The encoding is the x86 group-1 operation field, bits 5..3
/// of opcodes 00-3F and the ModRM `reg` field of 80-83.
enum AluOp : u3 { Add, Or, Adc, Sbb, And, Sub, Xor, Cmp }

/// The six arithmetic flags, as the ALU produces them.
bundle ArithFlags { cf: u1, pf: u1, af: u1, zf: u1, sf: u1, of: u1 }

/// PF is set for even parity of the low byte of a result, at any width.
unit Parity8(v: u8) -> u1 {
    return ~parity(v);
}

/// Datapath only, in W+1 bits so the caller sees the carry out of bit W-1.
/// `Cmp` computes like `Sub`; the caller does not write it back.
unit Alu<const W: width>(op: AluOp, a: u<W>, b: u<W>, cin: u1) -> (result: u<W>, raw: u<W + 1>) {
    let aw = a as u<W + 1>;
    let bw = b as u<W + 1>;
    let cw = cin as u<W + 1>;
    let r: u<W + 1> = match op {
        AluOp::Add => aw + bw,
        AluOp::Adc => aw + bw + cw,
        AluOp::Sub | AluOp::Cmp => aw - bw,
        AluOp::Sbb => aw - bw - cw,
        AluOp::And => aw & bw,
        AluOp::Or  => aw | bw,
        AluOp::Xor => aw ^ bw,
    };
    return (result: r as u<W>, raw: r);
}

/// Flags after an ALU operation of width W. Because the datapath works in
/// W+1 bits, bit W of `raw` is the carry for addition and the borrow for
/// subtraction alike. AF is the carry or borrow out of bit 3.
unit AluFlags<const W: width>(op: AluOp, a: u<W>, b: u<W>, raw: u<W + 1>) -> ArithFlags {
    let r: u<W> = raw as u<W>;
    let msb = W - 1;
    let (cf, af, of) = match op {
        AluOp::Add | AluOp::Adc =>
            (raw[W], raw[4] ^ a[4] ^ b[4], ~(a[msb] ^ b[msb]) & (a[msb] ^ r[msb])),
        AluOp::Sub | AluOp::Sbb | AluOp::Cmp =>
            (raw[W], raw[4] ^ a[4] ^ b[4], (a[msb] ^ b[msb]) & (a[msb] ^ r[msb])),
        AluOp::And | AluOp::Or | AluOp::Xor =>
            (0, 0, 0),
    };
    return ArithFlags { cf, pf: Parity8(r as u8), af, zf: (r == 0) as u1, sf: r[msb], of };
}

test "8-bit add carries out" {
    let (result, raw) = Alu<8>(AluOp::Add, 0xFF, 0x01, 0);
    let f = AluFlags<8>(AluOp::Add, 0xFF, 0x01, raw);
    expect { result == 0x00; f.cf == 1; f.zf == 1; f.af == 1; f.of == 0; f.pf == 1; }
}

test "16-bit add overflows into the sign" {
    let (result, raw) = Alu<16>(AluOp::Add, 0x7FFF, 0x0001, 0);
    let f = AluFlags<16>(AluOp::Add, 0x7FFF, 0x0001, raw);
    expect { result == 0x8000; f.of == 1; f.sf == 1; f.cf == 0; f.af == 1; }
}

test "subtraction borrows" {
    let (result, raw) = Alu<8>(AluOp::Sub, 0x00, 0x01, 0);
    let f = AluFlags<8>(AluOp::Sub, 0x00, 0x01, raw);
    expect { result == 0xFF; f.cf == 1; f.sf == 1; f.zf == 0; f.af == 1; f.of == 0; }
}

test "sbb with borrow in at the edge" {
    let (result, raw) = Alu<8>(AluOp::Sbb, 0xFF, 0xFF, 1);
    let f = AluFlags<8>(AluOp::Sbb, 0xFF, 0xFF, raw);
    expect { result == 0xFF; f.cf == 1; }
}

test "logical ops clear CF and OF" {
    let (_, raw) = Alu<8>(AluOp::And, 0xF0, 0x0F, 0);
    let f = AluFlags<8>(AluOp::And, 0xF0, 0x0F, raw);
    expect { f.cf == 0; f.of == 0; f.zf == 1; f.pf == 1; }
}
