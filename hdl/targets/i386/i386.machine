// The Intel 80386 instruction set architecture: real, protected and
// virtual-8086 mode, with paging.
//
// Real mode is checked against the SingleStepTests 80386 hardware vectors
// (a 386EX; see `vectors` at the end):
// `machine vectors --isa I386 targets/i286/alu.machine targets/i386/i386.machine`.
// Protected mode, paging and virtual-8086 mode have no hardware corpus;
// self-checking programs exercise them (`programs_test.rs`).
//
// Most instructions run at 16 or 32 bits, chosen by the code segment's
// default (its D bit; 16 in real and virtual-8086 mode) and the
// operand-size prefix (66), and address memory with 16- or 32-bit forms,
// chosen likewise and by the address-size prefix (67). They are written
// once, as families over the operand size (SPEC 11.2d); what depends on
// the address size (the ModRM's tail, string pointers, the count
// register) is decided where it is used, and the stack's width follows
// SS's B bit.
//
// Memory is reached in three steps: a segment check and offset give a
// linear address (`translate`), paging maps it to a physical one
// (`page`), and an access that straddles two pages is made a byte at a
// time (`lin_read`, `lin_write`), both pages checked before either is
// written.
//
// The arithmetic units are the 286's (`targets/i286/alu.machine`): they are
// generic over the width.

use alu::{AluOp, ArithFlags, Alu, AluFlags, Parity8};

/// A segment register: the selector and its descriptor cache. `rights` is
/// the descriptor's access byte (P, DPL, S, type), `limit` is in bytes
/// (the granularity applied), and `big` is the D/B bit: 32-bit code, a
/// 32-bit stack (ESP), or an expand-down segment reaching 4 GB. `stack`
/// marks SS, whose faults are #SS rather than #GP. Real mode loads only
/// the selector and the base, so the rest of the cache keeps what
/// protected mode left (a 4 GB limit survives the return to real mode).
bundle Segment { selector: u16, base: u32, limit: u32, rights: u8, big: bool, stack: bool }

/// A descriptor-table register (GDTR, IDTR).
bundle TableReg { base: u32, limit: u16 }

/// A descriptor as read from a table: base, limit (the granularity
/// applied), the access byte and the D/B bit; `w0` and `w3` are its first
/// and last words, from which a gate's offset is made (its selector is
/// `base[15:0]`, its parameter count `base[20:16]`).
bundle Descriptor { base: u32, limit: u32, rights: u8, big: bool, w0: u16, w3: u16 }

/// The address work of a ModRM memory operand beyond a plain base
/// register, fitted to the SingleStepTests 80386 traces: a clock for a
/// 16- or 32-bit displacement (an 8-bit one costs nothing) and one for an
/// index register (16-bit base+index forms, or a SIB that names an index);
/// a register operand none.
unit EaWork(mode: u2, rm: u3, a32: bool, sib_index: u3, sib_base: u3) -> u32 {
    if mode == 3 { return 0; }
    let disp = if a32 { mode == 2 || (mode == 0 && (rm == 5 || (rm == 4 && sib_base == 5))) } else { mode == 2 || (mode == 0 && rm == 6) };
    let index = if a32 { rm == 4 && sib_index != 4 } else { rm < 4 };
    return (if disp { 1 } else { 0 }) + (if index { 1 } else { 0 });
}

isa I386 {
    space mem: addr u32 -> u8, little_endian;
    space io:  addr u16 -> u8, little_endian;

    register EAX: u32 { AX: u16 @ 0; AL: u8 @ 0; AH: u8 @ 8; }
    register EBX: u32 { BX: u16 @ 0; BL: u8 @ 0; BH: u8 @ 8; }
    register ECX: u32 { CX: u16 @ 0; CL: u8 @ 0; CH: u8 @ 8; }
    register EDX: u32 { DX: u16 @ 0; DL: u8 @ 0; DH: u8 @ 8; }
    register ESI: u32 { SI: u16 @ 0; }
    register EDI: u32 { DI: u16 @ 0; }
    register EBP: u32 { BP: u16 @ 0; }
    register ESP: u32 { SP: u16 @ 0; }
    register EIP: u32 { IP: u16 @ 0; }
    /// Internal: set by an instruction after which no maskable interrupt is
    /// taken (STI from IF clear, MOV SS, POP SS), cleared at the next boundary.
    register INHIBIT: u1;
    register CS: Segment;
    register DS: Segment;
    register ES: Segment;
    register SS: Segment;
    register FS: Segment;
    register GS: Segment;
    /// The reserved bits keep whatever they hold (the 386EX's read as set).
    register EFLAGS: u32 {
        FLAGS: u16 @ 0;
        CF: u1 @ 0; PF: u1 @ 2; AF: u1 @ 4; ZF: u1 @ 6; SF: u1 @ 7;
        TF: u1 @ 8; IF: u1 @ 9; DF: u1 @ 10; OF: u1 @ 11;
        IOPL: u2 @ 12; NT: u1 @ 14; RF: u1 @ 16; VM: u1 @ 17;
        view arith: ArithFlags { cf: CF, pf: PF, af: AF, zf: ZF, sf: SF, of: OF }
    }
    /// The machine status word is CR0's low half.
    register CR0: u32 { MSW: u16 @ 0; PE: u1 @ 0; MP: u1 @ 1; EM: u1 @ 2; TS: u1 @ 3; ET: u1 @ 4; PG: u1 @ 31; }
    /// The linear address of the last page fault.
    register CR2: u32;
    /// The page directory's physical address.
    register CR3: u32;
    /// The debug registers hold what is written to them; breakpoints are
    /// not modelled. TR6 and TR7 are the TLB test registers.
    register DR0: u32;
    register DR1: u32;
    register DR2: u32;
    register DR3: u32;
    register DR6: u32;
    register DR7: u32;
    register TR6: u32;
    register TR7: u32;
    register GDTR: TableReg;
    register IDTR: TableReg;
    /// The local descriptor table and the task register: a selector and
    /// the cached descriptor, as for the segment registers.
    register LDTR: Segment;
    register TR: Segment;

    /// Why memory is touched.
    enum Access : u2 { Read, Write, Execute }

    /// A segment-override prefix in effect for the current instruction.
    enum SegOv : u3 { ES = 0, CS = 1, SS = 2, DS = 3, FS = 4, GS = 5, None = 6 }
    latch seg_override: SegOv = SegOv::None;
    /// The operand-size (66) and address-size (67) prefixes.
    latch opsize: u1 = 0;
    latch adsize: u1 = 0;
    /// Bytes of the current instruction fetched so far.
    latch fetched: u8 = 0;
    /// Where the current instruction (its first prefix) starts.
    latch start_ip: u32 = EIP;
    /// A repeat prefix: F2 (REPNE) or F3 (REP/REPE).
    enum Rep : u2 { None = 0, Ne = 1, E = 2 }
    latch rep: Rep = Rep::None;
    /// A LOCK prefix: only some read-modify-write forms with a memory
    /// destination accept it (their `lock` item); before any other
    /// instruction it is #UD.
    latch locked: u1 = 0;

    fault DE { vector: 0, class: Fault, contributory: true }
    fault BR { vector: 5, class: Fault }
    fault UD { vector: 6, class: Fault }
    fault NM { vector: 7, class: Fault }
    fault DoubleFault { vector: 8, class: Abort, pushes_error_code: true }
    fault InvalidTss(error: u16) { vector: 10, class: Fault, pushes_error_code: true, contributory: true }
    fault NP(error: u16) { vector: 11, class: Fault, pushes_error_code: true, contributory: true }
    fault StackFault(error: u16) { vector: 12, class: Fault, pushes_error_code: true, contributory: true }
    fault GP(error: u16) { vector: 13, class: Fault, pushes_error_code: true, contributory: true }
    /// CR2 holds the linear address; the error code is P (a protection
    /// violation rather than a page not present), W/R and U/S.
    fault PageFault(error: u16) { vector: 14, class: Fault, pushes_error_code: true, page_fault: true }

    // -- modes and sizes ------------------------------------------------------------

    /// Protected mode proper: PE set and not virtual-8086 mode.
    fn protected() -> bool { return CR0.PE == 1 && EFLAGS.VM == 0; }

    /// The current privilege level: CS's RPL in protected mode, 3 in
    /// virtual-8086 mode, 0 in real mode.
    fn cpl() -> u2 {
        if EFLAGS.VM == 1 { return 3; }
        return if CR0.PE == 1 { CS.selector[1:0] } else { 0 };
    }

    fn operand_size() -> u6 { return if (opsize ^ (CS.big as u1)) == 1 { 32 } else { 16 }; }
    fn address_size() -> u6 { return if (adsize ^ (CS.big as u1)) == 1 { 32 } else { 16 }; }

    // -- segments ---------------------------------------------------------------------

    /// A segment check: the offset's bytes within the limit (for
    /// expand-down data, above it), and in protected mode a usable segment
    /// for the access: not null, no write to code or read-only data, no
    /// read of execute-only code. Real and virtual-8086 mode check only
    /// the limit. A failure is #GP(0), or #SS(0) through SS.
    fn translate(seg: Segment, off: u32, size: u8, access: Access) -> u32 {
        if !in_segment(seg, off, size, access) {
            if seg.stack { raise StackFault(0); }
            raise GP(0);
        }
        return seg.base + off;
    }

    fn in_segment(seg: Segment, off: u32, size: u8, access: Access) -> bool {
        let last = (off as u64) + (size as u64) - 1;
        if !protected() { return last <= (seg.limit as u64); }
        let r = seg.rights;
        if r == 0 { return false; }
        let code = r[3] == 1;
        if access == Access::Write && (code || r[1] == 0) { return false; }
        if access == Access::Read && code && r[1] == 0 { return false; }
        if !code && r[2] == 1 {
            let top: u64 = if seg.big { 0xFFFFFFFF } else { 0xFFFF };
            return (off as u64) > (seg.limit as u64) && last <= top;
        }
        return last <= (seg.limit as u64);
    }

    /// A stack access at `off`.
    fn translate_stack(off: u32, size: u8, access: Access) -> u32 {
        return translate(SS, off, size, access);
    }

    /// A segment as reset leaves it, which is also how the hardware vectors
    /// start every segment: base `selector << 4`, 64 KB, data.
    fn real_mode_segment(sel: u16, stack: bool) -> Segment {
        return Segment { selector: sel, base: (sel as u32) << 4, limit: 0xFFFF, rights: 0x93, big: false, stack: stack };
    }

    /// A real-mode load: the selector and the base change; the limit,
    /// rights and size stay. Virtual-8086 mode loads a 64 KB, 16-bit,
    /// privilege-3 segment.
    fn plain_segment(old: Segment, sel: u16) -> Segment {
        if EFLAGS.VM == 1 {
            return Segment { selector: sel, base: (sel as u32) << 4, limit: 0xFFFF, rights: if old.rights[3] == 1 { 0xFB } else { 0xF3 }, big: false, stack: old.stack };
        }
        return Segment { selector: sel, base: (sel as u32) << 4, limit: old.limit, rights: old.rights, big: old.big, stack: old.stack };
    }

    fn null_segment(sel: u16, stack: bool) -> Segment {
        return Segment { selector: sel, base: 0, limit: 0, rights: 0, big: false, stack: stack };
    }

    /// Processor reset: execution starts at F000:FFF0 with the code
    /// segment's base at FFFF0000.
    fn reset() {
        CS = Segment { selector: 0xF000, base: 0xFFFF0000, limit: 0xFFFF, rights: 0x9B, big: false, stack: false };
        DS = real_mode_segment(0, false);
        ES = real_mode_segment(0, false);
        SS = real_mode_segment(0, true);
        FS = real_mode_segment(0, false);
        GS = real_mode_segment(0, false);
        EIP = 0xFFF0;
        EFLAGS = 0x0002;
        CR0 = 0;
        IDTR = TableReg { base: 0, limit: 0x03FF };
        GDTR = TableReg { base: 0, limit: 0xFFFF };
        LDTR = null_segment(0, false);
        TR = null_segment(0, false);
    }

    // -- paging and linear memory -------------------------------------------------------
    //
    // With CR0.PG set, a linear address goes through the page directory at
    // CR3 and a page table to a page frame. An entry has P (0), R/W (1),
    // U/S (2), accessed (5) and, in a table, dirty (6), and the frame
    // (31:12). A user access (CPL 3) needs U/S set in both entries, and
    // R/W in both to write; the 386 lets the supervisor write any present
    // page. A missing entry or a refused access is #PF, with CR2 the
    // linear address. The walk sets the accessed bits, and a write the
    // table entry's dirty bit. There is no TLB: every access walks the
    // tables, so software that relies on a stale translation differs.

    fn page(lin: u32, write: bool, user: bool) -> u32 {
        if CR0.PG == 0 { return lin; }
        let code: u16 = (if write { 2_u16 } else { 0_u16 }) | (if user { 4_u16 } else { 0_u16 });
        let da = (CR3 & 0xFFFFF000) + ((lin >> 22) << 2);
        let pde = mem.read_u32(da);
        if pde[0] == 0 { CR2 = lin; raise PageFault(code); }
        let ta = (pde & 0xFFFFF000) + (((lin >> 12) & 0x3FF) << 2);
        let pte = mem.read_u32(ta);
        if pte[0] == 0 { CR2 = lin; raise PageFault(code); }
        let both = pde & pte;
        if user && (both[2] == 0 || (write && both[1] == 0)) { CR2 = lin; raise PageFault(code | 1); }
        if pde[5] == 0 { mem.write_u32(da, pde | 0x20); }
        let want = pte | 0x20 | (if write { 0x40_u32 } else { 0_u32 });
        if want != pte { mem.write_u32(ta, want); }
        return (pte & 0xFFFFF000) | (lin & 0xFFF);
    }

    /// Whether an access of `n` bytes at `lin` stays within one page.
    fn one_page(lin: u32, n: u32) -> bool { return CR0.PG == 0 || (lin & 0xFFF) + n <= 0x1000; }

    fn lin_read<const W: width> in [8, 16, 32](lin: u32, user: bool) -> u<W> {
        if one_page(lin, W / 8) { return mem.read<W>(page(lin, false, user)); }
        let mut v: u<W> = 0;
        for i in 0..4 {
            if (i as u32) < W / 8 {
                let b = mem.read_u8(page(lin + (i as u32), false, user));
                v = v | ((b as u<W>) << ((i as u<W>) * 8));
            }
        }
        return v;
    }

    fn lin_write<const W: width> in [8, 16, 32](lin: u32, user: bool, v: u<W>) {
        if one_page(lin, W / 8) { mem.write<W>(page(lin, true, user), v); return; }
        let lo = page(lin, true, user);
        let hi = page((lin + (W / 8) - 1) & 0xFFFFF000, true, user);
        for i in 0..4 {
            if (i as u32) < W / 8 {
                let a = lin + (i as u32);
                let frame = if ((a ^ lin) & 0xFFFFF000) == 0 { lo } else { hi };
                mem.write_u8((frame & 0xFFFFF000) | (a & 0xFFF), (v >> ((i as u<W>) * 8)) as u8);
            }
        }
    }

    /// A program's access through a segment: a user access at CPL 3.
    fn seg_read<const W: width> in [8, 16, 32](s: Segment, off: u32) -> u<W> {
        return lin_read<W>(translate(s, off, (W / 8) as u8, Access::Read), cpl() == 3);
    }
    fn seg_write<const W: width> in [8, 16, 32](s: Segment, off: u32, v: u<W>) {
        lin_write<W>(translate(s, off, (W / 8) as u8, Access::Write), cpl() == 3, v);
    }

    /// The processor's own accesses to the descriptor tables, the IDT and
    /// task state segments: supervisor accesses at any CPL.
    fn sys_read<const W: width> in [8, 16, 32](lin: u32) -> u<W> { return lin_read<W>(lin, false); }
    fn sys_write<const W: width> in [8, 16, 32](lin: u32, v: u<W>) { lin_write<W>(lin, false, v); }

    // -- the stack ------------------------------------------------------------------------
    //
    // SS's B bit chooses the stack pointer: ESP, or SP with ESP's upper
    // half left alone (always, in real mode).

    /// The stack offset `delta` bytes from the top, as the stack wraps.
    fn stack_top(delta: u32) -> u32 {
        return if SS.big { ESP + delta } else { ((SP as u32) + delta) & 0xFFFF };
    }

    fn set_stack(v: u32) {
        if SS.big { ESP = v; } else { SP = v as u16; }
    }

    /// An offset wrapped as the stack's width does.
    fn stack_wrap(v: u32) -> u32 { return if SS.big { v } else { v & 0xFFFF }; }

    /// Releases `n` bytes of stack.
    fn release(n: u32) { set_stack(stack_top(n)); }

    fn stack_read<const W: width> in [16, 32](off: u32) -> u<W> {
        return lin_read<W>(translate_stack(off, (W / 8) as u8, Access::Read), cpl() == 3);
    }
    fn stack_write<const W: width> in [16, 32](off: u32, v: u<W>) {
        lin_write<W>(translate_stack(off, (W / 8) as u8, Access::Write), cpl() == 3, v);
    }

    /// A push writes before the stack pointer moves, so a faulting push
    /// restarts.
    fn push<const W: width> in [16, 32](v: u<W>) {
        let sp = stack_top(0_u32 - ((W / 8) as u32));
        stack_write<W>(sp, v);
        set_stack(sp);
    }

    /// The stack word or dword `off` bytes above the top, without popping it.
    fn peek<const W: width> in [16, 32](off: u32) -> u<W> {
        return stack_read<W>(stack_top(off));
    }

    fn pop<const W: width> in [16, 32]() -> u<W> {
        let v = peek<W>(0);
        release(W / 8);
        return v;
    }

    // -- flags ----------------------------------------------------------------------------

    /// FLAGS or EFLAGS (`wide`) from POPF or IRET. Bit 1 reads as set; a
    /// 16-bit load clears bit 15, a 32-bit one keeps the reserved bits and
    /// clears RF; VM never changes here. Outside real mode IOPL changes
    /// only at CPL 0, and IF only at CPL <= IOPL.
    fn load_flags(v: u32, wide: bool) {
        let mut writable: u32 = 0x00007FD5;
        if CR0.PE == 1 {
            if cpl() != 0 { writable = writable & 0xFFFFCFFF; }
            if (cpl() as u3) > (EFLAGS.IOPL as u3) { writable = writable & 0xFFFFFDFF; }
        }
        let e = (EFLAGS & ~writable) | (v & writable) | 0x0002;
        EFLAGS = if wide { e & 0xFFFEFFFF } else { e & 0xFFFF7FFF };
    }

    // -- protection ------------------------------------------------------------------------

    fn dpl(r: u8) -> u2 { return r[6:5]; }
    fn is_code(r: u8) -> bool { return r[4] == 1 && r[3] == 1; }
    fn is_data(r: u8) -> bool { return r[4] == 1 && r[3] == 0; }
    fn is_conforming(r: u8) -> bool { return is_code(r) && r[2] == 1; }
    fn system_type(r: u8) -> u4 { return if r[4] == 0 { r[3:0] } else { 0 }; }
    /// A TSS (available or busy, 286 or 386).
    fn is_tss(t: u4) -> bool { return t == 1 || t == 3 || t == 9 || t == 11; }

    /// The error code naming a selector.
    fn sel_error(sel: u16) -> u16 { return sel & 0xFFFC; }

    /// Whether `sel`'s descriptor lies within its table (the LDT when its
    /// TI bit is set, else the GDT).
    fn descriptor_at(sel: u16) -> bool {
        let index = (sel & 0xFFF8) as u32;
        if sel[2] == 1 {
            return LDTR.rights != 0 && index + 7 <= LDTR.limit;
        }
        return index + 7 <= (GDTR.limit as u32);
    }

    fn descriptor_address(sel: u16) -> u32 {
        let base = if sel[2] == 1 { LDTR.base } else { GDTR.base };
        return base + ((sel & 0xFFF8) as u32);
    }

    fn read_descriptor_at(a: u32) -> Descriptor {
        let lo = sys_read<32>(a);
        let hi = sys_read<32>(a + 4);
        let raw = (lo & 0xFFFF) | (hi & 0x000F0000);
        let limit = if hi[23] == 1 { (raw << 12) | 0xFFF } else { raw };
        let base = (lo >> 16) | ((hi & 0xFF) << 16) | (hi & 0xFF000000);
        return Descriptor { base: base, limit: limit, rights: hi[15:8] as u8, big: hi[22] == 1, w0: lo as u16, w3: (hi >> 16) as u16 };
    }

    /// The descriptor `sel` names; #GP(sel) when it is outside its table.
    fn descriptor(sel: u16) -> Descriptor {
        if !descriptor_at(sel) { raise GP(sel_error(sel)); }
        return read_descriptor_at(descriptor_address(sel));
    }

    /// Loading a segment descriptor marks it accessed.
    fn mark_accessed(sel: u16, r: u8) {
        if r[0] == 0 { sys_write<8>(descriptor_address(sel) + 5, r | 1); }
    }

    fn cached(sel: u16, d: Descriptor, stack: bool) -> Segment {
        return Segment { selector: sel, base: d.base, limit: d.limit, rights: d.rights | 1, big: d.big, stack: stack };
    }

    /// A gate's target offset: 32 bits for a 386 gate, 16 for a 286 one.
    fn gate_offset(g: Descriptor) -> u32 {
        return if g.rights[3] == 1 { (g.w0 as u32) | ((g.w3 as u32) << 16) } else { g.w0 as u32 };
    }

    /// DS, ES, FS or GS: a null selector loads a null segment (any access
    /// through it is #GP); otherwise data or readable code, at a privilege
    /// the selector and CPL may use (conforming code at any), and present.
    fn load_data_segment(sel: u16, old: Segment) -> Segment {
        if !protected() { return plain_segment(old, sel); }
        if (sel & 0xFFFC) == 0 { return null_segment(sel, false); }
        let d = descriptor(sel);
        let r = d.rights;
        if r[4] == 0 || (r[3] == 1 && r[1] == 0) { raise GP(sel_error(sel)); }
        if !is_conforming(r) && ((dpl(r) as u3) < (cpl() as u3) || (dpl(r) as u3) < (sel[1:0] as u3)) {
            raise GP(sel_error(sel));
        }
        if r[7] == 0 { raise NP(sel_error(sel)); }
        mark_accessed(sel, r);
        return cached(sel, d, false);
    }

    /// SS: a writable data segment at exactly CPL, present (#SS if not).
    fn load_stack_segment(sel: u16, old: Segment) -> Segment {
        if !protected() { return plain_segment(old, sel); }
        if (sel & 0xFFFC) == 0 { raise GP(0); }
        let d = descriptor(sel);
        let r = d.rights;
        if sel[1:0] != cpl() || dpl(r) != cpl() || !is_data(r) || r[1] == 0 { raise GP(sel_error(sel)); }
        if r[7] == 0 { raise StackFault(sel_error(sel)); }
        mark_accessed(sel, r);
        return cached(sel, d, true);
    }

    /// A code segment for a transfer to it at privilege `level`; the
    /// caller has checked the privilege. Not present is #NP, and the
    /// target offset must be within the limit.
    fn code_segment(sel: u16, d: Descriptor, level: u2, off: u32) -> Segment {
        if d.rights[7] == 0 { raise NP(sel_error(sel)); }
        if off > d.limit { raise GP(0); }
        mark_accessed(sel, d.rights);
        return cached((sel & 0xFFFC) | (level as u16), d, false);
    }

    /// A transfer within a privilege level to `sel`'s code segment
    /// (conforming code at or above CPL keeps CPL).
    fn same_level_code(sel: u16, d: Descriptor, off: u32) -> Segment {
        let r = d.rights;
        if !is_code(r) { raise GP(sel_error(sel)); }
        if is_conforming(r) {
            if (dpl(r) as u3) > (cpl() as u3) { raise GP(sel_error(sel)); }
        } else if (sel[1:0] as u3) > (cpl() as u3) || dpl(r) != cpl() {
            raise GP(sel_error(sel));
        }
        return code_segment(sel, d, cpl(), off);
    }

    /// A gate's privilege: its DPL at or above both CPL and the selector's
    /// RPL, and present.
    fn gate_allowed(sel: u16, g: Descriptor) {
        if (dpl(g.rights) as u3) < (cpl() as u3) || (dpl(g.rights) as u3) < (sel[1:0] as u3) { raise GP(sel_error(sel)); }
        if g.rights[7] == 0 { raise NP(sel_error(sel)); }
    }

    /// A real-mode or virtual-8086 far target: CS reloads, and the offset
    /// must lie within its limit (#GP(0) before anything moves).
    fn plain_code(sel: u16, off: u32) -> Segment {
        let s = plain_segment(CS, sel);
        if off > s.limit { raise GP(0); }
        return s;
    }

    // -- far transfers ----------------------------------------------------------------------

    /// The far JMP: to a code segment, through a call gate (at the same
    /// level), or to a task.
    fn jump_far(sel: u16, off: u32) {
        if !protected() { CS = plain_code(sel, off); EIP = off; return; }
        if (sel & 0xFFFC) == 0 { raise GP(0); }
        let d = descriptor(sel);
        if d.rights[4] == 1 { CS = same_level_code(sel, d, off); EIP = off; return; }
        let t = system_type(d.rights);
        if t == 1 || t == 9 || t == 5 { enter_task(sel, d, 0); return; }
        if t != 4 && t != 12 { raise GP(sel_error(sel)); }
        gate_allowed(sel, d);
        let tsel = d.base[15:0];
        if (tsel & 0xFFFC) == 0 { raise GP(0); }
        let td = descriptor(tsel);
        if !is_code(td.rights) { raise GP(sel_error(tsel)); }
        if is_conforming(td.rights) {
            if (dpl(td.rights) as u3) > (cpl() as u3) { raise GP(sel_error(tsel)); }
        } else if dpl(td.rights) != cpl() {
            raise GP(sel_error(tsel));
        }
        let goff = gate_offset(d);
        CS = code_segment(tsel, td, cpl(), goff);
        EIP = goff;
    }

    /// Pushes a return address at a gate's (or the instruction's) width.
    fn push_return(wide: bool, cs: u16, ip: u32) {
        if wide { push<32>(cs as u32); push<32>(ip); } else { push<16>(cs); push<16>(ip as u16); }
    }

    /// The far CALL at operand size `W`: as the JMP, pushing the return
    /// CS:EIP. A call gate to a more privileged nonconforming segment
    /// switches to that level's stack from the TSS, pushes the old SS:ESP
    /// and copies the gate's count of parameters (words through a 286
    /// gate, dwords through a 386 one); the pushes are the gate's width.
    fn call_far<const W: width> in [16, 32](sel: u16, off: u32) {
        if !protected() {
            let s = plain_code(sel, off);
            push_return(W == 32, CS.selector, EIP);
            CS = s;
            EIP = off;
            return;
        }
        if (sel & 0xFFFC) == 0 { raise GP(0); }
        let d = descriptor(sel);
        if d.rights[4] == 1 {
            let cs = same_level_code(sel, d, off);
            push_return(W == 32, CS.selector, EIP);
            CS = cs;
            EIP = off;
            return;
        }
        let t = system_type(d.rights);
        if t == 1 || t == 9 || t == 5 { enter_task(sel, d, 1); return; }
        if t != 4 && t != 12 { raise GP(sel_error(sel)); }
        gate_allowed(sel, d);
        let tsel = d.base[15:0];
        if (tsel & 0xFFFC) == 0 { raise GP(0); }
        let td = descriptor(tsel);
        if !is_code(td.rights) || (dpl(td.rights) as u3) > (cpl() as u3) { raise GP(sel_error(tsel)); }
        let wide = t == 12;
        let goff = gate_offset(d);
        let level = dpl(td.rights);
        let old_cs = CS.selector;
        let old_eip = EIP;
        if !is_conforming(td.rights) && (level as u3) < (cpl() as u3) {
            let count = d.base[20:16] as u32;
            let old_ss = SS;
            let old_esp = ESP;
            let old_top = stack_top(0);
            CS = code_segment(tsel, td, level, goff);
            stack_for(level);
            if wide { push<32>(old_ss.selector as u32); push<32>(old_esp); } else { push<16>(old_ss.selector); push<16>(old_esp as u16); }
            for i in 0..32 {
                if (i as u32) < count {
                    let k = count - 1 - (i as u32);
                    if wide {
                        let o = if old_ss.big { old_top + 4 * k } else { (old_top + 4 * k) & 0xFFFF };
                        push<32>(lin_read<32>(translate(old_ss, o, 4, Access::Read), false));
                    } else {
                        let o = if old_ss.big { old_top + 2 * k } else { (old_top + 2 * k) & 0xFFFF };
                        push<16>(lin_read<16>(translate(old_ss, o, 2, Access::Read), false));
                    }
                }
            }
            push_return(wide, old_cs, old_eip);
            EIP = goff;
            return;
        }
        let cs = code_segment(tsel, td, cpl(), goff);
        push_return(wide, old_cs, old_eip);
        CS = cs;
        EIP = goff;
    }

    /// SS:ESP for privilege `level` from the current TSS (a 386 TSS holds
    /// 32-bit stack pointers, a 286 one 16-bit).
    fn stack_for(level: u2) {
        let wide = TR.rights[3] == 1;
        let at = if wide { TR.base + 4 + (level as u32) * 8 } else { TR.base + 2 + (level as u32) * 4 };
        let last = if wide { 4 + (level as u32) * 8 + 5 } else { 2 + (level as u32) * 4 + 3 };
        if last > TR.limit { raise InvalidTss(sel_error(TR.selector)); }
        let sp = if wide { sys_read<32>(at) } else { sys_read<16>(at) as u32 };
        let ss = sys_read<16>(at + (if wide { 4_u32 } else { 2_u32 }));
        if (ss & 0xFFFC) == 0 || !descriptor_at(ss) { raise InvalidTss(sel_error(ss)); }
        let d = descriptor(ss);
        if ss[1:0] != level || dpl(d.rights) != level || !is_data(d.rights) || d.rights[1] == 0 { raise InvalidTss(sel_error(ss)); }
        if d.rights[7] == 0 { raise StackFault(sel_error(ss)); }
        mark_accessed(ss, d.rights);
        SS = cached(ss, d, true);
        if wide { ESP = sp; } else { SP = sp as u16; }
    }

    /// The far RET at operand size `W`, releasing `n` more bytes of
    /// parameters. To an outer level it also pops the caller's SS:ESP and
    /// releases them there, and nulls the data segments the outer level
    /// may not use.
    fn return_far<const W: width> in [16, 32](n: u16) {
        let k = (W / 8) as u32;
        let ip = peek<W>(0) as u32;
        let cs = peek<W>(k) as u16;
        if !protected() {
            let s = plain_code(cs, ip);
            release(2 * k + (n as u32));
            CS = s;
            EIP = ip;
            return;
        }
        if (cs & 0xFFFC) == 0 { raise GP(0); }
        let d = descriptor(cs);
        let rpl = cs[1:0];
        if !is_code(d.rights) || (rpl as u3) < (cpl() as u3) { raise GP(sel_error(cs)); }
        if is_conforming(d.rights) {
            if (dpl(d.rights) as u3) > (rpl as u3) { raise GP(sel_error(cs)); }
        } else if dpl(d.rights) != rpl {
            raise GP(sel_error(cs));
        }
        if rpl == cpl() {
            CS = code_segment(cs, d, rpl, ip);
            release(2 * k + (n as u32));
            EIP = ip;
            return;
        }
        let sp = peek<W>(2 * k + (n as u32)) as u32;
        let ss = peek<W>(3 * k + (n as u32)) as u16;
        CS = code_segment(cs, d, rpl, ip);
        EIP = ip;
        SS = load_stack_segment(ss, SS);
        if W == 32 { ESP = sp; } else { SP = sp as u16; }
        release(n as u32);
        leave_outward();
    }

    /// After a return to an outer level: DS, ES, FS and GS are nulled when
    /// the new CPL may not use them.
    fn leave_outward() {
        DS = outward(DS);
        ES = outward(ES);
        FS = outward(FS);
        GS = outward(GS);
    }

    fn outward(s: Segment) -> Segment {
        let r = s.rights;
        if r == 0 || is_conforming(r) { return s; }
        if (dpl(r) as u3) < (cpl() as u3) { return null_segment(0, false); }
        return s;
    }

    /// IRET at operand size `W`. Real mode pops EIP, CS and FLAGS;
    /// virtual-8086 mode too, at IOPL 3 (else #GP). Protected mode returns
    /// from a nested task when NT is set; from CPL 0 a 32-bit frame with VM
    /// set enters virtual-8086 mode; otherwise it is a far RET that also
    /// restores the flags (under the old CPL's rules).
    fn interrupt_return<const W: width> in [16, 32]() {
        let k = (W / 8) as u32;
        if !protected() {
            if EFLAGS.VM == 1 && EFLAGS.IOPL != 3 { raise GP(0); }
            let ip = peek<W>(0) as u32;
            let cs = peek<W>(k) as u16;
            let fl = peek<W>(2 * k) as u32;
            let s = plain_code(cs, ip);
            release(3 * k);
            CS = s;
            EIP = ip;
            load_flags(fl, W == 32);
            return;
        }
        if EFLAGS.NT == 1 {
            let back = sys_read<16>(TR.base);
            if (back & 0xFFFC) == 0 || back[2] == 1 || !descriptor_at(back) { raise InvalidTss(sel_error(back)); }
            let d = descriptor(back);
            let t = system_type(d.rights);
            if t != 3 && t != 11 { raise InvalidTss(sel_error(back)); }
            enter_task(back, d, 2);
            return;
        }
        let ip = peek<W>(0) as u32;
        let cs = peek<W>(k) as u16;
        let fl = peek<W>(2 * k) as u32;
        if W == 32 && fl[17] == 1 && cpl() == 0 {
            enter_v86(ip, cs, fl);
            return;
        }
        if (cs & 0xFFFC) == 0 { raise GP(0); }
        let d = descriptor(cs);
        let rpl = cs[1:0];
        if !is_code(d.rights) || (rpl as u3) < (cpl() as u3) { raise GP(sel_error(cs)); }
        if is_conforming(d.rights) {
            if (dpl(d.rights) as u3) > (rpl as u3) { raise GP(sel_error(cs)); }
        } else if dpl(d.rights) != rpl {
            raise GP(sel_error(cs));
        }
        load_flags(fl, W == 32);
        if W == 32 { EFLAGS.RF = fl[16]; }
        if rpl == cpl() {
            CS = code_segment(cs, d, rpl, ip);
            release(3 * k);
            EIP = ip;
            return;
        }
        let sp = peek<W>(3 * k) as u32;
        let ss = peek<W>(4 * k) as u16;
        CS = code_segment(cs, d, rpl, ip);
        EIP = ip;
        SS = load_stack_segment(ss, SS);
        if W == 32 { ESP = sp; } else { SP = sp as u16; }
        leave_outward();
    }

    /// IRETD from CPL 0 with VM set in the popped EFLAGS: the frame goes on
    /// with ESP, SS, ES, DS, FS and GS, all loaded as virtual-8086
    /// segments; EFLAGS is taken whole.
    fn enter_v86(ip: u32, cs: u16, fl: u32) {
        let sp = peek<32>(12);
        let ss = peek<32>(16) as u16;
        let es = peek<32>(20) as u16;
        let ds = peek<32>(24) as u16;
        let fs = peek<32>(28) as u16;
        let gs = peek<32>(32) as u16;
        EFLAGS = (EFLAGS & 0xFFFC8000) | (fl & 0x00037FD5) | 0x0002;
        CS = plain_segment(CS, cs);
        SS = plain_segment(SS, ss);
        ES = plain_segment(ES, es);
        DS = plain_segment(DS, ds);
        FS = plain_segment(FS, fs);
        GS = plain_segment(GS, gs);
        ESP = sp;
        EIP = ip & 0xFFFF;
    }

    // -- interrupts and tasks -----------------------------------------------------------------

    /// The fault hook: delivery of a fault (`restart` puts EIP back at the
    /// instruction), with its error code outside real mode.
    fn deliver(vector: u8, restart: bool, has_error: bool, error: u16) {
        if restart { EIP = start_ip; }
        interrupt(vector, 0, has_error, error);
    }

    /// Real-mode delivery through the vector table at IDTR's base. The
    /// vector is read before the frame is pushed (which may overwrite it).
    fn real_interrupt(vector: u8) {
        let entry = IDTR.base + (vector as u32) * 4;
        let ip = lin_read<16>(entry, false);
        let cs = lin_read<16>(entry + 2, false);
        push<16>(FLAGS);
        push<16>(CS.selector);
        push<16>(IP);
        EFLAGS.IF = 0;
        EFLAGS.TF = 0;
        CS = plain_segment(CS, cs);
        EIP = ip as u32;
    }

    /// Delivering interrupt `vector`; `soft` is 0 for an exception or
    /// external interrupt, 1 for INT n, 2 for INT3 and INTO. Real mode uses
    /// the vector table. Otherwise the IDT's gate: a task gate, or an
    /// interrupt or trap gate (286 gates push a 16-bit frame, 386 gates a
    /// 32-bit one) to a code segment, at an inner level on that level's
    /// stack with the old SS:ESP pushed first. From virtual-8086 mode the
    /// target must be privilege 0, the data segments are pushed (GS, FS,
    /// DS, ES, before SS:ESP) and nulled, and INT n needs IOPL 3. A
    /// software interrupt needs the gate's DPL at or above CPL.
    fn interrupt(vector: u8, soft: u2, has_error: bool, error: u16) {
        if CR0.PE == 0 { real_interrupt(vector); return; }
        if EFLAGS.VM == 1 && soft == 1 && EFLAGS.IOPL != 3 { raise GP(0); }
        let at = (vector as u32) * 8;
        let gate_error = ((vector as u16) * 8) + 2;
        if at + 7 > (IDTR.limit as u32) { raise GP(gate_error); }
        let g = read_descriptor_at(IDTR.base + at);
        let t = system_type(g.rights);
        if g.rights[4] == 1 || (t != 5 && t != 6 && t != 7 && t != 14 && t != 15) { raise GP(gate_error); }
        if soft != 0 && (dpl(g.rights) as u3) < (cpl() as u3) { raise GP(gate_error); }
        if g.rights[7] == 0 { raise NP(gate_error); }
        let tsel = g.base[15:0];
        if t == 5 {
            if (tsel & 0xFFFC) == 0 || tsel[2] == 1 { raise InvalidTss(sel_error(tsel)); }
            let td = descriptor(tsel);
            enter_task(tsel, td, 1);
            if has_error {
                if TR.rights[3] == 1 { push<32>(error as u32); } else { push<16>(error); }
            }
            return;
        }
        if (tsel & 0xFFFC) == 0 { raise GP(0); }
        let td = descriptor(tsel);
        if !is_code(td.rights) || (dpl(td.rights) as u3) > (cpl() as u3) { raise GP(sel_error(tsel)); }
        let level = if is_conforming(td.rights) { cpl() } else { dpl(td.rights) };
        let v86 = EFLAGS.VM == 1;
        if v86 && level != 0 { raise GP(sel_error(tsel)); }
        let wide = t >= 14;
        let off = gate_offset(g);
        let fl = EFLAGS;
        let old_cs = CS.selector;
        let old_eip = EIP;
        let inner = (level as u3) < (cpl() as u3);
        let cs = code_segment(tsel, td, level, off);
        if inner {
            let old_ss = SS.selector;
            let old_esp = ESP;
            CS = cs;
            EFLAGS.VM = 0;
            stack_for(level);
            if v86 {
                push<32>(GS.selector as u32);
                push<32>(FS.selector as u32);
                push<32>(DS.selector as u32);
                push<32>(ES.selector as u32);
                DS = null_segment(0, false);
                ES = null_segment(0, false);
                FS = null_segment(0, false);
                GS = null_segment(0, false);
            }
            if wide { push<32>(old_ss as u32); push<32>(old_esp); } else { push<16>(old_ss); push<16>(old_esp as u16); }
        }
        if wide { push<32>(fl); } else { push<16>(fl as u16); }
        push_return(wide, old_cs, old_eip);
        if has_error {
            if wide { push<32>(error as u32); } else { push<16>(error); }
        }
        CS = cs;
        EIP = off;
        EFLAGS.TF = 0;
        EFLAGS.NT = 0;
        EFLAGS.RF = 0;
        EFLAGS.VM = 0;
        if t == 6 || t == 14 { EFLAGS.IF = 0; }
    }

    /// A task switch to the TSS `sel` (descriptor `d`, or a task gate to
    /// one) by a JMP (0), a CALL or interrupt (1, nesting: the new task's
    /// back link names the old, and NT is set), or an IRET (2, back to a
    /// busy task). The outgoing state is saved into the current TSS in its
    /// format (a 386 TSS holds the 32-bit registers and FS, GS; a 286 one
    /// the 16-bit registers). The incoming state is read from the new TSS,
    /// with CR3 from a 386 TSS; then its LDT and segments are checked (#TS),
    /// or with VM set loaded as virtual-8086 segments.
    fn enter_task(sel: u16, d: Descriptor, how: u2) {
        let mut tsel = sel;
        let mut td = d;
        if system_type(d.rights) == 5 {
            gate_allowed(sel, d);
            tsel = d.base[15:0];
            if (tsel & 0xFFFC) == 0 || tsel[2] == 1 { raise GP(sel_error(tsel)); }
            td = descriptor(tsel);
        } else if how != 2 && ((dpl(d.rights) as u3) < (cpl() as u3) || (dpl(d.rights) as u3) < (sel[1:0] as u3)) {
            raise GP(sel_error(sel));
        }
        let t = system_type(td.rights);
        if !is_tss(t) || (t[1] == 1) != (how == 2) { raise GP(sel_error(tsel)); }
        if td.rights[7] == 0 { raise NP(sel_error(tsel)); }
        let new32 = t[3] == 1;
        if td.limit < (if new32 { 0x67_u32 } else { 0x2B_u32 }) { raise InvalidTss(sel_error(tsel)); }
        // Save the outgoing task.
        let old = TR;
        let b = old.base;
        let mut fl = EFLAGS;
        if how == 2 { fl = fl & 0xFFFFBFFF; }
        if old.rights[3] == 1 {
            sys_write<32>(b + 0x20, EIP);
            sys_write<32>(b + 0x24, fl);
            sys_write<32>(b + 0x28, EAX);
            sys_write<32>(b + 0x2C, ECX);
            sys_write<32>(b + 0x30, EDX);
            sys_write<32>(b + 0x34, EBX);
            sys_write<32>(b + 0x38, ESP);
            sys_write<32>(b + 0x3C, EBP);
            sys_write<32>(b + 0x40, ESI);
            sys_write<32>(b + 0x44, EDI);
            sys_write<16>(b + 0x48, ES.selector);
            sys_write<16>(b + 0x4C, CS.selector);
            sys_write<16>(b + 0x50, SS.selector);
            sys_write<16>(b + 0x54, DS.selector);
            sys_write<16>(b + 0x58, FS.selector);
            sys_write<16>(b + 0x5C, GS.selector);
        } else {
            sys_write<16>(b + 14, IP);
            sys_write<16>(b + 16, fl as u16);
            sys_write<16>(b + 18, AX);
            sys_write<16>(b + 20, CX);
            sys_write<16>(b + 22, DX);
            sys_write<16>(b + 24, BX);
            sys_write<16>(b + 26, SP);
            sys_write<16>(b + 28, BP);
            sys_write<16>(b + 30, SI);
            sys_write<16>(b + 32, DI);
            sys_write<16>(b + 34, ES.selector);
            sys_write<16>(b + 36, CS.selector);
            sys_write<16>(b + 38, SS.selector);
            sys_write<16>(b + 40, DS.selector);
        }
        // A JMP or IRET leaves the old task; a CALL keeps it busy.
        if how != 1 && old.rights != 0 {
            sys_write<8>(descriptor_address(old.selector) + 5, old.rights & 0xFD);
        }
        // The new task becomes busy.
        let nb = td.base;
        if how != 2 { sys_write<8>(descriptor_address(tsel) + 5, td.rights | 0x02); }
        if how == 1 { sys_write<16>(nb, old.selector); }
        TR = Segment { selector: tsel, base: nb, limit: td.limit, rights: td.rights | 0x02, big: false, stack: false };
        CR0.TS = 1;
        let mut es: u16 = 0;
        let mut cs: u16 = 0;
        let mut ss: u16 = 0;
        let mut ds: u16 = 0;
        let mut fs: u16 = 0;
        let mut gs: u16 = 0;
        let mut ldt: u16 = 0;
        if new32 {
            let cr3 = sys_read<32>(nb + 0x1C);
            EIP = sys_read<32>(nb + 0x20);
            let nfl = sys_read<32>(nb + 0x24);
            EAX = sys_read<32>(nb + 0x28);
            ECX = sys_read<32>(nb + 0x2C);
            EDX = sys_read<32>(nb + 0x30);
            EBX = sys_read<32>(nb + 0x34);
            ESP = sys_read<32>(nb + 0x38);
            EBP = sys_read<32>(nb + 0x3C);
            ESI = sys_read<32>(nb + 0x40);
            EDI = sys_read<32>(nb + 0x44);
            es = sys_read<16>(nb + 0x48);
            cs = sys_read<16>(nb + 0x4C);
            ss = sys_read<16>(nb + 0x50);
            ds = sys_read<16>(nb + 0x54);
            fs = sys_read<16>(nb + 0x58);
            gs = sys_read<16>(nb + 0x5C);
            ldt = sys_read<16>(nb + 0x60);
            EFLAGS = (EFLAGS & 0xFFFC8000) | (nfl & 0x00037FD5) | 0x0002;
            if CR0.PG == 1 { CR3 = cr3; }
        } else {
            EIP = sys_read<16>(nb + 14) as u32;
            let nfl = sys_read<16>(nb + 16);
            AX = sys_read<16>(nb + 18);
            CX = sys_read<16>(nb + 20);
            DX = sys_read<16>(nb + 22);
            BX = sys_read<16>(nb + 24);
            SP = sys_read<16>(nb + 26);
            BP = sys_read<16>(nb + 28);
            SI = sys_read<16>(nb + 30);
            DI = sys_read<16>(nb + 32);
            es = sys_read<16>(nb + 34);
            cs = sys_read<16>(nb + 36);
            ss = sys_read<16>(nb + 38);
            ds = sys_read<16>(nb + 40);
            ldt = sys_read<16>(nb + 42);
            EFLAGS = (EFLAGS & 0xFFFC8000) | ((nfl as u32) & 0x7FD5) | 0x0002;
        }
        if how == 1 { EFLAGS.NT = 1; }
        // The new task's LDT, then its segments, checked as #TS.
        LDTR = task_ldt(ldt);
        if EFLAGS.VM == 1 {
            CS = plain_segment(CS, cs);
            SS = plain_segment(SS, ss);
            DS = plain_segment(DS, ds);
            ES = plain_segment(ES, es);
            FS = plain_segment(FS, fs);
            GS = plain_segment(GS, gs);
            return;
        }
        if (cs & 0xFFFC) == 0 || !descriptor_at(cs) { raise InvalidTss(sel_error(cs)); }
        let cd = descriptor(cs);
        if !is_code(cd.rights) { raise InvalidTss(sel_error(cs)); }
        if cd.rights[7] == 0 { raise NP(sel_error(cs)); }
        mark_accessed(cs, cd.rights);
        CS = cached(cs, cd, false);
        if (ss & 0xFFFC) == 0 || !descriptor_at(ss) { raise InvalidTss(sel_error(ss)); }
        let sd = descriptor(ss);
        if !is_data(sd.rights) || sd.rights[1] == 0 || dpl(sd.rights) != cs[1:0] { raise InvalidTss(sel_error(ss)); }
        if sd.rights[7] == 0 { raise StackFault(sel_error(ss)); }
        mark_accessed(ss, sd.rights);
        SS = cached(ss, sd, true);
        DS = task_data(ds);
        ES = task_data(es);
        FS = task_data(fs);
        GS = task_data(gs);
    }

    fn task_ldt(sel: u16) -> Segment {
        if (sel & 0xFFFC) == 0 { return null_segment(sel, false); }
        if sel[2] == 1 || ((sel & 0xFFF8) as u32) + 7 > (GDTR.limit as u32) { raise InvalidTss(sel_error(sel)); }
        let d = read_descriptor_at(GDTR.base + ((sel & 0xFFF8) as u32));
        if system_type(d.rights) != 2 { raise InvalidTss(sel_error(sel)); }
        if d.rights[7] == 0 { raise InvalidTss(sel_error(sel)); }
        return Segment { selector: sel, base: d.base, limit: d.limit, rights: d.rights, big: false, stack: false };
    }

    fn task_data(sel: u16) -> Segment {
        if (sel & 0xFFFC) == 0 { return null_segment(sel, false); }
        if !descriptor_at(sel) { raise InvalidTss(sel_error(sel)); }
        let d = descriptor(sel);
        let r = d.rights;
        if r[4] == 0 || (r[3] == 1 && r[1] == 0) { raise InvalidTss(sel_error(sel)); }
        if r[7] == 0 { raise NP(sel_error(sel)); }
        mark_accessed(sel, r);
        return cached(sel, d, false);
    }

    // -- privilege checks --------------------------------------------------------------------

    /// CLI and STI: CPL at most IOPL (in virtual-8086 mode, IOPL 3).
    fn iopl_allowed() {
        if CR0.PE == 1 && (cpl() as u3) > (EFLAGS.IOPL as u3) { raise GP(0); }
    }

    /// PUSHF and POPF: only at IOPL 3 in virtual-8086 mode.
    fn v86_iopl() {
        if EFLAGS.VM == 1 && EFLAGS.IOPL != 3 { raise GP(0); }
    }

    /// I/O at `port` of `size` bytes: allowed at CPL <= IOPL in protected
    /// mode; otherwise (and always in virtual-8086 mode) when the 386
    /// TSS's permission bitmap has a clear bit for every port touched. The
    /// bitmap starts at the offset in the TSS's word at 66; a bit past the
    /// TSS's limit counts as set.
    fn io_allowed(port: u16, size: u8) {
        if CR0.PE == 0 { return; }
        if EFLAGS.VM == 0 && (cpl() as u3) <= (EFLAGS.IOPL as u3) { return; }
        let t = system_type(TR.rights);
        if (t != 9 && t != 11) || TR.limit < 0x67 { raise GP(0); }
        let at = (sys_read<16>(TR.base + 0x66) as u32) + ((port as u32) >> 3);
        if at + 1 > TR.limit { raise GP(0); }
        let bits = sys_read<16>(TR.base + at) as u32;
        let mask = ((1_u32 << (size as u32)) - 1) << ((port as u32) & 7);
        if (bits & mask) != 0 { raise GP(0); }
    }

    /// The system instructions: CPL 0 only (never in virtual-8086 mode).
    fn privileged() {
        if CR0.PE == 1 && cpl() != 0 { raise GP(0); }
    }

    /// The descriptor instructions exist only in protected mode.
    fn protected_only() {
        if !protected() { raise UD; }
    }

    // -- the instruction stream -------------------------------------------------------------

    fn code_address() -> u32 { return page(translate(CS, EIP, 1, Access::Execute), false, cpl() == 3); }
    fn code_room() -> u32 { return if EIP > CS.limit { 0 } else { CS.limit - EIP + 1 }; }

    /// A 386 instruction is at most 15 bytes, prefixes included; a longer
    /// one is #UD on the 386EX (the vectors show vector 6).
    fn next_byte() -> u8 {
        if fetched == 15 { raise UD; }
        fetched = fetched + 1;
        let b = mem.read_u8(code_address());
        EIP = EIP + 1;
        return b;
    }

    istream { space mem; address code_address; next next_byte; undefined UD; fault deliver; boundary take_interrupt; limit code_room; double DoubleFault; lock locked; }

    extern fn intr() -> bool;
    extern fn acknowledge() -> u8;

    fn take_interrupt() -> bool {
        if INHIBIT == 1 {
            INHIBIT = 0;
            return false;
        }
        if EFLAGS.IF == 1 && intr() {
            let v = acknowledge();
            interrupt(v, 0, false, 0);
            return true;
        }
        return false;
    }

    fn segment(s: SegOv) -> Segment {
        return match s {
            SegOv::ES => ES, SegOv::CS => CS, SegOv::SS => SS, SegOv::FS => FS, SegOv::GS => GS, _ => DS,
        };
    }

    /// The segment of a memory operand that defaults to DS.
    fn src_seg() -> Segment { return if seg_override == SegOv::None { DS } else { segment(seg_override) }; }

    /// ModRM; its tail is the displacement (and for 32-bit addresses the
    /// SIB) its addressing form carries.
    operand ModRM {
        size 1;
        fields { mod: u2 @ 6; reg: u3 @ 3; rm: u3 @ 0; }
        tail {
            if address_size() == 32 {
                if mod != 3 && rm == 4 { Sib }
                else if mod == 1 { Disp8 }
                else if mod == 2 || (mod == 0 && rm == 5) { Disp32 }
            } else if mod == 1 { Disp8 }
            else if mod == 2 || (mod == 0 && rm == 6) { Disp16 }
        }
    }
    /// The scale-index-base byte of a 32-bit address; its displacement
    /// depends on the ModRM it follows.
    operand Sib {
        size 1;
        fields { scale: u2 @ 6; index: u3 @ 3; base: u3 @ 0; }
        tail {
            if parent.mod == 1 { Disp8 }
            else if parent.mod == 2 || (parent.mod == 0 && base == 5) { Disp32 }
        }
    }
    operand Disp8  { size 1; fields { value: i8 @ 0; } }
    operand Disp16 { size 2; fields { value: i16 @ 0; } }
    operand Disp32 { size 4; fields { value: i32 @ 0; } }
    operand Imm<8>  { size 1; fields { value: u8 @ 0; } }
    operand Imm<16> { size 2; fields { value: u16 @ 0; } }
    operand Imm<32> { size 4; fields { value: u32 @ 0; } }
    /// A direct memory offset (A0-A3) at each address size.
    operand Moffs<16> { size 2; fields { off: u16 @ 0; } }
    operand Moffs<32> { size 4; fields { off: u32 @ 0; } }
    /// The ModRM of the control, debug and test register moves: `mod` is
    /// ignored (always a register), so nothing follows it.
    operand RegModRM { size 1; fields { mod: u2 @ 6; reg: u3 @ 3; rm: u3 @ 0; } }
    /// A direct far pointer (9A, EA): the offset, then the selector.
    operand FarPtr<16> { size 4; fields { off: u16 @ 0; seg: u16 @ 16; } }
    operand FarPtr<32> { size 6; fields { off: u32 @ 0; seg: u16 @ 32; } }

    fn reg32(n: u3) -> u32 {
        return match n { 0 => EAX, 1 => ECX, 2 => EDX, 3 => EBX, 4 => ESP, 5 => EBP, 6 => ESI, _ => EDI };
    }

    /// Segment and offset of a ModRM memory form. 16-bit forms are the
    /// 286's; 32-bit ones take a base register, or a SIB's base plus scaled
    /// index (where the SIB names no index but a scale, the 386 scales the
    /// base), and a displacement. EBP and ESP bases default to SS, the
    /// others to DS; a segment-override prefix replaces either.
    fn effective_address(m: ModRM) -> (seg: Segment, off: u32) {
        if address_size() == 16 {
            let disp: u16 = match m.mod {
                0 => if m.rm == 6 { m.tail.Disp16.value as u16 } else { 0 },
                1 => m.tail.Disp8.value as u16,
                2 => m.tail.Disp16.value as u16,
                _ => unreachable("register form"),
            };
            let (base, seg) = match m.rm {
                0 => (BX + SI, DS), 1 => (BX + DI, DS), 2 => (BP + SI, SS), 3 => (BP + DI, SS),
                4 => (SI, DS),      5 => (DI, DS),      6 => if m.mod == 0 { (0, DS) } else { (BP, SS) },
                7 => (BX, DS),
            };
            let s = if seg_override == SegOv::None { seg } else { segment(seg_override) };
            return (s, (base + disp) as u32);
        }
        let mut off: u32 = 0;
        let mut ss = false;
        if m.rm == 4 {
            let b = m.tail.Sib;
            let disp: u32 = match m.mod {
                0 => if b.base == 5 { b.tail.Disp32.value as u32 } else { 0 },
                1 => (b.tail.Disp8.value as i32) as u32,
                _ => b.tail.Disp32.value as u32,
            };
            let has_base = !(b.base == 5 && m.mod == 0);
            if b.index != 4 {
                off = reg32(b.index) << b.scale;
                if has_base { off = off + reg32(b.base); }
            } else if has_base {
                off = reg32(b.base) << b.scale;
            }
            ss = has_base && (b.base == 4 || b.base == 5);
            off = off + disp;
        } else {
            let disp: u32 = match m.mod {
                0 => if m.rm == 5 { m.tail.Disp32.value as u32 } else { 0 },
                1 => (m.tail.Disp8.value as i32) as u32,
                _ => m.tail.Disp32.value as u32,
            };
            if !(m.mod == 0 && m.rm == 5) {
                off = reg32(m.rm);
                ss = m.rm == 5;
            }
            off = off + disp;
        }
        let s = if seg_override != SegOv::None { segment(seg_override) } else if ss { SS } else { DS };
        return (s, off);
    }

    /// POP to memory: an ESP-based address sees the popped stack pointer,
    /// but a store that faults (the segment or the page) leaves the stack
    /// pointer where it was.
    fn pop_store<const W: width> in [16, 32](m: ModRM, v: u<W>) {
        let k = (W / 8) as u32;
        let old = stack_top(0);
        release(k);
        if m.mod == 3 { r<W>.select(m.rm) = v; return; }
        let (s, o) = effective_address(m);
        set_stack(old);
        let lin = translate(s, o, k as u8, Access::Write);
        let user = cpl() == 3;
        let _ = page(lin, true, user);
        let _ = page((lin + k - 1) & 0xFFFFF000, true, user);
        release(k);
        lin_write<W>(lin, user, v);
    }

    /// An offset `n` bytes on from `o`, wrapping as the address size does.
    fn ea_next(o: u32, n: u32) -> u32 {
        let a = o + n;
        return if address_size() == 16 { a & 0xFFFF } else { a };
    }

    fn ea_read<const W: width> in [8, 16, 32](m: ModRM) -> u<W> {
        let (s, o) = effective_address(m);
        return seg_read<W>(s, o);
    }
    fn ea_write<const W: width> in [8, 16, 32](m: ModRM, v: u<W>) {
        let (s, o) = effective_address(m);
        seg_write<W>(s, o, v);
    }

    // -- operand kinds --------------------------------------------------------------

    operand_kind r<8> : u8 {
        select(n: u3) => match n { 0 => AL, 1 => CL, 2 => DL, 3 => BL, 4 => AH, 5 => CH, 6 => DH, 7 => BH };
    }
    operand_kind r<16> : u16 {
        select(n: u3) => match n { 0 => AX, 1 => CX, 2 => DX, 3 => BX, 4 => SP, 5 => BP, 6 => SI, 7 => DI };
    }
    operand_kind r<32> : u32 {
        select(n: u3) => match n { 0 => EAX, 1 => ECX, 2 => EDX, 3 => EBX, 4 => ESP, 5 => EBP, 6 => ESI, 7 => EDI };
    }
    operand_kind rm<const W: width> in [8, 16, 32] : u<W> from m: ModRM {
        is_mem => m.mod != 3;
        /// Address work, for timing.
        ea => if (adsize ^ (CS.big as u1)) == 1 && m.mod != 3 && m.rm == 4 { EaWork(m.mod, m.rm, true, m.tail.Sib.index, m.tail.Sib.base) } else { EaWork(m.mod, m.rm, (adsize ^ (CS.big as u1)) == 1, 4, 0) };
        /// The register a register form names.
        index => m.rm;
        read => if m.mod == 3 { r<W>.select(m.rm) } else { ea_read<W>(m) };
        write(v: u<W>) => if m.mod == 3 { r<W>.select(m.rm) = v; } else { ea_write<W>(m, v); };
    }
    /// POP's destination: writing it pops the stack first, as an ESP-based
    /// address sees the popped ESP, but a store that faults leaves SP
    /// where it was.
    operand_kind pop_rm<const W: width> in [16, 32] : u<W> from m: ModRM {
        is_mem => m.mod != 3;
        /// Address work, for timing.
        ea => if (adsize ^ (CS.big as u1)) == 1 && m.mod != 3 && m.rm == 4 { EaWork(m.mod, m.rm, true, m.tail.Sib.index, m.tail.Sib.base) } else { EaWork(m.mod, m.rm, (adsize ^ (CS.big as u1)) == 1, 4, 0) };
        read => unreachable("POP's destination is not read");
        write(v: u<W>) => pop_store<W>(m, v);
    }
    operand_kind imm<const W: width> in [8, 16, 32] : u<W> from i: Imm<W> { read => i.value; }
    /// An 8-bit immediate or displacement, sign-extended.
    operand_kind simm8<const W: width> in [16, 32] : u<W> from i: Disp8 { read => (i.value as i<W>) as u<W>; }
    operand_kind alu_op : AluOp { value(n: u3) => n as AluOp; }
    operand_kind cond : u4 { value(n: u4) => n; }
    operand_kind seg_ov : SegOv { value(n: u2) => (n as u3) as SegOv; }
    /// 64 is FS, 65 GS.
    operand_kind fsgs : SegOv { value(n: u1) => ((n as u3) + 4) as SegOv; }
    operand_kind rep_kind : Rep { value(n: u1) => ((n as u2) + 1) as Rep; }

    // -- shared semantics ---------------------------------------------------------------

    fn alu_name(op: AluOp) -> str {
        return match op {
            AluOp::Add => "add", AluOp::Or => "or", AluOp::Adc => "adc", AluOp::Sbb => "sbb",
            AluOp::And => "and", AluOp::Sub => "sub", AluOp::Xor => "xor", AluOp::Cmp => "cmp",
        };
    }

    fn alu<const W: width> in [8, 16, 32](op: AluOp, a: u<W>, b: u<W>) -> u<W> {
        let (r, raw) = Alu<W>(op, a, b, CF);
        EFLAGS.arith = AluFlags<W>(op, a, b, raw);
        return r;
    }

    /// Condition `c` (opcode bits 3..0): bit 0 negates.
    fn condition(c: u4) -> bool {
        let r = match c >> 1 {
            0 => OF == 1,
            1 => CF == 1,
            2 => ZF == 1,
            3 => CF == 1 || ZF == 1,
            4 => SF == 1,
            5 => PF == 1,
            6 => SF != OF,
            _ => SF != OF || ZF == 1,
        };
        return if c[0] == 1 { !r } else { r };
    }

    /// A near transfer's target: at 16-bit operand size it wraps at 64 KB;
    /// either way it must lie within CS's limit (#GP before anything moves).
    fn near_target(target: u32) -> u32 {
        let t = if operand_size() == 16 { target & 0xFFFF } else { target };
        if t > CS.limit { raise GP(0); }
        return t;
    }

    fn jump_near(target: u32) {
        EIP = near_target(target);
    }

    // -- for the timing table (`timing.machine`) ------------------------------------------

    /// The early-out multiplier's work: the multiplier's significant bits
    /// (of its magnitude when signed), at least 3.
    fn mul_bits<const W: width> in [8, 16, 32](m: u<W>, signed: bool) -> u32 {
        let neg = signed && ((m >> ((W - 1) as u<W>)) & 1) == 1;
        let x = (if neg { ~m } else { m }) as u32;
        let mut n: u32 = 0;
        for i in 0..32 {
            if ((x >> (i as u32)) & 1) == 1 { n = (i as u32) + 1; }
        }
        return if n < 3 { 3 } else { n };
    }

    /// The zero bits below the lowest set bit (BSF's scan), or the width.
    fn trailing_zeros<const W: width> in [16, 32](v: u<W>) -> u32 {
        let x = v as u32;
        let mut n: u32 = W;
        for i in 0..32 {
            let k = 31 - (i as u32);
            if k < W && ((x >> k) & 1) == 1 { n = k; }
        }
        return n;
    }

    /// The zero bits above the highest set bit (BSR's scan), or the width.
    fn leading_zeros<const W: width> in [16, 32](v: u<W>) -> u32 {
        let x = v as u32;
        let mut n: u32 = W;
        for i in 0..32 {
            let k = i as u32;
            if k < W && ((x >> k) & 1) == 1 { n = W - 1 - k; }
        }
        return n;
    }

    /// Whether LOOP's count is about to run out (it decrements first).
    fn count_last() -> bool { return if address_size() == 32 { ECX == 1 } else { CX == 1 }; }

    // -- prefixes ------------------------------------------------------------------------

    prefix SegOverride {
        encoding { opcode "001ss110" { s: seg_ov } }
        operands (s: seg_ov);
        semantics { seg_override = s; }
    }
    prefix SegOverrideFsGs {
        encoding { opcode "0110010g" { g: fsgs } }
        operands (g: fsgs);
        semantics { seg_override = g; }
    }
    prefix OperandSize { encoding { opcode 0x66; } semantics { opsize = 1; } }
    prefix AddressSize { encoding { opcode 0x67; } semantics { adsize = 1; } }
    prefix Lock { encoding { opcode 0xF0; } semantics { locked = 1; } }
    prefix Repeat {
        encoding { opcode "1111001z" { z: rep_kind } }
        operands (z: rep_kind);
        semantics { rep = z; }
    }

    // -- ALU ------------------------------------------------------------------------------

    instruction Alu_rm8_r8 {
        mnemonic alu_name(op);
        encoding { opcode "00ooo000" { o: alu_op }; ModRM { reg: r<8> } }
        operands (op: alu_op, dst: rm<8>, src: r<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        lock if dst.is_mem && op != AluOp::Cmp;
        semantics { let r = alu<8>(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_rm_r<const W: width> in [16, 32] {
        mnemonic alu_name(op);
        encoding { when operand_size() == W; opcode "00ooo001" { o: alu_op }; ModRM { reg: r<W> } }
        operands (op: alu_op, dst: rm<W>, src: r<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        lock if dst.is_mem && op != AluOp::Cmp;
        semantics { let r = alu<W>(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_r8_rm8 {
        mnemonic alu_name(op);
        encoding { opcode "00ooo010" { o: alu_op }; ModRM { reg: r<8> } }
        operands (op: alu_op, dst: r<8>, src: rm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        semantics { let r = alu<8>(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_r_rm<const W: width> in [16, 32] {
        mnemonic alu_name(op);
        encoding { when operand_size() == W; opcode "00ooo011" { o: alu_op }; ModRM { reg: r<W> } }
        operands (op: alu_op, dst: r<W>, src: rm<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        semantics { let r = alu<W>(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_al_imm8 {
        mnemonic alu_name(op);
        encoding { opcode "00ooo100" { o: alu_op }; Imm<8> }
        operands (op: alu_op, src: imm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        semantics { let r = alu<8>(op, AL, src); if op != AluOp::Cmp { AL = r; } }
    }
    instruction Alu_ax_imm<const W: width> in [16, 32] {
        mnemonic alu_name(op);
        encoding { when operand_size() == W; opcode "00ooo101" { o: alu_op }; Imm<W> }
        operands (op: alu_op, src: imm<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            let a = r<W>.select(0);
            let r = alu<W>(op, a, src);
            if op != AluOp::Cmp { r<W>.select(0) = r; }
        }
    }
    /// 80 and 82 are the same instruction.
    instruction Alu_rm8_imm8 {
        mnemonic alu_name(op);
        encoding { opcode "100000-0"; ModRM { reg: alu_op } Imm<8> }
        operands (op: alu_op, dst: rm<8>, src: imm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        lock if dst.is_mem && op != AluOp::Cmp;
        semantics { let r = alu<8>(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_rm_imm<const W: width> in [16, 32] {
        mnemonic alu_name(op);
        encoding { when operand_size() == W; opcode 0x81; ModRM { reg: alu_op } Imm<W> }
        operands (op: alu_op, dst: rm<W>, src: imm<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        lock if dst.is_mem && op != AluOp::Cmp;
        semantics { let r = alu<W>(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }
    instruction Alu_rm_simm8<const W: width> in [16, 32] {
        mnemonic alu_name(op);
        encoding { when operand_size() == W; opcode 0x83; ModRM { reg: alu_op } Disp8 }
        operands (op: alu_op, dst: rm<W>, src: simm8<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        lock if dst.is_mem && op != AluOp::Cmp;
        semantics { let r = alu<W>(op, dst, src); if op != AluOp::Cmp { dst = r; } }
    }

    /// INC and DEC leave CF alone.
    instruction Inc_r<const W: width> in [16, 32] {
        mnemonic "inc";
        encoding { when operand_size() == W; opcode "01000rrr" { r: r<W> } }
        operands (dst: r<W>);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        semantics { let c = CF; dst = alu<W>(AluOp::Add, dst, 1); EFLAGS.CF = c; }
    }
    instruction Dec_r<const W: width> in [16, 32] {
        mnemonic "dec";
        encoding { when operand_size() == W; opcode "01001rrr" { r: r<W> } }
        operands (dst: r<W>);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        semantics { let c = CF; dst = alu<W>(AluOp::Sub, dst, 1); EFLAGS.CF = c; }
    }

    // -- MOV ---------------------------------------------------------------------------------

    instruction Mov_rm8_r8 {
        mnemonic "mov";
        encoding { opcode 0x88; ModRM { reg: r<8> } }
        operands (dst: rm<8>, src: r<8>);
        semantics { dst = src; }
    }
    instruction Mov_rm_r<const W: width> in [16, 32] {
        mnemonic "mov";
        encoding { when operand_size() == W; opcode 0x89; ModRM { reg: r<W> } }
        operands (dst: rm<W>, src: r<W>);
        semantics { dst = src; }
    }
    instruction Mov_r8_rm8 {
        mnemonic "mov";
        encoding { opcode 0x8A; ModRM { reg: r<8> } }
        operands (dst: r<8>, src: rm<8>);
        semantics { dst = src; }
    }
    instruction Mov_r_rm<const W: width> in [16, 32] {
        mnemonic "mov";
        encoding { when operand_size() == W; opcode 0x8B; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: rm<W>);
        semantics { dst = src; }
    }
    instruction Mov_r8_imm8 {
        mnemonic "mov";
        encoding { opcode "10110rrr" { r: r<8> }; Imm<8> }
        operands (dst: r<8>, src: imm<8>);
        semantics { dst = src; }
    }
    instruction Mov_r_imm<const W: width> in [16, 32] {
        mnemonic "mov";
        encoding { when operand_size() == W; opcode "10111rrr" { r: r<W> }; Imm<W> }
        operands (dst: r<W>, src: imm<W>);
        semantics { dst = src; }
    }
    instruction Mov_rm8_imm8 {
        mnemonic "mov";
        encoding { opcode 0xC6; ModRM { reg: 0 } Imm<8> }
        operands (dst: rm<8>, src: imm<8>);
        semantics { dst = src; }
    }
    instruction Mov_rm_imm<const W: width> in [16, 32] {
        mnemonic "mov";
        encoding { when operand_size() == W; opcode 0xC7; ModRM { reg: 0 } Imm<W> }
        operands (dst: rm<W>, src: imm<W>);
        semantics { dst = src; }
    }

    // -- stack ----------------------------------------------------------------------------------

    /// PUSH SP pushes the value SP had before the push.
    instruction Push_r<const W: width> in [16, 32] {
        mnemonic "push";
        encoding { when operand_size() == W; opcode "01010rrr" { r: r<W> } }
        operands (src: r<W>);
        semantics { push<W>(src); }
    }
    instruction Pop_r<const W: width> in [16, 32] {
        mnemonic "pop";
        encoding { when operand_size() == W; opcode "01011rrr" { r: r<W> } }
        operands (dst: r<W>);
        semantics { dst = pop<W>(); }
    }
    instruction Pushf<const W: width> in [16, 32] {
        mnemonic "pushf";
        encoding { when operand_size() == W; opcode 0x9C; }
        semantics { v86_iopl(); if W == 32 { push<32>(EFLAGS & 0x0000FFFF); } else { push<16>(FLAGS); } }
    }
    instruction Popf<const W: width> in [16, 32] {
        mnemonic "popf";
        encoding { when operand_size() == W; opcode 0x9D; }
        flags { modifies: [OF, DF, IF, TF, SF, ZF, AF, PF, CF]; }
        semantics { v86_iopl(); load_flags(pop<W>() as u32, W == 32); }
    }

    // -- near transfers ----------------------------------------------------------------------

    operand_kind rel8 : u32 from d: Disp8 { read => (d.value as i32) as u32; }
    operand_kind rel<16> : u32 from d: Imm<16> { read => (d.value as i16 as i32) as u32; }
    operand_kind rel<32> : u32 from d: Imm<32> { read => d.value; }

    instruction Jcc {
        mnemonic "jcc";
        encoding { opcode "0111cccc" { c: cond }; Disp8 }
        operands (c: cond, rel: rel8);
        semantics { if condition(c) { jump_near(EIP + rel); } }
    }
    instruction Jcc_near<const W: width> in [16, 32] {
        mnemonic "jcc";
        encoding { when operand_size() == W; opcode [0x0F, "1000cccc"] { c: cond }; Imm<W> }
        operands (c: cond, rel: rel<W>);
        semantics { if condition(c) { jump_near(EIP + rel); } }
    }
    instruction Jmp_rel8 {
        mnemonic "jmp";
        encoding { opcode 0xEB; Disp8 }
        operands (rel: rel8);
        semantics { jump_near(EIP + rel); }
    }
    instruction Jmp_rel<const W: width> in [16, 32] {
        mnemonic "jmp";
        encoding { when operand_size() == W; opcode 0xE9; Imm<W> }
        operands (rel: rel<W>);
        semantics { jump_near(EIP + rel); }
    }
    instruction Call_rel<const W: width> in [16, 32] {
        mnemonic "call";
        encoding { when operand_size() == W; opcode 0xE8; Imm<W> }
        operands (rel: rel<W>);
        semantics {
            let t = near_target(EIP + rel);
            if W == 32 { push<32>(EIP); } else { push<16>(IP); }
            EIP = t;
        }
    }
    instruction Ret<const W: width> in [16, 32] {
        mnemonic "ret";
        encoding { when operand_size() == W; opcode 0xC3; }
        semantics {
            let t = near_target(peek<W>(0) as u32);
            release(W / 8);
            EIP = t;
        }
    }
    instruction Ret_imm<const W: width> in [16, 32] {
        mnemonic "ret";
        encoding { when operand_size() == W; opcode 0xC2; Imm<16> }
        operands (n: imm<16>);
        semantics {
            let t = near_target(peek<W>(0) as u32);
            release((W / 8) + (n as u32));
            EIP = t;
        }
    }

    // -- shifts and rotates --------------------------------------------------------------------
    //
    // The count is masked to 5 bits; a zero count changes nothing (and a
    // memory operand is read but not written). One routine serves every
    // width, on a 64-bit working value.

    enum ShiftOp : u3 { Rol, Ror, Rcl, Rcr, Shl, Shr, Sal, Sar }
    operand_kind shift_op : ShiftOp { value(n: u3) => n as ShiftOp; }

    fn shift_name(op: ShiftOp) -> str {
        return match op {
            ShiftOp::Rol => "rol", ShiftOp::Ror => "ror", ShiftOp::Rcl => "rcl", ShiftOp::Rcr => "rcr",
            ShiftOp::Shl => "shl", ShiftOp::Shr => "shr", ShiftOp::Sal => "sal", ShiftOp::Sar => "sar",
        };
    }

    fn is_shift(op: ShiftOp) -> bool {
        return op == ShiftOp::Shl || op == ShiftOp::Sal || op == ShiftOp::Shr || op == ShiftOp::Sar;
    }

    /// `v` (its low `w` bits) shifted or rotated by `count`; sets the flags.
    fn shift(op: ShiftOp, v: u32, w: u8, count: u8) -> u32 {
        let n = (count & 0x1F) as u64;
        if n == 0 { return v; }
        let wd = w as u64;
        let mask = (1_u64 << wd) - 1;
        let x = (v as u64) & mask;
        let msb = wd - 1;
        let c = CF as u64;
        let sx = ((x << (64 - wd)) as i64) >> (64 - wd);
        let (r, cf): (u64, u64) = match op {
            ShiftOp::Rol => {
                let k = n % wd;
                let r = ((x << k) | (x >> (wd - k))) & mask;
                (r, r & 1)
            },
            ShiftOp::Ror => {
                let k = n % wd;
                let r = ((x >> k) | (x << (wd - k))) & mask;
                (r, (r >> msb) & 1)
            },
            ShiftOp::Rcl => {
                let k = n % (wd + 1);
                let y = x | (c << wd);
                let wide = (mask << 1) | 1;
                let r = ((y << k) | (y >> (wd + 1 - k))) & wide;
                (r & mask, (r >> wd) & 1)
            },
            ShiftOp::Rcr => {
                let k = n % (wd + 1);
                let y = x | (c << wd);
                let wide = (mask << 1) | 1;
                let r = ((y >> k) | (y << (wd + 1 - k))) & wide;
                (r & mask, (r >> wd) & 1)
            },
            ShiftOp::Shl | ShiftOp::Sal => {
                let t = x << n;
                (t & mask, (t >> wd) & 1)
            },
            ShiftOp::Shr => ((x >> n) & mask, (x >> (n - 1)) & 1),
            ShiftOp::Sar => (((sx >> n) as u64) & mask, ((sx >> (n - 1)) as u64) & 1),
        };
        EFLAGS.CF = cf as u1;
        let top = (r >> msb) & 1;
        let next = (r >> (msb - 1)) & 1;
        let of: u64 = match op {
            ShiftOp::Rol | ShiftOp::Rcl | ShiftOp::Shl | ShiftOp::Sal => top ^ cf,
            ShiftOp::Ror | ShiftOp::Rcr => top ^ next,
            ShiftOp::Shr => (x >> msb) & 1,
            ShiftOp::Sar => 0,
        };
        EFLAGS.OF = of as u1;
        if is_shift(op) {
            EFLAGS.SF = top as u1;
            EFLAGS.ZF = (r == 0) as u1;
            EFLAGS.PF = Parity8(r as u8);
        }
        return r as u32;
    }

    instruction Shift_rm8_1 {
        mnemonic shift_name(op);
        encoding { opcode 0xD0; ModRM { reg: shift_op } }
        operands (op: shift_op, dst: rm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_shift(op)]; }
        semantics { dst = shift(op, dst as u32, 8, 1) as u8; }
    }
    instruction Shift_rm_1<const W: width> in [16, 32] {
        mnemonic shift_name(op);
        encoding { when operand_size() == W; opcode 0xD1; ModRM { reg: shift_op } }
        operands (op: shift_op, dst: rm<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF if is_shift(op)]; }
        semantics { dst = shift(op, dst as u32, W, 1) as u<W>; }
    }
    instruction Shift_rm8_cl {
        mnemonic shift_name(op);
        encoding { opcode 0xD2; ModRM { reg: shift_op } }
        operands (op: shift_op, dst: rm<8>);
        flags {
            modifies: [OF, SF, ZF, AF, PF, CF];
            undefined: [OF if (CL & 0x1F) != 1, AF if is_shift(op) && (CL & 0x1F) != 0, CF if is_shift(op) && (CL & 0x1F) > 8];
        }
        semantics { let v = shift(op, dst as u32, 8, CL) as u8; if (CL & 0x1F) != 0 { dst = v; } }
    }
    instruction Shift_rm_cl<const W: width> in [16, 32] {
        mnemonic shift_name(op);
        encoding { when operand_size() == W; opcode 0xD3; ModRM { reg: shift_op } }
        operands (op: shift_op, dst: rm<W>);
        flags {
            modifies: [OF, SF, ZF, AF, PF, CF];
            undefined: [OF if (CL & 0x1F) != 1, AF if is_shift(op) && (CL & 0x1F) != 0, CF if is_shift(op) && (CL & 0x1F) > W];
        }
        semantics { let v = shift(op, dst as u32, W, CL) as u<W>; if (CL & 0x1F) != 0 { dst = v; } }
    }
    instruction Shift_rm8_imm8 {
        mnemonic shift_name(op);
        encoding { opcode 0xC0; ModRM { reg: shift_op } Imm<8> }
        operands (op: shift_op, dst: rm<8>, n: imm<8>);
        flags {
            modifies: [OF, SF, ZF, AF, PF, CF];
            undefined: [OF if (n & 0x1F) != 1, AF if is_shift(op) && (n & 0x1F) != 0, CF if is_shift(op) && (n & 0x1F) > 8];
        }
        semantics { let v = shift(op, dst as u32, 8, n) as u8; if (n & 0x1F) != 0 { dst = v; } }
    }
    instruction Shift_rm_imm8<const W: width> in [16, 32] {
        mnemonic shift_name(op);
        encoding { when operand_size() == W; opcode 0xC1; ModRM { reg: shift_op } Imm<8> }
        operands (op: shift_op, dst: rm<W>, n: imm<8>);
        flags {
            modifies: [OF, SF, ZF, AF, PF, CF];
            undefined: [OF if (n & 0x1F) != 1, AF if is_shift(op) && (n & 0x1F) != 0, CF if is_shift(op) && (n & 0x1F) > W];
        }
        semantics { let v = shift(op, dst as u32, W, n) as u<W>; if (n & 0x1F) != 0 { dst = v; } }
    }

    // -- TEST, NOT, NEG, MUL, DIV ------------------------------------------------------------------

    instruction Test_rm8_r8 {
        mnemonic "test";
        encoding { opcode 0x84; ModRM { reg: r<8> } }
        operands (a: rm<8>, b: r<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu<8>(AluOp::And, a, b); }
    }
    instruction Test_rm_r<const W: width> in [16, 32] {
        mnemonic "test";
        encoding { when operand_size() == W; opcode 0x85; ModRM { reg: r<W> } }
        operands (a: rm<W>, b: r<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu<W>(AluOp::And, a, b); }
    }
    instruction Test_al_imm8 {
        mnemonic "test";
        encoding { opcode 0xA8; Imm<8> }
        operands (b: imm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu<8>(AluOp::And, AL, b); }
    }
    instruction Test_ax_imm<const W: width> in [16, 32] {
        mnemonic "test";
        encoding { when operand_size() == W; opcode 0xA9; Imm<W> }
        operands (b: imm<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu<W>(AluOp::And, r<W>.select(0), b); }
    }
    /// F6 /1 and F7 /1 are undocumented aliases of /0.
    instruction Test_rm8_imm8 {
        mnemonic "test";
        encoding { opcode 0xF6; ModRM { reg: 0 } Imm<8> }
        operands (a: rm<8>, b: imm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu<8>(AluOp::And, a, b); }
    }
    instruction Test_rm8_imm8_alias {
        mnemonic "test";
        encoding { opcode 0xF6; ModRM { reg: 1 } Imm<8> }
        operands (a: rm<8>, b: imm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu<8>(AluOp::And, a, b); }
    }
    instruction Not_rm8 {
        mnemonic "not";
        encoding { opcode 0xF6; ModRM { reg: 2 } }
        operands (dst: rm<8>);
        lock if dst.is_mem;
        semantics { dst = ~dst; }
    }
    instruction Neg_rm8 {
        mnemonic "neg";
        encoding { opcode 0xF6; ModRM { reg: 3 } }
        operands (dst: rm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        lock if dst.is_mem;
        semantics { dst = alu<8>(AluOp::Sub, 0, dst); }
    }
    instruction Mul_rm8 {
        mnemonic "mul";
        encoding { opcode 0xF6; ModRM { reg: 4 } }
        operands (src: rm<8>);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics {
            AX = (AL as u16) * (src as u16);
            EFLAGS.CF = (AH != 0) as u1;
            EFLAGS.OF = (AH != 0) as u1;
        }
    }
    instruction Imul_rm8 {
        mnemonic "imul";
        encoding { opcode 0xF6; ModRM { reg: 5 } }
        operands (src: rm<8>);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics {
            let p = ((AL as i8) as i16) * ((src as i8) as i16);
            AX = p as u16;
            let wide = p != ((p as i8) as i16);
            EFLAGS.CF = wide as u1;
            EFLAGS.OF = wide as u1;
        }
    }
    instruction Div_rm8 {
        mnemonic "div";
        encoding { opcode 0xF6; ModRM { reg: 6 } }
        operands (src: rm<8>);
        flags { undefined: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            let d = src as u16;
            if d == 0 { raise DE; }
            let q = AX / d;
            if q > 0xFF { raise DE; }
            let r = AX % d;
            AL = q as u8;
            AH = r as u8;
        }
    }
    instruction Idiv_rm8 {
        mnemonic "idiv";
        encoding { opcode 0xF6; ModRM { reg: 7 } }
        operands (src: rm<8>);
        flags { undefined: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            let a = (AX as i16) as i32;
            let d = ((src as i8) as i16) as i32;
            if d == 0 { raise DE; }
            let q = a / d;
            if q > 127 || q < -128 { raise DE; }
            let r = a % d;
            AL = q as u8;
            AH = r as u8;
        }
    }
    instruction Test_rm_imm<const W: width> in [16, 32] {
        mnemonic "test";
        encoding { when operand_size() == W; opcode 0xF7; ModRM { reg: 0 } Imm<W> }
        operands (a: rm<W>, b: imm<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu<W>(AluOp::And, a, b); }
    }
    instruction Test_rm_imm_alias<const W: width> in [16, 32] {
        mnemonic "test";
        encoding { when operand_size() == W; opcode 0xF7; ModRM { reg: 1 } Imm<W> }
        operands (a: rm<W>, b: imm<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [AF]; }
        semantics { let _ = alu<W>(AluOp::And, a, b); }
    }
    instruction Not_rm<const W: width> in [16, 32] {
        mnemonic "not";
        encoding { when operand_size() == W; opcode 0xF7; ModRM { reg: 2 } }
        operands (dst: rm<W>);
        lock if dst.is_mem;
        semantics { dst = ~dst; }
    }
    instruction Neg_rm<const W: width> in [16, 32] {
        mnemonic "neg";
        encoding { when operand_size() == W; opcode 0xF7; ModRM { reg: 3 } }
        operands (dst: rm<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; }
        lock if dst.is_mem;
        semantics { dst = alu<W>(AluOp::Sub, 0, dst); }
    }
    instruction Mul_rm<const W: width> in [16, 32] {
        mnemonic "mul";
        encoding { when operand_size() == W; opcode 0xF7; ModRM { reg: 4 } }
        operands (src: rm<W>);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics {
            let hi = if W == 32 {
                let p = (EAX as u64) * (src as u64);
                EAX = p as u32;
                EDX = (p >> 32) as u32;
                EDX != 0
            } else {
                let p = (AX as u32) * (src as u32);
                AX = p as u16;
                DX = (p >> 16) as u16;
                DX != 0
            };
            EFLAGS.CF = hi as u1;
            EFLAGS.OF = hi as u1;
        }
    }
    instruction Imul_rm<const W: width> in [16, 32] {
        mnemonic "imul";
        encoding { when operand_size() == W; opcode 0xF7; ModRM { reg: 5 } }
        operands (src: rm<W>);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics {
            let wide = if W == 32 {
                let p = ((EAX as i32) as i64) * ((src as i32) as i64);
                EAX = p as u32;
                EDX = (p >> 32) as u32;
                p != ((p as i32) as i64)
            } else {
                let p = ((AX as i16) as i32) * ((src as i16) as i32);
                AX = p as u16;
                DX = (p >> 16) as u16;
                p != ((p as i16) as i32)
            };
            EFLAGS.CF = wide as u1;
            EFLAGS.OF = wide as u1;
        }
    }
    instruction Div_rm<const W: width> in [16, 32] {
        mnemonic "div";
        encoding { when operand_size() == W; opcode 0xF7; ModRM { reg: 6 } }
        operands (src: rm<W>);
        flags { undefined: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            let d = src as u64;
            if d == 0 { raise DE; }
            if W == 32 {
                let n = ((EDX as u64) << 32) | (EAX as u64);
                let q = n / d;
                if q > 0xFFFFFFFF { raise DE; }
                EAX = q as u32;
                EDX = (n % d) as u32;
            } else {
                let n = ((DX as u64) << 16) | (AX as u64);
                let q = n / d;
                if q > 0xFFFF { raise DE; }
                AX = q as u16;
                DX = (n % d) as u16;
            }
        }
    }
    instruction Idiv_rm<const W: width> in [16, 32] {
        mnemonic "idiv";
        encoding { when operand_size() == W; opcode 0xF7; ModRM { reg: 7 } }
        operands (src: rm<W>);
        flags { undefined: [OF, SF, ZF, AF, PF, CF]; }
        semantics {
            if W == 32 {
                let n = ((((EDX as u64) << 32) | (EAX as u64)) as i64) as i128;
                let d = ((src as i32) as i64) as i128;
                if d == 0 { raise DE; }
                let q = n / d;
                if q > 2147483647 || q < -2147483648 { raise DE; }
                EAX = q as u32;
                EDX = (n % d) as u32;
            } else {
                let n = ((((DX as u32) << 16) | (AX as u32)) as i32) as i64;
                let d = ((src as i16) as i32) as i64;
                if d == 0 { raise DE; }
                let q = n / d;
                if q > 32767 || q < -32768 { raise DE; }
                AX = q as u16;
                DX = (n % d) as u16;
            }
        }
    }

    // -- XCHG, sign extension, LEA ---------------------------------------------------------------

    /// XCHG with memory locks the bus by itself, and accepts LOCK.
    instruction Xchg_rm8_r8 {
        mnemonic "xchg";
        encoding { opcode 0x86; ModRM { reg: r<8> } }
        operands (a: rm<8>, b: r<8>);
        lock if a.is_mem;
        semantics { let x = a; let y = b; a = y; b = x; }
    }
    instruction Xchg_rm_r<const W: width> in [16, 32] {
        mnemonic "xchg";
        encoding { when operand_size() == W; opcode 0x87; ModRM { reg: r<W> } }
        operands (a: rm<W>, b: r<W>);
        lock if a.is_mem;
        semantics { let x = a; let y = b; a = y; b = x; }
    }
    /// 90 is `xchg ax, ax`: NOP.
    instruction Xchg_ax_r<const W: width> in [16, 32] {
        mnemonic "xchg";
        encoding { when operand_size() == W; opcode "10010rrr" { r: r<W> } }
        operands (b: r<W>);
        semantics { let x = r<W>.select(0); let y = b; r<W>.select(0) = y; b = x; }
    }
    /// CBW and CWDE.
    instruction Cbw<const W: width> in [16, 32] {
        mnemonic "cbw";
        encoding { when operand_size() == W; opcode 0x98; }
        semantics { if W == 32 { EAX = (AX as i16 as i32) as u32; } else { AX = (AL as i8) as u16; } }
    }
    /// CWD and CDQ.
    instruction Cwd<const W: width> in [16, 32] {
        mnemonic "cwd";
        encoding { when operand_size() == W; opcode 0x99; }
        semantics {
            if W == 32 { EDX = if EAX[31] == 1 { 0xFFFFFFFF } else { 0 }; }
            else { DX = if AX[15] == 1 { 0xFFFF } else { 0 }; }
        }
    }
    /// The offset of a ModRM memory form, at the address size.
    operand_kind mem_offset : u32 from m: ModRM {
        is_mem => m.mod != 3;
        /// Address work, for timing.
        ea => if (adsize ^ (CS.big as u1)) == 1 && m.mod != 3 && m.rm == 4 { EaWork(m.mod, m.rm, true, m.tail.Sib.index, m.tail.Sib.base) } else { EaWork(m.mod, m.rm, (adsize ^ (CS.big as u1)) == 1, 4, 0) };
        read => effective_address(m).off;
    }
    /// The register form is #UD.
    instruction Lea<const W: width> in [16, 32] {
        mnemonic "lea";
        encoding { when operand_size() == W; opcode 0x8D; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: mem_offset);
        semantics { if !src.is_mem { raise UD; } dst = src as u<W>; }
    }

    // -- FE/FF groups, 8F -----------------------------------------------------------------------------

    instruction Inc_rm8 {
        mnemonic "inc";
        encoding { opcode 0xFE; ModRM { reg: 0 } }
        operands (dst: rm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        lock if dst.is_mem;
        semantics { let c = CF; dst = alu<8>(AluOp::Add, dst, 1); EFLAGS.CF = c; }
    }
    instruction Dec_rm8 {
        mnemonic "dec";
        encoding { opcode 0xFE; ModRM { reg: 1 } }
        operands (dst: rm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        lock if dst.is_mem;
        semantics { let c = CF; dst = alu<8>(AluOp::Sub, dst, 1); EFLAGS.CF = c; }
    }
    instruction Inc_rm<const W: width> in [16, 32] {
        mnemonic "inc";
        encoding { when operand_size() == W; opcode 0xFF; ModRM { reg: 0 } }
        operands (dst: rm<W>);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        lock if dst.is_mem;
        semantics { let c = CF; dst = alu<W>(AluOp::Add, dst, 1); EFLAGS.CF = c; }
    }
    instruction Dec_rm<const W: width> in [16, 32] {
        mnemonic "dec";
        encoding { when operand_size() == W; opcode 0xFF; ModRM { reg: 1 } }
        operands (dst: rm<W>);
        flags { modifies: [OF, SF, ZF, AF, PF]; }
        lock if dst.is_mem;
        semantics { let c = CF; dst = alu<W>(AluOp::Sub, dst, 1); EFLAGS.CF = c; }
    }
    instruction Call_rm<const W: width> in [16, 32] {
        mnemonic "call";
        encoding { when operand_size() == W; opcode 0xFF; ModRM { reg: 2 } }
        operands (target: rm<W>);
        semantics {
            let t = near_target(target as u32);
            if W == 32 { push<32>(EIP); } else { push<16>(IP); }
            EIP = t;
        }
    }
    instruction Jmp_rm<const W: width> in [16, 32] {
        mnemonic "jmp";
        encoding { when operand_size() == W; opcode 0xFF; ModRM { reg: 4 } }
        operands (target: rm<W>);
        semantics { jump_near(target as u32); }
    }
    instruction Push_rm<const W: width> in [16, 32] {
        mnemonic "push";
        encoding { when operand_size() == W; opcode 0xFF; ModRM { reg: 6 } }
        operands (src: rm<W>);
        semantics { let v = src; push<W>(v); }
    }
    instruction Pop_rm<const W: width> in [16, 32] {
        mnemonic "pop";
        encoding { when operand_size() == W; opcode 0x8F; ModRM { reg: 0 } }
        operands (dst: pop_rm<W>);
        semantics { dst = peek<W>(0); }
    }

    // -- more stack, three-operand IMUL ------------------------------------------------------------

    instruction Push_imm<const W: width> in [16, 32] {
        mnemonic "push";
        encoding { when operand_size() == W; opcode 0x68; Imm<W> }
        operands (v: imm<W>);
        semantics { push<W>(v); }
    }
    instruction Push_simm8<const W: width> in [16, 32] {
        mnemonic "push";
        encoding { when operand_size() == W; opcode 0x6A; Disp8 }
        operands (v: simm8<W>);
        semantics { push<W>(v); }
    }

    fn imul<const W: width> in [16, 32](a: u<W>, b: u<W>) -> u<W> {
        let p = ((a as i<W>) as i64) * ((b as i<W>) as i64);
        let wide = p != ((p as i<W>) as i64);
        EFLAGS.CF = wide as u1;
        EFLAGS.OF = wide as u1;
        return p as u<W>;
    }
    instruction Imul_r_rm_imm<const W: width> in [16, 32] {
        mnemonic "imul";
        encoding { when operand_size() == W; opcode 0x69; ModRM { reg: r<W> } Imm<W> }
        operands (dst: r<W>, src: rm<W>, k: imm<W>);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics { dst = imul<W>(src, k); }
    }
    instruction Imul_r_rm_simm8<const W: width> in [16, 32] {
        mnemonic "imul";
        encoding { when operand_size() == W; opcode 0x6B; ModRM { reg: r<W> } Disp8 }
        operands (dst: r<W>, src: rm<W>, k: simm8<W>);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics { dst = imul<W>(src, k); }
    }
    instruction Imul_r_rm<const W: width> in [16, 32] {
        mnemonic "imul";
        encoding { when operand_size() == W; opcode [0x0F, 0xAF]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: rm<W>);
        flags { modifies: [OF, CF]; undefined: [SF, ZF, AF, PF]; }
        semantics { dst = imul<W>(dst, src); }
    }

    // -- direct memory offsets, loops, XLAT --------------------------------------------------------

    operand_kind moffs<16> : u32 from m: Moffs<16> { read => m.off as u32; }
    operand_kind moffs<32> : u32 from m: Moffs<32> { read => m.off; }

    instruction Mov_al_moffs<const A: width> in [16, 32] {
        mnemonic "mov";
        encoding { when address_size() == A; opcode 0xA0; Moffs<A> }
        operands (o: moffs<A>);
        semantics { AL = seg_read<8>(src_seg(), o); }
    }
    instruction Mov_ax_moffs<const A: width> in [16, 32] {
        mnemonic "mov";
        encoding { when address_size() == A; opcode 0xA1; Moffs<A> }
        operands (o: moffs<A>);
        semantics {
            if operand_size() == 32 { EAX = seg_read<32>(src_seg(), o); }
            else { AX = seg_read<16>(src_seg(), o); }
        }
    }
    instruction Mov_moffs_al<const A: width> in [16, 32] {
        mnemonic "mov";
        encoding { when address_size() == A; opcode 0xA2; Moffs<A> }
        operands (o: moffs<A>);
        semantics { seg_write<8>(src_seg(), o, AL); }
    }
    instruction Mov_moffs_ax<const A: width> in [16, 32] {
        mnemonic "mov";
        encoding { when address_size() == A; opcode 0xA3; Moffs<A> }
        operands (o: moffs<A>);
        semantics {
            if operand_size() == 32 { seg_write<32>(src_seg(), o, EAX); }
            else { seg_write<16>(src_seg(), o, AX); }
        }
    }

    /// The count register is CX or ECX by the address size.
    fn count_zero() -> bool { return if address_size() == 32 { ECX == 0 } else { CX == 0 }; }
    /// Decrements the count register; whether it is still nonzero.
    fn count_down() -> bool {
        if address_size() == 32 { ECX = ECX - 1; return ECX != 0; }
        CX = CX - 1;
        return CX != 0;
    }

    instruction Loopne {
        mnemonic "loopne";
        encoding { opcode 0xE0; Disp8 }
        operands (rel: rel8);
        semantics { let t = EIP + rel; if count_down() && ZF == 0 { jump_near(t); } }
    }
    instruction Loope {
        mnemonic "loope";
        encoding { opcode 0xE1; Disp8 }
        operands (rel: rel8);
        semantics { let t = EIP + rel; if count_down() && ZF == 1 { jump_near(t); } }
    }
    instruction Loop {
        mnemonic "loop";
        encoding { opcode 0xE2; Disp8 }
        operands (rel: rel8);
        semantics { let t = EIP + rel; if count_down() { jump_near(t); } }
    }
    instruction Jcxz {
        mnemonic "jcxz";
        encoding { opcode 0xE3; Disp8 }
        operands (rel: rel8);
        semantics { if count_zero() { jump_near(EIP + rel); } }
    }
    instruction Xlat {
        mnemonic "xlat";
        encoding { opcode 0xD7; }
        semantics {
            let o = if address_size() == 32 { EBX + (AL as u32) } else { (BX + (AL as u16)) as u32 };
            AL = seg_read<8>(src_seg(), o);
        }
    }
    instruction Lahf { mnemonic "lahf"; encoding { opcode 0x9F; } semantics { AH = FLAGS as u8; } }
    instruction Sahf {
        mnemonic "sahf";
        encoding { opcode 0x9E; }
        flags { modifies: [SF, ZF, AF, PF, CF]; }
        semantics { FLAGS = (FLAGS & 0xFF00) | ((AH as u16) & 0x00D5) | 0x0002; }
    }
    /// Undocumented: AL = CF ? FF : 00.
    instruction Salc { mnemonic "salc"; encoding { opcode 0xD6; } semantics { AL = if CF == 1 { 0xFF } else { 0x00 }; } }

    // -- BCD adjustment ----------------------------------------------------------------------------

    instruction Daa {
        mnemonic "daa";
        encoding { opcode 0x27; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF]; }
        semantics {
            let old_al = AL;
            let old_cf = CF;
            let lo = (AL & 0x0F) > 9 || AF == 1;
            let a1 = if lo { AL + 6 } else { AL };
            let hi = old_al > 0x99 || old_cf == 1;
            AL = if hi { a1 + 0x60 } else { a1 };
            EFLAGS.AF = lo as u1;
            EFLAGS.CF = hi as u1;
            EFLAGS.SF = AL[7];
            EFLAGS.ZF = (AL == 0) as u1;
            EFLAGS.PF = Parity8(AL);
        }
    }
    instruction Das {
        mnemonic "das";
        encoding { opcode 0x2F; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF]; }
        semantics {
            let old_al = AL;
            let old_cf = CF;
            let lo = (AL & 0x0F) > 9 || AF == 1;
            let a1 = if lo { AL - 6 } else { AL };
            let hi = old_al > 0x99 || old_cf == 1;
            AL = if hi { a1 - 0x60 } else { a1 };
            EFLAGS.AF = lo as u1;
            EFLAGS.CF = (hi || (lo && old_al < 6)) as u1;
            EFLAGS.SF = AL[7];
            EFLAGS.ZF = (AL == 0) as u1;
            EFLAGS.PF = Parity8(AL);
        }
    }
    instruction Aaa {
        mnemonic "aaa";
        encoding { opcode 0x37; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF, SF, ZF, PF]; }
        semantics {
            let adj = (AL & 0x0F) > 9 || AF == 1;
            if adj { AX = AX + 0x0106; }
            AL = AL & 0x0F;
            EFLAGS.AF = adj as u1;
            EFLAGS.CF = adj as u1;
        }
    }
    instruction Aas {
        mnemonic "aas";
        encoding { opcode 0x3F; }
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF, SF, ZF, PF]; }
        semantics {
            let adj = (AL & 0x0F) > 9 || AF == 1;
            if adj { AX = AX - 0x0106; }
            AL = AL & 0x0F;
            EFLAGS.AF = adj as u1;
            EFLAGS.CF = adj as u1;
        }
    }
    instruction Aam {
        mnemonic "aam";
        encoding { opcode 0xD4; Imm<8> }
        operands (base: imm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF, AF, CF]; }
        semantics {
            if base == 0 { raise DE; }
            let a = AL;
            AH = a / base;
            AL = a % base;
            EFLAGS.SF = AL[7];
            EFLAGS.ZF = (AL == 0) as u1;
            EFLAGS.PF = Parity8(AL);
        }
    }
    instruction Aad {
        mnemonic "aad";
        encoding { opcode 0xD5; Imm<8> }
        operands (base: imm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF, AF, CF]; }
        semantics {
            AL = AL + AH * base;
            AH = 0;
            EFLAGS.SF = AL[7];
            EFLAGS.ZF = (AL == 0) as u1;
            EFLAGS.PF = Parity8(AL);
        }
    }

    // -- segment registers ----------------------------------------------------------------------------

    /// The segment register number in a ModRM `reg` (8C/8E): ES, CS, SS,
    /// DS, FS, GS; 6 and 7 are #UD.
    operand_kind sreg_n : u3 { value(n: u3) => n; }

    fn read_sreg(n: u3) -> u16 {
        return match n {
            0 => ES.selector, 1 => CS.selector, 2 => SS.selector, 3 => DS.selector,
            4 => FS.selector, 5 => GS.selector, _ => { raise UD; },
        };
    }

    /// Loading CS this way is #UD, as are 6 and 7. Loading SS inhibits
    /// interrupts for an instruction.
    fn write_sreg(n: u3, v: u16) {
        match n {
            0 => { ES = load_data_segment(v, ES); }
            2 => { SS = load_stack_segment(v, SS); INHIBIT = 1; }
            3 => { DS = load_data_segment(v, DS); }
            4 => { FS = load_data_segment(v, FS); }
            5 => { GS = load_data_segment(v, GS); }
            _ => { raise UD; }
        }
    }

    /// To memory the selector is a word at any operand size; to a 32-bit
    /// register it is zero-extended.
    instruction Mov_rm_sreg {
        mnemonic "mov";
        encoding { opcode 0x8C; ModRM { reg: sreg_n } }
        operands (n: sreg_n, dst: rm<16>);
        semantics {
            let v = read_sreg(n);
            if operand_size() == 32 && !dst.is_mem { r<32>.select(dst.index) = v as u32; } else { dst = v; }
        }
    }
    instruction Mov_sreg_rm {
        mnemonic "mov";
        encoding { opcode 0x8E; ModRM { reg: sreg_n } }
        operands (n: sreg_n, src: rm<16>);
        semantics { if n == 1 || n > 5 { raise UD; } write_sreg(n, src); }
    }
    /// A 32-bit push writes the selector zero-extended.
    fn push_sreg(n: u3) {
        let v = read_sreg(n);
        if operand_size() == 32 { push<32>(v as u32); } else { push<16>(v); }
    }
    /// The register is loaded before SP moves; a 32-bit pop reads only the
    /// selector's word.
    fn pop_sreg(n: u3) {
        let v = peek<16>(0);
        write_sreg(n, v);
        release(if operand_size() == 32 { 4_u32 } else { 2_u32 });
    }
    instruction Push_es { mnemonic "push"; encoding { opcode 0x06; } semantics { push_sreg(0); } }
    instruction Push_cs { mnemonic "push"; encoding { opcode 0x0E; } semantics { push_sreg(1); } }
    instruction Push_ss { mnemonic "push"; encoding { opcode 0x16; } semantics { push_sreg(2); } }
    instruction Push_ds { mnemonic "push"; encoding { opcode 0x1E; } semantics { push_sreg(3); } }
    instruction Push_fs { mnemonic "push"; encoding { opcode [0x0F, 0xA0]; } semantics { push_sreg(4); } }
    instruction Push_gs { mnemonic "push"; encoding { opcode [0x0F, 0xA8]; } semantics { push_sreg(5); } }
    instruction Pop_es { mnemonic "pop"; encoding { opcode 0x07; } semantics { pop_sreg(0); } }
    instruction Pop_ss { mnemonic "pop"; encoding { opcode 0x17; } semantics { pop_sreg(2); } }
    instruction Pop_ds { mnemonic "pop"; encoding { opcode 0x1F; } semantics { pop_sreg(3); } }
    instruction Pop_fs { mnemonic "pop"; encoding { opcode [0x0F, 0xA1]; } semantics { pop_sreg(4); } }
    instruction Pop_gs { mnemonic "pop"; encoding { opcode [0x0F, 0xA9]; } semantics { pop_sreg(5); } }

    // -- 386: SETcc, MOVZX, MOVSX ---------------------------------------------------------------------

    instruction Setcc {
        mnemonic "setcc";
        encoding { opcode [0x0F, "1001cccc"] { c: cond }; ModRM }
        operands (c: cond, dst: rm<8>);
        semantics { dst = if condition(c) { 1 } else { 0 }; }
    }
    instruction Movzx_r_rm8<const W: width> in [16, 32] {
        mnemonic "movzx";
        encoding { when operand_size() == W; opcode [0x0F, 0xB6]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: rm<8>);
        semantics { dst = src as u<W>; }
    }
    instruction Movzx_r_rm16<const W: width> in [16, 32] {
        mnemonic "movzx";
        encoding { when operand_size() == W; opcode [0x0F, 0xB7]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: rm<16>);
        semantics { dst = src as u<W>; }
    }
    instruction Movsx_r_rm8<const W: width> in [16, 32] {
        mnemonic "movsx";
        encoding { when operand_size() == W; opcode [0x0F, 0xBE]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: rm<8>);
        semantics { dst = ((src as i8) as i<W>) as u<W>; }
    }
    instruction Movsx_r_rm16<const W: width> in [16, 32] {
        mnemonic "movsx";
        encoding { when operand_size() == W; opcode [0x0F, 0xBF]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: rm<16>);
        semantics { dst = ((src as i16) as i<W>) as u<W>; }
    }

    // -- far transfers, interrupts ---------------------------------------------------------------
    //
    // In real mode a far target only loads CS's selector and base; the
    // offset is checked against CS's limit (which stays 0xFFFF), so a
    // 32-bit offset past it is #GP(0) before anything is pushed. Interrupts
    // push a 16-bit frame whatever the operand size.

    operand_kind far_ptr<16> : (off: u32, seg: u16) from p: FarPtr<16> { read => (off: p.off as u32, seg: p.seg); }
    operand_kind far_ptr<32> : (off: u32, seg: u16) from p: FarPtr<32> { read => (off: p.off, seg: p.seg); }
    /// A far pointer in memory (`m16:16`, `m16:32`): the offset, then the
    /// selector's word.
    operand_kind far_mem<const W: width> in [16, 32] : (off: u32, seg: u16) from m: ModRM {
        is_mem => m.mod != 3;
        /// Address work, for timing.
        ea => if (adsize ^ (CS.big as u1)) == 1 && m.mod != 3 && m.rm == 4 { EaWork(m.mod, m.rm, true, m.tail.Sib.index, m.tail.Sib.base) } else { EaWork(m.mod, m.rm, (adsize ^ (CS.big as u1)) == 1, 4, 0) };
        read => {
            let (s, o) = effective_address(m);
            let off = seg_read<W>(s, o);
            let seg = seg_read<16>(s, ea_next(o, W / 8));
            (off: off as u32, seg: seg)
        };
    }

    instruction Call_far<const W: width> in [16, 32] {
        mnemonic "call";
        encoding { when operand_size() == W; opcode 0x9A; FarPtr<W> }
        operands (target: far_ptr<W>);
        semantics { let t = target; call_far<W>(t.seg, t.off); }
    }
    instruction Jmp_far<const W: width> in [16, 32] {
        mnemonic "jmp";
        encoding { when operand_size() == W; opcode 0xEA; FarPtr<W> }
        operands (target: far_ptr<W>);
        semantics { let t = target; jump_far(t.seg, t.off); }
    }
    instruction Call_far_mem<const W: width> in [16, 32] {
        mnemonic "call";
        encoding { when operand_size() == W; opcode 0xFF; ModRM { reg: 3 } }
        operands (target: far_mem<W>);
        semantics { if !target.is_mem { raise UD; } let t = target; call_far<W>(t.seg, t.off); }
    }
    instruction Jmp_far_mem<const W: width> in [16, 32] {
        mnemonic "jmp";
        encoding { when operand_size() == W; opcode 0xFF; ModRM { reg: 5 } }
        operands (target: far_mem<W>);
        semantics { if !target.is_mem { raise UD; } let t = target; jump_far(t.seg, t.off); }
    }
    instruction Retf<const W: width> in [16, 32] {
        mnemonic "retf";
        encoding { when operand_size() == W; opcode 0xCB; }
        semantics { return_far<W>(0); }
    }
    instruction Retf_imm<const W: width> in [16, 32] {
        mnemonic "retf";
        encoding { when operand_size() == W; opcode 0xCA; Imm<16> }
        operands (n: imm<16>);
        semantics { return_far<W>(n); }
    }

    /// Reads the frame before changing anything.
    instruction Iret<const W: width> in [16, 32] {
        mnemonic "iret";
        encoding { when operand_size() == W; opcode 0xCF; }
        flags { modifies: [OF, DF, IF, TF, SF, ZF, AF, PF, CF]; }
        semantics { interrupt_return<W>(); }
    }
    instruction Int3 { mnemonic "int3"; encoding { opcode 0xCC; } semantics { interrupt(3, 2, false, 0); } }
    instruction Int_imm8 {
        mnemonic "int";
        encoding { opcode 0xCD; Imm<8> }
        operands (n: imm<8>);
        semantics { interrupt(n, 1, false, 0); }
    }
    instruction Into { mnemonic "into"; encoding { opcode 0xCE; } semantics { if OF == 1 { interrupt(4, 2, false, 0); } } }

    /// The signed bounds pair of BOUND.
    operand_kind bounds<const W: width> in [16, 32] : (lo: u<W>, hi: u<W>) from m: ModRM {
        is_mem => m.mod != 3;
        /// Address work, for timing.
        ea => if (adsize ^ (CS.big as u1)) == 1 && m.mod != 3 && m.rm == 4 { EaWork(m.mod, m.rm, true, m.tail.Sib.index, m.tail.Sib.base) } else { EaWork(m.mod, m.rm, (adsize ^ (CS.big as u1)) == 1, 4, 0) };
        read => {
            let (s, o) = effective_address(m);
            let lo = seg_read<W>(s, o);
            let hi = seg_read<W>(s, ea_next(o, W / 8));
            (lo: lo, hi: hi)
        };
    }
    /// #BR when the index is outside the signed pair; the register form is #UD.
    instruction Bound<const W: width> in [16, 32] {
        mnemonic "bound";
        encoding { when operand_size() == W; opcode 0x62; ModRM { reg: r<W> } }
        operands (idx: r<W>, lim: bounds<W>);
        semantics {
            if !lim.is_mem { raise UD; }
            let b = lim;
            let x = idx as i<W>;
            if x < (b.lo as i<W>) || x > (b.hi as i<W>) { raise BR; }
        }
    }

    // -- PUSHA, POPA, ENTER, LEAVE ---------------------------------------------------------------

    /// Pushes the SP value from before the first push. The 386 stores from
    /// the lowest address up (DI first); SP moves only once every store has
    /// succeeded.
    instruction Pusha<const W: width> in [16, 32] {
        mnemonic "pusha";
        encoding { when operand_size() == W; opcode 0x60; }
        semantics {
            let n = (W / 8) as u32;
            stack_write<W>(stack_top(0 - 8 * n), r<W>.select(7));
            stack_write<W>(stack_top(0 - 7 * n), r<W>.select(6));
            stack_write<W>(stack_top(0 - 6 * n), r<W>.select(5));
            stack_write<W>(stack_top(0 - 5 * n), r<W>.select(4));
            stack_write<W>(stack_top(0 - 4 * n), r<W>.select(3));
            stack_write<W>(stack_top(0 - 3 * n), r<W>.select(2));
            stack_write<W>(stack_top(0 - 2 * n), r<W>.select(1));
            stack_write<W>(stack_top(0 - n), r<W>.select(0));
            set_stack(stack_top(0 - 8 * n));
        }
    }
    /// Pops into each register in turn (a fault part-way leaves the ones
    /// already popped, but not SP); the saved SP is skipped, except that
    /// POPAD on the 16-bit stack takes ESP's upper half from it.
    instruction Popa<const W: width> in [16, 32] {
        mnemonic "popa";
        encoding { when operand_size() == W; opcode 0x61; }
        semantics {
            let n = (W / 8) as u32;
            r<W>.select(7) = peek<W>(0);
            r<W>.select(6) = peek<W>(n);
            r<W>.select(5) = peek<W>(2 * n);
            let sp = peek<W>(3 * n);
            r<W>.select(3) = peek<W>(4 * n);
            r<W>.select(2) = peek<W>(5 * n);
            r<W>.select(1) = peek<W>(6 * n);
            r<W>.select(0) = peek<W>(7 * n);
            let top = stack_top(8 * n);
            // POPAD on a 16-bit stack takes ESP's upper half from the frame.
            if W == 32 && !SS.big { ESP = ((sp as u32) & 0xFFFF0000) | top; } else { set_stack(top); }
        }
    }
    /// The nesting level is masked to 5 bits; level - 1 frame pointers are
    /// copied from the enclosing frame. SP and BP change only at the end.
    /// On a 16-bit stack a 32-bit frame pointer keeps ESP's upper half.
    instruction Enter<const W: width> in [16, 32] {
        mnemonic "enter";
        encoding { when operand_size() == W; opcode 0xC8; Imm<16>; Imm<8> }
        operands (size: imm<16>, level: imm<8>);
        semantics {
            let n = (W / 8) as u32;
            let lvl = level & 0x1F;
            let frame = stack_top(0 - n);
            let fp = (if SS.big { frame } else { (ESP & 0xFFFF0000) | frame }) as u<W>;
            stack_write<W>(frame, r<W>.select(5));
            let bp = if SS.big { EBP } else { BP as u32 };
            for i in 1..32 {
                if (i as u8) < lvl {
                    let off = n * (i as u32);
                    let v = stack_read<W>(stack_wrap(bp - off));
                    stack_write<W>(stack_wrap(frame - off), v);
                }
            }
            let depth = n * (lvl as u32);
            if lvl > 0 { stack_write<W>(stack_wrap(frame - depth), fp); }
            r<W>.select(5) = fp;
            set_stack(stack_wrap(frame - depth - (size as u32)));
        }
    }
    /// Reads the saved frame pointer before releasing the frame.
    instruction Leave<const W: width> in [16, 32] {
        mnemonic "leave";
        encoding { when operand_size() == W; opcode 0xC9; }
        semantics {
            let top = if SS.big { EBP } else { BP as u32 };
            let v = stack_read<W>(top);
            set_stack(stack_wrap(top + (W / 8)));
            r<W>.select(5) = v;
        }
    }

    // -- far pointer loads ---------------------------------------------------------------------------

    instruction Les<const W: width> in [16, 32] {
        mnemonic "les";
        encoding { when operand_size() == W; opcode 0xC4; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: far_mem<W>);
        semantics { if !src.is_mem { raise UD; } let p = src; ES = load_data_segment(p.seg, ES); dst = p.off as u<W>; }
    }
    instruction Lds<const W: width> in [16, 32] {
        mnemonic "lds";
        encoding { when operand_size() == W; opcode 0xC5; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: far_mem<W>);
        semantics { if !src.is_mem { raise UD; } let p = src; DS = load_data_segment(p.seg, DS); dst = p.off as u<W>; }
    }
    instruction Lss<const W: width> in [16, 32] {
        mnemonic "lss";
        encoding { when operand_size() == W; opcode [0x0F, 0xB2]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: far_mem<W>);
        semantics { if !src.is_mem { raise UD; } let p = src; SS = load_stack_segment(p.seg, SS); dst = p.off as u<W>; }
    }
    instruction Lfs<const W: width> in [16, 32] {
        mnemonic "lfs";
        encoding { when operand_size() == W; opcode [0x0F, 0xB4]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: far_mem<W>);
        semantics { if !src.is_mem { raise UD; } let p = src; FS = load_data_segment(p.seg, FS); dst = p.off as u<W>; }
    }
    instruction Lgs<const W: width> in [16, 32] {
        mnemonic "lgs";
        encoding { when operand_size() == W; opcode [0x0F, 0xB5]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: far_mem<W>);
        semantics { if !src.is_mem { raise UD; } let p = src; GS = load_data_segment(p.seg, GS); dst = p.off as u<W>; }
    }

    // -- I/O --------------------------------------------------------------------------------------------

    instruction In_al_imm8 { mnemonic "in"; encoding { opcode 0xE4; Imm<8> } operands (p: imm<8>); semantics { io_allowed(p as u16, 1); AL = io.read_u8(p as u16); } }
    instruction In_ax_imm8<const W: width> in [16, 32] {
        mnemonic "in";
        encoding { when operand_size() == W; opcode 0xE5; Imm<8> }
        operands (p: imm<8>);
        semantics { io_allowed(p as u16, (W / 8) as u8); r<W>.select(0) = io.read<W>(p as u16); }
    }
    instruction Out_imm8_al { mnemonic "out"; encoding { opcode 0xE6; Imm<8> } operands (p: imm<8>); semantics { io_allowed(p as u16, 1); io.write_u8(p as u16, AL); } }
    instruction Out_imm8_ax<const W: width> in [16, 32] {
        mnemonic "out";
        encoding { when operand_size() == W; opcode 0xE7; Imm<8> }
        operands (p: imm<8>);
        semantics { io_allowed(p as u16, (W / 8) as u8); io.write<W>(p as u16, r<W>.select(0)); }
    }
    instruction In_al_dx { mnemonic "in"; encoding { opcode 0xEC; } semantics { io_allowed(DX, 1); AL = io.read_u8(DX); } }
    instruction In_ax_dx<const W: width> in [16, 32] {
        mnemonic "in";
        encoding { when operand_size() == W; opcode 0xED; }
        semantics { io_allowed(DX, (W / 8) as u8); r<W>.select(0) = io.read<W>(DX); }
    }
    instruction Out_dx_al { mnemonic "out"; encoding { opcode 0xEE; } semantics { io_allowed(DX, 1); io.write_u8(DX, AL); } }
    instruction Out_dx_ax<const W: width> in [16, 32] {
        mnemonic "out";
        encoding { when operand_size() == W; opcode 0xEF; }
        semantics { io_allowed(DX, (W / 8) as u8); io.write<W>(DX, r<W>.select(0)); }
    }

    // -- strings ---------------------------------------------------------------------------------------
    //
    // One element per execution. The pointers (SI/DI or ESI/EDI) and the
    // count (CX or ECX) follow the address size. Under a repeat prefix an
    // iteration that is not the last sets EIP back to the prefix, so REP is
    // interruptible; registers change only once an element's accesses have
    // succeeded, so a fault mid-REP restarts that element.

    fn delta(size: u8) -> u32 { return if DF == 1 { 0 - (size as u32) } else { size as u32 }; }
    fn repeating() -> bool { return rep != Rep::None; }
    /// Whether REPE/REPNE continue after a comparison.
    fn rep_continues() -> bool { return if rep == Rep::E { ZF == 1 } else { ZF == 0 }; }
    fn source_offset() -> u32 { return if address_size() == 32 { ESI } else { SI as u32 }; }
    fn dest_offset() -> u32 { return if address_size() == 32 { EDI } else { DI as u32 }; }
    fn advance_source(size: u8) {
        if address_size() == 32 { ESI = ESI + delta(size); } else { SI = SI + (delta(size) as u16); }
    }
    fn advance_dest(size: u8) {
        if address_size() == 32 { EDI = EDI + delta(size); } else { DI = DI + (delta(size) as u16); }
    }
    /// Ends a repeated element: counts it, and repeats unless that was the last.
    fn rep_next(compares: bool) {
        if !repeating() { return; }
        let more = count_down();
        if more && (!compares || rep_continues()) { EIP = start_ip; }
    }
    /// Whether a repeated instruction has nothing left to do.
    fn rep_done() -> bool { return repeating() && count_zero(); }

    fn movs<const W: width> in [8, 16, 32]() {
        if rep_done() { return; }
        let v = seg_read<W>(src_seg(), source_offset());
        seg_write<W>(ES, dest_offset(), v);
        advance_source((W / 8) as u8);
        advance_dest((W / 8) as u8);
        rep_next(false);
    }
    fn cmps<const W: width> in [8, 16, 32]() {
        if rep_done() { return; }
        let a = seg_read<W>(src_seg(), source_offset());
        let b = seg_read<W>(ES, dest_offset());
        let _ = alu<W>(AluOp::Cmp, a, b);
        advance_source((W / 8) as u8);
        advance_dest((W / 8) as u8);
        rep_next(true);
    }
    fn stos<const W: width> in [8, 16, 32]() {
        if rep_done() { return; }
        seg_write<W>(ES, dest_offset(), r<W>.select(0));
        advance_dest((W / 8) as u8);
        rep_next(false);
    }
    fn lods<const W: width> in [8, 16, 32]() {
        if rep_done() { return; }
        r<W>.select(0) = seg_read<W>(src_seg(), source_offset());
        advance_source((W / 8) as u8);
        rep_next(false);
    }
    fn scas<const W: width> in [8, 16, 32]() {
        if rep_done() { return; }
        let b = seg_read<W>(ES, dest_offset());
        let _ = alu<W>(AluOp::Cmp, r<W>.select(0), b);
        advance_dest((W / 8) as u8);
        rep_next(true);
    }
    fn ins<const W: width> in [8, 16, 32]() {
        if rep_done() { return; }
        io_allowed(DX, (W / 8) as u8);
        let v = io.read<W>(DX);
        seg_write<W>(ES, dest_offset(), v);
        advance_dest((W / 8) as u8);
        rep_next(false);
    }
    fn outs<const W: width> in [8, 16, 32]() {
        if rep_done() { return; }
        io_allowed(DX, (W / 8) as u8);
        let v = seg_read<W>(src_seg(), source_offset());
        io.write<W>(DX, v);
        advance_source((W / 8) as u8);
        rep_next(false);
    }

    instruction Movsb { mnemonic "movsb"; encoding { opcode 0xA4; } semantics { movs<8>(); } }
    instruction Movs<const W: width> in [16, 32] { mnemonic "movs"; encoding { when operand_size() == W; opcode 0xA5; } semantics { movs<W>(); } }
    instruction Cmpsb { mnemonic "cmpsb"; encoding { opcode 0xA6; } flags { modifies: [OF, SF, ZF, AF, PF, CF]; } semantics { cmps<8>(); } }
    instruction Cmps<const W: width> in [16, 32] { mnemonic "cmps"; encoding { when operand_size() == W; opcode 0xA7; } flags { modifies: [OF, SF, ZF, AF, PF, CF]; } semantics { cmps<W>(); } }
    instruction Stosb { mnemonic "stosb"; encoding { opcode 0xAA; } semantics { stos<8>(); } }
    instruction Stos<const W: width> in [16, 32] { mnemonic "stos"; encoding { when operand_size() == W; opcode 0xAB; } semantics { stos<W>(); } }
    instruction Lodsb { mnemonic "lodsb"; encoding { opcode 0xAC; } semantics { lods<8>(); } }
    instruction Lods<const W: width> in [16, 32] { mnemonic "lods"; encoding { when operand_size() == W; opcode 0xAD; } semantics { lods<W>(); } }
    instruction Scasb { mnemonic "scasb"; encoding { opcode 0xAE; } flags { modifies: [OF, SF, ZF, AF, PF, CF]; } semantics { scas<8>(); } }
    instruction Scas<const W: width> in [16, 32] { mnemonic "scas"; encoding { when operand_size() == W; opcode 0xAF; } flags { modifies: [OF, SF, ZF, AF, PF, CF]; } semantics { scas<W>(); } }
    instruction Insb { mnemonic "insb"; encoding { opcode 0x6C; } semantics { ins<8>(); } }
    instruction Ins<const W: width> in [16, 32] { mnemonic "ins"; encoding { when operand_size() == W; opcode 0x6D; } semantics { ins<W>(); } }
    instruction Outsb { mnemonic "outsb"; encoding { opcode 0x6E; } semantics { outs<8>(); } }
    instruction Outs<const W: width> in [16, 32] { mnemonic "outs"; encoding { when operand_size() == W; opcode 0x6F; } semantics { outs<W>(); } }

    // -- protected mode: the system instructions -------------------------------------------------
    //
    // The 0F 00 and 0F 01 groups (the descriptor-table registers, the
    // machine status word, the LDT and task registers, the descriptor
    // queries), LAR, LSL, ARPL, and the moves to and from the control,
    // debug and test registers. The loads and the register moves are CPL 0
    // only (#GP in virtual-8086 mode); SLDT, STR, LLDT, LTR, VERR, VERW,
    // LAR, LSL and ARPL are #UD outside protected mode.

    /// SGDT and SIDT store the limit and the base; at 16-bit operand size
    /// the base's top byte is stored as 0. LGDT and LIDT at 16-bit operand
    /// size load a 24-bit base.
    fn store_table(s: Segment, o: u32, t: TableReg) {
        seg_write<16>(s, o, t.limit);
        seg_write<32>(s, ea_next(o, 2), if operand_size() == 32 { t.base } else { t.base & 0x00FFFFFF });
    }

    fn load_table(s: Segment, o: u32) -> TableReg {
        let limit = seg_read<16>(s, o);
        let base = seg_read<32>(s, ea_next(o, 2));
        return TableReg { base: if operand_size() == 32 { base } else { base & 0x00FFFFFF }, limit: limit };
    }

    instruction Sgdt {
        mnemonic "sgdt";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 0 } }
        operands (m: place);
        semantics { if !m.is_mem { raise UD; } let p = m; store_table(p.seg, p.off, GDTR); }
    }
    instruction Sidt {
        mnemonic "sidt";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 1 } }
        operands (m: place);
        semantics { if !m.is_mem { raise UD; } let p = m; store_table(p.seg, p.off, IDTR); }
    }
    instruction Lgdt {
        mnemonic "lgdt";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 2 } }
        operands (m: place);
        semantics { if !m.is_mem { raise UD; } privileged(); let p = m; GDTR = load_table(p.seg, p.off); }
    }
    instruction Lidt {
        mnemonic "lidt";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 3 } }
        operands (m: place);
        semantics { if !m.is_mem { raise UD; } privileged(); let p = m; IDTR = load_table(p.seg, p.off); }
    }

    /// A selector stored by SMSW, SLDT, STR: a word to memory; to a
    /// register at 32-bit operand size, zero-extended.
    fn store_word(is_mem: bool, n: u3, v: u16) -> bool {
        if operand_size() == 32 && !is_mem { r<32>.select(n) = v as u32; return true; }
        return false;
    }

    /// SMSW stores CR0's low half (a 32-bit register gets all of CR0).
    instruction Smsw {
        mnemonic "smsw";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 4 } }
        operands (dst: rm<16>);
        semantics {
            if operand_size() == 32 && !dst.is_mem { r<32>.select(dst.index) = CR0; } else { dst = CR0 as u16; }
        }
    }
    /// LMSW sets PE, MP, EM and TS; it cannot clear PE.
    instruction Lmsw {
        mnemonic "lmsw";
        encoding { opcode [0x0F, 0x01]; ModRM { reg: 6 } }
        operands (src: rm<16>);
        semantics {
            privileged();
            let v = src as u32;
            CR0 = (CR0 & 0xFFFFFFF0) | (v & 0x0000000F) | (CR0 & 0x00000001);
        }
    }

    instruction Sldt {
        mnemonic "sldt";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 0 } }
        operands (dst: rm<16>);
        semantics { protected_only(); if !store_word(dst.is_mem, dst.index, LDTR.selector) { dst = LDTR.selector; } }
    }
    instruction Str {
        mnemonic "str";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 1 } }
        operands (dst: rm<16>);
        semantics { protected_only(); if !store_word(dst.is_mem, dst.index, TR.selector) { dst = TR.selector; } }
    }
    /// LLDT: an LDT descriptor in the GDT, or null for no LDT.
    instruction Lldt {
        mnemonic "lldt";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 2 } }
        operands (src: rm<16>);
        semantics {
            protected_only();
            privileged();
            let sel = src;
            if (sel & 0xFFFC) == 0 {
                LDTR = null_segment(sel, false);
            } else {
                if sel[2] == 1 { raise GP(sel_error(sel)); }
                let d = descriptor(sel);
                if system_type(d.rights) != 2 { raise GP(sel_error(sel)); }
                if d.rights[7] == 0 { raise NP(sel_error(sel)); }
                LDTR = Segment { selector: sel, base: d.base, limit: d.limit, rights: d.rights, big: false, stack: false };
            }
        }
    }
    /// LTR: an available TSS (286 or 386) in the GDT, which becomes busy.
    instruction Ltr {
        mnemonic "ltr";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 3 } }
        operands (src: rm<16>);
        semantics {
            protected_only();
            privileged();
            let sel = src;
            if (sel & 0xFFFC) == 0 || sel[2] == 1 { raise GP(sel_error(sel)); }
            let d = descriptor(sel);
            let t = system_type(d.rights);
            if t != 1 && t != 9 { raise GP(sel_error(sel)); }
            if d.rights[7] == 0 { raise NP(sel_error(sel)); }
            sys_write<8>(descriptor_address(sel) + 5, d.rights | 0x02);
            TR = Segment { selector: sel, base: d.base, limit: d.limit, rights: d.rights | 0x02, big: false, stack: false };
        }
    }

    /// The descriptor queries' privilege rule: a segment the selector and
    /// CPL may see (conforming code always).
    fn visible(sel: u16, r: u8) -> bool {
        if is_conforming(r) { return true; }
        return (dpl(r) as u3) >= (cpl() as u3) && (dpl(r) as u3) >= (sel[1:0] as u3);
    }

    /// VERR/VERW: ZF says whether the segment can be read (written) at CPL.
    fn verify(sel: u16, write: bool) {
        EFLAGS.ZF = 0;
        if (sel & 0xFFFC) == 0 || !descriptor_at(sel) { return; }
        let r = descriptor(sel).rights;
        if r[4] == 0 || !visible(sel, r) { return; }
        let ok = if write { is_data(r) && r[1] == 1 } else { is_data(r) || r[1] == 1 };
        if ok { EFLAGS.ZF = 1; }
    }

    instruction Verr {
        mnemonic "verr";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 4 } }
        operands (src: rm<16>);
        flags { modifies: [ZF]; }
        semantics { protected_only(); verify(src, false); }
    }
    instruction Verw {
        mnemonic "verw";
        encoding { opcode [0x0F, 0x00]; ModRM { reg: 5 } }
        operands (src: rm<16>);
        flags { modifies: [ZF]; }
        semantics { protected_only(); verify(src, true); }
    }
    /// LAR: the access rights of a segment, TSS, LDT, call gate or task
    /// gate the selector may see: the access byte in bits 15:8, and at
    /// 32-bit operand size G, D/B and AVL in bits 23:20.
    instruction Lar<const W: width> in [16, 32] {
        mnemonic "lar";
        encoding { when operand_size() == W; opcode [0x0F, 0x02]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: rm<16>);
        flags { modifies: [ZF]; }
        semantics {
            protected_only();
            let sel = src;
            EFLAGS.ZF = 0;
            if (sel & 0xFFFC) != 0 && descriptor_at(sel) {
                let d = descriptor(sel);
                let r = d.rights;
                let t = system_type(r);
                if (r[4] == 1 || (t >= 1 && t <= 5) || t == 9 || t == 11 || t == 12) && visible(sel, r) {
                    dst = (((r as u32) << 8) | (((d.w3 as u32) & 0x00F0) << 16)) as u<W>;
                    EFLAGS.ZF = 1;
                }
            }
        }
    }
    /// LSL: the limit, in bytes, of a segment, TSS or LDT the selector may see.
    instruction Lsl<const W: width> in [16, 32] {
        mnemonic "lsl";
        encoding { when operand_size() == W; opcode [0x0F, 0x03]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: rm<16>);
        flags { modifies: [ZF]; }
        semantics {
            protected_only();
            let sel = src;
            EFLAGS.ZF = 0;
            if (sel & 0xFFFC) != 0 && descriptor_at(sel) {
                let d = descriptor(sel);
                let t = system_type(d.rights);
                if (d.rights[4] == 1 || (t >= 1 && t <= 3) || t == 9 || t == 11) && visible(sel, d.rights) {
                    dst = d.limit as u<W>;
                    EFLAGS.ZF = 1;
                }
            }
        }
    }
    /// ARPL: raises the destination selector's RPL to the source's.
    instruction Arpl {
        mnemonic "arpl";
        encoding { opcode 0x63; ModRM { reg: r<16> } }
        operands (dst: rm<16>, src: r<16>);
        flags { modifies: [ZF]; }
        semantics {
            protected_only();
            let d = dst;
            if (d[1:0] as u3) < (src[1:0] as u3) {
                dst = (d & 0xFFFC) | (src & 0x0003);
                EFLAGS.ZF = 1;
            } else {
                EFLAGS.ZF = 0;
            }
        }
    }

    /// A control, debug or test register number (the ModRM's `reg`).
    operand_kind special_n : u3 { value(n: u3) => n; }

    /// CR0, CR2 and CR3 exist (others are #UD). Setting PG without PE is
    /// #GP(0).
    instruction Mov_r_cr {
        mnemonic "mov";
        encoding { opcode [0x0F, 0x20]; RegModRM { reg: special_n, rm: r<32> } }
        operands (n: special_n, dst: r<32>);
        semantics {
            if n == 1 || n > 3 { raise UD; }
            privileged();
            dst = match n { 0 => CR0, 2 => CR2, _ => CR3 };
        }
    }
    instruction Mov_cr_r {
        mnemonic "mov";
        encoding { opcode [0x0F, 0x22]; RegModRM { reg: special_n, rm: r<32> } }
        operands (n: special_n, src: r<32>);
        semantics {
            if n == 1 || n > 3 { raise UD; }
            privileged();
            let v = src;
            match n {
                0 => {
                    if v[31] == 1 && v[0] == 0 { raise GP(0); }
                    CR0 = v & 0x8000001F;
                }
                2 => { CR2 = v; }
                _ => { CR3 = v & 0xFFFFF000; }
            }
        }
    }
    /// DR4 and DR5 are DR6 and DR7.
    instruction Mov_r_dr {
        mnemonic "mov";
        encoding { opcode [0x0F, 0x21]; RegModRM { reg: special_n, rm: r<32> } }
        operands (n: special_n, dst: r<32>);
        semantics {
            privileged();
            dst = match n { 0 => DR0, 1 => DR1, 2 => DR2, 3 => DR3, 4 => DR6, 5 => DR7, 6 => DR6, _ => DR7 };
        }
    }
    instruction Mov_dr_r {
        mnemonic "mov";
        encoding { opcode [0x0F, 0x23]; RegModRM { reg: special_n, rm: r<32> } }
        operands (n: special_n, src: r<32>);
        semantics {
            privileged();
            let v = src;
            match n {
                0 => { DR0 = v; }
                1 => { DR1 = v; }
                2 => { DR2 = v; }
                3 => { DR3 = v; }
                4 => { DR6 = v; }
                6 => { DR6 = v; }
                _ => { DR7 = v; }
            }
        }
    }
    /// TR6 and TR7 only.
    instruction Mov_r_tr {
        mnemonic "mov";
        encoding { opcode [0x0F, 0x24]; RegModRM { reg: special_n, rm: r<32> } }
        operands (n: special_n, dst: r<32>);
        semantics {
            if n < 6 { raise UD; }
            privileged();
            dst = if n == 6 { TR6 } else { TR7 };
        }
    }
    instruction Mov_tr_r {
        mnemonic "mov";
        encoding { opcode [0x0F, 0x26]; RegModRM { reg: special_n, rm: r<32> } }
        operands (n: special_n, src: r<32>);
        semantics {
            if n < 6 { raise UD; }
            privileged();
            if n == 6 { TR6 = src; } else { TR7 = src; }
        }
    }

    // -- 386: bit tests and scans, double shifts --------------------------------------------------------

    /// A ModRM operand as a place: the register it names or the memory
    /// address it forms. The bit tests address memory by a bit offset.
    operand_kind place : (seg: Segment, off: u32) from m: ModRM {
        is_mem => m.mod != 3;
        /// Address work, for timing.
        ea => if (adsize ^ (CS.big as u1)) == 1 && m.mod != 3 && m.rm == 4 { EaWork(m.mod, m.rm, true, m.tail.Sib.index, m.tail.Sib.base) } else { EaWork(m.mod, m.rm, (adsize ^ (CS.big as u1)) == 1, 4, 0) };
        index => m.rm;
        read => effective_address(m);
    }

    enum BitOp : u2 { Test, Set, Reset, Complement }
    operand_kind bit_op : BitOp { value(n: u2) => n as BitOp; }
    /// 0FBA's `reg`: /4-/7 are BT, BTS, BTR, BTC; /0-/3 are #UD.
    operand_kind bit_op_imm : u3 { value(n: u3) => n; }

    fn bit_name(op: BitOp) -> str {
        return match op { BitOp::Test => "bt", BitOp::Set => "bts", BitOp::Reset => "btr", BitOp::Complement => "btc" };
    }

    fn bit_apply<const W: width> in [16, 32](op: BitOp, v: u<W>, k: u32) -> u<W> {
        let m = (1 as u<W>) << (k as u<W>);
        EFLAGS.CF = ((v >> (k as u<W>)) & 1) as u1;
        return match op { BitOp::Test => v, BitOp::Set => v | m, BitOp::Reset => v & ~m, BitOp::Complement => v ^ m };
    }

    /// The bit test at `bit` of a register or of memory. A register bit
    /// offset reaches memory beyond the operand (signed, in operand-sized
    /// steps); an immediate one stays within it.
    fn bit_test<const W: width> in [16, 32](op: BitOp, is_mem: bool, n: u3, s: Segment, o: u32, bit: u32, far: bool) {
        let k = bit & (W - 1);
        if !is_mem {
            let v = bit_apply<W>(op, r<W>.select(n), k);
            if op != BitOp::Test { r<W>.select(n) = v; }
            return;
        }
        let step = if far { ((((bit as u<W>) as i<W>) >> (if W == 32 { 5_u8 } else { 4_u8 })) as i32) * ((W / 8) as i32) } else { 0 };
        let a = o + (step as u32);
        let off = if address_size() == 16 { a & 0xFFFF } else { a };
        let v = seg_read<W>(s, off);
        let nv = bit_apply<W>(op, v, k);
        if op != BitOp::Test { seg_write<W>(s, off, nv); }
    }

    instruction Bt_rm_r<const W: width> in [16, 32] {
        mnemonic bit_name(op);
        encoding { when operand_size() == W; opcode [0x0F, "101oo011"] { o: bit_op }; ModRM { reg: r<W> } }
        operands (op: bit_op, dst: place, b: r<W>);
        flags { modifies: [CF]; undefined: [OF, SF, ZF, AF, PF]; }
        lock if dst.is_mem && op != BitOp::Test;
        semantics {
            let p = if dst.is_mem { dst } else { (seg: DS, off: 0) };
            bit_test<W>(op, dst.is_mem, dst.index, p.seg, p.off, b as u32, true);
        }
    }
    instruction Bt_rm_imm<const W: width> in [16, 32] {
        mnemonic bit_name(((op as u2) & 3) as BitOp);
        encoding { when operand_size() == W; opcode [0x0F, 0xBA]; ModRM { reg: bit_op_imm } Imm<8> }
        operands (op: bit_op_imm, dst: place, b: imm<8>);
        flags { modifies: [CF]; undefined: [OF, SF, ZF, AF, PF]; }
        lock if dst.is_mem && op != 4;
        semantics {
            if op < 4 { raise UD; }
            let p = if dst.is_mem { dst } else { (seg: DS, off: 0) };
            bit_test<W>(((op as u2) & 3) as BitOp, dst.is_mem, dst.index, p.seg, p.off, b as u32, false);
        }
    }

    /// BSF and BSR: a zero source sets ZF and leaves the destination.
    instruction Bsf<const W: width> in [16, 32] {
        mnemonic "bsf";
        encoding { when operand_size() == W; opcode [0x0F, 0xBC]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: rm<W>);
        flags { modifies: [ZF]; undefined: [OF, SF, AF, PF, CF]; }
        semantics {
            let v = src;
            if v == 0 { EFLAGS.ZF = 1; return; }
            EFLAGS.ZF = 0;
            let mut at: u<W> = 0;
            for i in 0..W {
                let k = (W - 1 - i) as u<W>;
                if ((v >> k) & 1) == 1 { at = k; }
            }
            dst = at;
        }
    }
    instruction Bsr<const W: width> in [16, 32] {
        mnemonic "bsr";
        encoding { when operand_size() == W; opcode [0x0F, 0xBD]; ModRM { reg: r<W> } }
        operands (dst: r<W>, src: rm<W>);
        flags { modifies: [ZF]; undefined: [OF, SF, AF, PF, CF]; }
        semantics {
            let v = src;
            if v == 0 { EFLAGS.ZF = 1; return; }
            EFLAGS.ZF = 0;
            let mut at: u<W> = 0;
            for i in 0..W {
                let k = i as u<W>;
                if ((v >> k) & 1) == 1 { at = k; }
            }
            dst = at;
        }
    }

    /// SHLD and SHRD: `dst` shifted by `count` (masked to 5 bits), filled
    /// from `src`. Past the width (16-bit forms) the result is undefined.
    ///
    /// The 386 shifts the pattern dst:src:src (SHRD src:src:dst), so a
    /// 16-bit count past 16 brings `src` in again.
    fn double_shift<const W: width> in [16, 32](left: bool, dst: u<W>, src: u<W>, count: u8) -> u<W> {
        let n = (count & 0x1F) as u128;
        let wd = W as u128;
        let mask = (1_u128 << wd) - 1;
        let d = dst as u128;
        let r: u128 = if left {
            let t = ((d << (2 * wd)) | ((src as u128) << wd) | (src as u128)) << n;
            EFLAGS.CF = ((t >> (3 * wd)) & 1) as u1;
            (t >> (2 * wd)) & mask
        } else {
            let x = ((src as u128) << (2 * wd)) | ((src as u128) << wd) | d;
            EFLAGS.CF = ((x >> (n - 1)) & 1) as u1;
            (x >> n) & mask
        };
        let top = (r >> (wd - 1)) & 1;
        EFLAGS.OF = (top ^ ((d >> (wd - 1)) & 1)) as u1;
        EFLAGS.SF = top as u1;
        EFLAGS.ZF = (r == 0) as u1;
        EFLAGS.PF = Parity8(r as u8);
        return r as u<W>;
    }

    instruction Shld_imm<const W: width> in [16, 32] {
        mnemonic "shld";
        encoding { when operand_size() == W; opcode [0x0F, 0xA4]; ModRM { reg: r<W> } Imm<8> }
        operands (dst: rm<W>, src: r<W>, n: imm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF if (n & 0x1F) != 1, AF, CF if (n & 0x1F) > W]; }
        semantics { let v = dst; if (n & 0x1F) != 0 { dst = double_shift<W>(true, v, src, n); } }
    }
    instruction Shld_cl<const W: width> in [16, 32] {
        mnemonic "shld";
        encoding { when operand_size() == W; opcode [0x0F, 0xA5]; ModRM { reg: r<W> } }
        operands (dst: rm<W>, src: r<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF if (CL & 0x1F) != 1, AF, CF if (CL & 0x1F) > W]; }
        semantics { let v = dst; if (CL & 0x1F) != 0 { dst = double_shift<W>(true, v, src, CL); } }
    }
    instruction Shrd_imm<const W: width> in [16, 32] {
        mnemonic "shrd";
        encoding { when operand_size() == W; opcode [0x0F, 0xAC]; ModRM { reg: r<W> } Imm<8> }
        operands (dst: rm<W>, src: r<W>, n: imm<8>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF if (n & 0x1F) != 1, AF, CF if (n & 0x1F) > W]; }
        semantics { let v = dst; if (n & 0x1F) != 0 { dst = double_shift<W>(false, v, src, n); } }
    }
    instruction Shrd_cl<const W: width> in [16, 32] {
        mnemonic "shrd";
        encoding { when operand_size() == W; opcode [0x0F, 0xAD]; ModRM { reg: r<W> } }
        operands (dst: rm<W>, src: r<W>);
        flags { modifies: [OF, SF, ZF, AF, PF, CF]; undefined: [OF if (CL & 0x1F) != 1, AF, CF if (CL & 0x1F) > W]; }
        semantics { let v = dst; if (CL & 0x1F) != 0 { dst = double_shift<W>(false, v, src, CL); } }
    }

    instruction Clts { mnemonic "clts"; encoding { opcode [0x0F, 0x06]; } semantics { privileged(); CR0.TS = 0; } }
    instruction Wait { mnemonic "wait"; encoding { opcode 0x9B; } semantics { if CR0.TS == 1 && CR0.MP == 1 { raise NM; } } }

    // -- flags and miscellany -----------------------------------------------------------------

    instruction Clc { mnemonic "clc"; encoding { opcode 0xF8; } flags { modifies: [CF]; } semantics { EFLAGS.CF = 0; } }
    instruction Stc { mnemonic "stc"; encoding { opcode 0xF9; } flags { modifies: [CF]; } semantics { EFLAGS.CF = 1; } }
    instruction Cmc { mnemonic "cmc"; encoding { opcode 0xF5; } flags { modifies: [CF]; } semantics { EFLAGS.CF = ~CF; } }
    instruction Cld { mnemonic "cld"; encoding { opcode 0xFC; } flags { modifies: [DF]; } semantics { EFLAGS.DF = 0; } }
    instruction Std { mnemonic "std"; encoding { opcode 0xFD; } flags { modifies: [DF]; } semantics { EFLAGS.DF = 1; } }
    instruction Cli { mnemonic "cli"; encoding { opcode 0xFA; } flags { modifies: [IF]; } semantics { iopl_allowed(); EFLAGS.IF = 0; } }
    instruction Sti { mnemonic "sti"; encoding { opcode 0xFB; } flags { modifies: [IF]; } semantics { iopl_allowed(); if EFLAGS.IF == 0 { INHIBIT = 1; } EFLAGS.IF = 1; } }
    instruction Hlt { mnemonic "hlt"; encoding { opcode 0xF4; } semantics { privileged(); halt; } }
}

// All 941 files: 1,758,700 vectors, of which 29 differ, each a quirk of
// the hardware this description does not model:
// - AAM 0 (D4, 10 vectors): the #DE leaves SF and ZF clear and PF set
//   without a pattern in AL or AH, where most #DE vectors keep the flags.
// - IDIV r/m8 (F6.7, 67F6.7; 9): some overflowing quotients give AL = 80
//   with a remainder rather than #DE.
// - IN AX/EAX (E5, 66E5; 6): ports 1F and 21 read 7FFF, the 386EX's own
//   peripherals answering in place of the floating bus.
// - A32 REP MOVSW/STOSW (67A5, 67AB, 6766A5, 6766AB; 4): the store
//   overwrites the instruction itself; the 386 repeats from what it
//   fetched, where restarting at the prefix fetches the new bytes.
vectors "../../../simulators/test/i386/SingleStepTests/v1_ex_real_mode/*.MOO.gz" on I386 {
    format moo;
    memory mem;
    /// The capture rig has nothing on the I/O bus: reads float high.
    open io = 0xFF;
    /// Each trace starts at the jump to the instruction and ends at the
    /// injected HLT's bus cycle, whose first clock belongs to no instruction.
    harness_cycles 1;
    reg cr0 = CR0;
    reg cr3 = CR3;
    reg eax = EAX;
    reg ebx = EBX;
    reg ecx = ECX;
    reg edx = EDX;
    reg esi = ESI;
    reg edi = EDI;
    reg ebp = EBP;
    reg esp = ESP;
    reg eip = EIP;
    reg eflags = EFLAGS;
    reg dr6 = DR6;
    reg dr7 = DR7;
    reg cs { load => CS = real_mode_segment(value, false); read => CS.selector; }
    reg ds { load => DS = real_mode_segment(value, false); read => DS.selector; }
    reg es { load => ES = real_mode_segment(value, false); read => ES.selector; }
    reg fs { load => FS = real_mode_segment(value, false); read => FS.selector; }
    reg gs { load => GS = real_mode_segment(value, false); read => GS.selector; }
    reg ss { load => SS = real_mode_segment(value, true); read => SS.selector; }
}
