// An AT-style 80386 board for the model backend: the i386 isa as a
// processor on a 32-bit local bus with RAM and a boot ROM, and behind the
// AT's bus controller the ISA bus with the PC's devices (`targets/pc`): the
// two cascaded 8259 interrupt controllers, the 8254 timer, the 8237 DMA
// controller, a host data link on DMA channel 1 (and IRQ 12), an EGA, and
// a debugging console port.
//
// `machine build --system Board386 --out <dir> targets/pc/*.machine
// targets/i286/alu.machine targets/i386/i386.machine
// targets/i386/timing.machine targets/i386/board.machine` generates the
// emulator crate. The processor is timed by the tier-1 table
// (`timing.machine`): an instruction costs its data transfers plus the
// larger of its code fetches and its execution cycles.

use i386::{I386};
use isabus::{Space, BusSize, IsaBus, IrqLines};
use pc::{Pic8259, Pit8254, Dma8237, HostLink, Ega, Console, PostCard, Mc146818, Kbc8042, Fdc765, Wd1003};
use vga::{Vga};

/// The 386 local bus at the transaction level: a transfer names an aligned
/// dword (`addr`, its low two bits clear) and the byte lanes it uses
/// (`be`, BE0#-BE3# active high); the data sits in its lanes. An access
/// that crosses a dword boundary is two transfers, as the 386 makes it.
bus LocalBus386 {
    clock clk;
    wires {
        addr:  u32  driven_by Master;
        data:  u32  shared;
        be:    u4   driven_by Master;
        mio:   bool driven_by Master;
        wr:    bool driven_by Master;
        ads:   bool driven_by Master;
        ready: bool wired_and;
    }
    roles { Master; Slave; }

    /// Two clocks (T1, T2) without wait states.
    transaction read(space: Space, addr: u32, be: u4) -> (data: u32) {
        Master {
            cycle { addr = addr; be = be; mio = space == Space::Mem; wr = false; ads = true; }
            wait until ready;
            cycle { ads = false; let v = data; return v; }
        }
    }
    transaction write(space: Space, addr: u32, be: u4, data: u32) {
        Master {
            cycle { addr = addr; be = be; mio = space == Space::Mem; wr = true; data = data; ads = true; }
            wait until ready;
            cycle { ads = false; }
        }
    }

    /// The interrupt-acknowledge cycles. Not address-decoded: the bus
    /// controller takes it to the interrupt controllers on the ISA bus.
    transaction inta() -> (vector: u8) {
        Master {
            cycle { } cycle { }
            wait until ready;
            cycle { } cycle { }
        }
    }
}

/// The byte lanes of `n` bytes at `addr` within its dword.
unit Lanes(addr: u32, n: u3) -> u4 {
    return (((1_u32 << (n as u32)) - 1) << (addr & 3)) as u4;
}

/// The processor: the i386 isa, with its memory and I/O spaces bound to the
/// local bus. Code is fetched a dword at a time into a one-dword buffer;
/// an access that crosses a dword boundary is two transfers.
component Cpu386 {
    isa I386;
    ports {
        bus local: LocalBus386::Master;
        /// INTR, from the master interrupt controller.
        in intr_line: bool;
        /// RESET (on an AT, from the keyboard controller; unwired, low).
        in reset_pin: bool;
        /// The A20 gate: low, address line 20 is held low and memory wraps
        /// at 1 MB (on an AT, the keyboard controller's output port drives
        /// it; boards without a gate tie it high).
        in a20_gate: bool;
    }
    model {
        /// The code dword last fetched, and whether it is still good.
        state code: u32 = 0;
        state code_addr: u32 = 0;
        state code_valid: bool = false;

        on intr() -> bool { return intr_line; }
        on reset_line() -> bool { return reset_pin; }
        /// A reset empties the code buffer.
        on reset { code_valid = false; }
        on acknowledge() -> u8 { return local.inta().vector; }

        /// A memory address through the A20 gate.
        fn gate(a: u32) -> u32 { return if a20_gate { a } else { a & 0xFFEFFFFF }; }

        on mem.fetch_u8(addr: u32) -> u8 {
            let d = gate(addr) & 0xFFFFFFFC;
            if !code_valid || d != code_addr {
                code = local.read(space: Space::Mem, addr: d, be: 0xF).data;
                code_addr = d;
                code_valid = true;
            }
            return (code >> ((addr & 3) * 8)) as u8;
        }

        /// A store into the buffered dword makes it stale.
        fn wrote(addr: u32, n: u3) {
            if (gate(addr) & 0xFFFFFFFC) == code_addr || (gate(addr + (n as u32) - 1) & 0xFFFFFFFC) == code_addr {
                code_valid = false;
            }
        }

        /// `n` bytes at `addr` that lie within one dword.
        fn read_in(space: Space, addr: u32, n: u3) -> u32 {
            let a = if space == Space::Mem { gate(addr) } else { addr };
            let v = local.read(space: space, addr: a & 0xFFFFFFFC, be: Lanes(addr, n)).data;
            return v >> ((addr & 3) * 8);
        }
        fn write_in(space: Space, addr: u32, n: u3, data: u32) {
            let a = if space == Space::Mem { gate(addr) } else { addr };
            local.write(space: space, addr: a & 0xFFFFFFFC, be: Lanes(addr, n), data: data << ((addr & 3) * 8));
        }

        /// `n` bytes at `addr`, as one transfer or, across a dword
        /// boundary, two (the lower dword first).
        fn read_n(space: Space, addr: u32, n: u3) -> u32 {
            let first = 4 - (addr & 3);
            if (n as u32) <= first { return read_in(space, addr, n); }
            let lo = read_in(space, addr, first as u3);
            let hi = read_in(space, (addr & 0xFFFFFFFC) + 4, n - (first as u3));
            return lo | (hi << (first * 8));
        }
        fn write_n(space: Space, addr: u32, n: u3, data: u32) {
            let first = 4 - (addr & 3);
            if (n as u32) <= first { write_in(space, addr, n, data); return; }
            write_in(space, addr, first as u3, data);
            write_in(space, (addr & 0xFFFFFFFC) + 4, n - (first as u3), data >> (first * 8));
        }

        on mem.read_u8(addr: u32) -> u8 { return read_n(Space::Mem, addr, 1) as u8; }
        on mem.read_u16(addr: u32) -> u16 { return read_n(Space::Mem, addr, 2) as u16; }
        on mem.read_u32(addr: u32) -> u32 { return read_n(Space::Mem, addr, 4); }
        on mem.write_u8(addr: u32, data: u8) { wrote(addr, 1); write_n(Space::Mem, addr, 1, data as u32); }
        on mem.write_u16(addr: u32, data: u16) { wrote(addr, 2); write_n(Space::Mem, addr, 2, data as u32); }
        on mem.write_u32(addr: u32, data: u32) { wrote(addr, 4); write_n(Space::Mem, addr, 4, data); }
        on io.read_u8(addr: u16) -> u8 { return read_n(Space::Io, addr as u32, 1) as u8; }
        on io.read_u16(addr: u16) -> u16 { return read_n(Space::Io, addr as u32, 2) as u16; }
        on io.read_u32(addr: u16) -> u32 { return read_n(Space::Io, addr as u32, 4); }
        on io.write_u8(addr: u16, data: u8) { write_n(Space::Io, addr as u32, 1, data as u32); }
        on io.write_u16(addr: u16, data: u16) { write_n(Space::Io, addr as u32, 2, data as u32); }
        on io.write_u32(addr: u16, data: u32) { write_n(Space::Io, addr as u32, 4, data); }
    }
}

/// 4 MB of zero-wait-state RAM: the first 640 KB and, from 1 MB, the
/// extended memory (the cells between are the ISA bus's). Its port reads
/// and writes the cells plainly (`direct`), so an emulation profile
/// reaches them without the handlers.
component Ram386 {
    ports { bus port: LocalBus386::Slave; }
    model {
        mem cells: [u8; 0x400000] { direct: port(addr & 0x3FFFFF), wait: 0 };
        on port.read(space: Space, addr: u32, be: u4) -> (data: u32, wait: u8) {
            let a = addr & 0x3FFFFC;
            return (data: concat(cells[a + 3], cells[a + 2], cells[a + 1], cells[a]), wait: 0);
        }
        on port.write(space: Space, addr: u32, be: u4, data: u32) -> (wait: u8) {
            let a = addr & 0x3FFFFC;
            if be[0] == 1 { cells[a] = data as u8; }
            if be[1] == 1 { cells[a + 1] = (data >> 8) as u8; }
            if be[2] == 1 { cells[a + 2] = (data >> 16) as u8; }
            if be[3] == 1 { cells[a + 3] = (data >> 24) as u8; }
            return (wait: 0);
        }
    }
}

/// A 64 KB boot ROM with two wait states, answering at the top of the first
/// megabyte and at the top of the 4 GB space, where the 386 starts. Writes
/// are not answered.
component Rom386 {
    ports { bus port: LocalBus386::Slave; }
    model {
        mem cells: [u8; 0x10000] { direct: port(addr & 0xFFFF), wait: 2, read_only };
        on port.read(space: Space, addr: u32, be: u4) -> (data: u32, wait: u8) {
            let a = addr & 0xFFFC;
            return (data: concat(cells[a + 3], cells[a + 2], cells[a + 1], cells[a]), wait: 2);
        }
    }
}

/// The AT bus controller of a 386 board: what nothing on the local bus
/// answers below 16 MB goes to the ISA bus, at the ISA bus's clock. Each
/// pair of enabled byte lanes that a 16-bit device (one that pulls
/// MEMCS16#/IOCS16# low) can take is one word cycle; everything else is a
/// byte cycle per lane. The AT's default wait states: one in a 16-bit
/// cycle, four in an 8-bit one. In the other direction, an ISA master's
/// memory cycle in system memory (the DMA controller's) reaches the local
/// bus.
component AtBus386 {
    ports {
        /// Everything the local bus does not answer.
        bus local: LocalBus386::Slave;
        bus isa: IsaBus::Master;
        /// System memory (RAM and the boot ROM), as ISA masters see it.
        bus sysmem: IsaBus::Slave;
        bus mem: LocalBus386::Master;
    }
    model {
        fn waits(n: u8) {
            for i in 0..4 {
                if (i as u8) < n { isa.wait_state(); }
            }
        }

        /// Whether the target is a 16-bit device.
        fn wide(space: Space, addr: u24) -> bool {
            return !isa.cs16(space: space, addr: addr).cs16_n;
        }

        /// One byte lane's cycle.
        fn read_byte(space: Space, addr: u24) -> u8 {
            let v = isa.read(space: space, addr: addr, size: BusSize::Byte).data as u8;
            waits(if wide(space, addr) { 1 } else { 4 });
            return v;
        }

        /// A pair of lanes (`lo`, `hi` enabled) at the even address `addr`.
        fn read_pair(space: Space, addr: u24, lo: bool, hi: bool) -> u16 {
            if lo && hi && wide(space, addr) {
                let v = isa.read(space: space, addr: addr, size: BusSize::Word).data;
                waits(1);
                return v;
            }
            let mut v: u16 = 0xFFFF;
            if lo { v = (v & 0xFF00) | (read_byte(space, addr) as u16); }
            if hi { v = (v & 0x00FF) | ((read_byte(space, addr + 1) as u16) << 8); }
            return v;
        }

        fn write_byte(space: Space, addr: u24, data: u8) {
            isa.write(space: space, addr: addr, size: BusSize::Byte, data: data as u16);
            waits(if wide(space, addr) { 1 } else { 4 });
        }

        fn write_pair(space: Space, addr: u24, lo: bool, hi: bool, data: u16) {
            if lo && hi && wide(space, addr) {
                isa.write(space: space, addr: addr, size: BusSize::Word, data: data);
                waits(1);
                return;
            }
            if lo { write_byte(space, addr, data as u8); }
            if hi { write_byte(space, addr + 1, (data >> 8) as u8); }
        }

        on local.read(space: Space, addr: u32, be: u4) -> (data: u32, wait: u8) {
            if addr > 0xFFFFFF { return (data: 0xFFFFFFFF, wait: 0); }
            let a = addr as u24;
            let lo = if be[0] == 1 || be[1] == 1 { read_pair(space, a, be[0] == 1, be[1] == 1) } else { 0xFFFF };
            let hi = if be[2] == 1 || be[3] == 1 { read_pair(space, a + 2, be[2] == 1, be[3] == 1) } else { 0xFFFF };
            return (data: concat(hi, lo), wait: 0);
        }

        on local.write(space: Space, addr: u32, be: u4, data: u32) -> (wait: u8) {
            if addr > 0xFFFFFF { return (wait: 0); }
            let a = addr as u24;
            if be[0] == 1 || be[1] == 1 { write_pair(space, a, be[0] == 1, be[1] == 1, data as u16); }
            if be[2] == 1 || be[3] == 1 { write_pair(space, a + 2, be[2] == 1, be[3] == 1, (data >> 16) as u16); }
            return (wait: 0);
        }

        on local.inta() -> (vector: u8, wait: u8) {
            return (vector: isa.inta().vector, wait: 0);
        }

        on sysmem.cs16(space: Space, addr: u24) -> (cs16_n: bool, wait: u8) {
            return (cs16_n: false, wait: 0);
        }
        on sysmem.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let n: u3 = if size == BusSize::Word { 2 } else { 1 };
            let a = addr as u32;
            let v = mem.read(space: space, addr: a & 0xFFFFFFFC, be: Lanes(a, n)).data;
            return (data: (v >> ((a & 3) * 8)) as u16, wait: 0);
        }
        on sysmem.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let n: u3 = if size == BusSize::Word { 2 } else { 1 };
            let a = addr as u32;
            mem.write(space: space, addr: a & 0xFFFFFFFC, be: Lanes(a, n), data: (data as u32) << ((a & 3) * 8));
            return (wait: 0);
        }
    }
}

system Board386 {
    clock osc: 14.31818 MHz;                 // the PC crystal
    clock cpu_clk: 25 MHz;                   // the processor clock
    clock bclk = cpu_clk / 3;                // 8.33 MHz ISA
    clock pit_clk = osc / 12;                // 1.193182 MHz
    clock dma_clk = osc / 3;                 // 4.77 MHz
    clock ega16: 16.257 MHz;                 // the EGA's 350-line dot clock

    component cpu: Cpu386 @ cpu_clk;
    component ram: Ram386;
    component rom: Rom386;
    component atbus: AtBus386;
    component pic1: Pic8259;
    component pic2: Pic8259;
    component pit: Pit8254 @ pit_clk;
    component dma: Dma8237 @ dma_clk;
    component link: HostLink;
    component ega: Ega @ (dot14: osc, dot16: ega16);
    component console: Console;

    bus local: LocalBus386 @ cpu_clk {
        master cpu.local;
        master atbus.mem;
        slave ram.port @ mem 0x000000..=0x09FFFF, mem 0x100000..=0x3FFFFF;
        slave rom.port @ mem 0xF0000..=0xFFFFF, mem 0xFFFF0000..=0xFFFFFFFF;
        slave atbus.local;
    }

    bus isa: IsaBus @ bclk {
        master atbus.isa;
        master dma.dma;
        // System RAM and the boot ROM, as ISA masters see them.
        slave atbus.sysmem @ mem 0x000000..=0x09FFFF, mem 0x0F0000..=0x3FFFFF;
        // The master first: it sees the acknowledge before the slave.
        slave pic1.port @ io 0x20..=0x21;
        slave pic2.port @ io 0xA0..=0xA1;
        slave pit.port @ io 0x40..=0x43;
        slave dma.regs @ io 0x00..=0x0F;
        slave dma.pages @ io 0x81..=0x87;
        slave link.port;
        slave console.port @ io 0xE9..=0xE9;
        slave ega.port @ mem 0xA0000..=0xBFFFF, mem 0xC0000..=0xC3FFF, io 0x3B0..=0x3DF;
    }

    /// IRQ 0-7: the timer on 0, the slave controller on 2.
    bus irq_master: IrqLines @ cpu_clk {
        master pic1.ir;
        slave pit.irq;
        slave pic2.cascade;
    }
    /// IRQ 8-15: the host link on 12.
    bus irq_slave: IrqLines @ cpu_clk {
        master pic2.ir;
        slave link.irq;
    }

    wire pic1.sp = true;
    wire pic2.sp = false;
    wire pic2.cas_in = pic1.cas_out;
    wire cpu.intr_line = pic1.int;
    /// No A20 gate on this board: address line 20 always passes.
    wire cpu.a20_gate = true;
    /// The EGA's configuration switches (1001 as the BIOS reads them): an
    /// Enhanced Color Display, primary, with a monochrome display beside it
    /// (whose mode sets the EGA BIOS hands to the system BIOS's video
    /// routine at F000:F065).
    wire ega.switches = 0x9;

    profile fast { default: model; }
    /// An emulator: the processor reaches RAM and ROM directly (time
    /// approximate: a transfer's clocks per dword touched).
    profile emulate { default: model; memory: direct; }
    /// The emulator with the trace core: runs of decoded instructions kept
    /// and run again.
    profile trace { default: model; memory: direct; core: trace; }
    /// The emulator with the JIT core: runs entered often compiled to host
    /// code.
    profile jit { default: model; memory: direct; core: jit; }
}

/// The same board with a VGA in place of the EGA.
system Board386Vga {
    clock osc: 14.31818 MHz;                 // the PC crystal
    clock cpu_clk: 25 MHz;                   // the processor clock
    clock bclk = cpu_clk / 3;                // 8.33 MHz ISA
    clock pit_clk = osc / 12;                // 1.193182 MHz
    clock dma_clk = osc / 3;                 // 4.77 MHz
    clock vga25: 25.175 MHz;                 // the VGA's dot clocks
    clock vga28: 28.322 MHz;

    component cpu: Cpu386 @ cpu_clk;
    component ram: Ram386;
    component rom: Rom386;
    component atbus: AtBus386;
    component pic1: Pic8259;
    component pic2: Pic8259;
    component pit: Pit8254 @ pit_clk;
    component dma: Dma8237 @ dma_clk;
    component link: HostLink;
    component vga: Vga @ (dot25: vga25, dot28: vga28);
    component console: Console;

    bus local: LocalBus386 @ cpu_clk {
        master cpu.local;
        master atbus.mem;
        slave ram.port @ mem 0x000000..=0x09FFFF, mem 0x100000..=0x3FFFFF;
        slave rom.port @ mem 0xF0000..=0xFFFFF, mem 0xFFFF0000..=0xFFFFFFFF;
        slave atbus.local;
    }

    bus isa: IsaBus @ bclk {
        master atbus.isa;
        master dma.dma;
        // System RAM and the boot ROM, as ISA masters see them.
        slave atbus.sysmem @ mem 0x000000..=0x09FFFF, mem 0x0F0000..=0x3FFFFF;
        // The master first: it sees the acknowledge before the slave.
        slave pic1.port @ io 0x20..=0x21;
        slave pic2.port @ io 0xA0..=0xA1;
        slave pit.port @ io 0x40..=0x43;
        slave dma.regs @ io 0x00..=0x0F;
        slave dma.pages @ io 0x81..=0x87;
        slave link.port;
        slave console.port @ io 0xE9..=0xE9;
        slave vga.port @ mem 0xA0000..=0xBFFFF, mem 0xC0000..=0xC7FFF, io 0x3B0..=0x3DF;
    }

    /// IRQ 0-7: the timer on 0, the slave controller on 2.
    bus irq_master: IrqLines @ cpu_clk {
        master pic1.ir;
        slave pit.irq;
        slave pic2.cascade;
    }
    /// IRQ 8-15: the host link on 12.
    bus irq_slave: IrqLines @ cpu_clk {
        master pic2.ir;
        slave link.irq;
    }

    wire pic1.sp = true;
    wire pic2.sp = false;
    wire pic2.cas_in = pic1.cas_out;
    wire cpu.intr_line = pic1.int;
    /// No A20 gate on this board: address line 20 always passes.
    wire cpu.a20_gate = true;

    profile fast { default: model; }
    /// An emulator: the processor reaches RAM and ROM directly (time
    /// approximate: a transfer's clocks per dword touched).
    profile emulate { default: model; memory: direct; }
    /// The emulator with the trace core: runs of decoded instructions kept
    /// and run again.
    profile trace { default: model; memory: direct; core: trace; }
    /// The emulator with the JIT core: runs entered often compiled to host
    /// code.
    profile jit { default: model; memory: direct; core: jit; }
}

/// A 386 AT with a VGA: the 25 MHz 386 board with the PC/AT's system-board
/// devices (both 8259s, the 8254 and port B, both DMA controllers and the
/// page registers, the MC146818 clock and CMOS, the 8042 keyboard
/// controller, the fixed disk and diskette adapter), a POST card, and the
/// IBM VGA. It boots IBM's PC/AT BIOS (`at_test.rs`).
system At386Vga {
    clock osc: 14.31818 MHz;
    clock cpu_clk: 25 MHz;
    clock bclk = cpu_clk / 3;
    clock pit_clk = osc / 12;
    clock dma_clk = osc / 3;
    clock rtc_clk: 32.768 kHz;
    clock vga25: 25.175 MHz;
    clock vga28: 28.322 MHz;

    component cpu: Cpu386 @ cpu_clk;
    component ram: Ram386;
    component rom: Rom386;
    component atbus: AtBus386;
    component pic1: Pic8259;
    component pic2: Pic8259;
    component pit: Pit8254 @ pit_clk;
    component dma: Dma8237 @ dma_clk;
    component dma2: Dma8237 @ dma_clk;
    component rtc: Mc146818 @ rtc_clk;
    component kbc: Kbc8042 @ pit_clk;
    component fdc: Fdc765 @ pit_clk;
    component hdc: Wd1003 @ pit_clk;
    component post: PostCard;
    component vga: Vga @ (dot25: vga25, dot28: vga28);

    bus local: LocalBus386 @ cpu_clk {
        master cpu.local;
        master atbus.mem;
        slave ram.port @ mem 0x000000..=0x09FFFF, mem 0x100000..=0x3FFFFF;
        slave rom.port @ mem 0xF0000..=0xFFFFF, mem 0xFFFF0000..=0xFFFFFFFF;
        slave atbus.local;
    }

    bus isa: IsaBus @ bclk {
        master atbus.isa;
        master dma.dma;
        master dma2.dma;
        slave atbus.sysmem @ mem 0x000000..=0x09FFFF, mem 0x0F0000..=0x3FFFFF;
        slave pic1.port @ io 0x20..=0x21;
        slave pic2.port @ io 0xA0..=0xA1;
        slave pit.port @ io 0x40..=0x43;
        slave pit.portb @ io 0x61..=0x61;
        slave dma.regs @ io 0x00..=0x0F;
        slave dma.pages @ io 0x81..=0x87;
        slave dma2.regs @ io 0xC0..=0xDF;
        slave dma2.pages @ io 0x88..=0x8F;
        slave post.port @ io 0x80..=0x80;
        slave rtc.port @ io 0x70..=0x71;
        slave kbc.port @ io 0x60..=0x60, io 0x64..=0x64;
        slave fdc.port @ io 0x3F2..=0x3F2, io 0x3F4..=0x3F5, io 0x3F7..=0x3F7;
        slave hdc.port @ io 0x1F0..=0x1F7, io 0x3F6..=0x3F6;
        slave vga.port @ mem 0xA0000..=0xBFFFF, mem 0xC0000..=0xC7FFF, io 0x3B0..=0x3DF;
    }

    bus irq_master: IrqLines @ cpu_clk {
        master pic1.ir;
        slave pit.irq;
        slave kbc.irq;
        slave pic2.cascade;
        slave fdc.irq;
    }
    bus irq_slave: IrqLines @ cpu_clk {
        master pic2.ir;
        slave rtc.irq;
        slave hdc.irq;
    }

    wire pic1.sp = true;
    wire pic2.sp = false;
    wire pic2.cas_in = pic1.cas_out;
    wire dma2.word = true;
    /// The keylock off, a colour display, no manufacturing jumper, 512 KB
    /// on the board.
    wire kbc.switches = 0xAF;
    wire cpu.intr_line = pic1.int;
    /// The A20 gate, from the keyboard controller.
    wire cpu.a20_gate = kbc.a20;
    wire cpu.reset_pin = kbc.cpu_reset;

    profile fast { default: model; }
    /// Direct memory bypasses the A20 gate: memory never wraps at 1 MB.
    profile emulate { default: model; memory: direct; }
    /// The emulator with the trace core: runs of decoded instructions kept
    /// and run again.
    profile trace { default: model; memory: direct; core: trace; }
    /// The emulator with the JIT core: runs entered often compiled to host
    /// code.
    profile jit { default: model; memory: direct; core: jit; }
    /// The JIT with its concessions: devices caught up once a run, and a
    /// compiled step's time in one add (SPEC 12, "Concessions").
    profile approx { default: model; memory: direct; core: jit; sync: run; timing: approximate; }
    /// The JIT as the fast PC emulators keep events: the devices caught up
    /// where a run goes round or returns, when one is due (DOSBox's slices,
    /// which end at the next event), interrupts recognised where a run is
    /// entered or goes round (QEMU's block starts). Time exact.
    profile blocks { default: model; memory: direct; core: jit; sync: block; events: block; }
    /// As `blocks`, with the devices caught up once a millisecond
    /// (MAME's quantum).
    profile quantum { default: model; memory: direct; core: jit; sync: quantum(1 ms); events: block; }
}
