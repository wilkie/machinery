// A small 80286 board for the model backend: the i286 isa as a processor
// on a 16-bit local bus, with RAM, a boot ROM, the AT's two cascaded 8259
// interrupt controllers, an 8254 timer, an 8237 DMA controller, a host data
// link on DMA channel 1 (and IRQ 12), a CGA, and a debugging console port.
//
// `machine build --system Board286 --out <dir> targets/i286/*.machine`
// generates the emulator crate: the interpreter, one struct per component
// model, and `system::System`, which runs the processor and charges every
// bus transaction to the system clock.

use i286::{I286};

enum Space : u1 { Mem, Io }
enum BusSize : u1 { Byte, Word }

/// The 286 local bus at the transaction level. A word transfer is aligned;
/// the processor splits an odd-address word into two byte transfers, as
/// the 286 does. A byte transfer carries its data in the low 8 bits
/// whatever the address: steering it to the right byte lane is the bus's
/// business, not the devices'.
bus LocalBus {
    clock clk;
    wires {
        addr:  u24  driven_by Master;
        data:  u16  shared;
        mio:   bool driven_by Master;
        rd:    bool driven_by Master;
        wr:    bool driven_by Master;
        bhe:   bool driven_by Master;
        ready: bool wired_and;
        drq:   [bool; 4] driven_by Slave;
    }
    /// The interrupt controllers are responders of their own kind: they
    /// answer the interrupt acknowledge.
    roles { Master; Slave; Controller; }

    /// Two bus cycles (Ts, Tc) without wait states.
    transaction read(space: Space, addr: u24, size: BusSize) -> (data: u16) {
        Master {
            cycle { addr = addr; mio = space == Space::Mem; bhe = size == BusSize::Word; rd = true; }
            wait until ready;
            cycle { let v = data; rd = false; return v; }
        }
    }
    transaction write(space: Space, addr: u24, size: BusSize, data: u16) {
        Master {
            cycle { addr = addr; mio = space == Space::Mem; bhe = size == BusSize::Word; data = data; wr = true; }
            wait until ready;
            cycle { wr = false; }
        }
    }

    /// The two interrupt-acknowledge cycles. Not address-decoded: the
    /// interrupt controller answers with the vector.
    transaction inta() -> (vector: u8) {
        Master {
            cycle { } cycle { }
            wait until ready;
            cycle { } cycle { }
        }
    }

    /// Fly-by DMA: the acknowledge half of a transfer. The device on the
    /// channel supplies (`dack_read`) or takes (`dack_write`) the byte while
    /// the DMA controller drives the memory side, which carries the bus
    /// time; the acknowledge itself costs no cycles. Not address-decoded:
    /// the device on the channel answers, the others decline.
    transaction dack_read(channel: u2) -> (data: u8) { Master { } }
    transaction dack_write(channel: u2, data: u8) { Master { } }

    signal dreq(channel: u2) = drq[channel];
}

/// The eight interrupt request lines into one 8259. Which device drives
/// which line is board wiring, so each controller has its own set: on the
/// AT the master's lines are IRQ 0-7 (IRQ 2 carrying the slave's INT) and
/// the slave's are IRQ 8-15.
bus IrqLines {
    clock clk;
    wires { ir: [bool; 8] driven_by Device; }
    roles { Controller; Device; }
    signal request(line: u3) = ir[line];
}

/// The later of two clocks.
unit Later(x: u64, y: u64) -> u64 {
    return if x > y { x } else { y };
}

/// One instruction as the pipeline model runs it: its schedule, with each
/// `access` step matched to the data access it stands for.
bundle Slot286 {
    valid: bool,
    len: u8,
    /// A sign-extended byte costs the decoder a clock (`decode Disp8`):
    /// one that starts a word stalls the decoder (`stall`, by byte);
    /// otherwise the instruction starts late (`late`).
    stall: [u4; 16],
    late: u4,
    start: u64,
    next: u64,
    /// Code bytes from `next` to the end of its segment.
    room: u32,
    halted: bool,
    /// The instruction transfers unconditionally: the decoder stops at its end.
    uncond: bool,
    /// Work before the first step, then each step (1 memory read, 2 memory
    /// write, 3 I/O read, 4 I/O write, 5 HALT, 6 jump), its bus cycles and
    /// the work after it.
    pre: u16,
    n: u8,
    kind: [u3; 72],
    cycles: [u2; 72],
    work: [u16; 72],
    /// It flushed the queue; its last byte has been decoded (at `ready_at`).
    jumped: bool,
    ready: bool,
    ready_at: u64,
}

/// The processor: the i286 isa, with its two address spaces bound to the
/// local bus.
///
/// Its timing is a model of the 286 pipeline (SPEC 11.2c, fitted to the
/// SingleStepTests traces in `research/i286-pipeline`): a 6-byte queue the
/// bus unit refills a word at a time, a decoder taking a byte a clock, and
/// an execution unit running each instruction's schedule. `on retire`
/// runs it, one instruction behind the interpreter (the decoder needs to
/// know where the following instruction ends), and returns the clocks
/// each took; the bus cycles it would run are recorded in `trace_*`.
/// The interpreter's own fetches go through a one-word buffer and take no
/// time of their own.
component Cpu286 {
    isa I286;
    ports {
        bus local: LocalBus::Master;
        /// INTR, from the master interrupt controller.
        in intr_line: bool;
    }
    model {
        /// The code word last fetched, and whether it is still good.
        state code: u16 = 0;
        state code_addr: u24 = 0;
        state code_valid: bool = false;

        // The data accesses of the instruction being interpreted.
        state lg_kind: [u3; 64];
        state lg_n: [u2; 64];
        state lg_count: u8 = 0;

        // The pipeline. Time is in processor clocks.
        state now: u64 = 0;
        state last_done: u64 = 0;
        state owed: u64 = 0;
        state need_flush: bool = true;
        /// Where the last instruction admitted started and continued: a
        /// repeated string instruction's next iteration starts where it
        /// started, with its bytes already decoded.
        state prev_start: u64 = 0xFFFFFFFFFFFFFFFF;
        state prev_next: u64 = 0xFFFFFFFFFFFFFFFF;
        /// The instruction executing (or next to) and the one after it.
        state a: Slot286;
        state b: Slot286;
        /// Execution unit: 0 waiting to start, 1 working until `eu_t`, 2
        /// waiting for a read, 3 done (at `done_at`); `si` is the next step.
        state eu: u2 = 0;
        state eu_t: u64 = 0;
        state si: u8 = 0;
        state done_at: u64 = 0;
        state wait_work: u16 = 0;
        state data_ready: u64 = 0;
        state data_set: bool = false;
        state halting: bool = false;
        state halt_from: u64 = 0;
        // Requests to the bus unit, oldest first.
        state rq_made: [u64; 8];
        state rq_kind: [u3; 8];
        state rq_left: [u2; 8];
        state rq_wait: [bool; 8];
        state rq_head: u8 = 0;
        state rq_count: u8 = 0;
        // The bus unit: busy until `bus_free`, prefetching at `fp`, no
        // prefetch decision before `fetch_block`; two fetches in flight.
        state bus_free: u64 = 1;
        state fetch_block: u64 = 0;
        state fp: u24 = 0;
        /// The bus unit does not prefetch at or past this address (the end
        /// of the code segment).
        state fetch_end: u64 = 0xFFFFFFFFFFFFFFFF;
        state f0_used: bool = false;
        state f0_live: bool = false;
        state f0_at: u64 = 0;
        state f0_n: u2 = 0;
        state f1_used: bool = false;
        state f1_live: bool = false;
        state f1_at: u64 = 0;
        state f1_n: u2 = 0;
        // The queue since the last flush: bytes arrived (an odd fetch's
        // dead byte included), entries and real bytes decoded, when the
        // last one was, and where the executing instruction starts.
        state ent_at: [u64; 8];
        state ent_dead: [bool; 8];
        state arrived: u32 = 0;
        state decoded: u32 = 0;
        state real: u32 = 0;
        state last_dec: u64 = 0;
        state base: u32 = 0;
        /// The bus cycles run: 0 code, 1 memory read, 2 memory write, 3 I/O
        /// read, 4 I/O write, 5 HALT; at the clock each started.
        state trace_kind: [u3; 512];
        state trace_at: [u32; 512];
        state trace_n: u16 = 0;

        on intr() -> bool { return intr_line; }

        on mem.fetch_u8(addr: u24) -> u8 {
            let w = addr & 0xFFFFFE;
            if !code_valid || w != code_addr {
                code = local.read(space: Space::Mem, addr: w, size: BusSize::Word).data;
                code_addr = w;
                code_valid = true;
            }
            return if addr[0] == 0 { code as u8 } else { (code >> 8) as u8 };
        }

        /// A store into the buffered word makes it stale.
        fn wrote(addr: u24) {
            if (addr & 0xFFFFFE) == code_addr || ((addr + 1) & 0xFFFFFE) == code_addr {
                code_valid = false;
            }
        }
        on acknowledge() -> u8 { return local.inta().vector; }

        /// The instruction made a data access of `cycles` bus cycles.
        fn note(kind: u3, cycles: u2) {
            if lg_count < 64 {
                lg_kind[lg_count] = kind;
                lg_n[lg_count] = cycles;
                lg_count = lg_count + 1;
            }
        }

        on mem.read_u8(addr: u24) -> u8 {
            note(1, 1);
            return local.read(space: Space::Mem, addr: addr, size: BusSize::Byte).data as u8;
        }
        /// An aligned word is one transfer; an odd address takes two.
        on mem.read_u16(addr: u24) -> u16 {
            if addr[0] == 0 {
                note(1, 1);
                return local.read(space: Space::Mem, addr: addr, size: BusSize::Word).data;
            }
            note(1, 2);
            let lo = local.read(space: Space::Mem, addr: addr, size: BusSize::Byte).data as u8;
            let hi = local.read(space: Space::Mem, addr: addr + 1, size: BusSize::Byte).data as u8;
            return concat(hi, lo);
        }
        on mem.write_u8(addr: u24, data: u8) {
            wrote(addr);
            note(2, 1);
            local.write(space: Space::Mem, addr: addr, size: BusSize::Byte, data: data as u16);
        }
        on mem.write_u16(addr: u24, data: u16) {
            wrote(addr);
            if addr[0] == 0 {
                note(2, 1);
                local.write(space: Space::Mem, addr: addr, size: BusSize::Word, data: data);
            } else {
                note(2, 2);
                local.write(space: Space::Mem, addr: addr, size: BusSize::Byte, data: data & 0xFF);
                local.write(space: Space::Mem, addr: addr + 1, size: BusSize::Byte, data: data >> 8);
            }
        }
        on io.read_u8(addr: u16) -> u8 {
            note(3, 1);
            return local.read(space: Space::Io, addr: addr as u24, size: BusSize::Byte).data as u8;
        }
        on io.write_u8(addr: u16, data: u8) {
            note(4, 1);
            local.write(space: Space::Io, addr: addr as u24, size: BusSize::Byte, data: data as u16);
        }
        /// A word port is one access for the pipeline (two bus cycles at an
        /// odd port); the devices see it a byte at a time.
        on io.read_u16(addr: u16) -> u16 {
            note(3, if addr[0] == 0 { 1 } else { 2 });
            let lo = local.read(space: Space::Io, addr: addr as u24, size: BusSize::Byte).data as u8;
            let hi = local.read(space: Space::Io, addr: (addr + 1) as u24, size: BusSize::Byte).data as u8;
            return concat(hi, lo);
        }
        on io.write_u16(addr: u16, data: u16) {
            note(4, if addr[0] == 0 { 1 } else { 2 });
            local.write(space: Space::Io, addr: addr as u24, size: BusSize::Byte, data: data & 0xFF);
            local.write(space: Space::Io, addr: (addr + 1) as u24, size: BusSize::Byte, data: data >> 8);
        }

        /// Start over with an empty pipeline at clock 0 and an empty bus
        /// record, as after a jump: the next instruction is fetched from
        /// scratch (the conformance rig runs each vector from here).
        fn flush() {
            now = 0;
            last_done = 0;
            owed = 0;
            trace_n = 0;
            a.valid = false;
            b.valid = false;
            eu = 0;
            rq_count = 0;
            data_set = false;
            f0_used = false;
            f1_used = false;
            bus_free = 1;
            lg_count = 0;
            need_flush = true;
            prev_start = 0xFFFFFFFFFFFFFFFF;
            prev_next = 0xFFFFFFFFFFFFFFFF;
        }

        /// The instruction's timing: run the pipeline until the instruction
        /// before it has finished (or, for HLT, this one), and return the
        /// clocks that took.
        on retire(s: Schedule) -> u32 {
            if need_flush {
                start_stream(s.start);
                need_flush = false;
            }
            admit(s);
            let mut guard: u32 = 0;
            while a.valid && (b.valid || a.halted) && guard < 100000 {
                clock();
                guard = guard + 1;
            }
            let c = owed;
            owed = 0;
            return c as u32;
        }

        /// The queue starts over at `addr`.
        fn start_stream(addr: u64) {
            arrived = 0;
            decoded = 0;
            real = 0;
            base = 0;
            last_dec = now;
            fp = addr as u24;
            fetch_end = 0xFFFFFFFFFFFFFFFF;
            fetch_block = now;
            f0_live = false;
            f1_live = false;
            halting = false;
        }

        /// Takes `s` (with the accesses noted while it ran) as the next
        /// instruction to time.
        fn admit(s: Schedule) {
            // A repeated string instruction's later iteration: its bytes
            // were decoded for the first.
            let again = s.start == prev_start && prev_next == prev_start;
            prev_start = s.start;
            prev_next = s.next;
            b.valid = true;
            b.len = if again { 0 } else { s.length };
            b.late = 0;
            for i in 0..16 {
                let d = if again { 0 } else { s.decode[i] };
                let even = ((s.start + i as u64) & 1) == 0;
                b.stall[i] = if even { d } else { 0 };
                if !even && d > b.late {
                    b.late = d;
                }
            }
            b.start = s.start;
            b.next = s.next;
            b.room = s.room;
            b.halted = s.halted;
            b.uncond = false;
            b.jumped = false;
            b.ready = b.len == 0;
            b.ready_at = 0;
            // HLT asks for its HALT bus cycle three clocks after it starts.
            b.pre = if s.halted { 3 } else { s.work[0] };
            b.n = 0;
            let mut li: u8 = 0;
            let mut jumps = false;
            for i in 0..8 {
                if (i as u4) < s.steps {
                    let w = s.work[(i as u4) + 1];
                    if s.step[i] == 1 {
                        // `access * n`: n accesses, the work after the last.
                        let mut k: u8 = 0;
                        while k < s.count[i] && li < lg_count {
                            push(lg_kind[li], lg_n[li], 0);
                            li = li + 1;
                            k = k + 1;
                        }
                        add_work(w);
                    } else {
                        push(6, 0, w);
                        jumps = true;
                        if s.step[i] == 2 {
                            b.uncond = true;
                        }
                    }
                }
            }
            // Accesses the schedule does not name follow with no work between.
            while li < lg_count {
                push(lg_kind[li], lg_n[li], 0);
                li = li + 1;
            }
            // A transfer the schedule does not name (an unfitted entry, a
            // fault, an interrupt) happens at the end; an iteration that
            // repeats does not transfer.
            let repeats = s.next == s.start && s.length != 0;
            if !jumps && !s.halted && !repeats && (s.length == 0 || s.next != s.start + s.length as u64) {
                push(6, 0, 0);
                b.uncond = true;
            }
            if s.halted {
                push(5, 1, 0);
            }
            lg_count = 0;
            if !a.valid {
                a = b;
                b.valid = false;
                eu = 0;
                si = 0;
            }
        }

        fn push(k: u3, c: u2, w: u16) {
            if b.n < 72 {
                b.kind[b.n] = k;
                b.cycles[b.n] = c;
                b.work[b.n] = w;
                b.n = b.n + 1;
            }
        }

        fn add_work(w: u16) {
            if b.n == 0 {
                b.pre = b.pre + w;
            } else {
                b.work[b.n - 1] = b.work[b.n - 1] + w;
            }
        }

        /// One clock: fetches arrive, the decoder takes bytes, the execution
        /// unit runs, and the bus unit chooses the next bus cycle.
        fn clock() {
            arrive();
            decode_bytes();
            execute();
            bus_phase();
            now = now + 1;
        }

        fn arrive() {
            while f0_used && f0_at <= now {
                if f0_live {
                    // An odd fetch's word slot holds a dead byte until the
                    // next flush.
                    if f0_n == 1 {
                        add_entry(f0_at, true);
                    }
                    add_entry(f0_at, false);
                    if f0_n == 2 {
                        add_entry(f0_at, false);
                    }
                }
                f0_used = f1_used;
                f0_live = f1_live;
                f0_at = f1_at;
                f0_n = f1_n;
                f1_used = false;
            }
        }

        fn add_entry(at: u64, dead: bool) {
            ent_at[arrived & 7] = at;
            ent_dead[arrived & 7] = dead;
            arrived = arrived + 1;
        }

        /// Where the instruction after the executing one starts in the queue.
        fn next_base() -> u32 {
            return if a.jumped { 0 } else { base + a.len as u32 };
        }

        /// How many real bytes the decoder may have taken: through the
        /// instruction after the executing one, or only the executing one's
        /// when it transfers unconditionally.
        fn decode_limit() -> u32 {
            if !a.valid {
                return base;
            }
            if a.uncond && !a.jumped {
                return base + a.len as u32;
            }
            if b.valid {
                return next_base() + b.len as u32;
            }
            return if a.jumped { 0 } else { base + a.len as u32 };
        }

        fn decode_bytes() {
            let lim = decode_limit();
            let nb = next_base();
            while decoded < arrived && real < lim {
                let k = decoded;
                if ent_dead[k & 7] {
                    // Freed with the byte beside it.
                    if k + 1 >= arrived {
                        return;
                    }
                    let p = Later(last_dec + 1, ent_at[(k + 1) & 7] + 1);
                    if p > now {
                        return;
                    }
                    decoded = decoded + 1;
                    continue;
                }
                let mut p = Later(last_dec + 1, ent_at[k & 7] + 1);
                // A sign-extended byte that starts a word stalls the decoder.
                if a.valid && !a.jumped && k >= base && k < base + 16 {
                    p = p + a.stall[k - base] as u64;
                }
                if b.valid && k >= nb && k < nb + 16 {
                    p = p + b.stall[k - nb] as u64;
                }
                if p > now {
                    return;
                }
                decoded = decoded + 1;
                real = real + 1;
                last_dec = p;
                // Otherwise it starts the instruction late.
                if a.valid && !a.jumped && !a.ready && real == base + a.len as u32 {
                    a.ready = true;
                    a.ready_at = p + a.late as u64;
                }
                if b.valid && !b.ready && real == nb + b.len as u32 {
                    b.ready = true;
                    b.ready_at = p + b.late as u64;
                }
            }
        }

        fn execute() {
            let mut i: u32 = 0;
            while i < 64 {
                i = i + 1;
                if !a.valid {
                    return;
                }
                if eu == 0 {
                    if !a.ready || now < a.ready_at {
                        return;
                    }
                    eu = 1;
                    eu_t = now + a.pre as u64;
                    si = 0;
                    if a.halted {
                        halting = true;
                        halt_from = now;
                    }
                } else if eu == 1 {
                    if now < eu_t {
                        return;
                    }
                    if si < a.n {
                        start_step();
                    } else {
                        eu = 3;
                        done_at = now;
                    }
                } else if eu == 2 {
                    if !data_set || now < data_ready {
                        return;
                    }
                    data_set = false;
                    eu = 1;
                    eu_t = now + wait_work as u64;
                } else {
                    if !b.valid && !a.halted {
                        return;
                    }
                    complete();
                }
            }
        }

        /// The executing instruction is done: account for it and move on.
        fn complete() {
            owed = owed + (done_at - last_done);
            last_done = done_at;
            base = next_base();
            a = b;
            b.valid = false;
            eu = 0;
            si = 0;
        }

        fn start_step() {
            let k = a.kind[si];
            let c = a.cycles[si];
            let w = a.work[si];
            si = si + 1;
            if k == 6 {
                // A jump flushes the queue and refills it from the target;
                // the target's fetch is decided a clock later.
                f0_live = false;
                f1_live = false;
                arrived = 0;
                decoded = 0;
                real = 0;
                last_dec = now;
                fp = a.next as u24;
                fetch_end = a.next + a.room as u64;
                fetch_block = now + 1;
                a.jumped = true;
                b.ready = b.len == 0;
                eu = 1;
                eu_t = now + w as u64;
                return;
            }
            // A request reaches the bus two clocks after it is made. Reads
            // (and HALT) wait for their last bus cycle to start; writes are
            // posted.
            let wait = k == 1 || k == 3 || k == 5;
            if rq_count < 8 {
                let j = (rq_head + rq_count) & 7;
                rq_made[j] = now;
                rq_kind[j] = k;
                rq_left[j] = c;
                rq_wait[j] = wait;
                rq_count = rq_count + 1;
            }
            if wait {
                eu = 2;
                wait_work = w;
            } else {
                eu = 1;
                eu_t = now + w as u64;
            }
        }

        fn record(kind: u3, at: u64) {
            if trace_n < 512 {
                trace_kind[trace_n] = kind;
                trace_at[trace_n] = at as u32;
                trace_n = trace_n + 1;
            }
        }

        /// The bus unit decides, a clock ahead, what the next bus cycle is:
        /// a request if one is due, else a prefetch if a word fits.
        fn bus_phase() {
            let s = now + 1;
            if s < bus_free {
                return;
            }
            if rq_count > 0 && s >= rq_made[rq_head] + 2 {
                let h = rq_head;
                record(rq_kind[h], s - 1);
                rq_left[h] = rq_left[h] - 1;
                bus_free = s + 2;
                if rq_left[h] == 0 {
                    rq_head = (h + 1) & 7;
                    rq_count = rq_count - 1;
                    if rq_wait[h] {
                        data_ready = s;
                        data_set = true;
                    }
                }
                return;
            }
            if s < fetch_block || (halting && now > halt_from) || fp as u64 >= fetch_end {
                return;
            }
            let consumed = if real > 0 && last_dec == now { real - 1 } else { real };
            let mut q = arrived - consumed;
            if f0_used && f0_live {
                q = q + 2;
            }
            if f1_used && f1_live {
                q = q + 2;
            }
            let n: u2 = if fp[0] == 1 { 1 } else { 2 };
            if q + n as u32 <= 6 {
                record(0, s - 1);
                if !f0_used {
                    f0_used = true;
                    f0_live = true;
                    f0_at = s + 2;
                    f0_n = n;
                } else {
                    f1_used = true;
                    f1_live = true;
                    f1_at = s + 2;
                    f1_n = n;
                }
                fp = fp + n as u24;
                bus_free = s + 2;
            }
        }
    }
}

/// 640 KB of zero-wait-state RAM at the bottom of memory.
component Ram {
    ports { bus port: LocalBus::Slave; }
    model {
        mem cells: [u8; 0xA0000];
        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            if size == BusSize::Word {
                return (data: concat(cells[addr + 1], cells[addr]), wait: 0);
            }
            return (data: cells[addr] as u16, wait: 0);
        }
        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            cells[addr] = data as u8;
            if size == BusSize::Word {
                cells[addr + 1] = (data >> 8) as u8;
            }
            return (wait: 0);
        }
    }
}

/// A 64 KB boot ROM with one wait state, answering at the top of the first
/// megabyte and at the top of the 16 MB space, where the 286 starts.
/// Writes are not answered.
component Rom {
    ports { bus port: LocalBus::Slave; }
    model {
        mem cells: [u8; 0x10000];
        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let a = addr[15:0];
            if size == BusSize::Word {
                return (data: concat(cells[a + 1], cells[a]), wait: 1);
            }
            return (data: cells[a] as u16, wait: 1);
        }
    }
}

/// The 8259 programmable interrupt controller in fixed-priority,
/// edge-triggered mode: a rising edge on an IR line sets its request bit,
/// and INT is high while an unmasked request outranks every line in
/// service. Port 0 takes ICW1, OCW2 (EOI) and OCW3 (which register a read
/// returns); port 1 takes ICW2-4 during initialisation and the mask (OCW1)
/// after.
///
/// Cascading: the SP/EN pin, strapped on the board, says which chip is the
/// master. The master's INT goes to the processor; a slave drives its INT
/// onto the master's IR line given by its ICW3 (its ID). When the master
/// grants a line that ICW3 marks as having a slave, it names the slave on
/// CAS0-2 and declines the acknowledge, and the slave whose ID matches
/// answers with its vector.
component Pic8259 {
    ports {
        bus port: LocalBus::Controller;
        /// IR0-7.
        bus ir: IrqLines::Controller;
        /// As a slave: INT onto the master's IR line.
        bus cascade: IrqLines::Device;
        /// SP/EN: high for the master.
        in sp: bool;
        out int: bool;
        /// CAS0-2, driven by the master and read by the slaves.
        out cas_out: u3;
        in cas_in: u3;
    }
    model {
        state irr: u8 = 0;
        state isr: u8 = 0;
        state imr: u8 = 0xFF;
        state base: u8 = 0;
        /// The master's slave lines, or a slave's ID.
        state icw3: u8 = 0;
        /// The ICW expected next on port 1: 2, 3, 4, or 0 when initialised.
        state icw: u8 = 0;
        state icw4_needed: bool = false;
        state single: bool = true;
        state auto_eoi: bool = false;
        state read_isr: bool = false;
        state lines: u8 = 0;

        /// INT follows the request the controller would grant.
        fn update_int() {
            let req = PicGrant(irr, imr, isr) != 0;
            int = req;
            if !sp && !single {
                emit cascade.request(icw3[2:0]) = req;
            }
        }

        /// Grant the highest-priority request: requested to in service.
        /// Returns the line, or 7 when nothing is requested (spurious).
        fn grant() -> u3 {
            let g = PicGrant(irr, imr, isr);
            if g == 0 {
                return 7;
            }
            let line = (g - 1) as u3;
            let bit = (1 as u8) << line;
            irr = irr & ~bit;
            if !auto_eoi {
                isr = isr | bit;
            }
            update_int();
            return line;
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let v: u8 = if addr[0] == 1 { imr } else if read_isr { isr } else { irr };
            return (data: v as u16, wait: 1);
        }
        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let d = data as u8;
            if addr[0] == 0 {
                if d[4] == 1 {
                    // ICW1: start initialisation; the mask clears.
                    icw = 2;
                    icw4_needed = d[0] == 1;
                    single = d[1] == 1;
                    imr = 0;
                    isr = 0;
                    read_isr = false;
                    auto_eoi = false;
                } else if d[3] == 0 {
                    // OCW2: non-specific EOI ends the highest-priority
                    // line in service, specific EOI the line named.
                    let cmd = d[7:5];
                    if cmd == 1 {
                        isr = isr & ~(isr & (~isr + 1));
                    } else if cmd == 3 {
                        isr = isr & ~((1 as u8) << d[2:0]);
                    }
                } else if d[1] == 1 {
                    // OCW3: select the register port 0 reads.
                    read_isr = d[0] == 1;
                }
            } else if icw == 2 {
                base = d & 0xF8;
                icw = if !single { 3 } else if icw4_needed { 4 } else { 0 };
            } else if icw == 3 {
                icw3 = d;
                icw = if icw4_needed { 4 } else { 0 };
            } else if icw == 4 {
                auto_eoi = d[1] == 1;
                icw = 0;
            } else {
                imr = d;
            }
            update_int();
            return (wait: 1);
        }
        on ir.request(line: u3, value: bool) {
            let bit = (1 as u8) << line;
            if value && (lines & bit) == 0 {
                irr = irr | bit;
            }
            lines = if value { lines | bit } else { lines & ~bit };
            update_int();
        }
        /// The acknowledge: the master grants, and either answers or names
        /// the slave on CAS and declines; a slave answers only when named.
        on port.inta() -> (vector: u8, wait: u8) {
            if sp || single {
                let line = grant();
                if !single && icw3[line] == 1 {
                    cas_out = line;
                    decline;
                }
                return (vector: base | line as u8, wait: 0);
            }
            if cas_in != icw3[2:0] {
                decline;
            }
            let line = grant();
            return (vector: base | line as u8, wait: 0);
        }
    }
}

/// The request the 8259 grants under fixed priority (IR0 highest): its
/// line plus one, or 0 when no unmasked request outranks the lines in
/// service.
unit PicGrant(irr: u8, imr: u8, isr: u8) -> u4 {
    for i in 0..8 {
        if isr[i] == 1 {
            return 0;
        }
        if irr[i] == 1 && imr[i] == 0 {
            return (i + 1) as u4;
        }
    }
    return 0;
}

/// One 8254 counter channel.
bundle PitChannel {
    count: u16,
    reload: u16,
    mode: u3,
    /// 1 low byte, 2 high byte, 3 low then high.
    access: u2,
    counting: bool,
    /// Access mode 3: the low byte of a new count has been written.
    low_written: bool,
    low_byte: u8,
    /// Access mode 3: the next read returns the high byte.
    read_high: bool,
    latched: bool,
    latch: u16,
    out: bool,
}

/// The 8254 programmable interval timer: three 16-bit down-counters on one
/// clock. Port 3 takes control words (channel, access mode, counting mode,
/// or a counter latch command); ports 0-2 read and write the counters in
/// the programmed access mode (low byte, high byte, or low then high).
/// Modes 0 (interrupt on terminal count), 2 (rate generator) and 3 (square
/// wave, counted like mode 2) count; the gated modes 1 and 5 wait. Channel
/// 0's output drives interrupt line 0. The model catches up in one step
/// per `tick`, raising one edge however many periods passed.
component Pit8254 {
    ports {
        bus port: LocalBus::Slave;
        /// OUT0 drives IRQ 0.
        bus irq: IrqLines::Device;
    }
    model {
        state ch: [PitChannel; 3];

        /// Set a channel's OUT pin; channel 0's drives interrupt line 0.
        fn set_out(c: u2, level: bool) {
            ch[c].out = level;
            if c == 0 {
                emit irq.request(0) = level;
            }
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let c = addr[1:0];
            if c == 3 {
                return (data: 0xFF, wait: 1);
            }
            let v = if ch[c].latched { ch[c].latch } else { ch[c].count };
            let high = ch[c].access == 2 || (ch[c].access == 3 && ch[c].read_high);
            if ch[c].access == 3 {
                ch[c].read_high = !ch[c].read_high;
            }
            if ch[c].access != 3 || !ch[c].read_high {
                ch[c].latched = false;
            }
            let b: u8 = if high { (v >> 8) as u8 } else { v as u8 };
            return (data: b as u16, wait: 1);
        }
        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let d = data as u8;
            let c = addr[1:0];
            if c == 3 {
                let sel = d[7:6];
                if sel == 3 {
                    return (wait: 1);
                }
                if d[5:4] == 0 {
                    ch[sel].latch = ch[sel].count;
                    ch[sel].latched = true;
                    return (wait: 1);
                }
                ch[sel].access = d[5:4];
                ch[sel].mode = if d[3:2] == 3 { d[3:1] & 3 } else { d[3:1] };
                ch[sel].counting = false;
                ch[sel].low_written = false;
                ch[sel].read_high = false;
                ch[sel].latched = false;
                // OUT starts low in mode 0, high in the others.
                set_out(sel, ch[sel].mode != 0);
                return (wait: 1);
            }
            // A count is complete after one byte, or the second of two.
            let full = ch[c].access != 3 || ch[c].low_written;
            if ch[c].access == 1 {
                ch[c].reload = d as u16;
            } else if ch[c].access == 2 {
                ch[c].reload = (d as u16) << 8;
            } else if !ch[c].low_written {
                ch[c].low_byte = d;
                ch[c].low_written = true;
                if ch[c].mode == 0 {
                    ch[c].counting = false;
                }
            } else {
                ch[c].reload = concat(d, ch[c].low_byte);
                ch[c].low_written = false;
            }
            if full {
                ch[c].count = ch[c].reload;
                ch[c].counting = ch[c].mode == 0 || ch[c].mode == 2 || ch[c].mode == 3;
                if ch[c].mode == 0 {
                    set_out(c, false);
                }
            }
            return (wait: 1);
        }
        /// Returns the cycles until channel 0's OUT next changes: nothing
        /// else here is visible without a bus access, which catches the
        /// timer up first.
        on tick(n: u32) -> u32 {
            for c in 0..3 {
                if ch[c].counting {
                    let period: u32 = if ch[c].reload == 0 { 0x10000 } else { ch[c].reload as u32 };
                    let left: u32 = if ch[c].count == 0 { 0x10000 } else { ch[c].count as u32 };
                    if n < left {
                        ch[c].count = (left - n) as u16;
                    } else if ch[c].mode == 0 {
                        ch[c].count = ((left + 0x10000 - n % 0x10000) % 0x10000) as u16;
                        if !ch[c].out {
                            set_out(c, true);
                        }
                    } else {
                        ch[c].count = (period - (n - left) % period) as u16;
                        // OUT pulses low as the count reloads: one edge.
                        set_out(c, false);
                        set_out(c, true);
                    }
                }
            }
            if !ch[0].counting || (ch[0].mode == 0 && ch[0].out) {
                return 0xFFFFFFFF;
            }
            return if ch[0].count == 0 { 0x10000 } else { ch[0].count as u32 };
        }
    }
}

/// One 8237 channel.
bundle DmaChannel {
    base_addr: u16,
    base_count: u16,
    addr: u16,
    count: u16,
    /// bits 0-1 channel, 2-3 transfer (1 write to memory, 2 read from
    /// memory), 4 autoinitialise, 5 address decrement, 6-7 mode
    mode: u8,
    masked: bool,
    /// Terminal count reached since the status register was last read.
    tc: bool,
    /// The address bits above 16, from the page register.
    page: u8,
}

/// The 8237 DMA controller with the AT's page registers. Registers 0-7
/// are each channel's address and count (low then high byte, through the
/// flip-flop), 8 status (read; clears the TC bits) and command (write), 10
/// a single mask bit, 11 the mode, 12 clears the flip-flop, 13 is a master
/// clear, 14 clears every mask and 15 writes them all. The page registers
/// at 81-87 give each channel's address bits 16-23. A channel transfers
/// while it is unmasked and its device holds DREQ, single-cycle mode, about
/// one byte per four DMA clocks; at terminal count it masks itself unless
/// it autoinitialises.
component Dma8237 {
    ports {
        bus regs: LocalBus::Slave;
        bus pages: LocalBus::Slave;
        bus dma: LocalBus::Master;
    }
    model {
        state ch: [DmaChannel; 4];
        state command: u8 = 0;
        state flip: bool = false;

        on reset { master_clear(); }

        fn master_clear() {
            for c in 0..4 {
                ch[c].masked = true;
                ch[c].tc = false;
            }
            command = 0;
            flip = false;
        }

        /// One fly-by transfer on channel `c`, then the address and count step.
        fn transfer(c: u2) {
            let a = concat(ch[c].page, ch[c].addr);
            let kind = ch[c].mode[3:2];
            if kind == 1 {
                let b = dma.dack_read(channel: c).data;
                dma.write(space: Space::Mem, addr: a, size: BusSize::Byte, data: b as u16);
            } else if kind == 2 {
                let b = dma.read(space: Space::Mem, addr: a, size: BusSize::Byte).data as u8;
                dma.dack_write(channel: c, data: b);
            }
            ch[c].addr = if ch[c].mode[5] == 1 { ch[c].addr - 1 } else { ch[c].addr + 1 };
            // Terminal count is the count rolling over from 0 to FFFF.
            let last = ch[c].count == 0;
            ch[c].count = ch[c].count - 1;
            if last {
                ch[c].tc = true;
                if ch[c].mode[4] == 1 {
                    ch[c].addr = ch[c].base_addr;
                    ch[c].count = ch[c].base_count;
                } else {
                    ch[c].masked = true;
                }
            }
        }

        /// Returns four clocks (one transfer) while a channel is active,
        /// else never: a rising DREQ wakes the controller, through the
        /// handler below, and programming it is a bus access.
        on tick(n: u32) -> u32 {
            if command[2] == 1 {
                return 0xFFFFFFFF;
            }
            let mut budget: u32 = n / 4;
            for c in 0..4 {
                while budget > 0 && !ch[c].masked && dma.dreq(c) {
                    transfer(c);
                    budget = budget - 1;
                }
            }
            for c in 0..4 {
                if !ch[c].masked && dma.dreq(c) {
                    return 4;
                }
            }
            return 0xFFFFFFFF;
        }

        /// A request edge: nothing to do but be woken.
        on dma.dreq(channel: u2, value: bool) { }

        on regs.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let r = addr[3:0];
            if r < 8 {
                let c = addr[2:1];
                let v = if r[0] == 0 { ch[c].addr } else { ch[c].count };
                let b: u8 = if flip { (v >> 8) as u8 } else { v as u8 };
                flip = !flip;
                return (data: b as u16, wait: 1);
            }
            if r == 8 {
                let mut status: u8 = 0;
                for c in 0..4 {
                    if ch[c].tc {
                        status = status | ((1 as u8) << c);
                        ch[c].tc = false;
                    }
                    if dma.dreq(c) {
                        status = status | ((0x10 as u8) << c);
                    }
                }
                return (data: status as u16, wait: 1);
            }
            return (data: 0xFF, wait: 1);
        }

        on regs.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let d = data as u8;
            let r = addr[3:0];
            if r < 8 {
                let c = addr[2:1];
                if r[0] == 0 {
                    let v = if flip { concat(d, ch[c].base_addr as u8) } else { (ch[c].base_addr & 0xFF00) | d as u16 };
                    ch[c].base_addr = v;
                    ch[c].addr = v;
                } else {
                    let v = if flip { concat(d, ch[c].base_count as u8) } else { (ch[c].base_count & 0xFF00) | d as u16 };
                    ch[c].base_count = v;
                    ch[c].count = v;
                }
                flip = !flip;
            } else if r == 8 {
                command = d;
            } else if r == 10 {
                ch[d[1:0]].masked = d[2] == 1;
            } else if r == 11 {
                ch[d[1:0]].mode = d;
            } else if r == 12 {
                flip = false;
            } else if r == 13 {
                master_clear();
            } else if r == 14 {
                for c in 0..4 {
                    ch[c].masked = false;
                }
            } else if r == 15 {
                for c in 0..4 {
                    ch[c].masked = d[c] == 1;
                }
            }
            return (wait: 1);
        }

        /// The AT page registers: 87 channel 0, 83 channel 1, 81 channel 2,
        /// 82 channel 3.
        on pages.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            let r = addr[2:0];
            if r == 7 {
                ch[0].page = data as u8;
            } else if r == 3 {
                ch[1].page = data as u8;
            } else if r == 1 {
                ch[2].page = data as u8;
            } else if r == 2 {
                ch[3].page = data as u8;
            }
            return (wait: 1);
        }
        on pages.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            let r = addr[2:0];
            let v: u8 = if r == 7 { ch[0].page } else if r == 3 { ch[1].page } else if r == 1 { ch[2].page } else if r == 2 { ch[3].page } else { 0xFF };
            return (data: v as u16, wait: 1);
        }
    }
}

/// A data link to the embedding program over DMA channel 1. Bytes the host
/// pushes are requested on DREQ 1 and written to memory by the DMA
/// controller; when the host expects bytes, the device requests them and
/// collects what the controller reads out of memory.
component HostLink {
    ports {
        bus port: LocalBus::Slave;
        /// IRQ 12, on the slave controller's IR4.
        bus irq: IrqLines::Device;
    }
    model {
        mem inbox: [u8; 256];
        state head: u8 = 0;
        state tail: u8 = 0;
        mem outbox: [u8; 256];
        state out_len: u8 = 0;
        state wanted: u8 = 0;

        fn update_dreq() {
            emit port.dreq(1) = head != tail || wanted != 0;
        }

        /// Host side: queue a byte for the guest.
        fn push(b: u8) {
            inbox[tail] = b;
            tail = tail + 1;
            update_dreq();
        }

        /// Host side: raise or drop the link's interrupt.
        fn interrupt(level: bool) {
            emit irq.request(4) = level;
        }

        /// Host side: ask for `n` bytes from the guest.
        fn expect(n: u8) {
            wanted = n;
            update_dreq();
        }

        on port.dack_read(channel: u2) -> (data: u8, wait: u8) {
            if channel != 1 || head == tail {
                decline;
            }
            let b = inbox[head];
            head = head + 1;
            update_dreq();
            return (data: b, wait: 0);
        }

        on port.dack_write(channel: u2, data: u8) -> (wait: u8) {
            if channel != 1 || wanted == 0 {
                decline;
            }
            outbox[out_len] = data;
            out_len = out_len + 1;
            wanted = wanted - 1;
            update_dreq();
            return (wait: 0);
        }
    }
}

/// The IBM Color Graphics Adapter: 16 KB of video RAM at B8000 (mirrored
/// to BFFFF), an MC6845 CRTC at 3D4/3D5, the mode control register at 3D8,
/// colour select at 3D9 and status at 3DA. It counts its 14.318 MHz dot
/// clock; as the beam finishes each scanline of the display area it renders
/// that line into `frame`, 640 dots wide, one colour index (0-15, IRGB)
/// per dot, so low-resolution modes draw every pixel twice. The host reads
/// `frame`, `frame_width`, `frame_height` and the `frames` counter. The
/// character generator's 8x8 font is in `font` (eight rows per character,
/// most significant bit leftmost), which the host fills, as it fills the
/// boot ROM.
component Cga {
    ports { bus port: LocalBus::Slave; }
    model {
        mem vram: [u8; 0x4000];
        mem font: [u8; 2048];
        mem frame: [u8; 163840];
        state frame_width: u32 = 0;
        state frame_height: u32 = 0;
        /// Completed frames.
        state frames: u32 = 0;
        state crtc: [u8; 18];
        state index: u8 = 0;
        /// 3D8: bit 0 80-column text, 1 graphics, 2 monochrome, 3 video
        /// enable, 4 640-dot graphics, 5 blink.
        state mode: u8 = 0;
        /// 3D9: bits 0-3 background (or 640-dot foreground), 4 intensity,
        /// 5 palette.
        state color: u8 = 0;
        /// The beam, in dots from the top left of the frame.
        state pos: u32 = 0;

        /// Dots per character: 8 in 80-column text, else 16.
        fn char_dots() -> u32 {
            return if mode[0] == 1 && mode[1] == 0 { 8 } else { 16 };
        }
        fn line_dots() -> u32 {
            return (crtc[0] as u32 + 1) * char_dots();
        }
        fn rows() -> u32 {
            return crtc[9] as u32 % 32 + 1;
        }
        fn frame_lines() -> u32 {
            return (crtc[4] as u32 % 128 + 1) * rows() + crtc[5] as u32 % 32;
        }
        fn display_lines() -> u32 {
            return crtc[6] as u32 % 128 * rows();
        }

        /// Draw scanline `line` of the display area into `frame`.
        fn render(line: u32) {
            let ra = line % rows();
            let row = line / rows();
            let cd = char_dots();
            let cols = crtc[1] as u32;
            let start = concat(crtc[12] & 0x3F, crtc[13]) as u32;
            let cursor = concat(crtc[14] & 0x3F, crtc[15]) as u32;
            let base = line * 640;
            for col in 0..80 {
                if (col as u32) < cols && (col as u32 + 1) * cd <= 640 {
                    let ma = (start + row * cols + col as u32) & 0x3FFF;
                    let x0 = base + col as u32 * cd;
                    if mode[3] == 0 {
                        for d in 0..16 {
                            if (d as u32) < cd { frame[x0 + d as u32] = 0; }
                        }
                    } else if mode[1] == 1 {
                        // Graphics: even scanlines in the first 8 KB, odd in
                        // the second; two bytes per character.
                        let a = ((ma * 2) & 0x1FFF) | ((ra & 1) << 13);
                        let bits = concat(vram[a], vram[a + 1]);
                        for d in 0..16 {
                            let mut c: u8 = 0;
                            if mode[4] == 1 {
                                if bits[15 - d] == 1 { c = color & 15; }
                            } else {
                                let px = d / 2;
                                let v = (bits >> (14 - px * 2)) & 3;
                                c = if v == 0 { color & 15 } else { (v as u8) * 2 + color[5] as u8 + (color[4] as u8) * 8 };
                            }
                            frame[x0 + d as u32] = c;
                        }
                    } else {
                        // Text: a character and its attribute.
                        let a = (ma * 2) & 0x3FFF;
                        let ch = vram[a];
                        let attr = vram[a + 1];
                        let mut glyph = font[ch as u32 * 8 + (ra & 7)];
                        let mut fg = attr & 15;
                        let bg = if mode[5] == 1 { (attr >> 4) & 7 } else { attr >> 4 };
                        if mode[5] == 1 && attr[7] == 1 && frames[4] == 1 {
                            fg = bg;
                        }
                        let cur_start = crtc[10] & 31;
                        let cur_on = crtc[10][6:5] != 1 && (crtc[10][6:5] == 0 || frames[3] == 1);
                        if ma == cursor && cur_on && ra as u8 >= cur_start && ra as u8 <= (crtc[11] & 31) {
                            glyph = 0xFF;
                            fg = attr & 15;
                        }
                        for d in 0..16 {
                            if (d as u32) < cd {
                                let px = if cd == 16 { d / 2 } else { d };
                                frame[x0 + d as u32] = if glyph[7 - px[2:0]] == 1 { fg } else { bg };
                            }
                        }
                    }
                }
            }
            frame_width = if cols * cd < 640 { cols * cd } else { 640 };
        }

        /// Returns the dots left in the frame: a raster write or a status
        /// read is a bus access and catches the card up first, so drawing a
        /// frame's lines in one go at its end looks the same; the host
        /// calls `catch_up_all` before reading `frame` mid-frame.
        on tick(n: u32) -> u32 {
            let ld = line_dots();
            let total = ld * frame_lines();
            if total == 0 {
                return 0xFFFFFFFF;
            }
            let mut left = n;
            while left > 0 {
                let line = pos / ld;
                let end = (line + 1) * ld;
                if pos + left < end {
                    pos = pos + left;
                    left = 0;
                } else {
                    left = left - (end - pos);
                    if line < display_lines() && line < 256 {
                        render(line);
                    }
                    pos = end;
                    if pos >= total {
                        pos = 0;
                        frames = frames + 1;
                        frame_height = if display_lines() < 256 { display_lines() } else { 256 };
                    }
                }
            }
            return total - pos;
        }

        on port.read(space: Space, addr: u24, size: BusSize) -> (data: u16, wait: u8) {
            if space == Space::Mem {
                let a = addr[13:0];
                if size == BusSize::Word {
                    return (data: concat(vram[a + 1], vram[a]), wait: 1);
                }
                return (data: vram[a] as u16, wait: 1);
            }
            let r = addr[3:0];
            if r == 10 {
                // Status: bit 0 outside the display area, bit 3 vertical
                // retrace (16 lines from the sync row).
                let ld = line_dots();
                let line = if ld == 0 { 0 } else { pos / ld };
                let h = if ld == 0 { 0 } else { pos % ld };
                let shown = h < crtc[1] as u32 * char_dots() && line < display_lines();
                let vs = crtc[7] as u32 % 128 * rows();
                let retrace = line >= vs && line < vs + 16;
                let v: u8 = (if shown { 0 } else { 1 }) | (if retrace { 8 } else { 0 });
                return (data: v as u16, wait: 1);
            }
            if r[2:0] == 5 || r[2:0] == 1 || r[2:0] == 3 || r[2:0] == 7 {
                if r < 8 {
                    let v: u8 = if index >= 12 && index < 18 { crtc[index] } else { 0 };
                    return (data: v as u16, wait: 1);
                }
            }
            return (data: 0xFF, wait: 1);
        }

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            if space == Space::Mem {
                let a = addr[13:0];
                vram[a] = data as u8;
                if size == BusSize::Word {
                    vram[(a + 1) & 0x3FFF] = (data >> 8) as u8;
                }
                return (wait: 1);
            }
            let r = addr[3:0];
            let d = data as u8;
            if r < 8 {
                if r[0] == 0 {
                    index = d & 31;
                } else if index < 18 {
                    crtc[index] = d;
                }
            } else if r == 8 {
                mode = d;
            } else if r == 9 {
                color = d;
            }
            return (wait: 1);
        }
    }
}

/// Collects the bytes written to its port (like the Bochs port E9 hack).
component Console {
    ports { bus port: LocalBus::Slave; }
    model {
        mem text: [u8; 256];
        state len: u8 = 0;

        /// Host side: forget what has been printed.
        fn clear() {
            len = 0;
        }

        on port.write(space: Space, addr: u24, size: BusSize, data: u16) -> (wait: u8) {
            text[len] = data as u8;
            len = len + 1;
            return (wait: 0);
        }
    }
}

system Board286 {
    clock osc: 14.31818 MHz;                 // the PC crystal
    clock cpu_clk: 8 MHz;                    // the processor clock (CLK / 2)
    clock pit_clk = osc / 12;                // 1.193182 MHz
    clock dma_clk = osc / 3;                 // 4.77 MHz

    component cpu: Cpu286 @ cpu_clk;
    component ram: Ram;
    component rom: Rom;
    component pic1: Pic8259;
    component pic2: Pic8259;
    component pit: Pit8254 @ pit_clk;
    component dma: Dma8237 @ dma_clk;
    component link: HostLink;
    component cga: Cga @ osc;
    component console: Console;

    bus local: LocalBus @ cpu_clk {
        master cpu.local;
        slave ram.port @ mem 0x00000..=0x9FFFF;
        slave rom.port @ mem 0xF0000..=0xFFFFF, mem 0xFF0000..=0xFFFFFF;
        // The master first: it sees the acknowledge before the slave.
        slave pic1.port @ io 0x20..=0x21;
        slave pic2.port @ io 0xA0..=0xA1;
        slave pit.port @ io 0x40..=0x43;
        slave dma.regs @ io 0x00..=0x0F;
        slave dma.pages @ io 0x81..=0x87;
        master dma.dma;
        slave link.port;
        slave console.port @ io 0xE9..=0xE9;
        slave cga.port @ mem 0xB8000..=0xBFFFF, io 0x3D0..=0x3DF;
    }

    /// IRQ 0-7: the timer on 0, the slave controller on 2.
    bus irq_master: IrqLines @ cpu_clk {
        master pic1.ir;
        slave pit.irq;
        slave pic2.cascade;
    }
    /// IRQ 8-15: the host link on 12.
    bus irq_slave: IrqLines @ cpu_clk {
        master pic2.ir;
        slave link.irq;
    }

    wire pic1.sp = true;
    wire pic2.sp = false;
    wire pic2.cas_in = pic1.cas_out;
    wire cpu.intr_line = pic1.int;

    profile fast { default: model; }
}
